+#include "Config.h"
 #include "DBCStores.h"
 #include "DBCStructure.h"
 #include "GameGraveyard.h"
@@ -40,6 +41,21 @@ void SpellMgr::LoadSpellInfoCorrections()
 {
     uint32 oldMSTime = getMSTime();
 
+    // SoloWoW Era (Nov 17 night): mounts took 3 seconds to summon before patch 3.2 cut it to 1.5 (the server tells the
+    // client the cast time, so the cast bar follows). SoloWoW.Era.MountCast = 0 keeps 1.5.
+    if (sConfigMgr->GetOption<bool>("SoloWoW.Era.MountCast", true))
+    {
+        SpellCastTimesEntry const* three = nullptr;
+        for (uint32 i = 0; i < sSpellCastTimesStore.GetNumRows() && !three; ++i)
+            if (SpellCastTimesEntry const* e = sSpellCastTimesStore.LookupEntry(i); e && e->CastTime == 3000) three = e;
+        uint32 mounts = 0;
+        if (three)
+            for (uint32 id = 0; id < GetSpellInfoStoreSize(); ++id)
+                if (SpellInfo* s = mSpellInfoMap[id]; s && s->CastTimeEntry && s->CastTimeEntry->CastTime == 1500 && s->HasAura(SPELL_AURA_MOUNTED))
+                { s->CastTimeEntry = three; ++mounts; }
+        LOG_INFO("server.loading", ">> SoloWoW era: {} mounts take 3 seconds to summon again", mounts);
+    }
+
     // SoloWoW: Plainsrunning (12821, a leftover tauren racial from the beta, still named in the 3.3.5 client) becomes
     // a stacking run-speed aura the server drives (see SoloSim/solosim_plainsrunning.cpp): +2% per stack, unlimited
     // duration, can't be cancelled. MOD_INCREASE_SPEED takes the strongest only, so it doesn't stack with other speed
