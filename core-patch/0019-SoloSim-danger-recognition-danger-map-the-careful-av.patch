 // every three hours: herds drift between their grazing grounds (not in the rain); packs follow the nearest herd by
 // day and take one of it when they catch up; at night packs go down to the roads
+// how dangerous a place is right now (Nov 17): camps and packs nearby, a roaming threat, people who died there lately,
+// the other side's adventurers about. Rebuilt every few sim hours; 0 = quiet, 3+ = most folk would rather not.
+void World::RebuildDanger()
+{
+    _danger.clear(); _enemyNear.clear();
+    std::vector<std::tuple<uint32, float, float, float>> sources;     // map, x, y, weight
+    for (SimCamp const& k : _camps)
+        if (!k.done && k.kind != CAMP_HERD) sources.emplace_back(k.map, k.x, k.y, k.kind == CAMP_PACK ? 1.0f : 1.5f);
+    for (auto const& [id, o] : _agents)
+    {
+        SimSite const* s = SiteById(o.site);
+        if (!s) continue;
+        if (o.role == ROLE_THREAT && o.status == AgentStatus::Active) sources.emplace_back(s->map, s->x, s->y, 3.0f);
+        else if (o.status == AgentStatus::Dead && _clock - o.diedAt < 3 * MIN_PER_DAY) sources.emplace_back(s->map, s->x, s->y, 1.0f);
+    }
+    for (SimSite const& s : _sites)
+    {
+        float d = 0.0f;
+        for (auto const& [m, x, y, w] : sources)
+            if (m == s.map)
+            {
+                float dist = Dist2d(x, y, s.x, s.y);
+                if (dist < 1500.0f) d += w * (w >= 3.0f ? 1.0f : (dist < 700.0f ? 1.0f : 0.0f));
+            }
+        if (d > 0.0f) _danger[s.id] = d;
+    }
+    // the other side about: their adventurers on (or near) a ground make it contested - for each side its own way
+    for (auto const& [id, o] : _agents)
+        if (o.role == ROLE_ADVENTURER && o.status == AgentStatus::Active && o.doing == Verb::Fight)
+            _enemyNear[(uint64(o.site) << 1) | (IsHordeRace(o.race) ? 1u : 0u)] += 1;
+}
+
+float World::DangerFor(SimAgent const& a, uint32 site) const
+{
+    float d = 0.0f;
+    if (auto it = _danger.find(site); it != _danger.end()) d = it->second;
+    if (auto it = _enemyNear.find((uint64(site) << 1) | (IsHordeRace(a.race) ? 0u : 1u)); it != _enemyNear.end()) d += 0.7f * float(std::min<uint32>(it->second, 4));
+    return d;
+}
