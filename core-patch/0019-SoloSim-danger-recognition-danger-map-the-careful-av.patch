+// adventurers talking within earshot of the player (templated, filled with what the sim knows about them)
+std::string World::AdventurerChatter(uint32 agentId, uint32 otherAgentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->role != ROLE_ADVENTURER) return "";
+    Rng r(_seed, agentId, _clock * 7 + otherAgentId, P_SOCIAL + 950);
+    auto pick = [&r](std::initializer_list<char const*> l) { return std::string(*(l.begin() + r.Range(0, uint32(l.size()) - 1))); };
+    if (SimAgent const* o = otherAgentId ? AgentById(otherAgentId) : nullptr)
+    {
+        int8 kind = 0;
+        for (SimRelation const& rel : _relations)
+            if ((rel.a == a->id && rel.b == o->id) || (rel.b == a->id && rel.a == o->id)) { kind = int8(rel.kind); break; }
+        bool foe = IsHordeRace(a->race) != IsHordeRace(o->race);
+        bool grudge = a->ambition == AmbitionType::Revenge && a->avengeFor == o->id;
+        if (grudge) return Acore::StringFormat("{}. I haven't forgotten.", o->given);
+        if (foe) return pick({ "Keep walking.", "Not here. Not today.", "Your lot shouldn't be this far out." });
+        if (kind == 2) return Acore::StringFormat(pick({ "Oh. {}.", "Still breathing, {}? Pity.", "Find your own spot, {}." }), o->given);
+        if (kind == 1 || kind == 3)
+            return Acore::StringFormat(pick({ "{}! Still alive, I see.", "Drinks later, {}? You're buying.", "Watch my back out there, {}.",
+                "{} - you look terrible. Good hunting?" }), o->given);
+        if (o->role == ROLE_CIVILIAN) return pick({ "Morning.", "Anything need doing round here?", "Fine day for it." });
+        return pick({ "Good hunting.", "Heading out too?", "Mind the road - it's been bad.", "Seen any bounties worth the walk?" });
+    }
+    if (a->ambition == AmbitionType::Revenge)
+        if (SimAgent const* f = AgentById(a->avengeFor))
+            return Acore::StringFormat(pick({ "I'll find {}. Sooner or later.", "Somewhere out there, {} is laughing. Not for long." }), f->FullName());
+    if (a->ambition == AmbitionType::Avenge)
+        if (SimAgent const* f = AgentById(a->avengeFor))
+            return Acore::StringFormat(pick({ "This one's for {}.", "{} would've laughed at me for being this careful." }), f->given);
+    if (a->wounds >= 60) return pick({ "I need a healer. Or a bed. Either.", "Just a scratch. A deep one.", "Remind me why I do this." });
+    if (a->bounty) return pick({ "That bounty's mine. Don't even think about it.", "One more and the board pays out.", "Bounty work. It's honest. Mostly." });
+    if (a->ambition == AmbitionType::SaveGold) return pick({ "Every copper counts.", "Another few days of this and I'll have it.", "Don't touch my coin purse." });
+    if (a->ambition == AmbitionType::SeePlace)
+        return Acore::StringFormat(pick({ "One day I'll see {}.", "They say {} is something to see." }), SiteName(a->ambitionTarget));
+    if (a->doing == Verb::Fight)
+        if (SimSite const* s = SiteById(a->site); s && s->type == SiteType::Hunt)
+            return Acore::StringFormat(pick({ "{} everywhere. Bring more arrows next time.", "Another {}. They just keep coming.", "Careful - the {} hit harder than they look." }), s->creatureName);
+    if (Rainy(a->site)) return pick({ "Rain again. Lovely.", "My boots will never dry.", "Good weather for staying in." });
+    static char const* const byClass[12][2] = {
+        { "", "" }, { "Could use a whetstone.", "Shield's seen better days." }, { "Light keep us.", "Someone needs patching up? No?" },
+        { "Quiet. The game's spooked.", "Where's that pet got to now..." }, { "Didn't see me. Nobody does.", "Pockets are lighter than I'd like." },
+        { "Bless this road, I suppose.", "I can mend the body. The rest is up to you." }, { "", "" },
+        { "The spirits are restless today.", "Storm's coming. I can feel it." }, { "Anyone seen my spare robes?", "Don't stand too close - I'm practising." },
+        { "Don't mind the smell. It's the imp.", "Power has a price. I'm paying in instalments." }, { "", "" },
+        { "The woods are uneasy.", "Hush. Listen to the trees." } };
+    uint8 c = std::min<uint8>(a->cls, 11);
+    if (byClass[c][0][0] && r.Chance(0.5f)) return byClass[c][r.Range(0, 1)];
+    return pick({ "Long road today.", "Could eat a horse. Not mine, though.", "Somewhere out there's a bed with my name on it.", "Quiet. I don't trust quiet." });
+}
