+    // the things in a town people use (Nov 17): benches and chairs, mailboxes, the bounty board, anvils and forges, fires
+    enum Thing : uint8 { THING_SEAT = 1, THING_MAILBOX, THING_BOARD, THING_ANVIL, THING_FIRE };
+    constexpr uint32 BOARD_ENTRY = 9100000;                 // solosim_boards.cpp
+    bool IsThing(GameObject const* g, uint8 kind)
+    {
+        GameObjectTemplate const* t = g ? g->GetGOInfo() : nullptr;
+        if (!t || !g->isSpawned()) return false;
+        switch (kind)
+        {
+            case THING_SEAT:    return t->type == GAMEOBJECT_TYPE_CHAIR;
+            case THING_MAILBOX: return t->type == GAMEOBJECT_TYPE_MAILBOX;
+            case THING_BOARD:   return g->GetEntry() == BOARD_ENTRY;
+            case THING_ANVIL:   return t->type == GAMEOBJECT_TYPE_SPELL_FOCUS && (t->spellFocus.focusId == 1 || t->spellFocus.focusId == 3);
+            case THING_FIRE:    return t->type == GAMEOBJECT_TYPE_SPELL_FOCUS && t->spellFocus.focusId == 4;
+        }
+        return false;
+    }
+    class ThingNear
+    {
+    public:
+        ThingNear(float x, float y, float range, uint8 kind) : _x(x), _y(y), _range(range), _kind(kind) { }
+        bool operator()(GameObject* g) const { return g && g->GetExactDist2d(_x, _y) <= _range && IsThing(g, _kind); }
+    private:
+        float _x, _y, _range; uint8 _kind;
+    };
+    // one person per seat on a bench (a bench has several), one at an anvil: who has which
+    std::mutex claimLock;
+    std::unordered_map<uint64, ObjectGuid> claims;           // (object guid low << 3 | slot) -> the person using it
+    void ReleaseClaims(ObjectGuid who)
+    {
+        std::lock_guard<std::mutex> g(claimLock);
+        std::erase_if(claims, [who](auto const& kv) { return kv.second == who; });
+    }
+    bool Claim(GameObject const* g, uint32 slot, Creature const* who)
+    {
+        std::lock_guard<std::mutex> lk(claimLock);
+        uint64 key = (uint64(g->GetSpawnId() ? g->GetSpawnId() : g->GetGUID().GetCounter()) << 3) | (slot & 7);
+        if (auto it = claims.find(key); it != claims.end() && it->second != who->GetGUID())
+        {
+            Creature const* other = ObjectAccessor::GetCreature(*who, it->second);
+            if (other && other->IsAlive() && other->GetExactDist2d(g) < 6.0f) return false;   // still there
+        }
+        claims[key] = who->GetGUID();
+        return true;
+    }
