+// ---------------------------------------------------------------------------------------------------------------------
+// map flags for what the player took on: roughly where (40-90 yd off for searches - "somewhere around there"), exact
+// for a town to walk someone to
+static void Vague(uint32 seed, float& x, float& y)
+{
+    float ang = float(seed % 628) / 100.0f, d = 40.0f + float((seed / 628) % 50);
+    x += d * std::cos(ang); y += d * std::sin(ang);
+}
+
+bool World::ErrandPlace(uint32 agentId, uint32 guid, uint32& map, float& x, float& y, std::string& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand const& e : _errands)
+    {
+        if (e.agent != agentId || e.done || e.player != guid) continue;
+        SimSite const* s = nullptr;
+        switch (e.kind)
+        {
+            case ERRAND_CULL: case ERRAND_STOLEN:
+                s = SiteById(e.site); if (s) name = Acore::StringFormat("{} near {}", s->creatureName, AreaOf(SiteName(s->id))); break;
+            case ERRAND_OLDFOE:
+                s = SiteById(e.site); name = RareName(e.target); break;
+            case ERRAND_ESCORT:
+                s = SiteById(e.site); name = SiteName(e.site); break;
+            case ERRAND_MESSAGE:
+                if (SimAgent const* t = AgentById(e.target)) { s = SiteById(t->site); name = Acore::StringFormat("{} - last seen here", t->FullName()); }
+                break;
+            case ERRAND_MISSING:
+                if (SimAgent const* t = AgentById(e.target)) { s = SiteById(t->site); name = Acore::StringFormat("Where {} was last seen", t->FullName()); }
+                break;
+            default: return false;                         // fetching: any market or the wilds will do
+        }
+        if (!s) return false;
+        map = s->map; x = s->x; y = s->y;
+        if (e.kind != ERRAND_ESCORT) Vague(e.id * 7919u + guid, x, y);
+        return true;
+    }
+    return false;
+}
+
+bool World::BountyPlace(uint32 guid, uint32& map, float& x, float& y, std::string& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimBounty const* best = nullptr;
+    for (SimBounty const& b : _bounties) if (!b.done && b.player == guid && (!best || b.id > best->id)) best = &b;
+    if (!best) return false;
+    SimSite const* s = SiteById(best->site);
+    if (!s) return false;
+    map = s->map; x = s->x; y = s->y;
+    if (best->target & CAMP_MARK)                           // a camp sits where it was pitched
+        for (SimCamp const& k : _camps) if (k.id == (best->target & ~CAMP_MARK)) { map = k.map; x = k.x; y = k.y; }
+    name = best->kind == BOUNTY_RARE ? RareName(best->target) : Acore::StringFormat("{} near {}", s->creatureName, AreaOf(SiteName(s->id)));
+    Vague(best->id * 104729u + guid, x, y);
+    return true;
+}
+
 } // namespace SoloSim
