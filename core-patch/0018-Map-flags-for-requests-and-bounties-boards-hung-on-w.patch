-    // a spot in the open near the town centre, the same one every time
+    // The Wanted Board is a wall board: hung on a wall near the town centre, flat against it and facing out (Nov 17 - in
+    // the open it floated). Candidates spiral out to 30 yd; a wall is something solid within 1.5 yd at chest height in
+    // one direction with open ground behind the spot. The same spot every time. No wall: the old open spot.
+    bool WallSpot(Map* map, SoloSim::SimSite const& town, Position& out)
+    {
+        auto blocked = [map](float x, float y, float z, float ang, float dist) {
+            return !map->isInLineOfSight(x, y, z, x + std::cos(ang) * dist, y + std::sin(ang) * dist, z, PHASEMASK_NORMAL,
+                LINEOFSIGHT_CHECK_VMAP, VMAP::ModelIgnoreFlags::Nothing);
+        };
+        for (uint32 k = 0; k < 60; ++k)
+        {
+            float ang = float(k) * 2.399f + float(town.id);
+            float r = 4.0f + float(k) * 0.45f;
+            float x = town.x + r * std::cos(ang), y = town.y + r * std::sin(ang);
+            float z = map->GetHeight(PHASEMASK_NORMAL, x, y, town.z + 6.0f, true, 20.0f);
+            if (z <= INVALID_HEIGHT || std::fabs(z - town.z) > 6.0f) continue;
+            if (map->GetLiquidData(PHASEMASK_NORMAL, x, y, z, 2.0f, {}).Status != LIQUID_MAP_NO_WATER) continue;
+            float chest = z + 1.4f;
+            for (uint32 d = 0; d < 16; ++d)
+            {
+                float wa = float(d) * float(M_PI) / 8.0f;
+                if (!blocked(x, y, chest, wa, 1.5f)) continue;                      // nothing there to hang it on
+                if (!blocked(x, y, z + 0.4f, wa, 1.6f)) continue;                   // a railing or a ledge, not a wall
+                if (blocked(x, y, chest, wa + float(M_PI), 3.5f)) continue;         // no room to stand and read it
+                if (blocked(x, y, chest, wa + float(M_PI) / 2.0f, 1.0f) && blocked(x, y, chest, wa - float(M_PI) / 2.0f, 1.0f)) continue;   // a corner/alley
+                float gap = 1.5f;                                                   // how far the wall is: step in
+                for (float s = 0.2f; s <= 1.5f; s += 0.1f) if (blocked(x, y, chest, wa, s)) { gap = s; break; }
+                float bx = x + std::cos(wa) * std::max(0.0f, gap - 0.25f), by = y + std::sin(wa) * std::max(0.0f, gap - 0.25f);
+                float bz = map->GetHeight(PHASEMASK_NORMAL, bx, by, z + 2.0f, true, 6.0f);
+                if (bz <= INVALID_HEIGHT || std::fabs(bz - z) > 1.0f) bz = z;
+                out.Relocate(bx, by, bz, wa + float(M_PI));                         // back to the wall, face out
+                return true;
+            }
+        }
+        return false;
+    }
