+// the town serving a dock: the nearest hub with an inn within 900 yd that will have this traveller (0 = none)
+uint32 World::DockTown(uint32 map, float x, float y, SimAgent const& a) const
+{
+    if (map > 1) return 0;
+    uint32 best = 0; float bd = 900.0f;
+    for (SimSite const& s : _sites)
+    {
+        if (s.type != SiteType::Hub || !(s.services & SVC_INN) || s.map != map || !Welcome(a, s)) continue;
+        float d = Dist2d(s.x, s.y, x, y);
+        if (d < bd) { bd = d; best = s.id; }
+    }
+    return best;
+}
