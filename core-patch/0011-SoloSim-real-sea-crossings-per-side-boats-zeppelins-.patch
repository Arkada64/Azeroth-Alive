+// Alliance and Horde on the same hunting ground (Ashenvale, the Barrens, Stranglethorn, Hillsbrad, Arathi...): someone
+// usually decides it's their ground. The cautious or the badly outnumbered keep their distance. Strength is level, kit,
+// party and luck; the loser is beaten (and can die of it like any defeat), the winner is bruised. Both remember the
+// other, and the nearest town hears of it. Returns true when `a` lost and their hunt is over.
+bool World::Clash(SimAgent& a, SimSite const& site)
+{
+    if (a.role != ROLE_ADVENTURER || site.type != SiteType::Hunt) return false;
+    if (auto it = _lastClash.find(a.id); it != _lastClash.end() && it->second + MIN_PER_DAY > _clock) return false;
+    bool horde = IsHordeRace(a.race);
+    SimAgent* foe = nullptr;
+    for (auto& [id, o] : _agents)
+    {
+        if (o.status != AgentStatus::Active || o.role != ROLE_ADVENTURER || o.doing != Verb::Fight) continue;
+        if (IsHordeRace(o.race) == horde || std::abs(int32(o.level) - int32(a.level)) > 12) continue;
+        if (o.site != site.id)                                     // or a neighbouring ground: hunters drift
+        {
+            SimSite const* os = SiteById(o.site);
+            if (!os || os->map != site.map || Dist2d(os->x, os->y, site.x, site.y) > 350.0f) continue;
+        }
+        if (auto it = _lastClash.find(o.id); it != _lastClash.end() && it->second + MIN_PER_DAY > _clock) continue;
+        if (!foe || o.level > foe->level) foe = &o;                // the most dangerous of them is the one who matters
+    }
+    if (!foe) return false;
+    Rng r(_seed, a.id ^ (foe->id << 12), _clock, P_FIGHT + 950);
+    if (!r.Chance(0.35f)) return false;                            // the ground is wide: often they never cross paths
+    _lastClash[a.id] = _lastClash[foe->id] = _clock;
+    uint32 na = PartySize(a), nf = PartySize(*foe);
+    auto strength = [&](SimAgent const& x, uint32 n) { return float(x.level) * 4.0f + x.gearTier / 10.0f + float(n - 1) * 14.0f + r.Float() * 20.0f; };
+    float sa = strength(a, na), sf = strength(*foe, nf);
+    std::string place = AreaOf(SiteName(site.id));
+    char const* them = horde ? "the Alliance" : "the Horde";
+    // seeing a fight they can't win, the careful walk away (both sides keep a grudge)
+    SimAgent& weaker = sa < sf ? a : *foe;
+    if (std::abs(sa - sf) > 25.0f && r.Chance(weaker.caution / 120.0f))
+    {
+        _memories.push_back({ a.id, 1, foe->id, uint8(EventType::Clash), -30, 40, _clock });
+        _memories.push_back({ foe->id, 1, a.id, uint8(EventType::Clash), -30, 40, _clock });
+        Log(EventType::Clash, weaker, site.id, Acore::StringFormat("{} saw {} of {} hunting {} and kept their distance.", Who(weaker),
+            Who(&weaker == &a ? *foe : a), &weaker == &a ? them : (horde ? "the Horde" : "the Alliance"), site.creatureName), false, (&weaker == &a ? *foe : a).id);
+        return false;
+    }
+    SimAgent& win = sa >= sf ? a : *foe;
+    SimAgent& lose = sa >= sf ? *foe : a;
+    win.wounds = uint8(std::min<uint32>(95, win.wounds + r.Range(10, 40)));
+    _memories.push_back({ lose.id, 1, win.id, uint8(EventType::Clash), -90, 90, _clock });
+    _memories.push_back({ win.id, 1, lose.id, uint8(EventType::Clash), -40, 60, _clock });
+    ++win.kills;
+    Log(EventType::Clash, win, site.id, Acore::StringFormat("{} fought {} over the {} hunting near {} and won.", Who(win), Who(lose), site.creatureName, place),
+        true, lose.id);
+    lose.wounds = uint8(std::min<uint32>(100, lose.wounds + r.Range(50, 90)));
+    if (lose.wounds >= 100 || r.Chance(0.6f))
+    {
+        _culprit = Acore::StringFormat("{} of {} near {}", lose.id == a.id ? Who(*foe) : Who(a), IsHordeRace(win.race) ? "the Horde" : "the Alliance", place);
+        lose.wounds = 100;
+        Defeat(lose, site);
+        _culprit.clear();
+        if (&lose != &a) _requeue.push_back(lose.id);                // their plans changed outside their own wake
+    }
+    return &lose == &a && a.status != AgentStatus::Active;           // beaten (or worse); a bloodied loser hunts on
+}
