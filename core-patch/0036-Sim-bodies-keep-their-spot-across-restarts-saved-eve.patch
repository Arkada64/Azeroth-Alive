+void World::NoteSpot(uint32 agentId, uint32 map, float x, float y, float z, float o, uint8 stand)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->status != AgentStatus::Active) { _spots.erase(agentId); return; }
+    _spots[agentId] = { map, x, y, z, o, stand, uint8(a->doing), a->wakeAt };
+}
+
+bool World::SavedSpot(uint32 agentId, BodySpot& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    auto it = _spots.find(agentId);
+    if (it == _spots.end()) return false;
+    out = it->second;
+    _spots.erase(it);
+    SimAgent const* a = AgentById(agentId);
+    // the same step as when they were last seen: nothing has moved them on since (a restart, a short absence)
+    return a && a->status == AgentStatus::Active && uint8(a->doing) == out.doing && a->wakeAt == out.wakeAt;
+}
