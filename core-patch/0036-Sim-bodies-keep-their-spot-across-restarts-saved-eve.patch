+bool World::FriendCard(uint32 agentId, std::string& name, uint8& race, uint8& gender, uint8& cls)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->role != ROLE_ADVENTURER) return false;
+    name = a->given; race = a->race; gender = a->gender; cls = a->cls;
+    return true;
+}
+
+bool World::FriendStatus(uint32 agentId, uint8& status, uint32& zone, uint8& level, uint8& cls)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    status = 0; zone = 0; level = 0; cls = 0;
+    if (!a || a->role != ROLE_ADVENTURER) return false;
+    if (a->status == AgentStatus::Dead || a->status == AgentStatus::Gone) return true;
+    status = a->status == AgentStatus::Recovering ? 2 : 1;
+    if (SimSite const* s = SiteById(a->site)) zone = s->zone;
+    level = a->level; cls = a->cls;
+    return true;
+}
