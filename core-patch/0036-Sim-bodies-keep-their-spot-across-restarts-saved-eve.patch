+// "/friend Marrin": you can befriend someone you've met, or someone standing in front of you. It warms them to you.
+uint32 World::Befriend(uint32 guid, std::string const& asked, bool horde, uint32 nearAgent, std::string& reply, std::string& fullName)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    auto lower = [](std::string s) { for (char& ch : s) ch = char(std::tolower(uint8(ch))); return s; };
+    std::string q = lower(asked);
+    SimAgent* best = nullptr; int32 bestRegard = INT32_MIN; bool bestMet = false;
+    for (auto& [id, a] : _agents)
+    {
+        if (a.role != ROLE_ADVENTURER || a.status == AgentStatus::Dead || a.status == AgentStatus::Gone) continue;
+        if (IsHordeRace(a.race) != horde) continue;
+        if (lower(a.given) != q && lower(a.FullName()) != q) continue;
+        int32 sum = 0; bool met = false;
+        for (SimMemory const& m : _memories) if (m.agent == id && m.subjectType == 4 && m.subject == guid) { met = true; sum += int32(m.valence) * m.intensity / 100; }
+        if (id == nearAgent) { met = true; sum += 1000; }                     // the one in front of you
+        if (!best || sum > bestRegard) { best = &a; bestRegard = sum; bestMet = met; }
+    }
+    if (!best) return 0;
+    fullName = best->FullName();
+    if (!bestMet) { reply = ""; return 0; }                                    // nobody by that name knows you
+    int32 regard = bestRegard >= 1000 ? bestRegard - 1000 : bestRegard;
+    if (regard < -30) { reply = "Friends? With you? No."; return 0; }
+    bool already = false;
+    for (SimMemory const& m : _memories)
+        if (m.agent == best->id && m.subjectType == 4 && m.subject == guid && m.eventType == uint8(EventType::Befriended)) already = true;
+    if (!already) RememberPlayer(*best, guid, 25, 60, EventType::Befriended);
+    Rng r(_seed, best->id, uint64(guid) << 8, P_SOCIAL + 910);
+    static char const* const warm[] = { "Glad to call you a friend. Send word if you need a hand.", "A friend, then. Look me up when you're near.",
+        "I'll remember that. Whisper if you're ever in a fix." };
+    static char const* const cool[] = { "All right. We'll see how it goes.", "Friends, eh? Fair enough.", "Sure. Don't make me regret it." };
+    reply = regard >= 0 ? warm[r.Range(0, 2)] : cool[r.Range(0, 2)];
+    return best->id;
+}
+
+// a whisper to someone far away: a line back about where they are and what they're about
+std::string World::WhisperReply(uint32 agentId, uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a) return "";
+    int32 sum = 0;
+    for (SimMemory const& m : _memories) if (m.agent == agentId && m.subjectType == 4 && m.subject == guid) sum += int32(m.valence) * m.intensity / 100;
+    Rng r(_seed, agentId, (uint64(guid) << 20) ^ (_clock / 30), P_SOCIAL + 920);
+    SimSite const* s = SiteById(a->site);
+    std::string where = s ? AreaOf(SiteName(s->id)) : std::string("the road");
+    if (a->status == AgentStatus::Hired) return "Can't talk long - I'm on the road with someone.";
+    if (a->status == AgentStatus::Recovering) return Acore::StringFormat("Still laid up near {}. Few more days and I'll be on my feet.", where);
+    if (sum < 0) return r.Chance(0.5f) ? "What do you want?" : "I've nothing to say to you.";
+    static char const* const open[] = { "Good to hear from you!", "Hey, friend.", "There you are.", "Well met." };
+    std::string line = Acore::StringFormat("{} I'm {}.", open[r.Range(0, 3)], Doing(*a));
+    if (a->doing == Verb::Fight && r.Chance(0.5f)) line += " Busy, mind - talk later.";
+    else if (sum >= 30 && r.Chance(0.4f)) line += " Want to meet up? Invite me and I'll tell you where.";
+    return line;
+}
