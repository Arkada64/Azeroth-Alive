+// ---- friends (Nov 17 night) --------------------------------------------------------------------------
+static uint32 FriendAgent(ObjectGuid guid)
+{
+    if (!guid.IsPlayer() || guid.GetCounter() < SoloSim::World::FRIEND_GUID_BASE) return 0;
+    return guid.GetCounter() - SoloSim::World::FRIEND_GUID_BASE;
+}
+static ObjectGuid FriendGuid(uint32 agent) { return ObjectGuid::Create<HighGuid::Player>(SoloSim::World::FRIEND_GUID_BASE + agent); }
+
+bool BotBubble::SimFriendName(ObjectGuid guid, std::string& name, uint8& race, uint8& gender, uint8& cls)
+{
+    uint32 agent = FriendAgent(guid);
+    return agent && sSoloSim->IsLive() && sSoloSim->FriendCard(agent, name, race, gender, cls);
+}
+
+bool BotBubble::SimFriendInfo(ObjectGuid guid, uint8& status, uint32& area, uint8& level, uint8& cls)
+{
+    uint32 agent = FriendAgent(guid);
+    if (!agent) return false;
+    status = 0; area = 0; level = 0; cls = 0;
+    if (sSoloSim->IsLive()) sSoloSim->FriendStatus(agent, status, area, level, cls);
+    return true;
+}
+
+// the nearest living body by that name, within reach (someone you're talking to)
+static uint32 NearAgentNamed(Player* player, std::string const& name, float range)
+{
+    uint32 best = 0; float bestD = range;
+    for (uint32 a : sSoloSim->AgentsNamed(name))
+        if (auto it = simAgentToEntry.find(a); it != simAgentToEntry.end())
+            if (Creature const* c = BotDataMgr::FindBot(it->second); c && c->IsInWorld() && c->IsAlive() && c->GetMap() == player->GetMap())
+                if (float d = c->GetExactDist(player); d < bestD) { bestD = d; best = a; }
+    return best;
+}
+
+static void WhisperAs(Player* player, uint32 agent, std::string const& text)
+{
+    WorldPacket data;
+    ChatHandler::BuildChatPacket(data, CHAT_MSG_WHISPER, LANG_UNIVERSAL, FriendGuid(agent), player->GetGUID(), text, 0);
+    player->SendDirectMessage(&data);
+}
+
+bool BotBubble::AddSimFriend(Player* player, std::string const& name, std::string const& note)
+{
+    if (!player || !sSoloSim->IsLive()) return false;
+    uint32 pguid = player->GetGUID().GetCounter();
+    std::string reply, full;
+    uint32 agent = sSoloSim->Befriend(pguid, name, player->GetTeamId() == TEAM_HORDE, NearAgentNamed(player, name, 30.0f), reply, full);
+    if (!agent)
+    {
+        if (full.empty()) return false;                                       // nobody by that name on your side
+        if (reply.empty())
+            ChatHandler(player->GetSession()).PSendSysMessage("You don't know {} well enough yet - meet them first, or ask them face to face.", full);
+        else
+            ChatHandler(player->GetSession()).PSendSysMessage("{}: \"{}\"", full, reply);
+        sSocialMgr->SendFriendStatus(player, FRIEND_NOT_FOUND, ObjectGuid::Empty, false);
+        return true;
+    }
+    ObjectGuid fg = FriendGuid(agent);
+    PlayerSocial* social = player->GetSocial();
+    if (social->HasFriend(fg)) { sSocialMgr->SendFriendStatus(player, FRIEND_ALREADY, fg, false); return true; }
+    if (!social->AddToSocialList(fg, SOCIAL_FLAG_FRIEND)) { sSocialMgr->SendFriendStatus(player, FRIEND_LIST_FULL, fg, false); return true; }
+    social->SetFriendNote(fg, note.empty() ? full : note);                    // the friends list shows one name; the note has both
+    uint8 st = 0, lv = 0, cl = 0; uint32 ar = 0;
+    sSoloSim->FriendStatus(agent, st, ar, lv, cl);
+    sSocialMgr->SendFriendStatus(player, st ? FRIEND_ADDED_ONLINE : FRIEND_ADDED_OFFLINE, fg, false);
+    WhisperAs(player, agent, reply);
+    return true;
+}
+
+bool BotBubble::WhisperSim(Player* player, std::string const& to, std::string const& msg)
+{
+    if (!player || !sSoloSim->IsLive()) return false;
+    uint32 pguid = player->GetGUID().GetCounter();
+    std::vector<uint32> agents = sSoloSim->AgentsNamed(to);
+    bool horde = player->GetTeamId() == TEAM_HORDE;
+    std::erase_if(agents, [horde](uint32 a) { return sSoloSim->AgentIsHorde(a) != horde; });
+    if (agents.empty()) return false;
+    // the one on your friends list, else the one near you, else the first by that name
+    uint32 agent = 0;
+    for (uint32 a : agents) if (player->GetSocial()->HasFriend(FriendGuid(a))) { agent = a; break; }
+    if (!agent) agent = NearAgentNamed(player, to, 40.0f);
+    if (!agent) agent = agents.front();
+    WorldPacket echo;                                                        // "To Marrin: ..." in your own chat
+    ChatHandler::BuildChatPacket(echo, CHAT_MSG_WHISPER_INFORM, LANG_UNIVERSAL, FriendGuid(agent), FriendGuid(agent), msg, 0);
+    player->SendDirectMessage(&echo);
+    if (std::string say = sSoloSim->WhisperReply(agent, pguid); !say.empty())
+        WhisperAs(player, agent, say);
+    return true;
+}
