+
+    // XP by difficulty and distance (Nov 17 night): what an ordinary quest of its level pays after the revert, times the
+    // work - kills or things to gather against an ordinary quest's eight or so, a rare, a group - and the way there
+    static uint32 XPFor(SoloSim::World::ErrandQuest const& in)
+    {
+        float effort = in.effort;
+        if (effort <= 0.0f)
+            switch (in.kind)
+            {
+                case SoloSim::ERRAND_CULL:    effort = float(std::max<uint32>(1, in.count)) / 8.0f; break;
+                case SoloSim::ERRAND_STOLEN:  effort = float(std::max<uint32>(1, in.count)) / 5.0f; break;   // humanoids, and the search
+                case SoloSim::ERRAND_FETCH:   effort = 0.8f * float(std::max<uint32>(1, in.count)) / 8.0f; break;
+                case SoloSim::ERRAND_OLDFOE:  effort = 1.8f; break;
+                case SoloSim::ERRAND_ESCORT:  effort = 1.1f; break;
+                case SoloSim::ERRAND_MISSING: effort = 0.9f; break;
+                case SoloSim::ERRAND_MESSAGE: effort = 0.4f; break;
+                case SoloSim::ERRAND_CARAVAN: effort = 1.5f; break;
+                default:                      effort = 1.0f; break;
+            }
+        float travel = 1.0f;
+        if (in.hasPlace && in.map == in.giverMap)
+        {
+            float d = std::hypot(in.x - in.giverX, in.y - in.giverY);
+            travel += std::clamp((d - 300.0f) / 2000.0f, 0.0f, 0.6f);       // up to +60% for a long walk
+        }
+        float f = std::clamp(effort * travel, 0.25f, 4.0f);
+        return std::max<uint32>(1, uint32(float(SoloEra::OrdinaryQuestXP(uint8(std::clamp<uint32>(in.level, 1, 80)))) * f + 0.5f));
+    }
 };
 
