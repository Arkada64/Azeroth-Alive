 #include <unordered_map>
 
 namespace SoloEra
@@ -40,12 +46,59 @@ namespace
     }
 }
 
+namespace
+{
+    std::shared_mutex liveLock;
+    std::unordered_map<uint32, uint32> liveXp;         // generated quests (pool ids), set when the sim writes them
+    std::once_flag ordinaryOnce;
+    std::array<uint32, 81> ordinary{};                 // level -> median full XP of ordinary solo quests
+
+    void LoadOrdinary()
+    {
+        std::call_once(questXpOnce, LoadQuestXP);
+        std::array<std::vector<uint32>, 81> by;
+        for (auto const& [id, q] : sObjectMgr->GetQuestTemplates())
+        {
+            int32 lvl = q->GetQuestLevel();
+            if (lvl < 1 || lvl > 80 || q->GetSuggestedPlayers() > 1 || q->GetQuestMethod() == 0 || q->IsDaily() || q->IsRepeatable()) continue;
+            if (q->GetType() != 0) continue;            // elite, dungeon, raid, PvP, group... - ordinary quests only
+            if (q->GetQuestId() >= 95000 && q->GetQuestId() < 97000) continue;   // our own pool
+            auto it = questXp.find(id);
+            uint32 xp = it != questXp.end() ? it->second : q->XPValue(uint8(lvl));
+            if (xp) by[lvl].push_back(xp);
+        }
+        for (uint32 l = 1; l <= 80; ++l)
+            if (!by[l].empty()) { std::ranges::nth_element(by[l], by[l].begin() + by[l].size() / 2); ordinary[l] = by[l][by[l].size() / 2]; }
+        for (uint32 l = 2; l <= 80; ++l) if (!ordinary[l]) ordinary[l] = ordinary[l - 1];          // gaps: the level below
+        for (uint32 l = 79; l >= 1; --l) if (!ordinary[l]) ordinary[l] = ordinary[l + 1];
+        LOG_INFO("server.loading", "SoloWoW era: ordinary quest XP - level 10 {}, 30 {}, 50 {}, 60 {}, 70 {}", ordinary[10], ordinary[30], ordinary[50], ordinary[60], ordinary[70]);
+    }
+}
+
 uint32 QuestXP(uint32 questId)
 {
+    if (questId >= 95000 && questId < 97000)
+    {
+        std::shared_lock lock(liveLock);
+        auto it = liveXp.find(questId);
+        return it == liveXp.end() ? 0 : it->second;
+    }
     std::call_once(questXpOnce, LoadQuestXP);
     auto it = questXp.find(questId);
     return it == questXp.end() ? 0 : it->second;
 }
+
+uint32 OrdinaryQuestXP(uint8 level)
+{
+    std::call_once(ordinaryOnce, LoadOrdinary);
+    return ordinary[std::clamp<uint32>(level, 1, 80)];
+}
+
+void SetQuestXP(uint32 questId, uint32 xp)
+{
+    std::unique_lock lock(liveLock);
+    liveXp[questId] = xp;
+}
 }
 
