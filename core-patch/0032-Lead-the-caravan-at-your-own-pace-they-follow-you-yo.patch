+std::string World::SummonCaravan(uint32 map, float x, float y)
+{
+    {
+        std::lock_guard<std::mutex> guard(sBodyLock);
+        if (!_ready) return "The world isn't running yet.";
+        uint32 town = 0; float best = 1e9f;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.map == map)
+                if (float d = Dist2d(s.x, s.y, x, y); d < best) { best = d; town = s.id; }
+        if (!town) return "No inn town on this map.";
+        _forceCaravanFrom = town; _forceCaravanNote.clear();
+    }
+    size_t before = _caravans.size();
+    CaravanTick();
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (_caravans.size() > before)
+    {
+        SimCaravan const& c = _caravans.back();
+        return Acore::StringFormat("A caravan is gathering in {} for {}. Ask about town for the trader - they want one more guard.", SiteName(c.from), SiteName(c.to));
+    }
+    return _forceCaravanNote.empty() ? std::string("No caravan could form.") : _forceCaravanNote;
+}
+
+std::string World::SummonHunters(uint32 guid, bool playerHorde, uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "The world isn't running yet.";
+    PlayerHeat& h = _heat[guid];
+    h.level = std::max<uint8>(h.level, 2); h.horde = !playerHorde; h.decayAt = _clock + MIN_PER_DAY;
+    h.town = 0;
+    float best = 1e9f;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.map == map && s.side == (h.horde ? SIDE_HORDE : SIDE_ALLIANCE))
+            if (float d = Dist2d(s.x, s.y, x, y); d < best) { best = d; h.town = s.id; }
+    h.reward = std::max<uint32>(h.reward, 2000);
+    h.lastHunt = 0; h.lastEval = 0; h.force = true;
+    return Acore::StringFormat("{} has put a price on your head. Go somewhere open, away from towns, and keep your eyes open.", h.town ? SiteName(h.town) : std::string("The other side"));
+}
