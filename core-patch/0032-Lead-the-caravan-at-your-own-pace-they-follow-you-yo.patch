+// back to walking on their own (the player who led them went another way, or a restart lost the thread)
+void World::CaravanOnward(SimCaravan& c, uint32 fromSite)
+{
+    c.led = false;
+    for (uint32 id : c.guards)
+        if (SimAgent* a = AgentById(id); a && a->status == AgentStatus::Active)
+        {
+            a->follow = 0; a->followKind = 0;
+            a->site = fromSite;
+            uint32 m = std::max<uint32>(1, TravelMinutes(fromSite, c.to, *a) * 17 / 10);
+            a->plan.clear();
+            a->plan.push_back({ Verb::Goto, c.to, m });
+            a->plan.push_back({ Verb::Trade, c.to, 30 });
+            a->doing = Verb::Goto; a->wakeAt = _clock + m;
+            _requeue.push_back(a->id);
+        }
+}
