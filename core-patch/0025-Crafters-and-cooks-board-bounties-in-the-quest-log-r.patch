+bool OfferBounty(Player* player, Object* board, uint32 bountyId)
+{
+    if (!player || !FillBounty(bountyId, player->GetGUID().GetCounter())) return false;
+    Quest const* q = sObjectMgr->GetQuestTemplate(BountyQuestId(bountyId));
+    QuestStatus st = player->GetQuestStatus(q->GetQuestId());
+    if (st == QUEST_STATUS_INCOMPLETE || st == QUEST_STATUS_COMPLETE) return true;
+    if (st == QUEST_STATUS_REWARDED) player->RemoveRewardedQuest(q->GetQuestId());
+    if (!player->CanAddQuest(q, true)) return false;
+    player->AddQuestAndCheckCompletion(q, board);
+    ChatHandler(player->GetSession()).PSendSysMessage("Quest accepted: {}", q->GetTitle());
+    return true;
+}
