+uint32 TurnInBounties(Player* player, Object* board)
+{
+    uint32 paid = 0, guid = player->GetGUID().GetCounter();
+    uint32 hub = sSoloSim->BoardHubAt(player->GetMapId(), player->GetPositionX(), player->GetPositionY());
+    std::vector<uint32> done;
+    for (auto const& [qid, st] : player->getQuestStatusMap())
+        if (IsBounty(qid) && st.Status == QUEST_STATUS_COMPLETE) done.push_back(qid);
+    for (uint32 qid : done)
+    {
+        SoloSim::SimBounty b;
+        if (!sSoloSim->BountyBySlot(guid, qid - BOUNTY_BASE, QUEST_POOL, b) || b.hub != hub) continue;   // collect where it was posted
+        Quest const* q = sObjectMgr->GetQuestTemplate(qid);
+        if (!q || !player->CanRewardQuest(q, true)) continue;
+        sSoloSim->ForceBountyProgress(b.id);
+        paid += uint32(std::max<int32>(0, q->GetRewOrReqMoney(player->GetLevel())));
+        player->RewardQuest(q, 0, board);
+    }
+    return paid;
+}
