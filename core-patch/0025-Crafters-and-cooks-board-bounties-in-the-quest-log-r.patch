+// ---------------------------------------------------------------------------------------------------------------------
+// board bounties as quests (Nov 17): thinning and packs count kills of the ground's creature, a rare or a camp the
+// named creature, a roaming threat is an event the sim marks when you put it down
+bool World::BountyQuestInfo(uint32 bountyId, uint32 guid, ErrandQuest& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimBounty const* b = nullptr;
+    for (SimBounty const& x : _bounties) if (x.id == bountyId && !x.done && x.player == guid) b = &x;
+    if (!b) return false;
+    SimSite const* hub = SiteById(b->hub); SimSite const* s = SiteById(b->site);
+    if (!hub || !s) return false;
+    out = {};
+    out.errand = b->id; out.reward = b->reward; out.count = b->count;
+    out.giverMap = hub->map; out.giverZone = hub->zone; out.giverX = hub->x; out.giverY = hub->y;
+    out.hasPlace = true; out.map = s->map; out.zone = s->zone; out.x = s->x; out.y = s->y;
+    out.level = std::max<uint32>(1, (s->minLevel + s->maxLevel) / 2);
+    std::string town = SiteName(b->hub), area = AreaOf(SiteName(s->id));
+    out.request = "The board's still up. Done yet?"; out.offer = "Paid in full - the town thanks you.";
+    if (b->kind == BOUNTY_RARE)
+    {
+        std::string name = RareName(b->target);
+        if (b->target & THREAT_MARK)
+        {
+            out.kind = 0;                                           // an event: the sim marks it
+            if (SimAgent const* t = AgentById(b->target & ~THREAT_MARK)) out.level = t->level;
+            out.title = Acore::StringFormat("Wanted: {}", name);
+            out.objective = Acore::StringFormat("Put down {}, last seen near {}, then collect at the board in {}.", name, area, town);
+        }
+        else if (b->target & CAMP_MARK)
+        {
+            out.kind = ERRAND_CULL;
+            for (SimCamp const& k : _camps)
+                if (k.id == (b->target & ~CAMP_MARK)) { out.entry = k.entry; out.level = k.level; out.x = k.x; out.y = k.y; out.creatureName = k.name; }
+            out.title = Acore::StringFormat("Bounty: {}", name);
+            out.objective = Acore::StringFormat("Break up {} near {} ({} of them), then collect at the board in {}.", name, area, b->count, town);
+        }
+        else
+        {
+            out.kind = ERRAND_OLDFOE; out.entry = b->target; if (b->targetLevel) out.level = b->targetLevel;
+            out.title = Acore::StringFormat("Wanted: {}", name);
+            out.objective = Acore::StringFormat("Kill {} near {}, then collect at the board in {}.", name, area, town);
+        }
+    }
+    else
+    {
+        out.kind = ERRAND_CULL; out.creatureName = s->creatureName; out.minLevel = s->minLevel; out.maxLevel = s->maxLevel;
+        out.title = b->kind == BOUNTY_PACK ? Acore::StringFormat("Bounty: the {} Pack", s->creatureName) : Acore::StringFormat("Bounty: {}", s->creatureName);
+        out.objective = Acore::StringFormat("Kill {} {} near {}{}, then collect at the board in {}.", b->count, s->creatureName, area,
+            b->party > 1 ? " - bring friends" : "", town);
+    }
+    out.details = Acore::StringFormat("A notice on the board in {}: {}\n\nThe town pays {} on proof.", town, out.objective, Money(b->reward));
+    return true;
+}
+
+bool World::BountyBySlot(uint32 guid, uint32 slot, uint32 pool, SimBounty& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimBounty const& b : _bounties)
+        if (!b.done && b.player == guid && b.id % pool == slot) { out = b; return true; }
+    return false;
+}
+
+void World::ForceBountyProgress(uint32 bountyId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimBounty& b : _bounties) if (b.id == bountyId && !b.done) b.playerProgress = std::max(b.playerProgress, b.count);
+}
+
+uint32 World::BoardHubAt(uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    return _ready ? HubNear(map, x, y, 120.0f) : 0;
+}
+
+uint32 World::NewestBountyOf(uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    uint32 best = 0;
+    for (SimBounty const& b : _bounties) if (!b.done && b.player == guid && b.id > best) best = b.id;
+    return best;
+}
