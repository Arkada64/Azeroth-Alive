+// ---------------------------------------------------------------------------------------------------------------------
+// crafters (Nov 17): what they make, by the land's level - the game's own items (potions and food sold in the shops)
+struct Product { uint32 item; uint8 minLvl, maxLvl; };
+static Product const POTIONS[] = { { 118, 1, 14 }, { 858, 8, 24 }, { 929, 18, 34 }, { 1710, 28, 44 }, { 3928, 38, 54 }, { 13446, 48, 60 } };
+static Product const FOODS[] = { { 2680, 1, 10 }, { 2684, 8, 18 }, { 3220, 14, 24 }, { 3666, 20, 30 }, { 12210, 28, 40 }, { 13851, 38, 50 }, { 18045, 46, 60 } };
+static uint32 ProductFor(Product const* list, size_t n, uint8 level)
+{
+    for (size_t i = 0; i < n; ++i) if (level >= list[i].minLvl && level <= list[i].maxLvl) return list[i].item;
+    return list[n - 1].item;
+}
+constexpr uint32 CRAFT_CAP = 60;                          // a town keeps at most this many of each made thing
+
+uint8 World::StationsOf(uint32 hub)
+{
+    if (_stations.empty())                                 // once: anvils, forges and cooking fires near each town
+    {
+        for (auto const& [guid, g] : sObjectMgr->GetAllGOData())
+        {
+            if (!SIM_MAPS.contains(g.mapid)) continue;
+            GameObjectTemplate const* t = sObjectMgr->GetGameObjectTemplate(g.id);
+            if (!t || t->type != GAMEOBJECT_TYPE_SPELL_FOCUS) continue;
+            uint8 bit = (t->spellFocus.focusId == 1 || t->spellFocus.focusId == 3) ? 1 : t->spellFocus.focusId == 4 ? 2 : 0;
+            if (!bit) continue;
+            for (SimSite const& h : _sites)
+                if (h.type == SiteType::Hub && h.map == g.mapid && Dist2d(h.x, h.y, g.posX, g.posY) < 90.0f) _stations[h.id] |= bit;
+        }
+        _stations[0];                                       // built
+    }
+    auto it = _stations.find(hub);
+    return it == _stations.end() ? 0 : it->second;
+}
+
+// each town that can keep one gets a smith (an anvil or forge in town), a cook (an inn), an alchemist
+// (10+) and a leatherworker (10+) - taken from its labourers and market hands, once, so the crafts stay with the people
+void World::AssignCrafters()
+{
+    uint32 made = 0;
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN)) continue;
+        uint32 folk = TownTarget(h);
+        std::vector<Job> want;
+        if (StationsOf(h.id) & 1) want.push_back(JOB_SMITH);
+        want.push_back(JOB_COOK);
+        if (folk >= 10) want.push_back(JOB_ALCHEMIST);
+        if (folk >= 10) want.push_back(JOB_LEATHERWORKER);
+        for (Job j : want)
+        {
+            bool have = false; SimAgent* pick = nullptr;
+            for (auto& [id, a] : _agents)
+            {
+                if (a.role != ROLE_CIVILIAN || a.home != h.id || a.status == AgentStatus::Dead || a.status == AgentStatus::Gone) continue;
+                if (a.job == j) { have = true; break; }
+                if (!pick && (a.job == JOB_LABORER || a.job == JOB_MARKET) && Age(a) < 60) pick = &a;
+            }
+            if (have || !pick) continue;
+            pick->job = j; ++made;
+        }
+    }
+    if (made) LOG_INFO("server.loading", "SoloWoW sim: {} townsfolk took up a craft (smiths, cooks, alchemists, leatherworkers)", made);
+}
+
+// a working session: so many batches, each turning the market's raw goods into something made. A cook with nothing to
+// cook goes down to the water for fish; the others wait for the gatherers.
+void World::CraftWork(SimAgent& a, uint32 minutes)
+{
+    uint8 craft; uint8 input; uint32 per, yield;          // per batch: so many lots in, so many things out (a brew fills several vials)
+    switch (a.job)
+    {
+        case JOB_SMITH:         craft = CRAFT_ARMS;    input = PROF_MINING;    per = 3; yield = 2; break;
+        case JOB_ALCHEMIST:     craft = CRAFT_POTION;  input = PROF_HERBALISM; per = 3; yield = 5; break;
+        case JOB_LEATHERWORKER: craft = CRAFT_LEATHER; input = PROF_SKINNING;  per = 3; yield = 2; break;
+        case JOB_COOK:          craft = CRAFT_FOOD;    input = PROF_FISHING;   per = 1; yield = 4; break;
+        default: return;
+    }
+    auto& market = _market[a.home];
+    auto& made = _crafted[a.home];
+    uint32 batches = std::max<uint32>(1, minutes / 40), n = 0;
+    for (uint32 b = 0; b < batches && made[craft] < CRAFT_CAP; ++b)
+    {
+        if (market[input] >= per) { market[input] -= per; made[craft] = std::min<uint32>(CRAFT_CAP, made[craft] + yield); ++n; continue; }
+        if (a.job == JOB_COOK && market[PROF_SKINNING] >= 2) { market[PROF_SKINNING] -= 2; made[craft] = std::min<uint32>(CRAFT_CAP, made[craft] + yield); ++n; continue; }   // meat off the hunters' kills
+        if (a.job == JOB_COOK) { market[PROF_FISHING] += 2; continue; }   // nothing in: off to fish for it
+        break;
+    }
+}
