+// "/invite Marrin": the living adventurers by that name (full name if anyone has it, else the given name)
+std::vector<uint32> World::AgentsNamed(std::string const& asked)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    auto lower = [](std::string s) { for (char& ch : s) ch = char(std::tolower(uint8(ch))); return s; };
+    std::string q = lower(asked);
+    std::vector<uint32> full, given;
+    for (auto const& [id, a] : _agents)
+    {
+        if (a.role != ROLE_ADVENTURER || a.status == AgentStatus::Dead || a.status == AgentStatus::Gone) continue;
+        if (lower(a.FullName()) == q) full.push_back(id);
+        else if (lower(a.given) == q) given.push_back(id);
+    }
+    return full.empty() ? given : full;
+}
