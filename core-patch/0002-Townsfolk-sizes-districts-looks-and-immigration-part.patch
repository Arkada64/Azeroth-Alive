+// invited from afar: the one of them who knows you best answers, saying where they are
+std::string World::InviteFromAfar(std::vector<uint32> const& ids, uint32 guid, std::string& who)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* best = nullptr; int32 bestRegard = INT32_MIN;
+    for (uint32 id : ids)
+        if (SimAgent const* a = AgentById(id))
+        {
+            int32 sum = 0;
+            for (SimMemory const& m : _memories) if (m.agent == id && m.subjectType == 4 && m.subject == guid) sum += int32(m.valence) * m.intensity / 100;
+            if (sum > bestRegard) { bestRegard = sum; best = a; }
+        }
+    if (!best) return "";
+    who = best->FullName();
+    SimSite const* s = SiteById(best->site);
+    std::string where = s ? AreaOf(SiteName(s->id)) : std::string("the road");
+    if (best->status == AgentStatus::Hired) return "I'm travelling with someone already. Another time.";
+    if (best->status == AgentStatus::Recovering) return Acore::StringFormat("I'm laid up near {}, getting over a beating. Give me a few days.", where);
+    if (bestRegard < 0) return "Not after last time.";
+    if (bestRegard >= 30) return Acore::StringFormat("I'm {} right now. Come find me and we'll go together.", Doing(*best));
+    return Acore::StringFormat("I'm {}. If you want company, come and ask me properly.", Doing(*best));
+}
+
+// they said yes
+std::string World::HireYes(uint32 agentId, uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    int32 sum = 0; bool met = false;
+    for (SimMemory const& m : _memories)
+        if (m.agent == agentId && m.subjectType == 4 && m.subject == guid) { met = true; sum += int32(m.valence) * m.intensity / 100; }
+    static char const* const trusted[] = { "Always. Lead the way.", "I was hoping you'd ask.", "Together again, then." };
+    static char const* const known[] = { "All right - let's go.", "Sure. Where are we headed?", "Why not. It's been a while." };
+    static char const* const stranger[] = { "All right. Let's see how this goes.", "I'll come along - for now.", "Fine. Don't get me killed." };
+    uint32 i = (agentId + guid + _clock / MIN_PER_DAY) % 3;
+    return sum >= 60 ? trusted[i] : met ? known[i] : stranger[i];
+}
+
+// fighting side by side with someone you hired: they come to like you (a little per hour of it)
+void World::SharedKill(uint32 agentId, uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a) return;
+    for (auto it = _memories.rbegin(); it != _memories.rend() && it->at + 60 > _clock; ++it)
+        if (it->agent == agentId && it->subjectType == 4 && it->subject == guid && it->eventType == uint8(EventType::Hunted)) return;
+    RememberPlayer(*a, guid, 20, 40, EventType::Hunted);
+}
