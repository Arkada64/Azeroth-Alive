+// Townsfolk move: danger nearby (deaths, a camp on the roads, a threat) pushes them out; a town with room pulls them
+// in - most of all one of their own people, a short road away. A handful a day across the world.
+void World::Immigration()
+{
+    std::map<uint32, uint32> living;
+    std::map<uint32, std::map<uint8, uint32>> races;
+    for (auto const& [id, a] : _agents)
+        if (a.role == ROLE_CIVILIAN && a.status == AgentStatus::Active) { ++living[a.home]; ++races[a.home][a.race]; }
+    std::vector<SimSite const*> towns;
+    for (SimSite const& h : _sites)
+        if (h.type == SiteType::Hub && (h.services & SVC_INN) && h.regionLevel) towns.push_back(&h);
+    auto danger = [&](SimSite const& h) {
+        uint32 d = 0;
+        for (auto const& [id, o] : _agents)
+            if (o.status == AgentStatus::Dead && _clock - o.diedAt < 30 * MIN_PER_DAY && o.home == h.id) ++d;
+        for (SimCamp const& k : _camps) if (!k.done && k.map == h.map && Dist2d(k.x, k.y, h.x, h.y) < 1500.0f) d += 2;
+        for (auto const& [id, t] : _agents)
+            if (t.role == ROLE_THREAT && t.status == AgentStatus::Active)
+                if (SimSite const* s = SiteById(t.site); s && s->map == h.map && Dist2d(s->x, s->y, h.x, h.y) < 2000.0f) d += 3;
+        return d;
+    };
+    std::map<uint32, uint32> dangerOf;
+    for (SimSite const* h : towns) dangerOf[h->id] = danger(*h);
+    uint32 moved = 0;
+    for (auto& [id, a] : _agents)
+    {
+        if (moved >= 5) break;
+        if (a.role != ROLE_CIVILIAN || a.status != AgentStatus::Active || a.doing == Verb::Goto || a.kills > 0) continue;   // old hands stay put
+        if (std::ranges::any_of(_errands, [&](SimErrand const& e) { return e.agent == id && !e.done; })) continue;
+        SimSite const* home = SiteById(a.home);
+        if (!home || Age(a) < 18 || Age(a) > 65) continue;
+        uint32 dz = dangerOf[home->id];
+        Rng r(_seed, id, _clock, P_GEN + 590);
+        float chance = 0.002f + std::min(0.03f, float(dz) * 0.004f);
+        if (!r.Chance(chance)) continue;
+        // where: room, safety, their own people, not too far
+        SimSite const* best = nullptr; float bestScore = 0.0f;
+        for (SimSite const* t : towns)
+        {
+            if (t->id == home->id || t->map != home->map) continue;
+            uint32 target = TownTarget(*t), have = living[t->id];
+            if (have >= target) continue;
+            float score = float(target - have) / float(target) * 10.0f;
+            uint32 total = 0; for (auto const& [rc, n] : races[t->id]) total += n;
+            float share = total ? float(races[t->id][a.race]) / float(total) : 0.5f;
+            score *= 0.3f + share * 2.0f;                                     // their own people, mostly
+            score /= 1.0f + float(dangerOf[t->id]);
+            score /= 1.0f + Dist2d(t->x, t->y, home->x, home->y) / 2000.0f;
+            score *= 0.75f + float(r.Range(0, 50)) / 100.0f;
+            if (score > bestScore) { bestScore = score; best = t; }
+        }
+        if (!best || bestScore < 1.0f) continue;
+        std::string why = dz >= 4 ? " after the troubles around " + SiteName(home->id)
+                        : dz >= 1 ? " - it hasn't felt safe lately" : r.Chance(0.5f) ? " for work" : " to start over";
+        Log(EventType::MovedHome, a, home->id, Acore::StringFormat("{} packed up and left {} for {}{}.", a.FullName(), SiteName(home->id), SiteName(best->id), why), true);
+        --living[home->id]; ++living[best->id]; ++races[best->id][a.race];
+        a.home = best->id;
+        a.plan.clear();
+        a.plan.push_back({ Verb::Goto, best->id, 0, false });
+        StartStep(a);                                      // on the road now; they arrive when the journey is done
+        _requeue.push_back(id);
+        ++moved;
+    }
+}
