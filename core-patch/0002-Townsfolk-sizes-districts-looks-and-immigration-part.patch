+// "/invite Marrin" (or inviting your target): a sim adventurer by that name. Near you: they join you - no gold - or
+// whisper why not. Far away: the one who knows you best whispers where they are. Returns false if nobody has that name.
+bool BotBubble::InviteByName(Player* player, std::string const& name)
+{
+    if (!player || !sSoloSim->IsLive()) return false;
+    std::vector<uint32> agents = sSoloSim->AgentsNamed(name);
+    if (agents.empty()) return false;
+    Creature* body = nullptr; uint32 agent = 0; float bestD = 60.0f;
+    for (uint32 a : agents)
+        if (auto it = simAgentToEntry.find(a); it != simAgentToEntry.end())
+            if (Creature* c = const_cast<Creature*>(BotDataMgr::FindBot(it->second)); c && c->IsInWorld() && c->IsAlive() && c->GetMap() == player->GetMap())
+                if (float d = c->GetExactDist(player); d < bestD) { bestD = d; body = c; agent = a; }
+    if (!body)
+    {
+        std::string who;
+        std::string reply = sSoloSim->InviteFromAfar(agents, player->GetGUID().GetCounter(), who);
+        if (reply.empty()) return false;
+        WorldPacket data;
+        ChatHandler::BuildChatPacket(data, CHAT_MSG_MONSTER_WHISPER, LANG_UNIVERSAL, ObjectGuid::Empty, player->GetGUID(), reply, 0, who, player->GetName());
+        player->SendDirectMessage(&data);
+        return true;
+    }
+    bot_ai* ai = body->GetBotAI();
+    if (!ai || !body->IsFreeBot())
+    {
+        body->Whisper(body->GetBotOwner() == player ? "I'm right here." : "I'm travelling with someone already.", LANG_UNIVERSAL, player);
+        return true;
+    }
+    if (std::string no = sSoloSim->HireRefusal(agent, player->GetGUID().GetCounter(), player->GetLevel()); !no.empty())
+    {
+        body->Whisper(no, LANG_UNIVERSAL, player);
+        return true;
+    }
+    if (BotDataMgr::GetOwnedBotsCount(player->GetGUID()) >= BotCfg::GetMaxNpcBots(player->GetLevel()))
+    {
+        body->Whisper("You've got all the company you can lead right now.", LANG_UNIVERSAL, player);
+        return true;
+    }
+    if (ai->SetBotOwner(player))
+        body->Whisper(sSoloSim->HireYes(agent, player->GetGUID().GetCounter()), LANG_UNIVERSAL, player);
+    else
+        body->Whisper("...not right now.", LANG_UNIVERSAL, player);
+    return true;
+}
