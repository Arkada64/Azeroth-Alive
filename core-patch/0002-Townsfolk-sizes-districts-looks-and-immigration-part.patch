+// A town's districts: its own service clusters (a city's sim sites - Stormwind has 14), within 450 yd and the same zone.
+std::vector<uint32> const& World::DistrictsOf(uint32 town) const
+{
+    if (auto it = _districts.find(town); it != _districts.end()) return it->second;
+    std::vector<uint32>& out = _districts[town];
+    if (SimSite const* t = SiteById(town))
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hub && s.map == t->map && s.zone == t->zone && Dist2d(s.x, s.y, t->x, t->y) < 450.0f)
+                out.push_back(s.id);
+    if (out.empty()) out.push_back(town);
+    return out;
+}
+
+// where in town a townsperson lives and works: a district, chosen by how much goes on there
+SimSite const* World::DistrictOf(SimAgent const& a) const
+{
+    SimSite const* home = SiteById(a.home);
+    std::vector<uint32> const& ds = DistrictsOf(a.home);
+    if (ds.size() < 2 || !home) return home;
+    uint32 total = 0;
+    for (uint32 d : ds) if (SimSite const* s = SiteById(d)) total += std::max<uint32>(1, s->spawns);
+    uint32 pick = uint32(Mix((uint64(a.id) << 20) ^ 0xD157) % std::max<uint32>(1, total));
+    for (uint32 d : ds)
+        if (SimSite const* s = SiteById(d))
+        {
+            uint32 w = std::max<uint32>(1, s->spawns);
+            if (pick < w) return s;
+            pick -= w;
+        }
+    return home;
+}
+
+// How many townsfolk a town holds: the capitals by hand, the rest by how much the town has (services across its districts)
+uint32 World::TownTarget(SimSite const& h) const
+{
+    uint32 capital = h.zone == 1519 ? 220 : h.zone == 1537 ? 160 : h.zone == 1657 ? 100 : 0;   // Stormwind, Ironforge, Darnassus
+    if (capital)
+    {
+        uint32 inns = 0;                                  // every inn in the city shares the city's people
+        for (SimSite const& s : _sites) if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.zone == h.zone) ++inns;
+        return capital / std::max<uint32>(1, inns);
+    }
+    uint32 total = 0, inns = 0;
+    for (uint32 d : DistrictsOf(h.id)) if (SimSite const* s = SiteById(d)) { total += s->spawns; if (s->services & SVC_INN) ++inns; }
+    uint32 size = total >= 25 ? 30 : total >= 12 ? 18 : total >= 6 ? 10 : 5;
+    return std::max<uint32>(3, size / std::max<uint32>(1, inns));     // a town with two inns shares its people between them
+}
