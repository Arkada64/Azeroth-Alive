+// SoloWoW: loot worth looking at (Nov 17), the user's design, first and safest step - WoW's own random suffixes ("of the
+// Bear", "of the Owl"...), which scale with an item's level, put on things that never had them:
+//   - ordinary drops: armour and weapons that drop with no random stats may roll a suffix (uncommon and rare: often;
+//     a plain white piece now and then - a "magic" white, as in Diablo);
+//   - quest rewards: the reward armour or weapon may roll one too - likelier the harder the quest (its level over yours,
+//     elite, group, dungeon);
+//   - rare finds: any foe near your level may, rarely, carry a world-drop green (which rolls its own random stats) -
+//     elites and rares more often.
+// The suffix pools are the game's own: the groups items of the same kind already use. Truly generated items are later.
+// Re-infested dungeons as a source wait for that system. Never copies another project's files.
+#include "Config.h"
+#include "Creature.h"
+#include "Item.h"
+#include "ItemEnchantmentMgr.h"
+#include "LootMgr.h"
+#include "ObjectAccessor.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "QuestDef.h"
+#include "Random.h"
+#include "ScriptMgr.h"
+#include <map>
+#include <mutex>
+#include <vector>
+
+namespace
+{
+    std::map<uint32, std::vector<uint32>> suffixGroups;       // (class, subclass, inventory type) / (class, subclass) -> RandomSuffix groups
+    std::map<uint32, std::vector<uint32>> worldGreens;        // required level -> world-drop greens that roll random stats
+    std::once_flag built;
+
+    uint32 Key(uint32 cls, uint32 sub, uint32 inv) { return (cls << 16) | (sub << 8) | inv; }
+
+    void Build()
+    {
+        for (auto const& [id, t] : *sObjectMgr->GetItemTemplateStore())
+        {
+            if (t.Class != ITEM_CLASS_ARMOR && t.Class != ITEM_CLASS_WEAPON) continue;
+            if (t.RandomSuffix)
+            {
+                for (uint32 k : { Key(t.Class, t.SubClass, t.InventoryType), Key(t.Class, t.SubClass, 0xFF) })
+                {
+                    auto& v = suffixGroups[k];
+                    if (std::find(v.begin(), v.end(), t.RandomSuffix) == v.end()) v.push_back(t.RandomSuffix);
+                }
+            }
+            if ((t.RandomProperty || t.RandomSuffix) && t.Quality == ITEM_QUALITY_UNCOMMON && t.Bonding == BIND_WHEN_EQUIPPED
+                && t.RequiredLevel >= 3 && t.ItemLevel >= 5 && !(t.Flags & ITEM_FLAG_IS_BOUND_TO_ACCOUNT) && t.SellPrice > 0)
+                worldGreens[t.RequiredLevel].push_back(id);
+        }
+        LOG_INFO("server.loading", "SoloWoW loot: {} suffix pools, world-drop greens for {} levels", suffixGroups.size(), worldGreens.size());
+    }
+
+    bool Enabled()
+    {
+        static bool const on = sConfigMgr->GetOption<bool>("SoloWoW.Loot.Enable", true);
+        std::call_once(built, Build);
+        return on;
+    }
+
+    // a suffix of the game's own for this kind of item, or 0
+    int32 RollSuffix(ItemTemplate const* t)
+    {
+        if (!t || (t->Class != ITEM_CLASS_ARMOR && t->Class != ITEM_CLASS_WEAPON) || t->RandomProperty || t->RandomSuffix) return 0;
+        if (t->Quality < ITEM_QUALITY_NORMAL || t->Quality > ITEM_QUALITY_RARE || t->ItemLevel < 5) return 0;
+        if (t->InventoryType == INVTYPE_NON_EQUIP || t->InventoryType == INVTYPE_BAG || t->InventoryType == INVTYPE_TABARD
+            || t->InventoryType == INVTYPE_AMMO || t->InventoryType == INVTYPE_QUIVER || t->InventoryType == INVTYPE_RELIC || t->InventoryType == INVTYPE_BODY) return 0;
+        std::vector<uint32> const* groups = nullptr;
+        for (uint32 k : { Key(t->Class, t->SubClass, t->InventoryType), Key(t->Class, t->SubClass, 0xFF) })
+            if (auto it = suffixGroups.find(k); it != suffixGroups.end() && !it->second.empty()) { groups = &it->second; break; }
+        if (!groups) return 0;
+        uint32 suffix = GetItemEnchantMod(int32((*groups)[urand(0, uint32(groups->size()) - 1)]));
+        return suffix ? -int32(suffix) : 0;
+    }
+
+    void Mark(LootItem& li, int32 suffix)
+    {
+        li.randomPropertyId = suffix;
+        li.randomSuffix = GenerateEnchSuffixFactorAny(li.itemid);
+    }
+
+    class solosim_loot_misc : public MiscScript
+    {
+    public:
+        solosim_loot_misc() : MiscScript("solosim_loot_misc", { MISCHOOK_ON_AFTER_LOOT_TEMPLATE_PROCESS }) { }
+
+        void OnAfterLootTemplateProcess(Loot* loot, LootTemplate const* /*tab*/, LootStore const& store, Player* owner, bool /*personal*/, bool /*noEmptyError*/, uint16 /*lootMode*/) override
+        {
+            if (!loot || !owner || !Enabled()) return;
+            bool creature = &store == &LootTemplates_Creature;
+            if (!creature && &store != &LootTemplates_Gameobject && &store != &LootTemplates_Item) return;
+            // ordinary drops: a suffix on what had none
+            for (LootItem& li : loot->items)
+            {
+                if (li.needs_quest || li.randomPropertyId) continue;
+                ItemTemplate const* t = sObjectMgr->GetItemTemplate(li.itemid);
+                if (!t) continue;
+                uint32 chance = t->Quality >= ITEM_QUALITY_UNCOMMON ? 35 : 6;
+                if (urand(1, 100) > chance) continue;
+                if (int32 s = RollSuffix(t)) Mark(li, s);
+            }
+            // a rare find on a foe near your level
+            if (!creature) return;
+            Creature const* c = ObjectAccessor::GetCreature(*owner, loot->sourceWorldObjectGUID);
+            if (!c || c->GetCreatureTemplate()->type == CREATURE_TYPE_CRITTER || (c->GetCreatureTemplate()->flags_extra & CREATURE_FLAG_EXTRA_NO_XP)) return;
+            if (int32(c->GetLevel()) < int32(owner->GetLevel()) - 6) return;
+            uint32 rank = c->GetCreatureTemplate()->rank;
+            uint32 per10k = rank == CREATURE_ELITE_RARE || rank == CREATURE_ELITE_RAREELITE || rank == CREATURE_ELITE_WORLDBOSS ? 1000 : rank == CREATURE_ELITE_ELITE ? 250 : 60;
+            if (urand(1, 10000) > per10k) return;
+            uint32 lvl = c->GetLevel();
+            std::vector<uint32> pool;
+            for (uint32 l = lvl > 3 ? lvl - 3 : 1; l <= lvl + 1; ++l)
+                if (auto it = worldGreens.find(l); it != worldGreens.end()) pool.insert(pool.end(), it->second.begin(), it->second.end());
+            if (pool.empty()) return;
+            LootItem li;
+            li.itemid = pool[urand(0, uint32(pool.size()) - 1)];
+            li.itemIndex = uint32(loot->items.size());
+            li.count = 1;
+            li.randomPropertyId = Item::GenerateItemRandomPropertyId(li.itemid);
+            li.randomSuffix = GenerateEnchSuffixFactor(li.itemid);
+            li.is_looted = false; li.is_blocked = false; li.freeforall = false; li.is_underthreshold = false;
+            li.is_counted = false; li.needs_quest = false; li.follow_loot_rules = true; li.groupid = 0;
+            loot->items.push_back(li);
+            ++loot->unlootedCount;
+        }
+    };
+
+    class solosim_loot_player : public PlayerScript
+    {
+    public:
+        solosim_loot_player() : PlayerScript("solosim_loot_player", { PLAYERHOOK_ON_QUEST_REWARD_ITEM }) { }
+
+        // a quest's reward armour or weapon: the harder the quest, the likelier it comes with something extra
+        void OnPlayerQuestRewardItem(Player* player, Item* item, uint32 /*count*/) override
+        {
+            if (!player || !item || item->GetItemRandomPropertyId() || !Enabled()) return;
+            ItemTemplate const* t = item->GetTemplate();
+            Quest const* q = nullptr;
+            for (auto const& [qid, st] : player->getQuestStatusMap())
+            {
+                if (st.Status != QUEST_STATUS_COMPLETE) continue;
+                Quest const* x = sObjectMgr->GetQuestTemplate(qid);
+                if (!x) continue;
+                for (uint32 i = 0; i < QUEST_REWARD_CHOICES_COUNT && !q; ++i) if (x->RewardChoiceItemId[i] == t->ItemId) q = x;
+                for (uint32 i = 0; i < QUEST_REWARDS_COUNT && !q; ++i) if (x->RewardItemId[i] == t->ItemId) q = x;
+                if (q) break;
+            }
+            int32 chance = t->Quality >= ITEM_QUALITY_UNCOMMON ? 25 : 8;
+            if (q)
+            {
+                int32 over = int32(q->GetQuestLevel() > 0 ? q->GetQuestLevel() : player->GetLevel()) - int32(player->GetLevel());
+                chance += std::clamp(over, -3, 5) * 5;
+                if (q->GetType() == QUEST_TYPE_ELITE || q->GetSuggestedPlayers() > 1) chance += 15;
+                if (q->GetType() == QUEST_TYPE_DUNGEON || q->GetType() == QUEST_TYPE_HEROIC || q->GetType() == QUEST_TYPE_RAID) chance += 20;
+            }
+            if (urand(1, 100) > uint32(std::clamp(chance, 0, 85))) return;
+            if (int32 s = RollSuffix(t))
+            {
+                item->SetItemRandomProperties(s);
+                item->SetState(ITEM_CHANGED, player);
+            }
+        }
+    };
+}
+
+void AddSC_solosim_loot()
+{
+    new solosim_loot_misc();
+    new solosim_loot_player();
+}
