@@ -3501,6 +3554,35 @@ void World::StartStep(SimAgent& a)
     if (s.verb == Verb::Goto)
     {
         s.minutes = TravelMinutes(a.site, s.site, a);
+        // a journey that runs well past their bedtime: stop for the night on the way - an inn if one's there, else camp -
+        // and go on in the morning (Nov 17)
+        uint32 toBed = MinutesToBed(a);
+        if (a.role == ROLE_ADVENTURER && !Asleep(a, _clock) && s.minutes >= 30 && s.minutes > toBed + 20)
+            if (uint32 stop = WayStop(a, a.site, s.site, toBed))
+            {
+                PlanStep onward = s;                                                      // the rest of the way, tomorrow
+                onward.minutes = 0;
+                uint32 leg = TravelMinutes(a.site, stop, a);
+                SimSite const* ss = SiteById(stop);
+                bool inn = ss && ss->type == SiteType::Hub && (ss->services & SVC_INN);
+                Rng r(_seed, a.id, _clock, P_GEN + 590);
+                uint32 evening = a.sociability >= 25 ? r.Range(20, 70) : 0;
+                uint32 arrive = (_clock + leg + evening) % MIN_PER_DAY;
+                uint32 sleep = std::max<uint32>(60, (WakeMinute(a) + MIN_PER_DAY - arrive) % MIN_PER_DAY + r.Range(0, 45));
+                std::vector<PlanStep> night = { { Verb::Goto, stop, 0, false } };
+                if (evening) night.push_back({ Verb::Socialize, stop, evening });
+                night.push_back({ Verb::Sleep, stop, sleep });
+                a.plan.erase(a.plan.begin());
+                a.plan.insert(a.plan.begin(), onward);
+                a.plan.insert(a.plan.begin(), night.begin(), night.end());
+                Log(EventType::Departed, a, a.site, Acore::StringFormat("{} set out from {} for {}, meaning to stop the night {}.", a.FullName(), SiteName(a.site),
+                    SiteName(onward.site), inn ? "at " + SiteName(stop) : "on the road near " + PlaceOnly(SiteName(stop))), onward.announce, 0, int32(leg));
+                PlanStep& first = a.plan.front();
+                first.minutes = leg;
+                a.doing = Verb::Goto;
+                a.wakeAt = _clock + std::max<uint32>(1, first.minutes);
+                return;
+            }
         // only purposeful journeys (an ambition to see a place) make the chronicle; errands and hunts are routine
         Log(EventType::Departed, a, a.site, Acore::StringFormat("{} left {} for {}.", a.FullName(), SiteName(a.site), SiteName(s.site)), s.announce, 0, int32(s.minutes));
     }
