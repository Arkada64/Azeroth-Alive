+bool World::IsCapital(SimSite const& s) const
+{
+    if (s.type != SiteType::Hub) return false;
+    for (Capital const& c : CAPITALS) if (c.zone == s.zone) return true;
+    return false;
+}
+
+// a journey that runs past bedtime (Nov 17): somewhere on the way, about when bedtime comes - a town with an inn that will
+// have them if there is one, else a safe hunting ground or outpost to camp at. Road minutes from both ends (cached tables).
+uint32 World::WayStop(SimAgent const& a, uint32 from, uint32 to, uint32 afterMinutes) const
+{
+    SimSite const* f = SiteById(from); SimSite const* t = SiteById(to);
+    if (!f || !t || f->map != t->map) return 0;
+    uint32 fi = SiteRoad(from), ti = SiteRoad(to);
+    if (fi == UINT32_MAX || ti == UINT32_MAX) return 0;
+    std::vector<float> const& df = DistTo(fi);
+    std::vector<float> const& dt = DistTo(ti);
+    float pace = 4.5f * (a.level >= 40 ? 1.6f : 1.0f) * 60.0f;                       // yards a minute
+    auto minutes = [&](SimSite const& s, uint32 si, std::vector<float> const& d, SimSite const& end, uint32 ei) {
+        float road = d[si];
+        if (road >= 1e8f) return 1e9f;
+        return (Dist2d(s.x, s.y, _roads[si].x, _roads[si].y) + road + Dist2d(_roads[ei].x, _roads[ei].y, end.x, end.y)) / pace;
+    };
+    float total = minutes(*t, ti, df, *f, fi);
+    uint32 best = 0; float bestScore = 1e9f;
+    for (SimSite const& s : _sites)
+    {
+        if (s.map != f->map || s.id == from || s.id == to) continue;
+        bool inn = s.type == SiteType::Hub && (s.services & SVC_INN);
+        if (inn ? !Welcome(a, s) : (s.elite || s.minLevel > a.level + 2 || DangerFor(a, s.id) >= 1.0f + a.bravery / 100.0f)) continue;
+        if (Dist2d(s.x, s.y, f->x, f->y) > total * pace * 1.1f) continue;                // nowhere near the way
+        uint32 si = SiteRoad(s.id);
+        if (si == UINT32_MAX) continue;
+        float there = minutes(s, si, df, *f, fi), on = minutes(s, si, dt, *t, ti);
+        if (there + on > total * 1.25f + 3.0f) continue;                                 // a detour
+        if (there < float(afterMinutes) * 0.5f || there > float(afterMinutes) + 40.0f) continue;   // too early, or too late
+        float score = std::fabs(there - float(afterMinutes)) - (inn ? 25.0f : 0.0f);
+        if (score < bestScore) { bestScore = score; best = s.id; }
+    }
+    return best;
+}
