@@ -3974,7 +4064,8 @@ bool World::Intent(uint32 agentId, SimIntent& out)
     // pace: nobody runs about town; on the road the weary, the hurt and the unhurried (three in ten, by nature) walk
     bool inTown = !out.travelling && out.siteType == SiteType::Hub;
     bool stroller = (Mix(uint64(a->id) * 2654435761u) % 10) < 3;
-    out.walk = inTown || a->doing == Verb::Recover || (out.travelling && (a->fatigue >= 60 || a->wounds >= 50 || stroller));
+    out.walk = inTown || a->doing == Verb::Recover || (out.travelling && (a->fatigue >= 60 || a->wounds >= 50 || stroller
