+// the first speaker again, after the answer: by how it was taken
+World::TalkLine World::TalkFollow(uint32 speakerId, uint32 replierId, TalkLine const& said, TalkLine const& back)
+{
+    TalkLine out;
+    SimAgent const* a = AgentById(speakerId);
+    SimAgent const* b = AgentById(replierId);
+    if (!a || !b || back.text.empty()) return out;
+    Rng r(_seed, speakerId, _clock * 19 + replierId, 9984);
+    Voice const& v = VoiceOf(a->race);
+    auto say = [&](std::initializer_list<char const*> l) { return Pick(std::vector<char const*>(l), r); };
+    switch (back.tone)
+    {
+        case TONE_SURPRISE:
+            out.text = said.act == ACT_GOSSIP ? say({ "That's what they're saying at the inn, anyway.", "It's true. Ask anyone.", "I didn't believe it either, at first.", "Heard it from the innkeeper myself." })
+                                              : say({ "It's true, I swear it.", "You heard me." });
+            break;
+        case TONE_AGREE:
+            out.text = said.act == ACT_WARN ? say({ "Somebody ought to tell the guards.", "I'm keeping my door barred, I can tell you." })
+                     : GrimNews(said.text) ? say({ "Strange times.", "Makes you wonder what's next.", "There's always something, isn't there?", "It's getting worse out there." })
+                                           : say({ "Good for them, I say.", "Nice to hear some good news for a change.", "Maybe I'll try my luck too.", "Lucky sort." });
+            break;
+        case TONE_FEAR:  out.text = say({ "Best we all stay in, then.", "Keep your door barred.", "Don't go wandering at night, that's all." }); break;
+        case TONE_BOLD:  out.text = say({ "Then go and deal with it.", "Brave words. Let's see you do it.", "I'll hold you to that." }); out.emote = EMOTE_ONESHOT_LAUGH; break;
+        case TONE_PRAISE:out.text = say({ "It was nothing. Well - it was something.", "I'll tell you the whole tale over a drink.", "Couldn't have done it alone." }); out.emote = EMOTE_ONESHOT_BOW; break;
+        case TONE_TEASE: out.text = say({ "Jealous, are we?", "Say that when you've done it yourself.", "Laugh all you like." }); break;
+        case TONE_COMFORT:
+            out.text = say({ "Thank you. That means something.", "We'll drink to them tonight.", "Aye. I'll miss them." });
+            break;
+        case TONE_SYMPATHY: out.text = say({ "I'll live.", "Next time will be different.", "Thanks. I needed that." }); break;
+        case TONE_MOCK:     out.text = say({ "Laugh it up.", "Wait until it's you.", "Very funny." }); out.emote = EMOTE_ONESHOT_NO; break;
+        case TONE_ENCOURAGE:out.text = say({ "That's the plan.", "Come with me, then.", "I'll send word when I'm there." }); break;
+        case TONE_DOUBT:    out.text = say({ "Watch me.", "You'll see.", "I've heard that before." }); break;
+        case TONE_GREET:
+            out.text = say({ "How've you been?", "What's the news with you?", "Keeping well?" });
+            out.act = ACT_GREET;
+            break;
+        case TONE_SCORN:    out.text = say({ "Watch your tongue.", "Some other time, then.", "Hmph." }); break;
+        default: return out;
+    }
+    if (a->sociability > 70 && r.Chance(0.25f)) out.text = WithTag(out.text, Pick(v.tag, r));
+    return out;
+}
+
+// the second speaker closes it: "how've you been" gets a real answer (by their mood), the rest a goodbye now and then
+World::TalkLine World::TalkClose(uint32 replierId, uint32 speakerId, TalkLine const& follow)
+{
+    TalkLine out;
+    SimAgent const* b = AgentById(replierId);
+    if (!b || follow.text.empty()) return out;
+    Rng r(_seed, replierId, _clock * 23 + speakerId, 9985);
+    Voice const& v = VoiceOf(b->race);
+    if (follow.act == ACT_GREET)
+    {
+        switch (MoodOf(*b))
+        {
+            case MOOD_GRIEVING: out.text = "Not well. I lost a friend."; out.emote = EMOTE_ONESHOT_CRY; break;
+            case MOOD_HURT:     out.text = "Battered, but breathing."; break;
+            case MOOD_ANGRY:    out.text = "Don't ask. Really, don't."; break;
+            case MOOD_PROUD:    out.text = "Never better, as it happens."; out.emote = EMOTE_ONESHOT_FLEX; break;
+            case MOOD_HAPPY:    out.text = Pick(std::vector<char const*>{ "Good, thanks. Really good.", "Can't complain. Wouldn't do any good if I did." }, r); break;
+            case MOOD_SCARED:   out.text = "Nervous. It's not safe out there."; break;
+            case MOOD_TIRED:    out.text = "Tired. Always tired."; break;
+            case MOOD_BORED:    out.text = "Bored out of my skull."; break;
+            default:            out.text = Pick(std::vector<char const*>{ "Can't complain.", "Busy, as ever.", "Same as always." }, r); break;
+        }
+        return out;
+    }
+    if (!r.Chance(0.45f)) return out;
+    out.text = Pick(v.bye, r);
+    if (follow.text.find(out.text) != std::string::npos) out.text.clear();
+    out.emote = EMOTE_ONESHOT_WAVE;
+    return out;
+}
+
+std::vector<World::TalkTurn> World::Conversation(uint32 a, uint32 b)
+{
+    std::vector<TalkTurn> turns;
+    TalkLine said = Talk(a, b);
+    if (said.text.empty()) return turns;
+    turns.push_back({ false, said });
+    if (!b) return turns;
+    TalkLine back = TalkReply(b, a, said);
+    if (back.text.empty()) return turns;
+    turns.push_back({ true, back });
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    TalkLine follow = TalkFollow(a, b, said, back);
+    if (follow.text.empty()) return turns;
+    turns.push_back({ false, follow });
+    TalkLine close = TalkClose(b, a, follow);
+    if (!close.text.empty()) turns.push_back({ true, close });
+    return turns;
+}
