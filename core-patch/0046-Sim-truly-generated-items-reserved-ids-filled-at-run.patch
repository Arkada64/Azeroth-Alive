+// SoloWoW (Nov 18): the bigger bounties pay in gear of their own too - a named rare's bounty usually an item of its name,
+// the elite and pack hunts sometimes (SoloSim/solosim_genitems.cpp). Into the bags, or by mail when they are full.
+static void GenReward(Player* player, SoloSim::SimBounty const& b)
+{
+    if (!SoloGen::Ready()) return;
+    uint32 chance = b.kind == SoloSim::BOUNTY_RARE ? 70 : b.kind == SoloSim::BOUNTY_ELITE ? 35 : b.kind == SoloSim::BOUNTY_PACK ? 12 : 0;
+    if (urand(1, 100) > chance) return;
+    std::string source;
+    if (b.kind == SoloSim::BOUNTY_RARE && b.target) source = sSoloSim->RareNameOf(b.target);
+    uint32 quality = b.kind == SoloSim::BOUNTY_RARE || (b.kind == SoloSim::BOUNTY_ELITE && urand(0, 1)) ? ITEM_QUALITY_RARE : ITEM_QUALITY_UNCOMMON;
+    ItemTemplate const* t = SoloGen::Make(player, uint8(std::min<uint32>(player->GetLevel(), 80)), quality, source);
+    if (!t && quality > ITEM_QUALITY_UNCOMMON) t = SoloGen::Make(player, uint8(std::min<uint32>(player->GetLevel(), 80)), ITEM_QUALITY_UNCOMMON, source);
+    if (!t) return;
+    ItemPosCountVec dest;
+    if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, t->ItemId, 1) == EQUIP_ERR_OK)
+    {
+        if (Item* it = player->StoreNewItem(dest, t->ItemId, true)) player->SendNewItem(it, 1, true, false);
+        return;
+    }
+    if (Item* it = Item::CreateItem(t->ItemId, 1, player))
+    {
+        CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+        it->SaveToDB(trans);
+        MailDraft("Your bounty", "Your bags were full, so the board's keeper sent this on.").AddItem(it)
+            .SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(MAIL_NORMAL, 0, MAIL_STATIONERY_DEFAULT));
+        CharacterDatabase.CommitTransaction(trans);
+        ChatHandler(player->GetSession()).SendSysMessage("Your bags are full: the bounty's reward went by mail.");
+    }
+}
