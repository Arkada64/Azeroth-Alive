+// SoloWoW: truly generated items (Nov 18) - the user's pick (DESIGN.md "Loot", option B: new named items with reserved
+// ids, the stat budget of real items of the same slot, quality and item level - never more).
+//
+// The client knows the reserved ids (950000 up) from scripts\gen-items.py: three for each look the game's weapons and
+// armour have. A generated item:
+//   - starts from a real item the player can use, of the right slot, level and quality (its armour, damage, speed,
+//     durability, price stay);
+//   - takes that item's own stat budget (the game's costs: stamina at two thirds, attack power at half...) and spends
+//     it again on a theme of its own - never more than the real item had;
+//   - wears a free reserved id of the same look;
+//   - gets a name of its own: an adjective of its theme and the item's noun ("Savage Claymore"), "of the..." for blues,
+//     a coined name for epics ("Grimfang, Claymore of Ruin"), and the name of the named foe it came from now and then
+//     ("Hexir's Runed Staff"), with "Taken from ..." under it.
+// Generated items are kept (world DB solo_gen_item) and loaded before anything that holds items; at start-up an id no
+// copy of which is left anywhere (bags, bank, mail, auctions) is freed for re-use - the launcher clears the client's
+// item cache, so a re-used id never shows old stats.
+#include "solosim_genitems.h"
+#include "DBCStores.h"
+#include "DatabaseEnv.h"
+#include "Field.h"
+#include "Log.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "QueryResult.h"
+#include "Random.h"
+#include <cstdio>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+
+namespace SoloGen
+{
+namespace
+{
+    constexpr uint32 GEN_BASE = 950000, GEN_END = 1010000;
+    std::recursive_mutex lock;
+    std::deque<ItemTemplate> made;                               // stable addresses: the fast store points into it
+    std::set<uint32> inUse;                                      // ids that hold a generated item
+    std::map<uint64, std::vector<uint32>> poolByLook;            // (class, subclass, slot, display) -> reserved ids
+    std::map<uint64, std::vector<uint32>> poolByKind;            // (class, subclass, slot) -> reserved ids
+    std::map<uint32, std::vector<ItemTemplate const*>> bases;    // quality << 8 | required level -> real items
+    bool ready = false, basesBuilt = false;
+
+    uint64 LookKey(uint32 cls, uint32 sub, uint32 inv, uint32 disp) { return (uint64(cls) << 48) | (uint64(sub) << 40) | (uint64(inv) << 32) | disp; }
+    uint64 KindKey(uint32 cls, uint32 sub, uint32 inv) { return (uint64(cls) << 16) | (uint64(sub) << 8) | inv; }
+
+    // what a point of each stat costs in an item's budget (the game's own weights)
+    float Cost(uint32 type)
+    {
+        switch (type)
+        {
+            case ITEM_MOD_STAMINA: return 0.667f;
+            case ITEM_MOD_ATTACK_POWER: case ITEM_MOD_RANGED_ATTACK_POWER: case ITEM_MOD_BLOCK_VALUE: return 0.5f;
+            case ITEM_MOD_SPELL_POWER: case ITEM_MOD_SPELL_DAMAGE_DONE: return 0.86f;
+            case ITEM_MOD_SPELL_HEALING_DONE: return 0.45f;
+            case ITEM_MOD_MANA_REGENERATION: case ITEM_MOD_HEALTH_REGEN: return 2.0f;
+            case ITEM_MOD_MANA: case ITEM_MOD_HEALTH: return 0.1f;
+            default: return 1.0f;
+        }
+    }
+    bool IsRating(uint32 type) { return (type >= 12 && type <= 37) || type == ITEM_MOD_ARMOR_PENETRATION_RATING || type == ITEM_MOD_SPELL_PENETRATION; }
+
+    void BuildPool()
+    {
+        for (uint32 id = GEN_BASE; id < GEN_END; ++id)
+            if (ItemEntry const* e = sItemStore.LookupEntry(id))
+            {
+                poolByLook[LookKey(e->ClassID, e->SubclassID, e->InventoryType, e->DisplayInfoID)].push_back(id);
+                poolByKind[KindKey(e->ClassID, e->SubclassID, e->InventoryType)].push_back(id);
+            }
+    }
+
+    void BuildBases()
+    {
+        basesBuilt = true;
+        for (auto const& [id, t] : *sObjectMgr->GetItemTemplateStore())
+        {
+            if (id >= GEN_BASE || (t.Class != ITEM_CLASS_ARMOR && t.Class != ITEM_CLASS_WEAPON)) continue;
+            if (t.Quality < ITEM_QUALITY_UNCOMMON || t.Quality > ITEM_QUALITY_EPIC || !t.StatsCount || !t.RequiredLevel || !t.DisplayInfoID) continue;
+            if (t.StartQuest || t.Bonding == BIND_QUEST_ITEM || t.HasFlag(ITEM_FLAG_IS_BOUND_TO_ACCOUNT) || t.ItemLimitCategory || t.HolidayId) continue;
+            if (t.InventoryType == INVTYPE_BODY || t.InventoryType == INVTYPE_TABARD || t.InventoryType == INVTYPE_RELIC) continue;
+            if (t.Name1.find("Test") != std::string::npos || t.Name1.find("Monster") != std::string::npos || t.Name1.find("Deprecated") != std::string::npos) continue;
+            bases[(t.Quality << 8) | std::min<uint32>(t.RequiredLevel, 80)].push_back(&t);
+        }
+    }
+
+    std::string Noun(std::string const& name)
+    {
+        std::string n = name.substr(0, name.find(" of "));
+        size_t sp = n.find_last_of(' ');
+        return sp == std::string::npos ? n : n.substr(sp + 1);
+    }
+
+    // for the GM sample command (no player): the class may use it, and its best armour type
+    bool TestFits(ItemTemplate const* t, uint32 cls)
+    {
+        if (!(t->AllowableClass & (1u << (cls - 1)))) return false;
+        if (t->Class != ITEM_CLASS_ARMOR || t->InventoryType == INVTYPE_CLOAK || t->SubClass == ITEM_SUBCLASS_ARMOR_MISC) return true;
+        uint32 best = cls == CLASS_MAGE || cls == CLASS_PRIEST || cls == CLASS_WARLOCK ? ITEM_SUBCLASS_ARMOR_CLOTH
+            : cls == CLASS_ROGUE || cls == CLASS_DRUID ? ITEM_SUBCLASS_ARMOR_LEATHER : cls == CLASS_HUNTER || cls == CLASS_SHAMAN ? ITEM_SUBCLASS_ARMOR_MAIL : ITEM_SUBCLASS_ARMOR_PLATE;
+        if (t->SubClass == ITEM_SUBCLASS_ARMOR_SHIELD) return cls == CLASS_WARRIOR || cls == CLASS_PALADIN || cls == CLASS_SHAMAN;
+        return t->SubClass == best;
+    }
+
+    template <typename T> T const& Any(std::vector<T> const& v) { return v[urand(0, uint32(v.size()) - 1)]; }
+
+    std::string Name(ItemTemplate const& base, uint32 theme, uint32 quality, std::string const& source)
+    {
+        static std::map<uint32, std::vector<std::string>> const adj = {
+            { ITEM_MOD_STRENGTH,  { "Brutal", "Ironclad", "Savage", "Warbound", "Crushing", "Battle-Worn", "Bloodied", "Unyielding" } },
+            { ITEM_MOD_AGILITY,   { "Swift", "Shadowed", "Feral", "Nimble", "Stalker's", "Keen", "Wolfhide", "Silent" } },
+            { ITEM_MOD_INTELLECT, { "Arcane", "Runed", "Mystic", "Starlit", "Sorcerous", "Ember-Touched", "Eldritch", "Whispering" } },
+            { ITEM_MOD_SPIRIT,    { "Serene", "Blessed", "Hallowed", "Tranquil", "Pilgrim's", "Radiant", "Dawnlit" } },
+            { ITEM_MOD_STAMINA,   { "Sturdy", "Stalwart", "Enduring", "Hardened", "Steadfast", "Weathered" } } };
+        static std::vector<std::string> const ofThe = { "the Fallen Watch", "the Wolf King", "the Deep Roads", "the Last Light", "the Broken Crown",
+            "the Silent Grove", "the Burning Sky", "the Hollow Moon", "the Iron Tide", "the Red Wastes", "the Old Kings", "the Lost Legion",
+            "the Ashen Vale", "the First Frost", "the Long Night", "the Drowned Coast" };
+        static std::vector<std::string> const ofWord = { "Ruin", "Thorns", "Dusk", "Embers", "Sorrow", "Valor", "the Tempest", "Whispers", "Vengeance", "Echoes" };
+        static std::vector<std::string> const coinA = { "Dusk", "Grim", "Storm", "Night", "Blood", "Frost", "Ember", "Doom", "Soul", "Thunder", "Ash", "Shadow", "Iron", "Sun", "Star", "Wraith" };
+        static std::vector<std::string> const coinB = { "rend", "fang", "caller", "bane", "reaver", "song", "ward", "bringer", "fall", "edge", "heart", "maw", "whisper", "forge" };
+        std::string noun = Noun(base.Name1);
+        auto a = adj.find(theme);
+        std::string adjective = a != adj.end() ? Any(a->second) : Any(adj.at(ITEM_MOD_STAMINA));
+        std::string ending = urand(0, 1) ? Any(ofThe) : Any(ofWord);
+        std::string owner;
+        if (!source.empty())
+        {
+            owner = source.rfind("The ", 0) == 0 ? source : source.substr(0, source.find(' '));   // "The Rake's", "Hexir's"
+            if (!owner.empty() && owner.back() == 's') owner += "'"; else owner += "'s";
+        }
+        if (quality >= ITEM_QUALITY_EPIC)
+        {
+            std::string coined = Any(coinA) + Any(coinB);
+            return !owner.empty() && urand(0, 2) == 0 ? owner + " " + coined : coined + ", " + noun + " of " + ending;
+        }
+        if (!owner.empty() && urand(0, 1)) return owner + " " + adjective + " " + noun;
+        if (quality == ITEM_QUALITY_RARE) return adjective + " " + noun + " of " + ending;
+        return adjective + " " + noun;
+    }
+
+    // the real item's budget, spent again on a theme of its own
+    uint32 Restat(ItemTemplate& t, ItemTemplate const& base)
+    {
+        float budget = 0; bool ratings = false;
+        std::map<uint32, float> by;
+        for (uint32 i = 0; i < base.StatsCount && i < MAX_ITEM_PROTO_STATS; ++i)
+        {
+            uint32 type = base.ItemStat[i].ItemStatType; int32 v = base.ItemStat[i].ItemStatValue;
+            if (v <= 0) continue;
+            budget += float(v) * Cost(type);
+            by[type] += float(v) * Cost(type);
+            ratings |= IsRating(type);
+        }
+        if (budget <= 0) return 0;
+        uint32 theme = ITEM_MOD_STAMINA; float best = 0;
+        for (uint32 p : { ITEM_MOD_STRENGTH, ITEM_MOD_AGILITY, ITEM_MOD_INTELLECT, ITEM_MOD_SPIRIT })
+            if (by[p] > best) { best = by[p]; theme = p; }
+        if (theme == ITEM_MOD_STAMINA)                                // a stamina-only piece: by what wears it
+            theme = base.SubClass == ITEM_SUBCLASS_ARMOR_CLOTH ? ITEM_MOD_INTELLECT : base.SubClass == ITEM_SUBCLASS_ARMOR_PLATE ? ITEM_MOD_STRENGTH : ITEM_MOD_AGILITY;
+        bool plate = base.Class == ITEM_CLASS_ARMOR && base.SubClass == ITEM_SUBCLASS_ARMOR_PLATE;
+        std::vector<uint32> second, third;
+        switch (theme)
+        {
+            case ITEM_MOD_STRENGTH:  second = { ITEM_MOD_STAMINA, ITEM_MOD_STAMINA, ITEM_MOD_AGILITY };
+                                     third = ratings ? std::vector<uint32>{ ITEM_MOD_CRIT_RATING, ITEM_MOD_HIT_RATING, uint32(plate ? ITEM_MOD_DEFENSE_SKILL_RATING : ITEM_MOD_HASTE_RATING), uint32(plate ? ITEM_MOD_PARRY_RATING : ITEM_MOD_ATTACK_POWER) } : std::vector<uint32>{ ITEM_MOD_AGILITY, ITEM_MOD_SPIRIT }; break;
+            case ITEM_MOD_AGILITY:   second = { ITEM_MOD_STAMINA, ITEM_MOD_STAMINA, ITEM_MOD_STRENGTH };
+                                     third = ratings ? std::vector<uint32>{ ITEM_MOD_CRIT_RATING, ITEM_MOD_HIT_RATING, ITEM_MOD_HASTE_RATING, ITEM_MOD_ATTACK_POWER } : std::vector<uint32>{ ITEM_MOD_STRENGTH, ITEM_MOD_ATTACK_POWER }; break;
+            case ITEM_MOD_INTELLECT: second = { ITEM_MOD_STAMINA, ITEM_MOD_SPIRIT };
+                                     third = ratings ? std::vector<uint32>{ ITEM_MOD_SPELL_POWER, ITEM_MOD_CRIT_RATING, ITEM_MOD_HASTE_RATING, ITEM_MOD_MANA_REGENERATION } : std::vector<uint32>{ ITEM_MOD_SPIRIT, ITEM_MOD_SPELL_POWER, ITEM_MOD_MANA_REGENERATION }; break;
+            default:                 second = { ITEM_MOD_INTELLECT, ITEM_MOD_STAMINA };
+                                     third = ratings ? std::vector<uint32>{ ITEM_MOD_SPELL_POWER, ITEM_MOD_MANA_REGENERATION } : std::vector<uint32>{ ITEM_MOD_STAMINA, ITEM_MOD_SPELL_POWER }; break;
+        }
+        uint32 s2 = Any(second), s3 = Any(third);
+        if (s3 == s2 || s3 == theme) s3 = 0;
+        float m = 0.45f + float(urand(0, 15)) / 100.0f, n = 0.22f + float(urand(0, 10)) / 100.0f;   // the third gets at least an eighth
+        if (!s3 || t.Quality < ITEM_QUALITY_RARE && urand(0, 2) == 0) { n = 1.0f - m; s3 = 0; }
+        std::vector<std::pair<uint32, float>> spend = { { theme, budget * m }, { s2, budget * n } };
+        if (s3) spend.push_back({ s3, budget * (1.0f - m - n) });
+        t.StatsCount = 0;
+        for (uint32 i = 0; i < MAX_ITEM_PROTO_STATS; ++i) { t.ItemStat[i].ItemStatType = 0; t.ItemStat[i].ItemStatValue = 0; }
+        for (auto const& [type, points] : spend)
+        {
+            int32 v = int32(points / Cost(type));                    // rounded down: never more than the real item
+            if (v <= 0) continue;
+            t.ItemStat[t.StatsCount].ItemStatType = type; t.ItemStat[t.StatsCount].ItemStatValue = v; ++t.StatsCount;
+        }
+        return theme;
+    }
+
+    std::string StatsString(ItemTemplate const& t)
+    {
+        std::string s;
+        for (uint32 i = 0; i < t.StatsCount; ++i) s += (s.empty() ? "" : ",") + std::to_string(t.ItemStat[i].ItemStatType) + ":" + std::to_string(t.ItemStat[i].ItemStatValue);
+        return s;
+    }
+
+    // a generated item from its base: everything the base has but its name, stats, look and the extras that make it
+    // that particular item (spells, set, sockets, uniqueness)
+    ItemTemplate& Shape(uint32 id, ItemTemplate const& base, uint32 quality, std::string const& name, std::string const& description)
+    {
+        made.push_back(base);
+        ItemTemplate& t = made.back();
+        ItemEntry const* e = sItemStore.LookupEntry(id);
+        t.ItemId = id; t.Name1 = name; t.Quality = quality; t.Description = description;
+        if (e) { t.DisplayInfoID = e->DisplayInfoID; t.Class = e->ClassID; t.SubClass = e->SubclassID; t.InventoryType = e->InventoryType; t.Material = e->Material; t.Sheath = e->SheatheType; t.SoundOverrideSubclass = e->SoundOverrideSubclassID; }
+        t.RandomProperty = 0; t.RandomSuffix = 0; t.ItemSet = 0; t.MaxCount = 0; t.StartQuest = 0; t.ScriptId = 0; t.Duration = 0;
+        t.ItemLimitCategory = 0; t.HolidayId = 0; t.Area = 0; t.Map = 0; t.socketBonus = 0; t.GemProperties = 0;
+        t.RequiredReputationFaction = 0; t.RequiredReputationRank = 0; t.RequiredHonorRank = 0; t.RequiredCityRank = 0;
+        t.Bonding = BIND_WHEN_EQUIPPED;
+        for (auto& sp : t.Spells) { sp.SpellId = 0; sp.SpellTrigger = 0; sp.SpellCharges = 0; sp.SpellPPMRate = 0; sp.SpellCooldown = -1; sp.SpellCategory = 0; sp.SpellCategoryCooldown = -1; }
+        for (auto& so : t.Socket) { so.Color = 0; so.Content = 0; }
+        t.Flags = ItemFlags(uint32(t.Flags) & ~uint32(ITEM_FLAG_UNIQUE_EQUIPPABLE));
+        return t;
+    }
+
+    void Publish(ItemTemplate& t)
+    {
+        sObjectMgr->SetGeneratedItemTemplate(t.ItemId, &t);
+        inUse.insert(t.ItemId);
+    }
+
+    uint32 FreeId(ItemTemplate const& base)
+    {
+        auto pick = [](std::vector<uint32> const& ids) -> uint32 {
+            for (uint32 id : ids) if (!inUse.contains(id)) return id;
+            return 0;
+        };
+        if (auto it = poolByLook.find(LookKey(base.Class, base.SubClass, base.InventoryType, base.DisplayInfoID)); it != poolByLook.end())
+            if (uint32 id = pick(it->second)) return id;
+        if (auto it = poolByKind.find(KindKey(base.Class, base.SubClass, base.InventoryType)); it != poolByKind.end())
+            if (uint32 id = pick(it->second)) return id;           // another look of the same kind of item
+        return 0;
+    }
+}
+
+void LoadTemplates()
+{
+    std::lock_guard<std::recursive_mutex> g(lock);
+    BuildPool();
+    if (poolByLook.empty()) { LOG_INFO("server.loading", "SoloWoW loot: no generated-item ids in Item.dbc (run scripts\\gen-items.py) - generated items off"); return; }
+    WorldDatabase.DirectExecute("CREATE TABLE IF NOT EXISTS solo_gen_item (id INT UNSIGNED NOT NULL PRIMARY KEY, base INT UNSIGNED NOT NULL, name VARCHAR(120) NOT NULL, "
+        "quality TINYINT UNSIGNED NOT NULL, stats VARCHAR(255) NOT NULL, description VARCHAR(255) NOT NULL DEFAULT '', created INT UNSIGNED NOT NULL DEFAULT 0) ENGINE=InnoDB");
+    // ids no copy of which is left anywhere are freed
+    std::set<uint32> held;
+    if (QueryResult r = CharacterDatabase.Query("SELECT DISTINCT itemEntry FROM item_instance WHERE itemEntry >= {}", GEN_BASE))
+        do { held.insert(r->Fetch()[0].Get<uint32>()); } while (r->NextRow());
+    uint32 loaded = 0, freed = 0;
+    if (QueryResult r = WorldDatabase.Query("SELECT id, base, name, quality, stats, description FROM solo_gen_item"))
+        do
+        {
+            Field* f = r->Fetch();
+            uint32 id = f[0].Get<uint32>();
+            if (!held.contains(id)) { WorldDatabase.Execute("DELETE FROM solo_gen_item WHERE id = {}", id); ++freed; continue; }
+            ItemTemplate const* base = sObjectMgr->GetItemTemplate(f[1].Get<uint32>());
+            if (!base || !sItemStore.LookupEntry(id)) continue;
+            ItemTemplate& t = Shape(id, *base, f[3].Get<uint32>(), f[2].Get<std::string>(), f[5].Get<std::string>());
+            t.StatsCount = 0;
+            for (uint32 i = 0; i < MAX_ITEM_PROTO_STATS; ++i) { t.ItemStat[i].ItemStatType = 0; t.ItemStat[i].ItemStatValue = 0; }
+            std::istringstream in(f[4].Get<std::string>());
+            std::string part;
+            while (std::getline(in, part, ',') && t.StatsCount < MAX_ITEM_PROTO_STATS)
+            {
+                uint32 type = 0; int32 v = 0;
+                if (std::sscanf(part.c_str(), "%u:%d", &type, &v) == 2) { t.ItemStat[t.StatsCount].ItemStatType = type; t.ItemStat[t.StatsCount].ItemStatValue = v; ++t.StatsCount; }
+            }
+            Publish(t);
+            ++loaded;
+        } while (r->NextRow());
+    ready = true;
+    LOG_INFO("server.loading", "SoloWoW loot: {} generated items kept, {} ids freed, {} ids for new ones", loaded, freed, uint32(GEN_END - GEN_BASE));
+}
+
+bool Ready() { return ready; }
+
+ItemTemplate const* Make(Player const* player, uint8 level, uint32 quality, std::string const& source, uint32 testClass)
+{
+    std::lock_guard<std::recursive_mutex> g(lock);
+    if (!ready || (!player && !testClass)) return nullptr;
+    if (!basesBuilt) BuildBases();
+    // a real item for the player, of that quality, at about their level: one they could wear (class, armour, weapons)
+    std::vector<ItemTemplate const*> fit;
+    for (uint32 l = level > 3 ? level - 3 : 1; l <= level; ++l)
+        if (auto it = bases.find((quality << 8) | l); it != bases.end())
+            for (ItemTemplate const* t : it->second)
+                if (player ? player->CanUseItem(t) == EQUIP_ERR_OK : TestFits(t, testClass)) fit.push_back(t);
+    if (fit.empty()) return nullptr;
+    for (uint32 attempt = 0; attempt < 8; ++attempt)
+    {
+        ItemTemplate const* base = Any(fit);
+        uint32 id = FreeId(*base);
+        if (!id) continue;
+        ItemTemplate probe = *base;                                  // restat on a copy first, to know the theme for the name
+        probe.Quality = quality;
+        uint32 theme = Restat(probe, *base);
+        if (!theme || !probe.StatsCount) continue;
+        std::string name = Name(*base, theme, quality, source);
+        std::string description = !source.empty() && quality >= ITEM_QUALITY_RARE ? "Taken from " + source + "." : std::string();
+        ItemTemplate& t = Shape(id, *base, quality, name, description);
+        t.StatsCount = probe.StatsCount;
+        for (uint32 i = 0; i < MAX_ITEM_PROTO_STATS; ++i) t.ItemStat[i] = probe.ItemStat[i];
+        Publish(t);
+        std::string qName = name, qDesc = description;                // names carry apostrophes ("Hexir's")
+        WorldDatabase.EscapeString(qName); WorldDatabase.EscapeString(qDesc);
+        WorldDatabase.Execute("REPLACE INTO solo_gen_item (id, base, name, quality, stats, description, created) VALUES ({}, {}, '{}', {}, '{}', '{}', UNIX_TIMESTAMP())",
+            id, base->ItemId, qName, quality, StatsString(t), qDesc);
+        return &t;
+    }
+    return nullptr;
+}
+
+std::string Describe(ItemTemplate const* t)
+{
+    static char const* names[] = { "", "", "", "Agi", "Str", "Int", "Spi", "Sta" };
+    std::string s = t->Name1 + " [q" + std::to_string(t->Quality) + " req " + std::to_string(t->RequiredLevel) + ", id " + std::to_string(t->ItemId) + "]:";
+    for (uint32 i = 0; i < t->StatsCount; ++i)
+    {
+        uint32 type = t->ItemStat[i].ItemStatType;
+        s += " +" + std::to_string(t->ItemStat[i].ItemStatValue) + " " + (type < 8 && names[type][0] ? std::string(names[type]) : "mod" + std::to_string(type));
+    }
+    if (!t->Description.empty()) s += " (" + t->Description + ")";
+    return s;
+}
+}
