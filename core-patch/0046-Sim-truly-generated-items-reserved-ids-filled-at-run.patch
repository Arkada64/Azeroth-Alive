+
+// someone near the player talks to them (Nov 18): by what they remember of the player - thanks, a warm word and a
+// question, cold words - or, from a stranger, a question about the road, the danger near town, a place they dream of
+World::TalkLine World::TalkToPlayer(uint32 agentId, uint32 guid, std::string const& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    TalkLine out;
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->status != AgentStatus::Active || a->doing == Verb::Sleep) return out;
+    Rng r(_seed, agentId, _clock * 29 + guid, 9986);
+    Voice const& v = VoiceOf(a->race);
+    int32 regard = 0; bool helped = false, crossed = false; uint32 helpedAt = 0;
+    for (SimMemory const& m : _memories)
+        if (m.agent == agentId && m.subjectType == 4 && m.subject == guid)
+        {
+            regard += int32(m.valence) * m.intensity / 100;
+            if (m.eventType == uint8(EventType::PlayerHelped) && _clock - m.at < 3 * MIN_PER_DAY) { helped = true; helpedAt = m.at; }
+            if (m.eventType == uint8(EventType::Clash)) crossed = true;
+        }
+    (void)helpedAt;
+    auto say = [&](std::initializer_list<std::string> l) { return Pick(std::vector<std::string>(l), r); };
+    if (crossed || regard < -30)
+    {
+        out.text = crossed ? say({ "You've got some nerve showing your face here, " + name + ".", "I remember you, " + name + ". Keep walking.", "Not another step closer, " + name + "." })
+                           : say({ "Stay away from me, " + name + ".", "I've nothing to say to you.", "Go bother someone else." });
+        out.whisper = true; out.emote = EMOTE_ONESHOT_NO;
+        return out;
+    }
+    if (helped)
+    {
+        out.text = say({ name + "! You're the one who helped me out there. I owe you one.", "Thanks again for the help, " + name + ". I won't forget it.",
+            "If you ever need a hand, " + name + ", you know where to find me." });
+        out.whisper = true; out.emote = EMOTE_ONESHOT_BOW;
+        return out;
+    }
+    if (regard >= 30)
+    {
+        out.text = Fill(Pick(v.hello, r), name) + " " + say({ "Where are you headed?", "Any good hunting lately?", "Watch yourself out there.", "Stay for a drink, if you've time." });
+        out.whisper = r.Chance(0.5f); out.emote = EMOTE_ONESHOT_WAVE;
+        return out;
+    }
+    if (a->sociability < 40 || !r.Chance(0.6f)) return out;            // strangers mostly leave you be
+    std::vector<std::string> asks = { "You've come a long way by the look of you. Any news from the road?", "Is it as bad out there as they say?",
+        "Passing through, or staying a while?" };
+    if (std::string w = WorryLine(*a); !w.empty())
+        asks.push_back("You look handy with a blade. " + w);
+    if (a->ambition == AmbitionType::SeePlace && a->ambitionTarget)
+        asks.push_back("Have you ever been to " + SiteName(a->ambitionTarget) + "? Is it as grand as they say?");
+    if (a->ambition == AmbitionType::SaveGold) asks.push_back("You wouldn't know where a body can earn some honest coin, would you?");
+    if (a->role == ROLE_ADVENTURER && a->level + 3 < 80) asks.push_back("Fancy some company on the road sometime? Just ask.");
+    out.text = Pick(asks, r);
+    out.emote = EMOTE_ONESHOT_QUESTION;
+    return out;
+}
