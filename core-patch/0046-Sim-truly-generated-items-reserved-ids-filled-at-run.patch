+// SoloWoW: truly generated items (see solosim_genitems.cpp)
+#ifndef SOLOSIM_GENITEMS_H
+#define SOLOSIM_GENITEMS_H
+
+#include "Define.h"
+#include <string>
+
+class Player;
+struct ItemTemplate;
+
+namespace SoloGen
+{
+    constexpr uint32 GEN_ID_END = 1010000;                      // the fast item store is sized to hold the reserved ids
