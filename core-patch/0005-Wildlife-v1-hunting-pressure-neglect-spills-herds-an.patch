+// every three hours: herds drift between their grazing grounds (not in the rain); packs follow the nearest herd by
+// day and take one of it when they catch up; at night packs go down to the roads
+void World::WildlifeTick()
+{
+    bool night = HourOf(_clock) >= 21 || HourOf(_clock) < 5;
+    for (SimCamp& k : _camps)
+    {
+        if (k.done || k.kind == CAMP_BAND) continue;
+        if (_clock >= k.until || !k.alive) { k.done = true; continue; }
+        SimSite const* home = SiteById(k.home);
+        if (!home) continue;
+        Rng r(_seed, k.id, _clock, P_GEN + 630);
+        if (k.kind == CAMP_HERD)
+        {
+            if (Rainy(k.home) || !r.Chance(0.4f)) continue;          // sheltering, or still grazing
+            std::vector<SimSite const*> spots;
+            for (SimSite const& s : _sites)
+                if (s.type == SiteType::Hunt && s.map == k.map && s.creatureType == 1 && !s.elite && Dist2d(s.x, s.y, home->x, home->y) < 1500.0f)
+                    spots.push_back(&s);
+            if (spots.empty()) continue;
+            SimSite const& to = *spots[r.Range(0, uint32(spots.size()) - 1)];
+            k.x = to.x + float(r.Range(0, 40)) - 20.0f; k.y = to.y + float(r.Range(0, 40)) - 20.0f; k.z = to.z; k.site = to.id;
+            continue;
+        }
+        // a pack
+        if (night)
+        {
+            RoadNode const* best = nullptr; float bd = 700.0f;
+            for (RoadNode const& n : _roads)
+                if (n.map == k.map) { float d = Dist2d(n.x, n.y, k.x, k.y); if (d < bd) { bd = d; best = &n; } }
+            if (best) { k.x = best->x + 10.0f; k.y = best->y + 10.0f; k.z = best->z; k.site = ClosestSite(k.map, k.x, k.y); }
+        }
+        else
+        {
+            SimCamp* prey = nullptr; float pd = 2000.0f;
+            for (SimCamp& h : _camps)
+                if (!h.done && h.kind == CAMP_HERD && h.alive && h.map == k.map) { float d = Dist2d(h.x, h.y, k.x, k.y); if (d < pd) { pd = d; prey = &h; } }
+            if (prey)
+            {
+                k.x = prey->x + 35.0f; k.y = prey->y + 35.0f; k.z = prey->z; k.site = prey->site;
