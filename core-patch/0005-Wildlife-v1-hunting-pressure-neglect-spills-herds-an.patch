+// A band of src's creatures sets up by a road near town h (the board posts a bounty). nearSource: on the road
+// closest to where they came from (a neglected ground spilling over), else anywhere a fair walk from town.
+bool World::MakeCamp(SimSite const& h, SimSite const& src, Rng& r, bool nearSource)
+{
+    uint32 lvl = (src.minLevel + src.maxLevel) / 2;
+    uint32 entry = CampEntry(src.creatureName, lvl);
+    if (!entry) return false;
+    std::vector<RoadNode const*> spots;
+    for (RoadNode const& n : _roads)
+    {
+        if (n.map != h.map) continue;
+        float d = Dist2d(n.x, n.y, h.x, h.y);
+        if (d < 250.0f || d > 1100.0f) continue;
+        bool clear = true;
+        for (SimSite const& s : _sites)
+            if (s.map == h.map && Dist2d(n.x, n.y, s.x, s.y) < (s.type == SiteType::Hub ? 300.0f : 250.0f)) { clear = false; break; }
+        if (clear) spots.push_back(&n);
+    }
+    if (spots.empty()) return false;
+    if (nearSource)
+    {
+        std::ranges::sort(spots, [&](RoadNode const* x, RoadNode const* y) { return Dist2d(x->x, x->y, src.x, src.y) < Dist2d(y->x, y->y, src.x, src.y); });
+        spots.resize(std::min<size_t>(spots.size(), 4));
+    }
+    RoadNode const& at = *spots[r.Range(0, uint32(spots.size()) - 1)];
+    SimCamp k;
+    k.id = _nextCamp++; k.map = h.map; k.entry = entry; k.town = h.id; k.name = src.creatureName; k.level = uint8(lvl);
+    k.kind = CAMP_BAND; k.home = src.id;
+    k.x = at.x + 12.0f; k.y = at.y + 12.0f; k.z = at.z;                         // just off the road
+    k.size = k.alive = uint8(r.Range(4, 7)); k.made = _clock; k.until = _clock + r.Range(3, 5) * MIN_PER_DAY;
+    k.site = ClosestSite(k.map, k.x, k.y);
+    _camps.push_back(k);
+    Log(EventType::RareFind, Nobody(), h.id, nearSource
+        ? Acore::StringFormat("With nobody hunting them, the {} near {} have grown bold and spilled onto the road.", Plural(k.name), AreaOf(SiteName(src.id)))
+        : Acore::StringFormat("{} have made camp by the road near {}. Travellers are going the long way round.", Plural(k.name), AreaOf(SiteName(k.site))), true);
+    SimBounty b;
+    b.id = _nextBounty++; b.hub = h.id; b.site = k.site; b.kind = BOUNTY_RARE; b.count = k.size; b.party = 3;
+    b.target = k.id | CAMP_MARK; b.targetLevel = k.level;
+    b.reward = (lvl * lvl * 30 + 500) * 3 / 2;
+    b.posted = _clock; b.expires = k.until;
+    _bounties.push_back(b);
+    return true;
+}
+
+uint32 World::ClosestSite(uint32 map, float x, float y) const
+{
+    uint32 best = 0; float bd = 1e9f;
+    for (SimSite const& s : _sites)
+        if (s.map == map) { float d = Dist2d(s.x, s.y, x, y); if (d < bd) { bd = d; best = s.id; } }
+    return best;
+}
+
+float World::Pressure(uint32 site) const
+{
+    auto it = _pressure.find(site);
+    return it == _pressure.end() ? 0.0f : it->second;
+}
