+// =====================================================================================================
+// wildlife: hunting grounds remember being hunted; neglected ones spill onto the roads; herds graze between grounds
+// and predator packs follow them (and prowl the roads at night). All sim-owned; real creatures only near the player.
+// =====================================================================================================
+namespace
+{
+    bool IsGrazer(std::string const& n)
+    {
+        return NameHas(n, { "Deer", "Stag", "Doe", "Fawn", "Boar", "Kodo", "Zhevra", "Plainstrider", "Goat", "Ram", "Elk", "Moose", "Sheep",
+                            "Thunder Lizard", "Strider", "Mountain Cow", "Rabbit", "Hare" });
+    }
+    bool IsPredator(std::string const& n)
+    {
+        return NameHas(n, { "Wolf", "Worg", "Coyote", "Jackal", "Lion", "Panther", "Tiger", "Lynx", "Saber", "Bear", "Hyena", "Raptor", "Crocolisk", "Prowler", "Stalker" });
+    }
+}
+
+// a hunting ground near a town that nobody has hunted for a week grows bold: some of it spills onto the nearest road
+void World::NeglectSpills()
+{
+    if (_clock < 7 * MIN_PER_DAY) return;
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN) || !h.regionLevel || !SIM_MAPS.contains(h.map)) continue;
+        if (std::ranges::any_of(_camps, [&](SimCamp const& k) { return !k.done && k.kind == CAMP_BAND && k.town == h.id; })) continue;
+        std::vector<SimSite const*> quiet;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && !s.elite && s.map == h.map && (s.creatureType == 7 || s.creatureType == 1) && Dist2d(s.x, s.y, h.x, h.y) < 1500.0f
+                && std::abs(int32((s.minLevel + s.maxLevel) / 2) - int32(h.regionLevel)) <= 4
+                && (!_lastHunt.contains(s.id) || _clock - _lastHunt.at(s.id) > 7 * MIN_PER_DAY))
+                quiet.push_back(&s);
+        if (quiet.empty()) continue;
+        Rng r(_seed, h.id, _clock, P_GEN + 610);
+        if (!r.Chance(0.2f) || !AwayAllows(h.id + 3000)) continue;
+        MakeCamp(h, *quiet[r.Range(0, uint32(quiet.size()) - 1)], r, true);
+    }
+}
