+std::string World::SummonWildlife()
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "The world isn't running yet.";
+    for (int i = 0; i < 4; ++i) { SpawnWildlife(); _clock += 1; }    // a few rolls (the clock nudge changes the dice)
+    _clock -= 4;
+    WildlifeTick();
+    uint32 herds = 0, packs = 0, bands = 0;
+    std::string some;
+    for (SimCamp const& k : _camps)
+        if (!k.done)
+        {
+            (k.kind == CAMP_HERD ? herds : k.kind == CAMP_PACK ? packs : bands)++;
+            if (k.kind != CAMP_BAND && some.size() < 300)
+                some += Acore::StringFormat(" {} ({}) near {};", k.kind == CAMP_HERD ? "herd of " + Plural(k.name) : "pack of " + Plural(k.name), k.alive, AreaOf(SiteName(k.site)));
+        }
+    return Acore::StringFormat("{} herds, {} packs, {} roadside camps.{}", herds, packs, bands, some);
+}
