 }
 
+// a sim person's body drinks a healing potion in front of you: it comes out of what they carry (false = none left)
+bool World::UsePotion(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a) return true;                 // not ours to count
+    if (!a->potions) return false;
+    --a->potions;
+    return true;
+}
+
+bool World::HasPotion(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    return !a || a->potions > 0;
+}
