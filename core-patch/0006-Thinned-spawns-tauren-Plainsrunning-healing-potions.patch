+// SoloWoW: tauren Plainsrunning, as on WoW Forever (numbers checked in play by the user):
+//   a stack for every 35 yards run (about 5 s at normal run speed - by distance), +2% run speed per stack, at most 30;
+//   -1 stack for each second standing still, -6 for every hit taken; works everywhere, instances included; doesn't
+//   stack with other speed effects (the strongest wins) and gives nothing mounted (stacks freeze while mounted).
+// The aura is spell 12821 (the beta racial still named in the client), reshaped in SpellInfoCorrections.cpp.
+// Settings: SoloWoW.Plainsrunning.Enable / .MaxStacks / .YardsPerStack / .LossStill / .LossHit.
+#include "Config.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "ScriptMgr.h"
+#include "SpellAuras.h"
+#include "UnitScript.h"
+#include <algorithm>
+#include <cmath>
+#include <mutex>
+#include <unordered_map>
+
+namespace SoloPlainsrunning
+{
+namespace
+{
+    constexpr uint32 SPELL_PLAINSRUNNING = 12821;
+
+    struct Settings { bool on = true; int32 max = 30; float yards = 35.0f; int32 still = 1; int32 hit = 6; };
+    Settings const& Cfg()
+    {
+        static Settings const s{
+            sConfigMgr->GetOption<bool>("SoloWoW.Plainsrunning.Enable", true),
+            int32(std::clamp<uint32>(sConfigMgr->GetOption<uint32>("SoloWoW.Plainsrunning.MaxStacks", 30), 1, 100)),
+            std::max(5.0f, sConfigMgr->GetOption<float>("SoloWoW.Plainsrunning.YardsPerStack", 35.0f)),
+            int32(sConfigMgr->GetOption<uint32>("SoloWoW.Plainsrunning.LossStill", 1)),
+            int32(sConfigMgr->GetOption<uint32>("SoloWoW.Plainsrunning.LossHit", 6)) };
+        return s;
+    }
+
+    struct Runner { uint32 map = 0; float x = 0, y = 0, yards = 0; uint32 ms = 0; bool placed = false; };
+    std::mutex lock;
+    std::unordered_map<uint64, Runner> runners;
+
+    int32 Stacks(Unit* u)
+    {
+        Aura* a = u->GetAura(SPELL_PLAINSRUNNING);
+        return a ? int32(a->GetStackAmount()) : 0;
+    }
+
+    void SetStacks(Unit* u, int32 n)
+    {
+        n = std::clamp(n, 0, Cfg().max);
+        Aura* a = u->GetAura(SPELL_PLAINSRUNNING);
+        if (!n) { if (a) u->RemoveAurasDueToSpell(SPELL_PLAINSRUNNING); return; }
+        if (!a && !(a = u->AddAura(SPELL_PLAINSRUNNING, u))) return;
+        if (int32 d = n - int32(a->GetStackAmount())) a->ModStackAmount(d);
+    }
+
+    class solosim_plainsrunning_player : public PlayerScript
+    {
+    public:
+        solosim_plainsrunning_player() : PlayerScript("solosim_plainsrunning_player", { PLAYERHOOK_ON_UPDATE, PLAYERHOOK_ON_LOGOUT }) { }
+
+        void OnPlayerUpdate(Player* p, uint32 diff) override
+        {
+            if (!Cfg().on || p->getRace() != RACE_TAUREN) return;
+            std::lock_guard<std::mutex> guard(lock);
+            Runner& r = runners[p->GetGUID().GetCounter()];
+            if ((r.ms += diff) < 1000) return;
+            uint32 secs = r.ms / 1000; r.ms %= 1000;
+            if (!p->IsAlive() || p->IsInFlight() || p->GetVehicle() || p->IsMounted() || !p->IsInWorld())
+            {
+                r.placed = false;            // mounted, flying, dead: the stacks hold where they are
+                return;
+            }
+            float moved = (r.placed && r.map == p->GetMapId()) ? std::hypot(p->GetPositionX() - r.x, p->GetPositionY() - r.y) : 0.0f;
+            r.map = p->GetMapId(); r.x = p->GetPositionX(); r.y = p->GetPositionY(); r.placed = true;
+            if (moved > 60.0f * secs) moved = 0.0f;   // a teleport or a summon, not a run
+            int32 cur = Stacks(p), n = cur;
+            if (moved < 0.5f * secs) { n -= Cfg().still * int32(secs); r.yards = 0; }
+            else if (!p->IsInWater())
+                for (r.yards += moved; r.yards >= Cfg().yards; r.yards -= Cfg().yards) ++n;
+            if (n != cur) SetStacks(p, n);
+        }
+
+        void OnPlayerLogout(Player* p) override
+        {
+            std::lock_guard<std::mutex> guard(lock);
+            runners.erase(p->GetGUID().GetCounter());
+        }
+    };
+
+    class solosim_plainsrunning_hits : public UnitScript
+    {
+    public:
+        solosim_plainsrunning_hits() : UnitScript("solosim_plainsrunning_hits", true, { UNITHOOK_ON_DAMAGE }) { }
+
+        void OnDamage(Unit* attacker, Unit* victim, uint32& damage) override
+        {
+            if (!damage || !victim || attacker == victim || !Cfg().on || !victim->IsPlayer() || victim->getRace() != RACE_TAUREN) return;
+            if (int32 cur = Stacks(victim)) SetStacks(victim, cur - Cfg().hit);
+        }
+    };
+}
+
+void AddScripts()
+{
+    new solosim_plainsrunning_player();
+    new solosim_plainsrunning_hits();
+}
+}
