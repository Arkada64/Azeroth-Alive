+// The game's own spawns feel the sim's hunting: a creature killed on a hard-hunted ground (by anyone) stays dead
+// longer - up to about three times its normal respawn - so a ground the sim's adventurers have been working looks
+// thinned out when the player gets there. The player's own kills count against the ground too. Called from map
+// threads (both continents may update at once), hence the lock; the sim itself only touches this from the world thread
+// while maps are idle.
+uint32 World::HuntedDeath(uint32 map, float x, float y, uint32 respawnDelay, bool countIt)
+{
+    static std::mutex huntLock;
+    static std::map<std::tuple<uint32, int32, int32>, uint32> cellSite;
+    static size_t indexed = 0;
+    std::lock_guard<std::mutex> guard(huntLock);
+    if (indexed != _sites.size())
+    {
+        cellSite.clear();
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt)
+                cellSite[{ s.map, int32(std::floor(s.x / 200.0f)), int32(std::floor(s.y / 200.0f)) }] = s.id;
+        indexed = _sites.size();
+    }
+    auto it = cellSite.find({ map, int32(std::floor(x / 200.0f)), int32(std::floor(y / 200.0f)) });
+    if (it == cellSite.end()) return 0;
+    SimSite const* s = SiteById(it->second);
+    if (!s) return 0;
+    if (countIt)
+    {
+        _pressure[s->id] += 1.0f;
+        _lastHunt[s->id] = _clock;
+    }
+    float quiet = std::clamp(1.0f - Pressure(s->id) / (float(std::max<uint32>(s->spawns, 4)) * 25.0f), 0.35f, 1.0f);
+    if (quiet > 0.95f) return 0;
+    return std::min<uint32>(uint32(float(respawnDelay) * (1.0f / quiet - 1.0f)), 30 * 60);
+}
