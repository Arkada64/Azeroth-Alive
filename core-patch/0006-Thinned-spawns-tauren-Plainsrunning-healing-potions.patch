+            }
             if (a.durability < 100 || a.supplies < 100)
                 Log(EventType::Broke, a, a.site, Acore::StringFormat("{} couldn't afford repairs and supplies at {} and had to make do.", a.FullName(), SiteName(a.site)), true);
             else
@@ -3702,6 +3750,24 @@ bool World::GearOf(uint32 agentId, std::string& gear, uint8& due)
