-{
-    if (map > 1) return 0;
-    uint32 best = 0; float bd = 900.0f;
+uint32 World::DockTown(uint32 map, float x, float y, SimAgent const& a, float reach) const
+{
+    // the same few docks are asked about thousands of times a sim-day; the answer depends only on whose side the
+    // traveller is (Welcome), and changes only when towns are added
+    if (_dockCacheSites != _sites.size()) { _dockCache.clear(); _dockCacheSites = _sites.size(); }
+    uint8 who = a.role == ROLE_THREAT ? 3 : IsHordeRace(a.race) ? 2 : 1;
+    auto key = std::make_tuple(map, uint32(int32(x) + 100000), uint32(int32(y) + 100000), uint32(reach), who);
+    if (auto it = _dockCache.find(key); it != _dockCache.end()) return it->second;
+    uint32 best = 0; float bd = reach;
     for (SimSite const& s : _sites)
     {
         if (s.type != SiteType::Hub || !(s.services & SVC_INN) || s.map != map || !Welcome(a, s)) continue;
         float d = Dist2d(s.x, s.y, x, y);
         if (d < bd) { bd = d; best = s.id; }
     }
+    _dockCache[key] = best;
     return best;
 }
 
@@ -1063,16 +1086,44 @@ uint32 World::TravelMinutes(uint32 fromSite, uint32 toSite, SimAgent const& a) c
     if (!f || !t || f == t) return 0;
     if (f->map != t->map)
     {
