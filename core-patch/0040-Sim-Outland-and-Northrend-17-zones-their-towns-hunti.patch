         bool horde = IsHordeRace(a.race);
+        auto mayUse = [&](SeaRoute const& sr) { return sr.side == SIDE_NEUTRAL || a.role == ROLE_THREAT || sr.side == (horde ? SIDE_HORDE : SIDE_ALLIANCE); };
+        auto end = [](SeaRoute const& sr, uint32 map, float& x, float& y) {
+            if (sr.amap == map) { x = sr.ax; y = sr.ay; return true; }
+            if (sr.bmap == map) { x = sr.bx; y = sr.by; return true; }
+            return false;
+        };
+        auto other = [](SeaRoute const& sr, uint32 map) { return sr.amap == map ? sr.bmap : sr.amap; };
+        uint32 best = UINT32_MAX;
         for (SeaRoute const& sr : SEA_ROUTES)
         {
-            if (sr.side != SIDE_NEUTRAL && a.role != ROLE_THREAT && sr.side != (horde ? SIDE_HORDE : SIDE_ALLIANCE)) continue;
-            uint32 here = DockTown(f->map, f->map == 0 ? sr.ax : sr.bx, f->map == 0 ? sr.ay : sr.by, a);
-            uint32 there = DockTown(t->map, t->map == 0 ? sr.ax : sr.bx, t->map == 0 ? sr.ay : sr.by, a);
-            if (!here || !there) continue;
-            best = std::min(best, TravelMinutes(fromSite, here, a) + sr.minutes + TravelMinutes(there, toSite, a));
+            float hx, hy, tx, ty;
+            if (!mayUse(sr) || !end(sr, f->map, hx, hy)) continue;
+            uint32 here = DockTown(f->map, hx, hy, a, sr.reach);
+            if (!here) continue;
+            uint32 mid = other(sr, f->map);
+            if (mid == t->map)
+            {
+                end(sr, t->map, tx, ty);
+                if (uint32 there = DockTown(t->map, tx, ty, a, sr.reach))
+                    best = std::min(best, TravelMinutes(fromSite, here, a) + sr.minutes + TravelMinutes(there, toSite, a));
+                continue;
+            }
+            // a second crossing from the middle continent
+            float mx, my; end(sr, mid, mx, my);
+            uint32 landed = DockTown(mid, mx, my, a, sr.reach);
+            if (!landed) continue;
+            for (SeaRoute const& s2 : SEA_ROUTES)
+            {
+                float ax2, ay2, bx2, by2;
+                if (&s2 == &sr || !mayUse(s2) || !end(s2, mid, ax2, ay2) || !end(s2, t->map, bx2, by2)) continue;
+                uint32 dock2 = DockTown(mid, ax2, ay2, a, s2.reach), there = DockTown(t->map, bx2, by2, a, s2.reach);
+                if (!dock2 || !there) continue;
+                best = std::min(best, TravelMinutes(fromSite, here, a) + sr.minutes + TravelMinutes(landed, dock2, a) + s2.minutes
+                    + TravelMinutes(there, toSite, a));
+            }
         }
         return best == UINT32_MAX ? 24 * 60 : best;
     }
