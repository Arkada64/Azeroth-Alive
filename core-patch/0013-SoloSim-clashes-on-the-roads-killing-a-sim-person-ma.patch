 // an adventurer's road went past a camp: strong ones cut their way through, the rest take a beating (or worse)
+// on the roads: someone of the other side travelling a road that runs close to yours (Nov 17). Roads are narrower than
+// hunting grounds but you're passing, not staying: 6%, 12% at night when you see each other late; the grudge-bound
+// always stop. Returns true when `a` came off worse and their journey is over.
+bool World::RoadClash(SimAgent& a, SimSite const& f, SimSite const& t)
+{
+    if (a.role != ROLE_ADVENTURER || f.map != t.map) return false;
+    if (auto it = _lastClash.find(a.id); it != _lastClash.end() && it->second + MIN_PER_DAY > _clock) return false;
+    bool horde = IsHordeRace(a.race);
+    SimAgent* foe = nullptr; bool sought = false;
+    for (auto& [id, o] : _agents)
+    {
+        if (o.status != AgentStatus::Active || o.role != ROLE_ADVENTURER || o.doing != Verb::Goto || o.plan.empty()) continue;
+        if (IsHordeRace(o.race) == horde || std::abs(int32(o.level) - int32(a.level)) > 12) continue;
+        SimSite const* of = SiteById(o.site); SimSite const* ot = SiteById(o.plan.front().site);
+        if (!of || !ot || of->map != f.map || ot->map != f.map) continue;
+        float mx = (of->x + ot->x) * 0.5f, my = (of->y + ot->y) * 0.5f;
+        float d = std::min({ SegDist(of->x, of->y, f.x, f.y, t.x, t.y), SegDist(ot->x, ot->y, f.x, f.y, t.x, t.y), SegDist(mx, my, f.x, f.y, t.x, t.y) });
+        if (d > 300.0f) continue;
+        if (auto it = _lastClash.find(o.id); it != _lastClash.end() && it->second + MIN_PER_DAY > _clock) continue;
+        bool grudge = (a.ambition == AmbitionType::Revenge && a.avengeFor == o.id) || (o.ambition == AmbitionType::Revenge && o.avengeFor == a.id);
+        if (grudge) { foe = &o; sought = true; break; }
+        if (!foe || o.level > foe->level) foe = &o;
+    }
+    if (!foe) return false;
+    Rng r(_seed, a.id ^ (foe->id << 12), _clock, P_FIGHT + 960);
+    bool night = HourOf(_clock) >= 21 || HourOf(_clock) < 5;
+    if (!sought && !r.Chance(night ? 0.12f : 0.06f)) return false;
+    return Duel(a, *foe, t, 0, sought, r, "on the road", "on the road");
+}
+
