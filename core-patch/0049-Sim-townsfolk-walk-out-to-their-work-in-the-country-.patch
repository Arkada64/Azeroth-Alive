 {
     SimSite const* home = SiteById(a.home);
@@ -4176,6 +4201,7 @@ std::vector<uint32> World::Route(uint32 fromIdx, uint32 toIdx) const
 bool World::BodyOf(SimAgent const& a, SimBody& b) const
 {
     if (a.status != AgentStatus::Active || !a.sourceEntry || a.doing == Verb::Delve) return false;   // inside a dungeon: no body
+    if (a.born > _clock) return false;                  // a newcomer still on the road here (Nov 18: one stood idle at Northshire)
     SimSite const* here = SiteById(a.site);
     if (!here) return false;
     b.agent = a.id; b.name = a.FullName(); b.race = a.race; b.cls = a.cls; b.gender = a.gender; b.level = a.level;
@@ -4204,6 +4230,14 @@ bool World::BodyOf(SimAgent const& a, SimBody& b) const
         // townsfolk are out unless they're home asleep; they appear at their own door (the body finds it)
         if (a.doing == Verb::Sleep || a.doing == Verb::Goto || hereIdx == UINT32_MAX) return false;   // asleep, or on the road to a new home
         SimSite const* d = DistrictOf(a);                  // in a big town, their own quarter of it
+        if (SimSite const* g = a.doing == Verb::Work ? WorkGround(a) : nullptr)   // out at their work in the country (Nov 18)
+            if (uint32 gi = SiteRoad(g->id); gi != UINT32_MAX)
+            {
+                b.x = g->x; b.y = g->y; b.z = g->z;
+                b.spawnNode = b.goalNode = _roads[gi].id;
+                b.zone = _roads[gi].zone;
+                return true;
+            }
         b.x = d->x; b.y = d->y; b.z = d->z;
         b.spawnNode = b.goalNode = _roads[hereIdx].id;
         b.zone = _roads[hereIdx].zone;
@@ -4298,6 +4332,8 @@ bool World::Intent(uint32 agentId, SimIntent& out)
     out.follow = a->follow; out.followKind = a->followKind;
     if (SimCaravan const* c = CaravanOf(*a)) out.caravanLead = (out.travelling || a->followKind == 1) && !c->guards.empty() && c->guards.front() == a->id;
     if (SimSite const* hs = a->role == ROLE_CIVILIAN ? DistrictOf(*a) : SiteById(a->home)) { out.homeX = hs->x; out.homeY = hs->y; out.homeZ = hs->z; }
+    if (a->role == ROLE_CIVILIAN && a->doing == Verb::Work)
+        if (SimSite const* g = WorkGround(*a)) { out.workOut = true; out.workX = g->x; out.workY = g->y; out.workZ = g->z; }
     if (a->role == ROLE_CIVILIAN)
         for (SimErrand const& e : _errands)
             if (e.agent == a->id && !e.done && e.kind == ERRAND_ESCORT && e.player)
