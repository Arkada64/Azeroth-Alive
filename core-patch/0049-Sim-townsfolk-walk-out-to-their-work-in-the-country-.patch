@@ -861,12 +901,31 @@ namespace
                 // home time: walk to their own door and go in
                 Position door = DoorOf(_agent);
                 if (door.GetPositionX() == 0.0f && door.GetPositionY() == 0.0f) { me->DespawnOrUnsummon(1s); return; }
+                if (float d = me->GetExactDist2d(door.GetPositionX(), door.GetPositionY()); d > 110.0f)   // out in the country: the walk home
+                {
+                    if (d > 2500.0f) { me->DespawnOrUnsummon(1s); return; }
+                    if (TrekTo(door)) return;
+                }
                 _home = true;
                 Go(door, 0);
                 return;
             }
             Position p;
             float cx = in.homeX, cy = in.homeY, cz = in.homeZ;
+            // their work is out in the country today (Nov 18): out of town they go, and there they work
+            if (in.verb == Verb::Work && in.workOut)
+            {
+                Position spot(in.workX, in.workY, in.workZ, 0.0f);
+                if (me->GetExactDist2d(in.workX, in.workY) > 70.0f && TrekTo(spot)) return;
+                if (Gather(in.job, in.workX, in.workY, in.workZ)) return;
+                if (RandomNear(in.workX, in.workY, in.workZ, 10.0f, 60.0f, p))     // nothing of their trade right here: look about
+                    return Go(p, urand(30000, 60000), UNIT_STAND_STATE_STAND, EMOTE_STATE_USE_STANDING);
+            }
+            else if (float d = me->GetExactDist2d(cx, cy); d > 110.0f)    // done out there: back to town
+            {
+                if (d > 2500.0f) { me->DespawnOrUnsummon(1s); return; }
+                if (TrekTo(Position(cx, cy, cz, 0.0f))) return;
+            }
             switch (in.verb)
             {
                 case Verb::Work:
@@ -979,7 +1038,8 @@ namespace
         ObjectGuid _npc;
         bool _moving = false, _home = false, _following = false;
         std::vector<Move> _moves; std::vector<uint32> _cooldowns; bool _fled = false;
