-            _shoreFound = true;
+            if (_shoreFound && std::hypot(_shoreAt.first - cx, _shoreAt.second - cy) < 100.0f) { out = _shore; return _shore.GetPositionX() != 0.0f || _shore.GetPositionY() != 0.0f; }
+            _shoreFound = true; _shoreAt = { cx, cy }; _shore = Position();
             Map* map = me->GetMap();
