 // where in town a townsperson lives and works: a district, chosen by how much goes on there
+// the townsfolk whose work is out in the country (Nov 18 - "NPCs actually going out into the world"): the fisher, the
+// herbalist, the woodcutter, the miner and the trapper walk out of town to a quiet hunting ground nearby - out of the
+// city gates and into Elwynn from Stormwind - one their level can live with, a different one most days
+SimSite const* World::WorkGround(SimAgent const& a) const
+{
+    if (a.role != ROLE_CIVILIAN || a.job < JOB_FISHER || a.job > JOB_TRAPPER) return nullptr;
+    SimSite const* home = DistrictOf(a);
+    if (!home) return nullptr;
+    uint32 land = Land(*home);
+    float reach = IsCapital(*SiteById(a.home)) ? 1700.0f : 1100.0f;
+    std::vector<SimSite const*> calm, any;
+    for (SimSite const& s : _sites)
+    {
+        if (s.type != SiteType::Hunt || s.elite || Land(s) != land) continue;
+        float d = Dist2d(s.x, s.y, home->x, home->y);
+        if (d < 180.0f || d > reach) continue;
+        any.push_back(&s);
+        if (s.maxLevel <= a.level + 4) calm.push_back(&s);
+    }
+    std::vector<SimSite const*> const& pool = calm.empty() ? any : calm;
+    if (pool.empty()) return nullptr;
+    uint32 day = _clock / MIN_PER_DAY;
+    return pool[uint32(Mix((uint64(a.id) << 24) ^ (day / (2 + a.id % 3)) ^ 0x30A7) % pool.size())];   // the same ground for a few days
+}
+
