+        // a long walk (Nov 18): out of town to their work, and home again - in stretches of up to 65 yards along the ground,
+        // each one a real path, turning aside where the way ahead is blocked (a wall, the water, a cliff). With no way
+        // on after a few tries, they go on out of sight.
+        bool TrekTo(Position const& goal)
+        {
+            float dist = me->GetExactDist2d(goal.GetPositionX(), goal.GetPositionY());
+            if (dist < 55.0f && Walkable(goal)) { _trekking = false; _trekFails = 0; return false; }   // near enough: walk the last bit
+            BotBubble::ReleaseInnSeat(me->GetEntry());
+            ReleaseClaims(me->GetGUID());
+            me->SetStandState(UNIT_STAND_STATE_STAND);
+            me->SetEmoteState(EMOTE_ONESHOT_NONE);
+            Map* map = me->GetMap();
+            float base = std::atan2(goal.GetPositionY() - me->GetPositionY(), goal.GetPositionX() - me->GetPositionX());
+            static float const offsets[] = { 0.0f, 0.45f, -0.45f, 0.9f, -0.9f, 1.4f, -1.4f };
+            for (float o : offsets)
+            {
+                float step = std::min(dist, 65.0f);
+                float x = me->GetPositionX() + std::cos(base + o) * step, y = me->GetPositionY() + std::sin(base + o) * step;
+                float z = map->GetHeight(me->GetPhaseMask(), x, y, me->GetPositionZ() + 25.0f, true, 60.0f);
+                if (z <= INVALID_HEIGHT || map->IsInWater(me->GetPhaseMask(), x, y, z, me->GetCollisionHeight())) continue;
+                Position p(x, y, z, 0.0f);
+                if (!Walkable(p)) continue;
+                me->SetWalk(true);
+                _trekking = true; _trekFails = 0;
+                _moving = true; _moveStart = getMSTime();
+                me->GetMotionMaster()->MovePoint(2, p);
+                _timer = 1000;
+                return true;
+            }
+            if (++_trekFails > 4) { me->DespawnOrUnsummon(1s); return true; }   // no way on from here: on out of sight
+            _timer = 3000;
+            return true;
+        }
+
         // the gatherers' work, out where it can be seen (Nov 18): the fisher on the shore, the herbalist knelt by a herb,
         // the miner at the ore, the woodcutter at the treeline, the trapper setting snares
         bool Gather(uint8 job, float cx, float cy, float cz)
@@ -526,8 +566,8 @@ namespace
