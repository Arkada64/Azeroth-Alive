From 069e27681f332898cf3b99b9d5605f8540cca839 Mon Sep 17 00:00:00 2001
From: Arkada64 <166951731+Arkada64@users.noreply.github.com>
Date: Tue, 17 Nov 2026 12:40:21 -0600
Subject: [PATCH 27/40] Remove the custom races (murloc, naga, tuskarr,
 furbolg): Worgen and Goblin only

Their slots' NPC looks would draw on the new bodies; solosim_races.cpp and the loot delay go.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JU37XfnHTvru3VVz2sNN7z
---
 src/server/game/Handlers/LootHandler.cpp     | 13 ----
 src/server/game/SoloSim/solosim_commands.cpp |  2 -
 src/server/game/SoloSim/solosim_races.cpp    | 68 --------------------
 3 files changed, 83 deletions(-)
 delete mode 100644 src/server/game/SoloSim/solosim_races.cpp

diff --git a/src/server/game/Handlers/LootHandler.cpp b/src/server/game/Handlers/LootHandler.cpp
index f09d5f3..428c19b 100644
--- a/src/server/game/Handlers/LootHandler.cpp
+++ b/src/server/game/Handlers/LootHandler.cpp
@@ -368,19 +368,6 @@ void WorldSession::HandleLootOpcode(WorldPacket& recvData)
     if (player->IsNonMeleeSpellCast(false))
         player->InterruptNonMeleeSpells(false);
 
-    // SoloWoW: murlocs (race 15) have no kneel-to-loot animation, so the window opened at once - give the corpse the same
-    // moment of rummaging every other race spends (Nov 17)
-    if (player->getRace() == 15 || player->getRace() == 20)   // murloc, furbolg: creature bodies
-    {
-        player->StopMoving();
-        player->m_Events.AddEventAtOffset([player, guid]()
-        {
-            if (player->IsAlive() && player->IsInWorld())
-                player->SendLoot(guid, LOOT_CORPSE);
-        }, 900ms);
-        return;
-    }
-
     player->SendLoot(guid, LOOT_CORPSE);
 }
 
diff --git a/src/server/game/SoloSim/solosim_commands.cpp b/src/server/game/SoloSim/solosim_commands.cpp
index ca6631c..62780a9 100644
--- a/src/server/game/SoloSim/solosim_commands.cpp
+++ b/src/server/game/SoloSim/solosim_commands.cpp
@@ -282,13 +282,11 @@ public:
 };
 
 namespace SoloPlainsrunning { void AddScripts(); }
-namespace SoloRaces { void AddScripts(); }
 void AddSC_solosim_xp();
 void AddSC_solosim_quests();
 
 void AddSC_solosim_commands()
 {
-    SoloRaces::AddScripts();
     SoloPlainsrunning::AddScripts();
     AddSC_solosim_xp();
     AddSC_solosim_quests();
diff --git a/src/server/game/SoloSim/solosim_races.cpp b/src/server/game/SoloSim/solosim_races.cpp
deleted file mode 100644
index 4cb8a9f..0000000
--- a/src/server/game/SoloSim/solosim_races.cpp
+++ /dev/null
@@ -1,68 +0,0 @@
-// SoloWoW: our own playable races' server-side rules.
-// Murloc (race 15): the creature murloc body can hold weapons but can't wear drawn armour (armour textures are painted
-// for humanoid bodies), so only the weapon slots are shown; armour still counts in full. Weapons are always drawn, and
-// looting waits a moment (LootHandler.cpp) as there is no loot animation.
-#include "Player.h"
-#include "PlayerScript.h"
-#include "ScriptMgr.h"
-#include <unordered_map>
-
-namespace SoloRaces
-{
-namespace
-{
-    constexpr uint8 RACE_MURLOC = 15;
-    // our races (Nov 17): armour isn't drawn on any of these bodies; the creature-model ones (murloc, furbolg) also
-    // keep their weapons in hand (no sheath animations or points)
-    inline bool OurRace(uint8 r) { return r == 15 || r == 13 || r == 17 || r == 20; }
-    inline bool CreatureBody(uint8 r) { return r == 15 || r == 20; }
-
-    class solosim_race_looks : public PlayerScript
-    {
-    public:
-        solosim_race_looks() : PlayerScript("solosim_race_looks", { PLAYERHOOK_ON_AFTER_SET_VISIBLE_ITEM_SLOT, PLAYERHOOK_ON_UPDATE, PLAYERHOOK_ON_LOGIN }) { }
-
-        // murlocs made before their race was finished (Nov 17) lack languages, armour skills and what comes with them:
-        // whatever their race and class should start with and they don't have, they get on logging in
-        void OnPlayerLogin(Player* player) override
-        {
-            if (!OurRace(player->getRace())) return;
-            player->LearnDefaultSkills();
-            player->LearnCustomSpells();                     // the racials (playercreateinfo_spell_custom)
-        }
-
-        // the creature body has no sheathe/draw animations and no proper back or hip points: murlocs keep their weapons
-        // in hand, like every murloc you've ever met (Nov 17). Ranged stays ranged while shooting.
-        void OnPlayerUpdate(Player* player, uint32 diff) override
-        {
-            if (!CreatureBody(player->getRace())) return;
-            if (player->GetSheath() == SHEATH_STATE_UNARMED)
-            {
-                if (player->GetWeaponForAttack(BASE_ATTACK, true) || player->GetWeaponForAttack(OFF_ATTACK, true))
-                    player->SetSheath(SHEATH_STATE_MELEE);
-                return;
-            }
-            // talking to someone, the client puts the weapons away on its own without telling the server: remind it every
-            // second (Nov 17 - murlocs sheathed when they spoke to NPCs)
-            _remind[player->GetGUID().GetCounter()] += diff;
-            if (_remind[player->GetGUID().GetCounter()] >= 1000)
-            {
-                _remind[player->GetGUID().GetCounter()] = 0;
-                player->ForceValuesUpdateAtIndex(UNIT_FIELD_BYTES_2);
-            }
-        }
-
-        void OnPlayerAfterSetVisibleItemSlot(Player* player, uint8 slot, Item* /*item*/) override
-        {
-            if (!OurRace(player->getRace())) return;
-            if (slot == EQUIPMENT_SLOT_MAINHAND || slot == EQUIPMENT_SLOT_OFFHAND || slot == EQUIPMENT_SLOT_RANGED) return;
-            player->SetUInt32Value(PLAYER_VISIBLE_ITEM_1_ENTRYID + (slot * 2), 0);
-            player->SetUInt32Value(PLAYER_VISIBLE_ITEM_1_ENCHANTMENT + (slot * 2), 0);
-        }
-    private:
-        std::unordered_map<uint32, uint32> _remind;
-    };
-}
-
-void AddScripts() { new solosim_race_looks(); }
-}
