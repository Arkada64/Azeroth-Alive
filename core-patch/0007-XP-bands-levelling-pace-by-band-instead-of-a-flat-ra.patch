+++ b/src/server/game/SoloSim/solosim_xp.cpp
@@ -0,0 +1,80 @@
+// SoloWoW: levelling pace by band instead of one flat rate. Each band has its own multiplier for kills and for quests
+// (exploration follows quests). The defaults bring 1-60 to vanilla's pace: this server's table needs 82-94% of
+// vanilla's XP from 20 on, so the kill multiplier is that share; quests (boosted after vanilla) are trimmed harder.
+// 60-80 stay native. Off by default (SoloWoW.XPBands.Enable); when on, it replaces Rate.XP.Kill/Quest/Explore for
+// players, and the sim's adventurers level on the same curve.
+// SoloWoW.XPBands = "1-10:1.0/0.85, 10-20:0.94/0.75, ..." (from-to level: kill/quest)
+#include "solosim.h"
+#include "Config.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "ScriptMgr.h"
+#include "World.h"
+#include <algorithm>
+#include <cstdio>
+#include <sstream>
+#include <vector>
+
+namespace SoloSim
+{
+namespace
+{
+    struct Band { uint8 from = 1, to = 80; float kill = 1.0f, quest = 1.0f; };
+    constexpr char const* DEFAULT_BANDS = "1-10:1.0/0.85, 10-20:0.94/0.75, 20-30:0.85/0.65, 30-60:0.82/0.62, 60-80:1.0/1.0";
+
+    struct Curve
+    {
+        bool on = false;
+        std::vector<Band> bands;
+        Curve()
+        {
+            on = sConfigMgr->GetOption<bool>("SoloWoW.XPBands.Enable", false);
+            std::istringstream in(sConfigMgr->GetOption<std::string>("SoloWoW.XPBands", DEFAULT_BANDS));
+            std::string part;
+            while (std::getline(in, part, ','))
+            {
+                Band b; unsigned f = 0, t = 0;
+                if (std::sscanf(part.c_str(), " %u-%u:%f/%f", &f, &t, &b.kill, &b.quest) == 4 && f && t > f)
+                { b.from = uint8(f); b.to = uint8(t); bands.push_back(b); }
+            }
+        }
+    };
+    Curve const& TheCurve() { static Curve const c; return c; }
+}
+
+// the band multiplier at this level (quest: quests and exploration), or a negative number when bands are off
+float BandXP(uint8 level, bool quest)
+{
+    Curve const& c = TheCurve();
+    if (!c.on) return -1.0f;
+    for (Band const& b : c.bands)
+        if (level >= b.from && level < b.to) return quest ? b.quest : b.kill;
+    return 1.0f;
+}
+}
+
+namespace
+{
+    class solosim_xp_bands : public PlayerScript
+    {
+    public:
+        solosim_xp_bands() : PlayerScript("solosim_xp_bands", { PLAYERHOOK_ON_GIVE_EXP }) { }
+
+        void OnPlayerGiveXP(Player* player, uint32& amount, Unit* /*victim*/, uint8 source) override
+        {
+            if (!amount || source == XPSOURCE_BATTLEGROUND || source == XPSOURCE_QUEST_DF) return;
+            bool quest = source != XPSOURCE_KILL;
+            float band = SoloSim::BandXP(player->GetLevel(), quest);
+            if (band < 0.0f) return;
+            // the game already applied its flat rate: swap it for the band's
+            float flat = sWorld->getRate(source == XPSOURCE_KILL ? RATE_XP_KILL : (source == XPSOURCE_EXPLORE ? RATE_XP_EXPLORE : RATE_XP_QUEST));
+            if (flat <= 0.0f) return;
+            amount = std::max<uint32>(1, uint32(float(amount) * band / flat + 0.5f));
+        }
+    };
+}
+
+void AddSC_solosim_xp()
+{
+    new solosim_xp_bands();
+}
