+// real kits for everyone (Nov 17 night): those with none get one, those with pieces due get the weakest replaced where
+// something better fits - a few hundred people an hour, round the whole world in turn. Anyone whose body was near the
+// player lately is left alone (the body wears and records their kit).
+void World::RefreshKits(uint32 budget)
+{
+    if (_agents.empty()) return;
+    auto it = _agents.lower_bound(_gearCursor);
+    uint32 looked = 0, done = 0, pieces = 0;
+    while (done < budget && looked < _agents.size())
+    {
+        if (it == _agents.end()) it = _agents.begin();
+        SimAgent& a = it->second;
+        _gearCursor = it->first + 1;
+        ++it; ++looked;
+        if (a.role != ROLE_ADVENTURER || (a.status != AgentStatus::Active && a.status != AgentStatus::Recovering)) continue;
+        if (!a.gear.empty() && !a.gearDue) continue;
+        if (auto s = _lastSeen.find(a.id); s != _lastSeen.end() && _clock - s->second < 30) continue;
+        uint32 changed = 0;
+        a.gear = SoloGear::Refresh(a.cls, a.level, a.gear, a.gear.empty() ? 0 : a.gearDue, Mix((uint64(_seed) << 20) ^ (uint64(a.id) << 8) ^ (_clock / MIN_PER_DAY)), &changed);
+        a.gearDue = 0;
+        TierFromKit(a);
+        ++done; pieces += changed;
+    }
+    (void)pieces;
+}
