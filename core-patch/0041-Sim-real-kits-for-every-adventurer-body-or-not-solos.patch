+    // the kit after a refresh: an empty kit is built whole; otherwise the open slots are filled and the `due` weakest
+    // pieces replaced where something better fits (changed: how many pieces are new)
+    std::string Refresh(uint8 cls, uint8 level, std::string const& kit, uint8 due, uint64 seed, uint32* changed = nullptr);
