+// how well equipped they really are: item level and quality against what's normal for their level, minus empty slots
+void World::TierFromKit(SimAgent& sa)
+{
+    SimAgent* a = &sa;
+    std::string const& gear = a->gear;
     static int32 const qualityBonus[] = { -5, 0, 3, 7, 13, 20, 20, 20 };
     int32 sum = 0, n = 0;
     std::istringstream in(gear);
@@ -4705,9 +4741,12 @@ void World::SetGear(uint32 agentId, std::string const& gear)
         if (ItemTemplate const* p = sObjectMgr->GetItemTemplate(entry)) { sum += int32(p->ItemLevel) + qualityBonus[std::min<uint32>(p->Quality, 7)]; ++n; }
     }
     if (!n) return;
-    int32 expected = a->level < 20 ? 12 : a->level < 30 ? 15 : 17;
-    float rel = float(sum) / float(n) - float(a->level + 3);
-    float tier = 50.0f + rel * 4.0f - float(std::max<int32>(0, expected - n)) * 3.0f;
+    int32 expected = a->level < 10 ? 9 : a->level < 20 ? 10 : a->level < 30 ? 13 : 16;   // the slots open at the level (Nov 17 night)
+    // a typical item for the level: close to the level itself up to 60, then Outland's and Northrend's steeper climb
+    // (about 115 at 70, about 195 at 80) - measured as a share, so a few item levels count the same at 20 as at 80
+    float norm = a->level <= 60 ? float(a->level) + 3.0f : a->level <= 70 ? 63.0f + float(a->level - 60) * 5.2f : 115.0f + float(a->level - 70) * 8.0f;
+    float rel = (float(sum) / float(n) / norm - 1.0f) * 100.0f;       // per cent above (or below) the norm
+    float tier = 50.0f + rel * 1.3f - float(std::max<int32>(0, expected - n)) * 3.0f;
     a->gearTier = uint8(std::clamp(tier, 5.0f, 100.0f));
 }
 
