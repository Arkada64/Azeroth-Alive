+#include <vector>
+
+namespace SoloGear
+{
+namespace
+{
+    struct Piece { uint8 slot = 0; uint32 entry = 0; int32 suffix = 0; uint32 enchant = 0; };
+
+    // a small deterministic generator: the same person, the same day, the same roll
+    struct Roll
+    {
+        uint64 s;
+        explicit Roll(uint64 seed) : s(seed * 6364136223846793005ULL + 1442695040888963407ULL) { }
+        uint32 Next() { s ^= s >> 33; s *= 0xff51afd7ed558ccdULL; s ^= s >> 33; s *= 0xc4ceb9fe1a85ec53ULL; s ^= s >> 33; return uint32(s); }
+        uint32 Below(uint32 n) { return n ? Next() % n : 0; }
+    };
+
+    bool CanRanged(uint8 cls)
+    {
+        return cls == BOT_CLASS_HUNTER || cls == BOT_CLASS_ROGUE || cls == BOT_CLASS_WARRIOR || cls == BOT_CLASS_PRIEST
+            || cls == BOT_CLASS_MAGE || cls == BOT_CLASS_WARLOCK;
+    }
+    bool Caster(uint8 cls) { return cls == BOT_CLASS_PRIEST || cls == BOT_CLASS_MAGE || cls == BOT_CLASS_WARLOCK || cls == BOT_CLASS_DRUID; }
+
+    // the slot is open at this level (as bot_ai::InitEquips does it)
+    bool SlotOpen(uint8 slot, uint8 cls, uint8 level)
+    {
+        if (slot == BOT_SLOT_BODY) return false;                                          // shirts: not worth a roll
+        if (slot == BOT_SLOT_OFFHAND && level < 10 && Caster(cls)) return false;
+        if ((slot == BOT_SLOT_FINGER1 || slot == BOT_SLOT_FINGER2 || slot == BOT_SLOT_NECK || slot == BOT_SLOT_SHOULDERS) && level < 20) return false;
+        if ((slot == BOT_SLOT_TRINKET1 || slot == BOT_SLOT_TRINKET2 || slot == BOT_SLOT_HEAD) && level < 30) return false;
+        return true;
+    }
+
+    bool QualityFits(uint32 q, uint8 level, Roll& r)
+    {
+        if (q >= ITEM_QUALITY_EPIC) return r.Below(100) < (level >= 60 ? 12u : level >= 50 ? 2u : 0u);
+        if (q == ITEM_QUALITY_RARE) return r.Below(100) < (level < 20 ? 5u : level < 50 ? 25u : level < 60 ? 40u : 100u);
+        return q >= ITEM_QUALITY_NORMAL;
+    }
+
+    // one piece for the slot: from the highest level step down, the items this class can wear there
+    uint32 Pick(uint8 cls, uint8 level, uint8 slot, ItemTemplate const* mainHand, std::string& family, Roll& r, uint32 avoid = 0)
+    {
+        if (cls >= BOT_CLASS_END || slot >= BOT_INVENTORY_SIZE) return 0;
+        ItemLeveledArr const& steps = BotDataMgr::GetWanderingBotsSortedGearMap()[BOT_GENERATED_WANDERING][cls][slot];
+        uint32 maxIlvl = BotCfg::GetBotWandererMaxItemLevel(level);
+        bool armour = slot >= BOT_SLOT_HEAD && slot <= BOT_SLOT_HANDS;
+        for (int32 lvl = level; lvl > ITEM_SORTING_LEVEL_STEP; lvl -= ITEM_SORTING_LEVEL_STEP)
+        {
+            uint32 step = uint32(lvl) / ITEM_SORTING_LEVEL_STEP;
+            if (step >= steps.size() || steps[step].empty()) continue;
+            std::vector<ItemTemplate const*> valid;
+            for (uint32 id : steps[step])
+            {
+                ItemTemplate const* p = sObjectMgr->GetItemTemplate(id);
+                if (!p || (maxIlvl && p->ItemLevel > maxIlvl) || p->ItemId == avoid) continue;   // not the same ring or trinket twice
+                if (!bot_ai::CanEquipFor(cls, level, BOT_SPEC_DEFAULT, CanRanged(cls), p, slot)) continue;
+                if (slot == BOT_SLOT_OFFHAND && mainHand && mainHand->InventoryType == INVTYPE_2HWEAPON) continue;   // two hands full
+                valid.push_back(p);
+            }
+            if (valid.empty()) continue;
+            ItemTemplate const* keep = nullptr;
+            for (uint32 attempt = 0; attempt < 6; ++attempt)
+            {
+                ItemTemplate const* p = valid[r.Below(uint32(valid.size()))];
+                bool qualityOk = QualityFits(p->Quality, level, r);
+                bool familyOk = !armour || level < 30 || family.empty() || p->Name1.rfind(family + " ", 0) == 0;
+                if (qualityOk && familyOk) { keep = p; break; }
+                if (qualityOk && !keep) keep = p;
+            }
+            if (!keep) keep = valid[r.Below(uint32(valid.size()))];
+            if (armour && level >= 30 && family.empty())
+                if (size_t sp = keep->Name1.find(' '); sp != std::string::npos && keep->Name1.find(" of ") == std::string::npos)
+                    family = keep->Name1.substr(0, sp);
+            return keep->ItemId;
+        }
+        return 0;
+    }
+
+    std::vector<Piece> Parse(std::string const& kit)
+    {
+        std::vector<Piece> out;
+        std::istringstream in(kit);
+        std::string part;
+        while (std::getline(in, part, ','))
+        {
+            Piece g; uint32 slot = 0;
+            if (std::sscanf(part.c_str(), "%u:%u:%d:%u", &slot, &g.entry, &g.suffix, &g.enchant) == 4 && g.entry && slot < BOT_INVENTORY_SIZE)
+            { g.slot = uint8(slot); out.push_back(g); }
+        }
+        return out;
+    }
+}
+
+std::string Refresh(uint8 cls, uint8 level, std::string const& kit, uint8 due, uint64 seed, uint32* changed)
+{
+    if (changed) *changed = 0;
+    if (cls < BOT_CLASS_WARRIOR || cls > BOT_CLASS_DRUID || cls == BOT_CLASS_DEATH_KNIGHT) return kit;
+    std::vector<Piece> have = Parse(kit);
+    std::map<uint8, Piece> bySlot;
+    for (Piece const& g : have) bySlot[g.slot] = g;
+    Roll r(seed);
+
+    // which slots get a new piece: an empty kit - all of them; otherwise the open slots with nothing in them, then the
+    // weakest pieces, as many as are due
+    std::vector<uint8> todo;
+    std::vector<std::pair<uint32, uint8>> weakest;
+    for (uint8 s = 0; s < BOT_INVENTORY_SIZE; ++s)
+    {
+        if (!SlotOpen(s, cls, level)) continue;
+        auto it = bySlot.find(s);
+        if (it == bySlot.end()) { todo.push_back(s); continue; }
+        if (ItemTemplate const* p = sObjectMgr->GetItemTemplate(it->second.entry)) weakest.emplace_back(p->ItemLevel, s);
+        else todo.push_back(s);
+    }
+    std::ranges::sort(weakest);
+    for (uint32 k = 0; k < weakest.size() && k < due; ++k) todo.push_back(weakest[k].second);
+    if (todo.empty()) return kit;
+    std::ranges::sort(todo);                                   // main hand first: the off hand depends on it
+
+    // the armour family they already wear, so new pieces match it
+    std::string family;
+    for (auto const& [s, g] : bySlot)
+        if (s >= BOT_SLOT_HEAD && s <= BOT_SLOT_HANDS)
+            if (ItemTemplate const* p = sObjectMgr->GetItemTemplate(g.entry); p && p->Name1.find(" of ") == std::string::npos)
+                if (size_t sp = p->Name1.find(' '); sp != std::string::npos) { family = p->Name1.substr(0, sp); break; }
+
+    uint32 n = 0;
+    for (uint8 s : todo)
+    {
+        ItemTemplate const* mh = nullptr;
+        if (auto it = bySlot.find(BOT_SLOT_MAINHAND); it != bySlot.end()) mh = sObjectMgr->GetItemTemplate(it->second.entry);
+        // the other ring or trinket they wear: never the same piece twice
+        uint8 partner = s == BOT_SLOT_FINGER1 ? BOT_SLOT_FINGER2 : s == BOT_SLOT_FINGER2 ? BOT_SLOT_FINGER1
+                      : s == BOT_SLOT_TRINKET1 ? BOT_SLOT_TRINKET2 : s == BOT_SLOT_TRINKET2 ? BOT_SLOT_TRINKET1 : BOT_INVENTORY_SIZE;
+        uint32 avoid = 0;
+        if (partner < BOT_INVENTORY_SIZE) if (auto pit = bySlot.find(partner); pit != bySlot.end()) avoid = pit->second.entry;
+        uint32 entry = Pick(cls, level, s, mh, family, r, avoid);
+        if (!entry) continue;
+        ItemTemplate const* np = sObjectMgr->GetItemTemplate(entry);
+        auto it = bySlot.find(s);
+        if (it != bySlot.end())
+            if (ItemTemplate const* op = sObjectMgr->GetItemTemplate(it->second.entry); op && np && op->ItemLevel + (op->Quality > np->Quality ? 5 : 0) > np->ItemLevel)
+                continue;                                      // nothing better on offer: keep what they have
+        Piece g; g.slot = s; g.entry = entry; g.suffix = Item::GenerateItemRandomPropertyId(entry);
+        bySlot[s] = g;
+        ++n;
+        if (s == BOT_SLOT_MAINHAND && np && np->InventoryType == INVTYPE_2HWEAPON) bySlot.erase(BOT_SLOT_OFFHAND);   // a two-hander: off hand empty
+    }
+    if (changed) *changed = n;
+    std::string out;
+    for (auto const& [s, g] : bySlot)
+        out += (out.empty() ? "" : ",") + std::to_string(uint32(s)) + ":" + std::to_string(g.entry) + ":" + std::to_string(g.suffix) + ":" + std::to_string(g.enchant);
+    return out;
+}
+}
