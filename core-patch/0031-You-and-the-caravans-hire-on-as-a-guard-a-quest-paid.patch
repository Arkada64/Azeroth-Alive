+void World::CaravanCompany(uint32 guid, uint8 level, std::vector<uint32> const& nearAgents)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimCaravan& c : _caravans)
+    {
+        if (!c.player && c.errand)                              // after a restart: who signed on is in the job itself
+            for (SimErrand const& e : _errands) if (e.id == c.errand && e.player) c.player = e.player;
+        if (c.player != guid || c.state > 1 || c.guards.empty()) continue;
+        SimAgent const* lead = AgentById(c.guards.front());
+        if (!lead || lead->doing != Verb::Goto) continue;          // counted on the road only
+        c.playerLevel = level;
+        bool with = std::ranges::any_of(c.guards, [&](uint32 g) { return std::ranges::find(nearAgents, g) != nearAgents.end(); });
+        if (with) { ++c.with; c.lastWith = _clock; } else ++c.away;
+    }
+}
+
+bool World::TakeAmbush(uint32 guid, SimAmbush& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (auto it = _ambushes.begin(); it != _ambushes.end(); ++it)
+        if (it->guid == guid) { out = *it; _ambushes.erase(it); return true; }
+    return false;
+}
+
+bool World::CaravanReport(uint32 guid, uint32 agentId, SimErrand& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->role != ROLE_CIVILIAN) return false;
+    for (SimErrand const& e : _errands)
+        if (!e.done && e.kind == ERRAND_CARAVAN && e.player == guid && e.site == a->home && e.progress >= e.count) { out = e; return true; }
+    return false;
+}
+
+// the player brought down the last of an enemy caravan's guards: the wagons are theirs to go through
+bool World::CaravanPlunder(uint32 guid, uint32 fallenAgent, uint32& copper, std::vector<std::pair<uint32, uint32>>& items, std::string& text)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    copper = 0; items.clear();
+    SimAgent* g = AgentById(fallenAgent);
+    if (!guid || !g || !g->caravan) return false;
+    SimCaravan* c = CaravanOf(*g);
+    if (!c || c->state != 0) return false;
+    if (std::ranges::any_of(c->guards, [&](uint32 id) { SimAgent const* x = AgentById(id); return x && x->status == AgentStatus::Active; })) return false;   // someone still stands
+    SimSite const* f = SiteById(c->from);
+    uint32 lvl = std::max<uint32>(1, f ? f->regionLevel : g->level);
+    uint32 tier = lvl < 15 ? 0 : lvl < 25 ? 1 : lvl < 35 ? 2 : lvl < 45 ? 3 : 4;
+    static uint32 const goods[5][5] = { { 0, 0, 0, 0, 0 }, { 2770, 2771, 2772, 3858, 10620 }, { 765, 2450, 3355, 8831, 13464 },
+                                        { 2318, 2319, 4234, 4304, 8170 }, { 6291, 6308, 6362, 4603, 13754 } };
+    static uint32 const made[2][5] = { { 118, 858, 929, 1710, 3928 }, { 2680, 2684, 3220, 3666, 12210 } };   // potions, food
+    for (uint8 p = 1; p < 5; ++p)
+    {
+        copper += c->goods[p] * (4 + lvl);
+        if (uint32 n = std::min<uint32>(c->goods[p] / 4, 20)) items.emplace_back(goods[p][tier], n);
+    }
+    for (uint8 k = 0; k < 4; ++k) copper += c->made[k] * (10 + lvl * 2);
+    if (uint32 n = std::min<uint32>(c->made[CRAFT_POTION] / 2, 5)) items.emplace_back(made[0][tier], n);
+    if (uint32 n = std::min<uint32>(c->made[CRAFT_FOOD] / 2, 10)) items.emplace_back(made[1][tier], n);
+    copper = copper / 3 + lvl * lvl * 4;                      // most of a wagon's worth is in the goods themselves
+    text = Acore::StringFormat("The wagons from {} are yours. You go through them: {}.", SiteName(c->from), Cargo(*c));
+    Log(EventType::Caravan, *g, c->to, Acore::StringFormat("The caravan from {} to {} was waylaid, its guards cut down and its wagons emptied - by an enemy of {}'s people.",
+        SiteName(c->from), SiteName(c->to), SiteName(c->from)), true);
+    c->state = 4; c->goods.fill(0); c->made.fill(0);
+    for (SimErrand& e : _errands) if (e.id == c->errand && !e.done) { e.done = true; e.expires = _clock; }
+    return true;
+}
+
 } // namespace SoloSim
