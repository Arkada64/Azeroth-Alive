@@ -511,14 +536,27 @@ void World::GeneratePopulation(uint32 count)
 
 // A save made before zones were added to the region: map the new zones (hubs, hunting grounds) and move people into
 // their towns - adventurers at the level of the land around each town, dwarves and gnomes in the dwarven lands.
+// towns inside the Horde's capitals belong to the city, not the zone outside it (see CAPITALS). Idempotent.
+void World::FileCapitals()
+{
+    uint32 moved = 0;
+    for (SimSite& s : _sites)
+        for (Capital const& c : CAPITALS)
+            if (c.radius > 0.0f && s.type == SiteType::Hub && s.map == c.map && s.zone != c.zone && Dist2d(s.x, s.y, c.x, c.y) <= c.radius)
+            { s.zone = c.zone; ++moved; }
+    if (moved) LOG_INFO("server.loading", "SoloWoW sim: {} towns filed under their capital (Orgrimmar, the Undercity, Thunder Bluff)", moved);
+}
+
 void World::ExpandRegion()
 {
+    FileCapitals();
     std::set<uint32> have, missing;
     for (SimSite const& s : _sites) have.insert(s.zone);
     for (uint32 z : REGION_ZONES) if (!have.contains(z)) missing.insert(z);
     if (missing.empty()) return;
     uint32 firstNew = _nextSite;
     BootstrapSites(missing);
+    FileCapitals();                                     // the new towns too, before they're sized and settled
     LOG_INFO("server.loading", "SoloWoW sim: the world grew by {} zones", uint32(missing.size()));
     SettleNewHubs(firstNew);
 }
