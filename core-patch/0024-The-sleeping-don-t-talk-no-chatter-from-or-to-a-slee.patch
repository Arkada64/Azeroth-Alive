From e98ac930fac3c76a3587afde75b9b4eb71a13a4b Mon Sep 17 00:00:00 2001
From: Arkada64 <166951731+Arkada64@users.noreply.github.com>
Date: Tue, 17 Nov 2026 07:06:19 -0600
Subject: [PATCH 24/26] The sleeping don't talk: no chatter from (or to) a
 sleeping adventurer or townsperson

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JU37XfnHTvru3VVz2sNN7z
---
 src/server/game/AI/NpcBots/botbubble.cpp      | 1 +
 src/server/game/SoloSim/solosim.cpp           | 6 ++++--
 src/server/game/SoloSim/solosim_civilians.cpp | 1 +
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/server/game/AI/NpcBots/botbubble.cpp b/src/server/game/AI/NpcBots/botbubble.cpp
index 58a13f1..abe7e65 100644
--- a/src/server/game/AI/NpcBots/botbubble.cpp
+++ b/src/server/game/AI/NpcBots/botbubble.cpp
@@ -280,6 +280,7 @@ namespace
             for (auto const& [entry, agent] : simEntryToAgent)
                 if (Creature* bot = const_cast<Creature*>(BotDataMgr::FindBot(entry)); bot && bot->IsInWorld() && bot->IsAlive() && bot->IsFreeBot()
                     && bot->GetMapId() == mapId && !bot->IsInCombat() && bot->GetExactDist(player) < 30.0f
+                    && bot->GetStandState() != UNIT_STAND_STATE_SLEEP                      // the sleeping don't talk (Nov 17)
                     && GetMSTimeDiffToNow(saidAt[entry]) > 60000)
                     nearBodies.emplace_back(bot, agent);
             if (!nearBodies.empty())
diff --git a/src/server/game/SoloSim/solosim.cpp b/src/server/game/SoloSim/solosim.cpp
index 6493191..e54a6f0 100644
--- a/src/server/game/SoloSim/solosim.cpp
+++ b/src/server/game/SoloSim/solosim.cpp
@@ -5344,10 +5344,12 @@ std::string World::AdventurerChatter(uint32 agentId, uint32 otherAgentId)
 {
     std::lock_guard<std::mutex> guard(sBodyLock);
     SimAgent const* a = AgentById(agentId);
-    if (!a || a->role != ROLE_ADVENTURER) return "";
+    if (!a || a->role != ROLE_ADVENTURER || a->doing == Verb::Sleep) return "";   // asleep: not a word (Nov 17)
     Rng r(_seed, agentId, _clock * 7 + otherAgentId, P_SOCIAL + 950);
     auto pick = [&r](std::initializer_list<char const*> l) { return std::string(*(l.begin() + r.Range(0, uint32(l.size()) - 1))); };
-    if (SimAgent const* o = otherAgentId ? AgentById(otherAgentId) : nullptr)
+    SimAgent const* o = otherAgentId ? AgentById(otherAgentId) : nullptr;
+    if (o && (o->doing == Verb::Sleep || (o->role == ROLE_CIVILIAN && Asleep(*o, _clock)))) o = nullptr;   // nobody talks to the sleeping - about their own day instead
+    if (o)
     {
         int8 kind = 0;
         for (SimRelation const& rel : _relations)
diff --git a/src/server/game/SoloSim/solosim_civilians.cpp b/src/server/game/SoloSim/solosim_civilians.cpp
index 218e9d7..c390656 100644
--- a/src/server/game/SoloSim/solosim_civilians.cpp
+++ b/src/server/game/SoloSim/solosim_civilians.cpp
@@ -442,6 +442,7 @@ namespace
         void Chatter(Creature* npc)
         {
             if (GetMSTimeDiffToNow(_lastSaid) < 60000 && _lastSaid) return;
+            if (me->GetStandState() == UNIT_STAND_STATE_SLEEP) return;               // asleep (Nov 17)
             if (!me->SelectNearestPlayer(25.0f) || urand(1, 100) > 40) return;
             _lastSaid = getMSTime();
             uint8 job = 0; uint32 agent = _agent;
-- 
