diff --git a/src/server/game/SoloSim/solosim.cpp b/src/server/game/SoloSim/solosim.cpp
index bc367ba..01709ff 100644
--- a/src/server/game/SoloSim/solosim.cpp
+++ b/src/server/game/SoloSim/solosim.cpp
@@ -3950,9 +3950,36 @@ uint32 World::HubNear(uint32 map, float x, float y, float range) const
 
 void World::RememberPlayer(SimAgent& a, uint32 guid, int8 valence, uint8 intensity, EventType why)
 {
+    // the Alliance and the Horde are at war: the other side's people never warm to you, whatever you did near them
+    // (Nov 17). Neutral goblins and the like count as their race's side; only hostile memories cross the line.
+    if (valence > 0)
+    {
+        std::lock_guard<std::mutex> g(_sideLock);
+        if (auto it = _playerHorde.find(guid); it != _playerHorde.end() && it->second != IsHordeRace(a.race)) return;
+    }
     _memories.push_back({ a.id, 4, guid, uint8(why), valence, intensity, _clock });
 }
 
+void World::NotePlayerSide(uint32 guid, bool horde)
+{
+    {
+        std::lock_guard<std::mutex> g(_sideLock);
+        auto it = _playerHorde.find(guid);
+        if (it != _playerHorde.end() && it->second == horde) return;
+        _playerHorde[guid] = horde;
+    }
+    // first sight of this player (or a side change): goodwill the other side's people held from before is forgotten
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    size_t before = _memories.size();
+    std::erase_if(_memories, [&](SimMemory const& m) {
+        if (m.subjectType != 4 || m.subject != guid || m.valence <= 0) return false;
+        SimAgent const* a = AgentById(m.agent);
+        return a && IsHordeRace(a->race) != horde;
+    });
+    if (before != _memories.size())
+        LOG_INFO("server.loading", "SoloWoW sim: {} kind memories of player {} held by the other side's people forgotten (the war)", before - _memories.size(), guid);
+}
+
