+        if (IsHordeRace(a->race) != IsHordeRace(o->race)) return "";
         bool grudge = a->ambition == AmbitionType::Revenge && a->avengeFor == o->id;
         if (grudge) return Acore::StringFormat("{}. I haven't forgotten.", o->given);
-        if (foe) return pick({ "Keep walking.", "Not here. Not today.", "Your lot shouldn't be this far out." });
         if (kind == 2) return Acore::StringFormat(pick({ "Oh. {}.", "Still breathing, {}? Pity.", "Find your own spot, {}." }), o->given);
         if (kind == 1 || kind == 3)
             return Acore::StringFormat(pick({ "{}! Still alive, I see.", "Drinks later, {}? You're buying.", "Watch my back out there, {}.",
