+// SoloWoW: camping (Nov 17), after the idea in WoW Forever, built from what 3.3.5 already has.
+// A campfire - your own Basic Campfire, or one the sim's people have lit for the night - is a place to rest:
+//   - near it you are resting (rested XP builds as at an inn; log out there and you rest as at an inn);
+//   - sit by it for a minute and you get an hour of Cozy Fire (Spirit, by level; more for a good cook),
+//     and what you know helps: a smith mends their gear by the fire, someone with first aid sees to their wounds.
+#include "Chat.h"
+#include "GameObject.h"
+#include "Player.h"
+#include "SpellAuraEffects.h"
+#include "SpellAuras.h"
+#include "Timer.h"
+#include <mutex>
+#include <unordered_map>
+
+namespace SoloCamp
+{
+    namespace
+    {
+        constexpr uint32 FIRES[] = { 29784, 31511 };        // Basic Campfire, Bright Campfire
+        constexpr uint32 COZY_HOUR = 7358;                  // Cozy Fire (the second one; the fire's own aura is 7353)
+        constexpr float FIRE_RANGE = 7.0f;
+        std::unordered_map<uint32, uint32> sitSince;         // player guid -> ms they sat down by the fire
+        std::mutex campLock;
+    }
+
+    void Tick(Player* player)
+    {
+        if (!player || !player->IsInWorld())
+            return;
+        GameObject* fire = nullptr;
+        for (uint32 entry : FIRES)
+            if ((fire = player->FindNearestGameObject(entry, FIRE_RANGE, true)))
+                break;
+        bool at = fire && player->IsAlive() && !player->IsInCombat();
+        if (at && !player->HasRestFlag(REST_FLAG_AT_CAMP))
+        {
+            player->SetRestFlag(REST_FLAG_AT_CAMP);
+            ChatHandler(player->GetSession()).SendSysMessage("You settle in by the fire. (Resting)");
+        }
+        else if (!at && player->HasRestFlag(REST_FLAG_AT_CAMP))
+            player->RemoveRestFlag(REST_FLAG_AT_CAMP);
+
+        uint32 guid = player->GetGUID().GetCounter();
+        std::lock_guard<std::mutex> guard(campLock);
+        if (!at || !player->IsSitState())
+        {
+            sitSince.erase(guid);
+            return;
+        }
+        uint32 now = getMSTime();
+        auto [it, fresh] = sitSince.try_emplace(guid, now);
+        if (fresh || getMSTimeDiff(it->second, now) < 60000)
+            return;
+        it->second = now;                                   // once a minute at most
+        if (Aura const* have = player->GetAura(COZY_HOUR); have && have->GetDuration() > int32(50 * MINUTE * IN_MILLISECONDS))
+            return;                                         // already rested here not long ago
+
+        bool cook = player->GetSkillValue(SKILL_COOKING) >= 75;
+        int32 spirit = 2 + int32(player->GetLevel()) / 5;
+        if (cook) spirit += spirit / 2;
+        if (Aura* aura = player->AddAura(COZY_HOUR, player))
+        {
+            aura->SetMaxDuration(int32(HOUR * IN_MILLISECONDS));
+            aura->SetDuration(int32(HOUR * IN_MILLISECONDS));
+            if (AuraEffect* eff = aura->GetEffect(EFFECT_0))
+                eff->ChangeAmount(spirit);
+        }
+        std::string perks;
+        if (player->HasSkill(SKILL_BLACKSMITHING))
+        {
+            player->DurabilityRepairAll(false, 0.0f, false);
+            perks += " You mend your gear by the fire.";
+        }
+        if (player->HasSkill(SKILL_FIRST_AID) && player->GetHealth() < player->GetMaxHealth())
+        {
+            player->SetFullHealth();
+            perks += " You see to your wounds.";
+        }
+        if (cook)
+            perks += " And a proper meal off the fire.";
+        ChatHandler(player->GetSession()).PSendSysMessage("You rest a while by the fire: Cozy Fire, +{} Spirit for an hour.{}", spirit, perks);
+    }
+}
