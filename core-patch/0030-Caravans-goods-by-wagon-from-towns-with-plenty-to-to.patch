+// =====================================================================================================
+// caravans (Nov 17): goods on the road. A town with plenty in its market or on its crafters' shelves sends a trader's
+// wagon to a town that's short, a long day's road away at a wagon's pace (about 2.6 yd/s), with two to four of the
+// town's adventurers hired to guard it. The guards travel as one: the same legs, the same stop for the night (an inn on
+// the way, else a camp), the same arrival. A bandit camp by the road may fall on it - beaten off, or the wagons emptied
+// and the price on that camp raised. At the end the goods go into the town's market and shelves, and the guards are paid.
+// =====================================================================================================
+namespace
+{
+    constexpr uint32 WAGON_NUM = 17, WAGON_DEN = 10;      // wagon minutes = foot minutes x 1.7
+    std::string Cargo(SimCaravan const& c)
+    {
+        static char const* const goods[5] = { "", "ore", "herbs", "hides", "fish" };
+        static char const* const made[4] = { "potions", "food", "arms", "leather goods" };
+        std::vector<std::pair<uint32, std::string>> parts;          // what there's most of, first
+        for (uint8 p = 1; p < 5; ++p) if (c.goods[p] >= 5) parts.emplace_back(c.goods[p], goods[p]);
+        for (uint8 k = 0; k < 4; ++k) if (c.made[k] >= 3) parts.emplace_back(c.made[k] * 3, made[k]);   // made things count for more
+        if (parts.empty()) return "odds and ends";
+        std::ranges::stable_sort(parts, [](auto const& x, auto const& y) { return x.first > y.first; });
+        size_t n = std::min<size_t>(parts.size(), 3);
+        std::string out;
+        for (size_t i = 0; i < n; ++i) out += (i == 0 ? "" : i + 1 == n ? " and " : ", ") + parts[i].second;
+        return parts.size() > n ? out + ", among other things" : out;
+    }
+}
+
+SimCaravan* World::CaravanOf(SimAgent const& a)
+{
+    if (!a.caravan) return nullptr;
+    for (SimCaravan& c : _caravans) if (c.id == a.caravan) return &c;
+    return nullptr;
+}
+
+void World::CaravanTick()
+{
+    auto names = [this](SimCaravan const& c) {
+        std::string out;
+        for (size_t i = 0; i < c.guards.size(); ++i)
+            if (SimAgent const* g = AgentById(c.guards[i]))
+                out += (out.empty() ? "" : i + 1 == c.guards.size() ? " and " : ", ") + g->FullName();
+        return out;
+    };
+    // the road takes its toll: guards beaten, fallen or hired away leave the caravan; with none left, it's lost
+    for (auto it = _caravans.begin(); it != _caravans.end();)
+    {
+        SimCaravan& c = *it;
+        std::erase_if(c.guards, [&](uint32 id) {
+            SimAgent* g = AgentById(id);
+            bool ok = g && g->status == AgentStatus::Active && g->caravan == c.id;
+            if (!ok && g && g->caravan == c.id) g->caravan = 0;
+            return !ok;
+        });
+        if (c.guards.empty())
+        {
+            if (c.state == 0)
+                Log(EventType::Caravan, Nobody(), c.to, Acore::StringFormat("The caravan from {} to {} never arrived. Its guards fell on the road, and its {} with them.",
+                    SiteName(c.from), SiteName(c.to), Cargo(c)), true);
+            it = _caravans.erase(it);
+        }
+        else ++it;
+    }
+
+    uint32 hour = HourOf(_clock);
+    if (hour < 6 || hour > 12) return;                     // wagons leave in the morning
+    uint32 towns = 0;
+    for (SimSite const& s : _sites) if (s.type == SiteType::Hub && (s.services & SVC_INN)) ++towns;
+    uint32 cap = std::clamp<uint32>(towns / 12, 2, 10);
+    Rng r(_seed, _clock, uint32(_caravans.size()), P_GEN + 600);
+    // towns with plenty, that haven't a wagon out already
+    std::vector<std::pair<uint32, uint32>> rich;                         // (town, goods + made)
+    for (auto const& [hub, g] : _market)
+    {
+        SimSite const* s = SiteById(hub);
+        if (!s || s->type != SiteType::Hub || !(s->services & SVC_INN)) continue;
+        if (std::ranges::any_of(_caravans, [hub](SimCaravan const& c) { return c.from == hub; })) continue;
+        uint32 goods = g[1] + g[2] + g[3] + g[4], made = 0;
+        if (auto it = _crafted.find(hub); it != _crafted.end()) for (uint32 v : it->second) made += v;
+        if (goods >= 60 || made >= 40) rich.emplace_back(hub, goods + made);
+    }
+    for (size_t i = rich.size(); i > 1; --i) std::swap(rich[i - 1], rich[r.Range(0, uint32(i) - 1)]);   // in no order
+    uint32 started = 0;
+    for (auto const& [from, stock] : rich)
+    {
+        if (_caravans.size() >= cap || started >= 2) break;
+        if (!r.Chance(0.35f)) continue;
+        SimSite const& f = *SiteById(from);
+        // guards: the town's own adventurers within a short walk, with nothing pressing, who like coin or the road
+        std::vector<std::pair<SimAgent*, uint32>> idle;                   // (agent, minutes to the town)
+        for (auto& [id, a] : _agents)
+        {
+            if (a.role != ROLE_ADVENTURER || a.status != AgentStatus::Active || a.caravan || a.bounty || a.party || a.wounds >= 40) continue;
+            if (a.home != from && a.site != from) continue;
+            if (a.doing == Verb::Goto || a.doing == Verb::Sleep || a.greed + a.wanderlust < 80) continue;
+            uint32 m = a.site == from ? 0 : TravelMinutes(a.site, from, a);
+            if (m <= 15) idle.emplace_back(&a, m);
+        }
+        if (idle.size() < 2) continue;
+        std::ranges::sort(idle, [](auto const& x, auto const& y) { return x.first->level != y.first->level ? x.first->level > y.first->level : x.first->id < y.first->id; });
+        SimAgent& lead = *idle[0].first;
+        // a town of the same side (or neutral) that has less than half of this one's stock, a long day's road away
+        std::vector<std::pair<uint32, uint32>> want;
+        for (SimSite const& s : _sites)
+        {
+            if (s.type != SiteType::Hub || !(s.services & SVC_INN) || s.map != f.map || s.id == from) continue;
+            if (!Welcome(lead, s) || (s.side != f.side && s.side != SIDE_NEUTRAL && f.side != SIDE_NEUTRAL)) continue;
+            if (s.regionLevel > lead.level + 3) continue;
+            uint32 have = 0;
+            if (auto it = _market.find(s.id); it != _market.end()) have += it->second[1] + it->second[2] + it->second[3] + it->second[4];
+            if (auto it = _crafted.find(s.id); it != _crafted.end()) for (uint32 v : it->second) have += v;
+            if (have * 2 >= stock) continue;
+            uint32 m = TravelMinutes(from, s.id, lead) * WAGON_NUM / WAGON_DEN;
+            if (m >= 30 && m <= 600) want.emplace_back(s.id, m);
+        }
+        if (want.empty()) continue;
+        auto [to, minutes] = want[r.Range(0, uint32(want.size()) - 1)];
+        ++started;
+
+        SimCaravan c; c.id = _nextCaravan++; c.from = from; c.to = to; c.pay = minutes; c.left = _clock;
+        auto& g = _market[from];
+        for (uint8 p = 1; p < PROF_COUNT; ++p) { c.goods[p] = g[p] / 2; g[p] -= c.goods[p]; }
+        auto& made = _crafted[from];
+        for (uint8 k = 0; k < CRAFT_COUNT; ++k) { c.made[k] = made[k] / 2; made[k] -= c.made[k]; }
+        uint32 want_guards = 2 + r.Range(0, 2), gather = 1;
+        for (auto const& [a, m] : idle)
+            if (c.guards.size() < want_guards && a->level + 8 >= lead.level && IsHordeRace(a->race) == IsHordeRace(lead.race))   // one side to a wagon
+                { c.guards.push_back(a->id); gather = std::max(gather, m + 1); }
+        if (c.guards.size() < 2) { --_nextCaravan; continue; }
+
+        // the road: on to the end, or (when it runs past nightfall) to an inn or a camp on the way, and on in the morning
+        uint32 tod = (_clock + gather) % MIN_PER_DAY, toNight = tod < 21 * 60 ? 21 * 60 - tod : 0;   // they leave once all are in
+        uint32 stop = minutes > toNight + 20 ? WayStop(lead, from, to, toNight * WAGON_DEN / WAGON_NUM) : 0;
+        std::vector<PlanStep> legs;
+        if (stop)
+        {
+            uint32 leg1 = std::max<uint32>(1, TravelMinutes(from, stop, lead) * WAGON_NUM / WAGON_DEN);
+            uint32 leg2 = std::max<uint32>(1, TravelMinutes(stop, to, lead) * WAGON_NUM / WAGON_DEN);
+            uint32 arrive = (tod + leg1 + 40) % MIN_PER_DAY;
+            uint32 sleep = std::max<uint32>(60, (6 * 60 + MIN_PER_DAY - arrive) % MIN_PER_DAY + r.Range(0, 30));
+            legs = { { Verb::Goto, stop, leg1 }, { Verb::Socialize, stop, 40 }, { Verb::Sleep, stop, sleep }, { Verb::Goto, to, leg2 } };
+        }
+        else
+            legs = { { Verb::Goto, to, minutes } };
+        legs.push_back({ Verb::Trade, to, 30 });
+        for (uint32 id : c.guards)
+            if (SimAgent* a = AgentById(id))
+            {
+                a->plan.clear();
+                uint32 walk = a->site == from ? 0 : std::max<uint32>(1, TravelMinutes(a->site, from, *a));
+                if (walk) a->plan.push_back({ Verb::Goto, from, walk });               // come into town...
+                a->plan.push_back({ Verb::Idle, from, std::max<uint32>(1, gather - walk) });   // ...and wait for the rest
+                a->plan.insert(a->plan.end(), legs.begin(), legs.end());
+                a->caravan = c.id; a->doing = a->plan.front().verb; a->wakeAt = _clock + std::max<uint32>(1, a->plan.front().minutes);   // the first step is under way
+                _requeue.push_back(a->id);
+            }
+        _caravans.push_back(c);
+        Log(EventType::Caravan, lead, from, Acore::StringFormat("A trader's caravan set out from {} for {} with {}, {} guarding it.", SiteName(from), SiteName(to), Cargo(c),
+            names(_caravans.back())), true, 0, int32(minutes));
+    }
+}
+
+void World::CaravanLeg(SimAgent& lead, uint32 from, uint32 to)
+{
+    SimCaravan* c = CaravanOf(lead);
+    if (!c || c->state || c->guards.empty() || c->guards.front() != lead.id) return;
+    SimSite const* f = SiteById(from); SimSite const* t = SiteById(to);
+    if (!f || !t || f->map != t->map) return;
+    for (SimCamp& k : _camps)
+    {
+        if (k.done || k.kind != CAMP_BAND || k.map != f->map || SegDist(k.x, k.y, f->x, f->y, t->x, t->y) > 500.0f) continue;
+        Rng r(_seed, c->id, _clock, P_FIGHT + 910);
+        if (!r.Chance(0.6f)) continue;                     // a wagon's worth robbing - most bands try
+        std::vector<SimAgent*> gs; float guard = 0.0f; std::string who;
+        for (uint32 id : c->guards)
+            if (SimAgent* g = AgentById(id); g && g->status == AgentStatus::Active)
+            {
+                gs.push_back(g);
+                guard += float(g->level) * float(100 - g->wounds) / 100.0f;
+            }
+        for (size_t i = 0; i < gs.size(); ++i) who += (i == 0 ? "" : i + 1 == gs.size() ? " and " : ", ") + gs[i]->FullName();
+        float band = float(k.level) * float(k.alive) * 0.9f;
+        std::string place = AreaOf(SiteName(k.site));
+        if (r.Chance(guard / std::max(1.0f, guard + band)))
+        {
+            uint32 n = std::min<uint32>(k.alive, r.Range(1, 3));
+            for (SimAgent* g : gs) g->wounds = uint8(std::min<uint32>(95, g->wounds + r.Range(5, 20)));
+            Log(EventType::Caravan, lead, to, Acore::StringFormat("{} fell on the caravan from {} to {} near {}. {} drove them off.", Plural(k.name), SiteName(c->from),
+                SiteName(c->to), place, who), true);
+            for (uint32 i = 0; i < n; ++i) CampLossLocked(k, who);
+        }
+        else
+        {
+            c->state = 1; c->goods.fill(0); c->made.fill(0);
+            for (SimAgent* g : gs) g->wounds = uint8(std::min<uint32>(95, g->wounds + r.Range(30, 60)));
+            for (SimBounty& b : _bounties)
+                if (!b.done && b.target == (k.id | CAMP_MARK)) b.reward += b.reward / 2;
+            k.until = std::max<SimTime>(k.until, _clock + 2 * MIN_PER_DAY);
+            Log(EventType::Caravan, lead, to, Acore::StringFormat("{} robbed the caravan from {} to {} near {}. {} limped on behind empty wagons; the price on that camp went up.",
+                Plural(k.name), SiteName(c->from), SiteName(c->to), place, who), true);
+        }
+        return;                                             // one camp a stretch
+    }
+}
+
+void World::CaravanArrive(SimAgent& a)
+{
+    SimCaravan* c = CaravanOf(a);
+    a.caravan = 0;
+    if (!c || a.site != c->to) return;
+    uint32 pay = uint32(a.level) * a.level * 3 + c->pay * a.level / 2 + 100;   // a day's hire, by level and the length of the road
+    if (c->state == 1) pay /= 3;                                                 // robbed: the trader pays what's left
+    a.money += pay;
+    if (c->state == 0)
+    {
+        auto& g = _market[c->to];
+        for (uint8 p = 1; p < PROF_COUNT; ++p) g[p] += c->goods[p];
+        auto& made = _crafted[c->to];
+        for (uint8 k = 0; k < CRAFT_COUNT; ++k) made[k] = std::min<uint32>(CRAFT_CAP, made[k] + c->made[k]);
+        Log(EventType::Caravan, a, c->to, Acore::StringFormat("The caravan from {} came into {} with {}. Its guards were paid off.", SiteName(c->from), SiteName(c->to), Cargo(*c)), true);
+        c->state = 2;
+    }
+    else if (c->state == 1)
+    {
+        Log(EventType::Caravan, a, c->to, Acore::StringFormat("What was left of the caravan from {} limped into {} with nothing to sell.", SiteName(c->from), SiteName(c->to)), true);
+        c->state = 3;
+    }
+    std::erase(c->guards, a.id);
+    if (c->guards.empty())
+        std::erase_if(_caravans, [id = c->id](SimCaravan const& x) { return x.id == id; });
+}
+
 } // namespace SoloSim
