+++ b/src/server/game/SoloSim/solosim_boards.h
@@ -14,6 +14,8 @@ namespace SoloBoards
     void Update(Player* player);                        // world thread: put up boards in inn towns near the player
     // a flag on the player's map and minimap (the guards' direction marker), named
     void SendMarker(Player* player, uint32 map, float x, float y, std::string const& name);
+    // the nearest bounty board that's up within 800 yd: a flag on the map for it; false if none (Nov 17)
+    bool MarkNearestBoard(Player* player);
 }
 
 void AddSC_solosim_boards();
