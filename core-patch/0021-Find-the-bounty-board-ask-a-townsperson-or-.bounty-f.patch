 src/server/game/SoloSim/solosim_civilians.cpp |  9 ++++++++-
 src/server/game/SoloSim/solosim_commands.cpp  |  1 +
 4 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/server/game/SoloSim/solosim_boards.cpp b/src/server/game/SoloSim/solosim_boards.cpp
index 45cea6d..752302b 100644
--- a/src/server/game/SoloSim/solosim_boards.cpp
+++ b/src/server/game/SoloSim/solosim_boards.cpp
@@ -201,6 +201,18 @@ namespace
 
 namespace SoloBoards
 {
+    bool MarkNearestBoard(Player* player)
+    {
+        if (!player) return false;
+        GameObject const* best = nullptr;
+        for (auto const& [town, guid] : boards)
+            if (GameObject const* go = player->GetMap()->GetGameObject(guid))
+                if (go->GetExactDist2d(player) < 800.0f && (!best || go->GetExactDist2d(player) < best->GetExactDist2d(player))) best = go;
+        if (!best) return false;
+        SendMarker(player, player->GetMapId(), best->GetPositionX(), best->GetPositionY(), "Bounty Board");
+        return true;
+    }
+
     void SendMarker(Player* player, uint32 map, float x, float y, std::string const& name)
     {
         if (!player || player->GetMapId() != map) return;           // the flag only makes sense on your own map
@@ -235,7 +247,7 @@ namespace SoloBoards
             if (GameObject* go = map->SummonGameObject(BOARD_ENTRY, spot.GetPositionX(), spot.GetPositionY(), spot.GetPositionZ(), spot.GetOrientation(), 0, 0, 0, 0, 0))
             {
                 boards[town.id] = go->GetGUID();
-                LOG_INFO("server.loading", "SoloWoW: bounty board put up in {}", town.name);
+                LOG_INFO("server.loading", "SoloWoW: bounty board put up in {} at {:.0f} {:.0f} {:.0f}", town.name, spot.GetPositionX(), spot.GetPositionY(), spot.GetPositionZ());
             }
         }
     }
diff --git a/src/server/game/SoloSim/solosim_boards.h b/src/server/game/SoloSim/solosim_boards.h
