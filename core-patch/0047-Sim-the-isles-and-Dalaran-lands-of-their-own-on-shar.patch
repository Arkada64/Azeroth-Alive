+// the gatherers (Nov 18): from the farmhands, labourers and idlers, once - a fisher, an herbalist and a woodcutter in a
+// town of 8, a miner from 10, a trapper from 12. They work where it can be seen (the shore, the herb patches, the trees,
+// the ore by the road) and bring the goods in for the crafters.
+void World::AssignGatherers()
+{
+    uint32 made = 0;
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN)) continue;
+        uint32 folk = TownTarget(h);
+        std::vector<Job> want;
+        if (folk >= 6) want.push_back(JOB_FISHER);
+        if (folk >= 8) { want.push_back(JOB_HERBALIST); want.push_back(JOB_WOODCUTTER); }
+        if (folk >= 10) want.push_back(JOB_MINER);
+        if (folk >= 12) want.push_back(JOB_TRAPPER);
+        for (Job j : want)
+        {
+            bool have = false; SimAgent* pick = nullptr;
+            for (auto& [id, a] : _agents)
+            {
+                if (a.role != ROLE_CIVILIAN || a.home != h.id || a.status == AgentStatus::Dead || a.status == AgentStatus::Gone) continue;
+                if (a.job == j) { have = true; break; }
+                if (!pick && (a.job == JOB_FARMHAND || a.job == JOB_LABORER || a.job == JOB_LOAFER) && Age(a) < 60) pick = &a;
+            }
+            if (have || !pick) continue;
+            pick->job = j; ++made;
+        }
+    }
+    if (made) LOG_INFO("server.loading", "SoloWoW sim: {} townsfolk took up gathering (fishers, herbalists, woodcutters, miners, trappers)", made);
+}
+
+// mercenaries (Nov 18): one at every inn of the land's level, two where the town is bigger - their own people, gear,
+// level and class, about the land's band. They wait about the inn; a player hires them for coin, for a day.
+void World::AssignMercenaries()
+{
+    std::map<uint32, uint32> have;
+    for (auto const& [id, a] : _agents)
+        if (a.job == JOB_MERCENARY && a.status != AgentStatus::Dead && a.status != AgentStatus::Gone) ++have[a.home];
+    uint32 made = 0;
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN) || h.regionLevel < 5 || IsStartCamp(h)) continue;
+        uint32 want = TownTarget(h) >= 14 ? 2 : 1;
+        for (uint32 i = have[h.id]; i < want; ++i)
+        {
+            uint32 id = _nextAgent++;
+            SimAgent a = MakeSettler(h, id, 0x3E5C);
+            a.job = JOB_MERCENARY; a.ambition = AmbitionType::None; a.ambitionTarget = 0;
+            _agents[id] = a;
+            ++made;
+        }
+    }
+    if (made) LOG_INFO("server.loading", "SoloWoW sim: {} mercenaries took rooms at the inns", made);
+}
+
+bool World::IsMercenary(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    return a && a->job == JOB_MERCENARY;
+}
