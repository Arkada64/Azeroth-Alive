+uint32 BotBubble::HireCost(Creature const* bot, uint32 usual)
+{
+    uint32 agent = bot ? SimAgentOf(bot->GetEntry()) : 0;
+    return agent && sSoloSim->IsLive() && sSoloSim->IsMercenary(agent) ? sSoloSim->MercPrice(agent) : usual;
+}
+
+std::string BotBubble::CostText(uint32 c)
+{
+    std::string s;
+    if (c >= 10000) s += std::to_string(c / 10000) + "g ";
+    if (c >= 100 && c / 100 % 100) s += std::to_string(c / 100 % 100) + "s ";
+    if (c % 100 || s.empty()) s += std::to_string(c % 100) + "c";
+    while (!s.empty() && s.back() == ' ') s.pop_back();
+    return s;
+}
