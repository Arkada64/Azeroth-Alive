+uint32 World::MercPrice(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    return a ? std::max<uint32>(500, uint32(a->level) * a->level * 25) : 0;
+}
