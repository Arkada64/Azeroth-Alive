+bool BotBubble::SimGear(uint32 agent, std::vector<GearPiece>& out, uint8& due)
+{
+    std::string gear;
+    if (!sSoloSim->GearOf(agent, gear, due)) return false;
+    std::istringstream in(gear);
+    std::string part;
+    while (std::getline(in, part, ','))
+    {
+        GearPiece g; uint32 slot = 0;
+        if (std::sscanf(part.c_str(), "%u:%u:%d:%u", &slot, &g.entry, &g.suffix, &g.enchant) == 4 && g.entry) { g.slot = uint8(slot); out.push_back(g); }
+    }
+    return true;
+}
+
+void BotBubble::SaveSimGear(Creature const* bot)
+{
+    uint32 agent = bot ? SimAgentOf(bot->GetEntry()) : 0;
+    bot_ai const* ai = bot ? bot->GetBotAI() : nullptr;
+    if (!agent || !ai) return;
+    std::string gear;
+    for (uint8 i = 0; i < BOT_INVENTORY_SIZE; ++i)
+        if (Item const* it = ai->GetEquips(i))
+            gear += Acore::StringFormat("{}{}:{}:{}:{}", gear.empty() ? "" : ",", uint32(i), it->GetEntry(), it->GetItemRandomPropertyId(), it->GetEnchantmentId(PERM_ENCHANTMENT_SLOT));
+    sSoloSim->SetGear(agent, gear);
+}
+
+bool BotBubble::DismissFromParty(Player* player, ObjectGuid guid)
+{
+    if (!player || !guid.IsCreature() || !player->GetBotMgr()) return false;
+    Creature* bot = player->GetBotMgr()->GetBot(guid);
+    if (!bot || !SimAgentOf(bot->GetEntry())) return false;
+    bot->Whisper("Safe travels. You know where to find me.", LANG_UNIVERSAL, player);
+    player->GetBotMgr()->RemoveBot(guid, BOT_REMOVE_DISMISS);
+    return true;
+}
