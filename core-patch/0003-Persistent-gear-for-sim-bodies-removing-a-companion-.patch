+// an adventurer's kit as their body last wore it ("slot:entry:suffix:enchant,..."), and how many pieces are due a change
+bool World::GearOf(uint32 agentId, std::string& gear, uint8& due)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a) return false;
+    gear = a->gear; due = a->gearDue;
+    return true;
+}
+
+void World::SetGear(uint32 agentId, std::string const& gear)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (SimAgent* a = AgentById(agentId)) { a->gear = gear; a->gearDue = 0; }
+}
