+// =====================================================================================================
+// two sides: whose towns are whose, and who is born where
+// =====================================================================================================
+bool World::Welcome(SimAgent const& a, SimSite const& s) const
+{
+    if (s.type != SiteType::Hub || s.side == SIDE_NEUTRAL || a.role == ROLE_THREAT) return true;
+    return s.side == (IsHordeRace(a.race) ? SIDE_HORDE : SIDE_ALLIANCE);
+}
+
+// the people a town is mostly made of (0 = the Alliance mix the caller already knows). Townsfolk can be goblins too;
+// adventurers only come in races NPCBots has bodies for.
+uint8 World::NativeRace(SimSite const& h, Rng& r, bool civilian) const
+{
+    static std::set<uint32> const ORC_LANDS = { 14, 1637 }, TAUREN_LANDS = { 215, 1638 }, FORSAKEN_LANDS = { 85, 1497, 130 };
+    uint32 roll = r.Range(1, 100);
+    if (h.side == SIDE_NEUTRAL)
+        return civilian && roll <= 60 ? 9 : 0;                       // goblin ports: goblins, and whoever passes through
+    if (h.side != SIDE_HORDE) return 0;
+    if (ORC_LANDS.contains(h.zone))      return roll <= 55 ? 2 : roll <= (civilian ? 92u : 100u) ? 8 : 9;
+    if (TAUREN_LANDS.contains(h.zone))   return roll <= 85 ? 6 : roll <= 95 ? 2 : 8;
+    if (FORSAKEN_LANDS.contains(h.zone)) return roll <= 90 ? 5 : roll <= 95 ? 2 : 8;
+    return roll <= 40 ? 2 : roll <= 65 ? 6 : roll <= 85 ? 8 : 5;     // the Barrens and the rest of the Horde's roads
+}
+
+// a world from before the Horde: every town was taken as the Alliance's. Ask the town's own service NPCs whose it is.
+void World::ClassifySides()
+{
+    FactionTemplateEntry const* alliance = sFactionTemplateStore.LookupEntry(1);
+    FactionTemplateEntry const* horde = sFactionTemplateStore.LookupEntry(2);
+    if (!alliance || !horde) return;
+    std::map<uint32, std::array<uint32, 3>> votes;                     // hub -> alliance / horde / neutral services nearby
+    for (auto const& [guid, data] : sObjectMgr->GetAllCreatureData())
+    {
+        if (!SIM_MAPS.contains(data.mapid)) continue;
+        CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(data.id);
+        if (!t || !(t->npcflag & (65536 | 128 | 4096 | 8192 | 16))) continue;
+        FactionTemplateEntry const* ft = sFactionTemplateStore.LookupEntry(t->faction);
+        if (!ft) continue;
+        bool forA = !ft->IsHostileTo(*alliance), forH = !ft->IsHostileTo(*horde);
+        if (!forA && !forH) continue;
+        for (SimSite const& h : _sites)
+            if (h.type == SiteType::Hub && h.map == data.mapid && Dist2d(h.x, h.y, data.posX, data.posY) < 50.0f)
+                ++votes[h.id][forA && forH ? SIDE_NEUTRAL : forA ? SIDE_ALLIANCE : SIDE_HORDE];
+    }
+    uint32 changed = 0;
+    for (SimSite& h : _sites)
+        if (auto it = votes.find(h.id); it != votes.end())
+        {
+            auto const& v = it->second;
+            // many of a town's vendors serve anyone (Goldshire and Stormwind have plenty): only a town with nobody
+            // of either side behind its counters is neutral
+            uint8 side = !v[SIDE_ALLIANCE] && !v[SIDE_HORDE] ? SIDE_NEUTRAL : v[SIDE_HORDE] > v[SIDE_ALLIANCE] ? SIDE_HORDE : SIDE_ALLIANCE;
+            if (side != h.side) { h.side = side; ++changed; }
+        }
+    LOG_INFO("server.loading", "SoloWoW sim: {} towns found to be neutral or the Horde's", changed);
+}
+
+// towns of the zones we already have that the Alliance-only world left out (the Crossroads, Camp Taurajo...)
+void World::AddHordeTowns()
+{
+    std::set<uint32> have;
+    for (SimSite const& s : _sites) have.insert(s.zone);
+    uint32 first = _nextSite;
+    BootstrapSites(have, true);
+    SettleNewHubs(first);
+}
