+﻿// SoloWoW roadside camps in the game world: a sim camp (solosim.cpp PostCamps) is put up for real - a campfire and its
+// band - when a player comes within reach, and taken down again when they leave. Deaths of its members, by anyone,
+// go back to the sim (it remembers how many are left).
+#ifndef SOLOSIM_CAMPS_H
+#define SOLOSIM_CAMPS_H
+
+#include "Define.h"
+#include "ObjectGuid.h"
+
+class Player;
+
+namespace SoloCamps
+{
+    void Update(Player* player);              // world thread, from the bot bubble
+    uint32 CampOf(ObjectGuid const& guid);    // the sim camp a creature belongs to (0 = none)
+    void AddScripts();
+}
+
+#endif
diff --git a/src/server/game/SoloSim/solosim_civilians.cpp b/src/server/game/SoloSim/solosim_civilians.cpp
new file mode 100644
index 0000000..bc2c57e
--- /dev/null
+++ b/src/server/game/SoloSim/solosim_civilians.cpp
@@ -0,0 +1,625 @@
+// SoloWoW townsfolk bodies: plain creatures (not NPCBots - no class kit, no buffing, no adventurer gear) that act out a
+// townsperson's day from the sim: working (fields, timber, market), errands and idling in the square, evenings at the
+// inn, and home to sleep - they walk up to their own house and go in (despawn), and come out of the same door.
+// Each one is a runtime creature template (entry 9,000,000 + sim id) with their own name and job title, borrowing the
+// look of the region's peasants and lumberjacks. See DESIGN.md "Civilians' homes".
+#include "solosim_civilians.h"
+#include "solosim.h"
+#include "botbubble.h"
+#include "CellImpl.h"
+#include "Creature.h"
+#include "CreatureAI.h"
+#include "DBCStores.h"
+#include "GridNotifiers.h"
+#include "GridNotifiersImpl.h"
+#include "Log.h"
+#include "Map.h"
+#include "MapMgr.h"
+#include "ObjectAccessor.h"
+#include "ObjectMgr.h"
+#include "AllCreatureScript.h"
+#include "Chat.h"
+#include "GossipDef.h"
+#include "Player.h"
+#include "ScriptedGossip.h"
+#include "Random.h"
+#include "TemporarySummon.h"
+#include "Timer.h"
+#include <cmath>
+#include <list>
+#include <mutex>
+#include <shared_mutex>
+#include <unordered_map>
+
+using SoloSim::SimBody;
+
+namespace
+{
+    constexpr uint32 ENTRY_BASE = 9000000;
+
+    std::shared_mutex tplLock;
+    std::unordered_map<uint32, CreatureTemplate> templates;     // entry -> template
+    std::unordered_map<uint32, uint32> sourceOf;                // entry -> borrowed template (equipment)
+
+    std::mutex doorLock;
+    std::unordered_map<uint32, Position> doors;                 // sim agent -> their front door
+
+    std::unordered_map<uint32, ObjectGuid> bodies;              // sim agent -> creature (world thread only)
+
+    uint32 Hash(uint32 agent, uint32 salt) { return uint32(SoloSim::Mix((uint64(agent) << 24) ^ salt)); }
+
+    char const* JobTitle(uint8 job, bool veteran = false)
+    {
+        if (veteran) return "Retired Adventurer";
+        switch (job)
+        {
+            case SoloSim::JOB_FARMHAND: return "Farmhand";
+            case SoloSim::JOB_LABORER:  return "Laborer";
+            case SoloSim::JOB_MARKET:   return "Market Hand";
+            default:                    return "Townsfolk";
+        }
+    }
+
+    uint32 EnsureTemplate(SimBody const& b)
+    {
+        uint32 entry = ENTRY_BASE + b.agent;
+        {
+            std::unique_lock lock(tplLock);
+            if (auto it = templates.find(entry); it != templates.end())
+            {
+                // they've grown since we last made their body: the next one comes out at their new level
+                uint8 lvl = std::max<uint8>(1, b.level);
+                if (it->second.minlevel != lvl) it->second.minlevel = it->second.maxlevel = lvl;
+                it->second.SubName = JobTitle(b.job, b.veteran);          // an elder who gave up their work
+                return entry;
+            }
+        }
+        CreatureTemplate const* src = sObjectMgr->GetCreatureTemplate(b.sourceEntry);
+        if (!src || src->Models.empty()) return 0;
+        CreatureTemplate t = *src;
+        t.Entry = entry;
+        t.Name = b.name;
+        t.SubName = JobTitle(b.job, b.veteran);
+        uint32 idx = uint32(SoloSim::Mix(0x5010C0DEull ^ (uint64(b.agent) * 0x27D4EB2Full)) % src->Models.size());
+        // a body of their own sex: the borrowed townsfolk often come in both
+        for (uint32 k = 0; k < src->Models.size(); ++k)
+        {
+            uint32 j = (idx + k) % src->Models.size();
+            CreatureModelInfo const* mi = sObjectMgr->GetCreatureModelInfo(src->Models[j].CreatureDisplayID);
+            if (mi && uint8(mi->gender == 1 ? 1 : 0) == b.gender) { idx = j; break; }
+        }
+        t.Models = { CreatureModel(src->Models[idx].CreatureDisplayID, 1.0f, 1.0f) };
+        t.minlevel = t.maxlevel = std::max<uint8>(1, b.level);
+        t.npcflag = UNIT_NPC_FLAG_GOSSIP | UNIT_NPC_FLAG_QUESTGIVER;   // you can talk to them; some have a request (blue !)
+        t.AIName = "";
+        t.ScriptID = 0;
+        for (uint32& k : t.KillCredit) k = 0;
+        t.InitializeQueryData();
+        std::unique_lock lock(tplLock);
+        templates[entry] = std::move(t);
+        sourceOf[entry] = b.sourceEntry;
+        return entry;
+    }
+
+    // Their house: a spot outdoors, beside a building wall, in town - the same one every time.
+    Position FindDoor(Map* map, uint32 agent, float cx, float cy, float cz)
+    {
+        {
+            std::lock_guard<std::mutex> guard(doorLock);
+            if (auto it = doors.find(agent); it != doors.end()) return it->second;
+        }
+        Position door(cx, cy, cz, 0.0f);
+        uint32 h = Hash(agent, 0xD00);
+        for (uint32 k = 0; k < 64; ++k)
+        {
+            float ang = float((h % 1000) + k * 618) / 1000.0f * 2.0f * float(M_PI);
+            float r = 15.0f + float((h >> 10) % 40 + k * 7 % 45);
+            float x = cx + r * std::cos(ang), y = cy + r * std::sin(ang);
+            float z = map->GetHeight(PHASEMASK_NORMAL, x, y, cz + 10.0f, true, 30.0f);
+            if (z <= INVALID_HEIGHT || std::fabs(z - cz) > 12.0f)
+                continue;
+            PositionFullTerrainStatus terrain;
+            map->GetFullTerrainStatusForPosition(PHASEMASK_NORMAL, x, y, z, 2.0f, terrain);
+            if (!terrain.outdoors || terrain.liquidInfo.Status != LIQUID_MAP_NO_WATER)
+                continue;
+            for (uint32 d = 0; d < 8; ++d)
+            {
+                float da = float(d) * float(M_PI) / 4.0f;
+                if (!map->isInLineOfSight(x, y, z + 1.5f, x + std::cos(da) * 2.5f, y + std::sin(da) * 2.5f, z + 1.5f,
+                    PHASEMASK_NORMAL, LINEOFSIGHT_CHECK_VMAP, VMAP::ModelIgnoreFlags::Nothing))
+                {
+                    door.Relocate(x, y, z, da);                 // facing the wall: their door
+                    std::lock_guard<std::mutex> guard(doorLock);
+                    doors[agent] = door;
+                    return door;
+                }
+            }
+        }
+        std::lock_guard<std::mutex> guard(doorLock);
+        doors[agent] = door;
+        return door;
+    }
+
+    Position DoorOf(uint32 agent)
+    {
+        std::lock_guard<std::mutex> guard(doorLock);
+        auto it = doors.find(agent);
+        return it == doors.end() ? Position() : it->second;
+    }
+
+    class NpcNear
+    {
+    public:
+        NpcNear(Unit const* me, float x, float y, float range, uint32 flags) : _me(me), _x(x), _y(y), _range(range), _flags(flags) { }
+        bool operator()(Creature* c) const
+        {
+            if (!c || !c->IsAlive() || c->IsNPCBotOrPet() || c->isMoving() || c->IsHostileTo(_me)) return false;
+            CreatureTemplate const* t = c->GetCreatureTemplate();
+            return t && (t->npcflag & _flags) && c->GetExactDist2d(_x, _y) <= _range;
+        }
+    private:
+        Unit const* _me; float _x, _y, _range; uint32 _flags;
+    };
+
+    // ------------------------------------------------------------------------------------------------- the body
+    class TownsfolkAI : public CreatureAI
+    {
+    public:
+        TownsfolkAI(Creature* c, uint32 agent) : CreatureAI(c), _agent(agent) { }
+
+        void InitializeAI() override
+        {
+            me->SetWalk(true);
+            uint32 src = 0;
+            {
+                std::shared_lock lock(tplLock);
+                if (auto it = sourceOf.find(me->GetEntry()); it != sourceOf.end()) src = it->second;
+            }
+            int8 id = 1;
+            if (EquipmentInfo const* e = sObjectMgr->GetEquipmentInfo(src, id))
+                for (uint8 i = 0; i < MAX_EQUIPMENT_ITEMS; ++i)
+                    me->SetVirtualItem(i, e->ItemEntry[i]);
+            _timer = urand(500, 3000);
+        }
+
+        void JustDied(Unit* killer) override
+        {
+            std::string who = killer ? std::string(killer->GetName()) : std::string("something");
+            if (killer && killer->IsCreature() && !killer->IsNPCBotOrPet()) who = "a " + who;
+            BotBubble::ReportFallen(_agent, who);
+        }
+
+        void KilledUnit(Unit* victim) override
+        {
+            if (victim && victim->IsCreature() && !victim->IsNPCBotOrPet())
+                sSoloSim->CivilianFought(_agent);
+        }
+
+        // after a fight: carry on from where they stand (not back to the door they stepped out of)
+        void EnterEvadeMode(EvadeReason why) override
+        {
+            if (!_EnterEvadeMode(why)) return;
+            me->GetMotionMaster()->Clear();
+            me->GetMotionMaster()->MoveIdle();
+            _moving = false; _following = false;
+            _timer = 1500;
+        }
+
+        // the player just took them on (an escort): stop what they're doing and look to the player
+        void Wake() { me->GetMotionMaster()->Clear(); me->GetMotionMaster()->MoveIdle(); _moving = false; _following = false; _home = false; _timer = 500; }
+
+        void MovementInform(uint32 type, uint32 id) override
+        {
+            if (type == POINT_MOTION_TYPE && id == 1 && _moving)
+            {
+                _moving = false;
+                Arrived();
+            }
+        }
+
+        void UpdateAI(uint32 diff) override
+        {
+            if (UpdateVictim())
+            {
+                DoMeleeAttackIfReady();
+                return;
+            }
+            if (_timer > diff) { _timer -= diff; return; }
+            _timer = 0;
+            if (_moving)
+            {
+                if (GetMSTimeDiffToNow(_moveStart) < 45000 && me->isMoving()) { _timer = 1000; return; }
+                _moving = false;                                   // stuck or arrived without word: carry on
+                Arrived();
+                return;
+            }
+            Next();
+        }
+
+    private:
+        void Go(Position const& p, uint32 stay, uint8 stand = UNIT_STAND_STATE_STAND, uint32 emoteState = 0, float face = -1.0f, ObjectGuid npc = ObjectGuid::Empty)
+        {
+            BotBubble::ReleaseInnSeat(me->GetEntry());
+            me->SetStandState(UNIT_STAND_STATE_STAND);
+            me->SetEmoteState(EMOTE_ONESHOT_NONE);
+            me->SetWalk(true);
+            _stay = stay; _stand = stand; _emote = emoteState; _face = face; _npc = npc;
+            _moving = true;
+            _moveStart = getMSTime();
+            me->GetMotionMaster()->MovePoint(1, p);
+            _timer = 1000;
+        }
+
+        void Arrived()
+        {
+            if (_home)
+            {
+                me->DespawnOrUnsummon(1s);                        // in through their door
+                return;
+            }
+            if (_npc)
+                if (Creature* npc = ObjectAccessor::GetCreature(*me, _npc); npc && me->GetExactDist2d(npc) < 8.0f)
+                {
+                    me->SetFacingToObject(npc);
+                    me->HandleEmoteCommand(urand(0, 2) ? EMOTE_ONESHOT_TALK : EMOTE_ONESHOT_POINT);
+                }
+            if (_face >= 0.0f) me->SetFacingTo(_face);
+            if (_stand != UNIT_STAND_STATE_STAND) me->SetStandState(_stand);
+            if (_emote) me->SetEmoteState(Emote(_emote));
+            _timer = std::max<uint32>(1000, _stay);
+        }
+
+        bool RandomNear(float cx, float cy, float cz, float minR, float maxR, Position& out)
+        {
+            Map* map = me->GetMap();
+            for (int attempt = 0; attempt < 8; ++attempt)
+            {
+                float dist = minR + rand_norm() * (maxR - minR);
+                float ang = float(rand_norm()) * 2.0f * float(M_PI);
+                float x = cx + dist * std::cos(ang), y = cy + dist * std::sin(ang), z = cz;
+                float ground = map->GetHeight(me->GetPhaseMask(), x, y, z + 5.0f);
+                if (ground <= INVALID_HEIGHT) continue;
+                z = ground;
+                if (!map->CanReachPositionAndGetValidCoords(me, x, y, z)) continue;
+                if (map->IsInWater(me->GetPhaseMask(), x, y, z, me->GetCollisionHeight())) continue;
+                out.Relocate(x, y, z, frand(0.0f, 2.0f * float(M_PI)));
+                return true;
+            }
+            return false;
+        }
+
+        Creature* SomeNpc(float x, float y, uint32 flags)
+        {
+            std::list<Creature*> found;
+            NpcNear check(me, x, y, 60.0f, flags);
+            Acore::CreatureListSearcher<NpcNear> searcher(me, found, check);
+            Cell::VisitObjects(me, searcher, 60.0f + me->GetExactDist2d(x, y));
+            if (found.empty()) return nullptr;
+            auto it = found.begin();
+            std::advance(it, urand(0, uint32(found.size()) - 1));
+            return *it;
+        }
+
+        Position InFrontOf(Creature* npc)
+        {
+            float ang = npc->GetAngle(me) + frand(-0.6f, 0.6f);
+            float d = frand(2.0f, 3.5f);
+            float x = npc->GetPositionX() + std::cos(ang) * d, y = npc->GetPositionY() + std::sin(ang) * d, z = npc->GetPositionZ();
+            if (!npc->GetMap()->CheckCollisionAndGetValidCoords(npc, npc->GetPositionX(), npc->GetPositionY(), npc->GetPositionZ(), x, y, z))
+            { x = npc->GetPositionX(); y = npc->GetPositionY(); }
+            return Position(x, y, z, 0.0f);
+        }
+
+        void Next()
+        {
+            using SoloSim::Verb;
+            SoloSim::SimIntent in;
+            bool known = sSoloSim->Intent(_agent, in);
+            if (known && in.escort && Escort(in))
+                return;
+            if (!known || in.verb == Verb::Sleep)
+            {
+                // home time: walk to their own door and go in
+                Position door = DoorOf(_agent);
+                if (door.GetPositionX() == 0.0f && door.GetPositionY() == 0.0f) { me->DespawnOrUnsummon(1s); return; }
+                _home = true;
+                Go(door, 0);
+                return;
+            }
+            Position p;
+            float cx = in.homeX, cy = in.homeY, cz = in.homeZ;
+            switch (in.verb)
+            {
+                case Verb::Work:
+                    if (in.job == SoloSim::JOB_FARMHAND && RandomNear(cx, cy, cz, 35.0f, 80.0f, p))
+                        return Go(p, urand(40000, 90000), UNIT_STAND_STATE_STAND, urand(0, 1) ? EMOTE_STATE_WORK : EMOTE_STATE_USE_STANDING);
+                    if (in.job == SoloSim::JOB_LABORER && RandomNear(cx, cy, cz, 15.0f, 55.0f, p))
+                        return Go(p, urand(40000, 90000), UNIT_STAND_STATE_STAND, urand(0, 1) ? EMOTE_STATE_WORK_CHOPWOOD : EMOTE_STATE_WORK);
+                    if (Creature* npc = SomeNpc(cx, cy, UNIT_NPC_FLAG_VENDOR | UNIT_NPC_FLAG_REPAIR))
+                        return Go(InFrontOf(npc), urand(30000, 60000), UNIT_STAND_STATE_STAND, 0, -1.0f, npc->GetGUID());
+                    break;
+                case Verb::Socialize:
+                case Verb::Recover:
+                {
+                    uint8 stand = UNIT_STAND_STATE_SIT;
+                    if (BotBubble::ClaimInnSeat(me, _agent, cx, cy, p, stand))
+                        return Go(p, urand(60000, 180000), stand, 0, p.GetOrientation());
+                    break;
+                }
+                case Verb::Trade:
+                    if (Creature* npc = SomeNpc(cx, cy, UNIT_NPC_FLAG_VENDOR))
+                        return Go(InFrontOf(npc), urand(15000, 35000), UNIT_STAND_STATE_STAND, 0, -1.0f, npc->GetGUID());
+                    break;
+                default:
+                    if (urand(0, 99) < 35)
+                        if (Creature* npc = SomeNpc(cx, cy, 0xFFFFFFFF))
+                            return Go(InFrontOf(npc), urand(10000, 25000), UNIT_STAND_STATE_STAND, 0, -1.0f, npc->GetGUID());
+                    break;
+            }
+            if (RandomNear(cx, cy, cz, 5.0f, 28.0f, p))
+                return Go(p, urand(8000, 25000), urand(0, 4) ? UNIT_STAND_STATE_STAND : UNIT_STAND_STATE_SIT);
+            _timer = 5000;
+        }
+
+        // being walked to another town: keep close to the player; wait where they are if left behind
+        bool Escort(SoloSim::SimIntent const& in)
+        {
+            _home = false;
+            if (in.escortState == 2)
+            {
+                // there: stay put until paid (and look about the place)
+                if (_following) { me->GetMotionMaster()->Clear(); me->GetMotionMaster()->MoveIdle(); _following = false; }
+                me->SetWalk(true);
+                _timer = 5000;
+                return true;
+            }
+            Player* p = ObjectAccessor::FindConnectedPlayer(ObjectGuid::Create<HighGuid::Player>(in.escort));
+            bool close = p && p->IsInWorld() && p->IsAlive() && p->GetMap() == me->GetMap() && me->GetExactDist2d(p) < 70.0f;
+            if (!close)
+            {
+                if (_following)
+                {
+                    me->GetMotionMaster()->Clear(); me->GetMotionMaster()->MoveIdle(); _following = false;
+                    me->Say(urand(0, 1) ? "Wait - where did you go? I'll stay here." : "I'll wait here for you. Don't be long.", LANG_UNIVERSAL);
+                }
+                _timer = 3000;
+                return true;
+            }
+            if (me->GetExactDist2d(in.destX, in.destY) < 45.0f && p->GetExactDist2d(in.destX, in.destY) < 60.0f)
+            {
+                if (sSoloSim->EscortArrived(_agent, in.escort))
+                {
+                    me->GetMotionMaster()->Clear(); me->GetMotionMaster()->MoveIdle(); _following = false;
+                    me->SetFacingToObject(p);
+                    me->Say("We made it. Come and see me before you go.", LANG_UNIVERSAL, p);
+                    p->PlayerTalkClass->SendQuestGiverStatus(uint8(SoloCivilians::DialogStatus(p, me)), me->GetGUID());
+                }
+                _timer = 3000;
+                return true;
+            }
+            if (!_following || me->GetMotionMaster()->GetCurrentMovementGeneratorType() != FOLLOW_MOTION_TYPE)
+            {
+                BotBubble::ReleaseInnSeat(me->GetEntry());
+                me->SetStandState(UNIT_STAND_STATE_STAND);
+                me->SetEmoteState(EMOTE_ONESHOT_NONE);
+                me->SetWalk(false);                                 // keeping up with someone on the road
+                me->GetMotionMaster()->Clear();
+                me->GetMotionMaster()->MoveFollow(p, 2.5f, float(M_PI) * 0.75f);
+                _following = true;
+            }
+            _timer = 2000;
+            return true;
+        }
+
+        uint32 _agent;
+        uint32 _timer = 0, _stay = 0, _emote = 0, _moveStart = 0;
+        uint8 _stand = UNIT_STAND_STATE_STAND;
+        float _face = -1.0f;
+        ObjectGuid _npc;
+        bool _moving = false, _home = false, _following = false;
+    };
+}
+
+// ----------------------------------------------------------------------------------------------- talking to them
+namespace
+{
+    enum : uint32 { ACT_NEWS = 1, ACT_TAKE = 2, ACT_FINISH = 3, ACT_REMIND = 4, ACT_BYE = 5, ACT_ASK = 6, ACT_ADVICE = 7 };
+
+    uint32 AgentOf(Creature const* c) { return c && c->GetEntry() >= ENTRY_BASE && c->GetEntry() < ENTRY_BASE + 100000 ? c->GetEntry() - ENTRY_BASE : 0; }
+
+    // a request is ready to hand in: cull progress done, or the goods are in the player's bags
+    bool Ready(Player* player, SoloSim::SimErrand const& e)
+    {
+        if (e.kind != SoloSim::ERRAND_FETCH) return e.progress >= e.count;
+        return player->GetItemCount(e.item) >= e.count;
+    }
+
+    void ShowMenu(Player* player, Creature* c)
+    {
+        uint32 agent = AgentOf(c);
+        ClearGossipMenuFor(player);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "What's the news?", GOSSIP_SENDER_MAIN, ACT_NEWS);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Have you seen someone?", GOSSIP_SENDER_MAIN, ACT_ASK, "Who are you looking for?", 0, true);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Any advice for the road?", GOSSIP_SENDER_MAIN, ACT_ADVICE);
+        SoloSim::SimErrand e;
+        if (sSoloSim->ErrandFor(agent, e))
+        {
+            uint32 guid = player->GetGUID().GetCounter();
+            if (!e.player)
+                AddGossipItemFor(player, GOSSIP_ICON_TALK, sSoloSim->ErrandText(e), GOSSIP_SENDER_MAIN, ACT_TAKE);
+            else if (e.player == guid)
+            {
+                if (Ready(player, e))
+                    AddGossipItemFor(player, GOSSIP_ICON_INTERACT_1, e.kind == SoloSim::ERRAND_MISSING ? "I found where they fell." : e.kind == SoloSim::ERRAND_MESSAGE ? "I passed on your message."
+                        : e.kind == SoloSim::ERRAND_STOLEN ? "I got it back." : e.kind == SoloSim::ERRAND_OLDFOE ? "It's dead." : e.kind == SoloSim::ERRAND_ESCORT ? "Here we are." : "Here's what you asked for.", GOSSIP_SENDER_MAIN, ACT_FINISH);
+                else
+                    AddGossipItemFor(player, GOSSIP_ICON_CHAT, e.kind == SoloSim::ERRAND_MESSAGE ? std::string("I haven't found them yet.") :
+                        e.kind == SoloSim::ERRAND_MISSING ? std::string("I'm still looking.") :
+                        e.kind == SoloSim::ERRAND_STOLEN ? Acore::StringFormat("I'm still after {}.", SoloSim::StolenThing(e.id)) :
+                        e.kind == SoloSim::ERRAND_ESCORT ? std::string("Stay close. We'll get there.") :
+                        e.kind == SoloSim::ERRAND_OLDFOE ? std::string("I'm still hunting it.") : e.kind == SoloSim::ERRAND_CULL
+                        ? Acore::StringFormat("About those pests... ({}/{})", e.progress, e.count)
+                        : Acore::StringFormat("About what you asked for... ({}/{})", std::min<uint32>(player->GetItemCount(e.item), e.count), e.count),
+                        GOSSIP_SENDER_MAIN, ACT_REMIND);
+            }
+        }
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Good day.", GOSSIP_SENDER_MAIN, ACT_BYE);
+        SendGossipMenuFor(player, DEFAULT_GOSSIP_MESSAGE, c->GetGUID());
+    }
+
+    void Refresh(Player* player, Creature* c)
+    {
+        player->PlayerTalkClass->SendQuestGiverStatus(uint8(SoloCivilians::DialogStatus(player, c)), c->GetGUID());
+    }
+
+    class solosim_townsfolk_talk : public AllCreatureScript
+    {
+    public:
+        solosim_townsfolk_talk() : AllCreatureScript("solosim_townsfolk_talk") { }
+
+        bool CanCreatureGossipHello(Player* player, Creature* c) override
+        {
+            if (!AgentOf(c)) return false;
+            c->StopMoving();
+            c->SetFacingToObject(player);
+            ShowMenu(player, c);
+            return true;
+        }
+
+        bool CanCreatureGossipSelect(Player* player, Creature* c, uint32 /*sender*/, uint32 action) override
+        {
+            uint32 agent = AgentOf(c);
+            if (!agent) return false;
+            uint32 guid = player->GetGUID().GetCounter();
+            switch (action)
+            {
+                case ACT_NEWS:
+                    c->Say(sSoloSim->Rumor(agent), LANG_UNIVERSAL, player);
+                    break;
+                case ACT_ADVICE:
+                    c->Say(sSoloSim->Advice(agent), LANG_UNIVERSAL, player);
+                    break;
+                case ACT_TAKE:
+                {
+                    std::string reply = sSoloSim->TakeErrand(agent, guid, player->GetName());
+                    if (!reply.empty()) c->Say(reply, LANG_UNIVERSAL, player);
+                    SoloSim::SimErrand e;
+                    if (sSoloSim->ErrandFor(agent, e) && e.kind == SoloSim::ERRAND_ESCORT && e.player == guid)
+                        if (TownsfolkAI* ai = dynamic_cast<TownsfolkAI*>(c->AI())) ai->Wake();
+                    break;
+                }
+                case ACT_FINISH:
+                {
+                    SoloSim::SimErrand e;
+                    if (!sSoloSim->ErrandFor(agent, e) || e.player != guid || !Ready(player, e)) break;
+                    if (e.kind == SoloSim::ERRAND_FETCH)
+                        player->DestroyItemCount(e.item, e.count, true);
+                    uint32 reward = 0; std::string thanks;
+                    if (sSoloSim->FinishErrand(agent, guid, player->GetName(), reward, thanks))
+                    {
+                        if (reward) player->ModifyMoney(int32(reward));
+                        c->Say(thanks, LANG_UNIVERSAL, player);
+                        c->HandleEmoteCommand(EMOTE_ONESHOT_BOW);
+                        if (e.kind == SoloSim::ERRAND_ESCORT)
+                            c->DespawnOrUnsummon(8s);             // off to whoever they came to see
+
+                    }
+                    break;
+                }
+                case ACT_REMIND:
+                    c->Say("No rush. Well - a little rush.", LANG_UNIVERSAL, player);
+                    break;
+                default:
+                    break;
+            }
+            CloseGossipMenuFor(player);
+            Refresh(player, c);
+            return true;
+        }
+
+        bool CanCreatureGossipSelectCode(Player* player, Creature* c, uint32 /*sender*/, uint32 action, char const* code) override
+        {
+            if (!AgentOf(c)) return false;
+            if (action == ACT_ASK && code)
+                c->Say(sSoloSim->AskAfter(code), LANG_UNIVERSAL, player);
+            CloseGossipMenuFor(player);
+            return true;
+        }
+    };
+}
+
+namespace SoloCivilians
+{
+    // the quest mark over a townsperson: blue ! = they have a request; grey ? = yours, not done; blue ? = ready to hand in
+    uint32 DialogStatus(Player* player, Creature const* c)
+    {
+        uint32 agent = AgentOf(c);
+        if (!agent) return 0;
+        SoloSim::SimErrand e;
+        if (!sSoloSim->ErrandFor(agent, e)) return DIALOG_STATUS_NONE;
+        uint32 guid = player->GetGUID().GetCounter();
+        if (!e.player) return DIALOG_STATUS_AVAILABLE_REP;
+        if (e.player != guid) return DIALOG_STATUS_NONE;
+        return Ready(player, e) ? DIALOG_STATUS_REWARD_REP : DIALOG_STATUS_INCOMPLETE;
+    }
+
+    void AddScripts() { new solosim_townsfolk_talk(); }
+
+    CreatureTemplate const* Template(uint32 entry)
+    {
+        if (entry < ENTRY_BASE) return nullptr;
+        std::shared_lock lock(tplLock);
+        auto it = templates.find(entry);
+        return it == templates.end() ? nullptr : &it->second;
+    }
+
+    // World thread, from the bot bubble: keep the townsfolk of the bubble's towns out and about (nearest first).
+    void Update(Player* player, uint32 mapId, std::unordered_set<uint32> const& bubbleZones, std::vector<SimBody> const& all, uint32 maxBodies, float safeDistance)
+    {
+        Map* map = player->GetMap();
+        if (!map || map->GetId() != mapId)
+            return;
+
+        std::vector<SimBody const*> wanted;
+        for (SimBody const& b : all)
+            if (b.role == SoloSim::ROLE_CIVILIAN && bubbleZones.contains(b.zone))
+                wanted.push_back(&b);
+        std::ranges::sort(wanted, [&](SimBody const* x, SimBody const* y) {
+            return player->GetExactDist2d(x->x, x->y) < player->GetExactDist2d(y->x, y->y); });
+        if (wanted.size() > maxBodies)
+            wanted.resize(maxBodies);
+        std::unordered_set<uint32> want;
+        for (SimBody const* b : wanted) want.insert(b->agent);
+
+        // bodies that went home / died vanish on their own; the rest leave when they're no longer wanted
+        for (auto it = bodies.begin(); it != bodies.end();)
+        {
+            Creature* c = map->GetCreature(it->second);
+            if (!c || !c->IsInWorld() || !c->IsAlive()) { it = bodies.erase(it); continue; }
+            if (!want.contains(it->first) && c->GetExactDist2d(player) > safeDistance)
+            {
+                c->DespawnOrUnsummon();
+                it = bodies.erase(it);
+                continue;
+            }
+            ++it;
+        }
+
+        uint32 spawned = 0;
+        for (SimBody const* b : wanted)
+        {
+            if (spawned >= 4) break;
+            if (bodies.contains(b->agent)) continue;
+            uint32 entry = EnsureTemplate(*b);
+            if (!entry) continue;
+            map->LoadGrid(b->x, b->y);
+            Position door = FindDoor(map, b->agent, b->x, b->y, b->z);
+            TempSummon* c = map->SummonCreature(entry, door);
+            if (!c) continue;
+            c->SetFacingTo(Position::NormalizeOrientation(door.GetOrientation() + float(M_PI)));   // stepping out of the door
+            c->AIM_Initialize(new TownsfolkAI(c, b->agent));
+            bodies[b->agent] = c->GetGUID();
+            ++spawned;
+        }
+    }
+}
