diff --git a/src/server/game/SoloSim/solosim_boards.cpp b/src/server/game/SoloSim/solosim_boards.cpp
new file mode 100644
index 0000000..a08581d
--- /dev/null
+++ b/src/server/game/SoloSim/solosim_boards.cpp
@@ -0,0 +1,194 @@
+// SoloWoW bounty boards: a real board in every inn town (the Sentinel Hill "Wanted Board" look, our own template so its
+// quests don't come along). Right-click: the town's bounties (take one), yours with progress, what's in the shops, drop.
+// Finished bounties pay out by mail from the town's innkeeper (solosim.cpp PlayerKill / DeliverMail).
+#include "solosim_boards.h"
+#include "solosim.h"
+#include "AllGameObjectScript.h"
+#include "Chat.h"
+#include "GameObject.h"
+#include "Log.h"
+#include "Map.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "ScriptedGossip.h"
+#include <cmath>
+#include <map>
+#include <mutex>
+#include <shared_mutex>
+
+namespace
+{
+    constexpr uint32 BOARD_ENTRY = 9100000;
+    constexpr uint32 BOARD_LOOK = 2713;                     // "Wanted Board" (Sentinel Hill)
+    constexpr uint32 ACT_TURNIN = 2, ACT_SHOPS = 3, ACT_DROP = 4, ACT_NOTICES = 5, ACT_ASK = 6, ACT_TAKE = 1000;
+
+    std::shared_mutex tplLock;
+    bool tplBuilt = false;
+    GameObjectTemplate boardTemplate;
+
+    std::map<uint32, ObjectGuid> boards;                    // town hub -> board (world thread)
+
+    void BuildTemplate()
+    {
+        std::unique_lock lock(tplLock);
+        if (tplBuilt) return;
+        GameObjectTemplate const* src = sObjectMgr->GetGameObjectTemplate(BOARD_LOOK);
+        if (!src) return;
+        boardTemplate = *src;
+        boardTemplate.entry = BOARD_ENTRY;
+        boardTemplate.name = "Bounty Board";
+        boardTemplate.ScriptId = 0;
+        boardTemplate.AIName = "";
+        tplBuilt = true;
+    }
+
+    // a spot in the open near the town centre, the same one every time
+    bool BoardSpot(Map* map, SoloSim::SimSite const& town, Position& out)
+    {
+        for (uint32 k = 0; k < 24; ++k)
+        {
+            float ang = float(k) * 2.399f + float(town.id);
+            float r = 5.0f + float(k % 6) * 2.5f;
+            float x = town.x + r * std::cos(ang), y = town.y + r * std::sin(ang);
+            float z = map->GetHeight(PHASEMASK_NORMAL, x, y, town.z + 6.0f, true, 20.0f);
+            if (z <= INVALID_HEIGHT || std::fabs(z - town.z) > 5.0f) continue;
+            PositionFullTerrainStatus terrain;
+            map->GetFullTerrainStatusForPosition(PHASEMASK_NORMAL, x, y, z, 2.0f, terrain);
+            if (!terrain.outdoors || terrain.liquidInfo.Status != LIQUID_MAP_NO_WATER) continue;
+            // room to stand: nothing solid within 2.5 yd at chest height
+            bool clear = true;
+            for (uint32 d = 0; d < 8 && clear; ++d)
+            {
+                float da = float(d) * float(M_PI) / 4.0f;
+                clear = map->isInLineOfSight(x, y, z + 1.5f, x + std::cos(da) * 2.5f, y + std::sin(da) * 2.5f, z + 1.5f,
+                    PHASEMASK_NORMAL, LINEOFSIGHT_CHECK_VMAP, VMAP::ModelIgnoreFlags::Nothing);
+            }
+            if (!clear) continue;
+            out.Relocate(x, y, z, std::atan2(town.y - y, town.x - x));   // facing the square
+            return true;
+        }
+        return false;
+    }
+
+    void ShowMenu(Player* player, GameObject* go)
+    {
+        ClearGossipMenuFor(player);
+        uint32 hub = 0;
+        auto items = sSoloSim->PlayerBoardMenu(player->GetMapId(), player->GetPositionX(), player->GetPositionY(), player->GetGUID().GetCounter(), hub);
+        uint32 shown = 0;
+        for (auto const& [text, action] : items)
+        {
+            if (++shown > 12) break;                          // a board only holds so many notices
+            AddGossipItemFor(player, action ? GOSSIP_ICON_BATTLE : GOSSIP_ICON_TALK, text, GOSSIP_SENDER_MAIN, action ? action : ACT_SHOPS + 100);
+        }
+        if (items.empty())
+            AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Nothing posted right now. Check back tomorrow.", GOSSIP_SENDER_MAIN, ACT_SHOPS + 100);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Read the notices", GOSSIP_SENDER_MAIN, ACT_NOTICES);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Look for word of someone...", GOSSIP_SENDER_MAIN, ACT_ASK, "Whose name do you look for among the notices?", 0, true);
+        AddGossipItemFor(player, GOSSIP_ICON_MONEY_BAG, "What's in the shops?", GOSSIP_SENDER_MAIN, ACT_SHOPS);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Check my bounties", GOSSIP_SENDER_MAIN, ACT_TURNIN);
+        AddGossipItemFor(player, GOSSIP_ICON_CHAT, "Take my name off my bounties", GOSSIP_SENDER_MAIN, ACT_DROP);
+        SendGossipMenuFor(player, DEFAULT_GOSSIP_MESSAGE, go->GetGUID());
+    }
+
+    void Say(Player* player, std::string const& text)
+    {
+        ChatHandler ch(player->GetSession());
+        size_t start = 0;
+        while (start <= text.size())
+        {
+            size_t end = text.find('\n', start);
+            ch.SendSysMessage(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+            if (end == std::string::npos) break;
+            start = end + 1;
+        }
+    }
+
+    class solosim_board : public AllGameObjectScript
+    {
+    public:
+        solosim_board() : AllGameObjectScript("solosim_board") { }
+
+        bool CanGameObjectGossipHello(Player* player, GameObject* go) override
+        {
+            if (!go || go->GetEntry() != BOARD_ENTRY) return false;
+            ShowMenu(player, go);
+            return true;
+        }
+
+        bool CanGameObjectGossipSelect(Player* player, GameObject* go, uint32 /*sender*/, uint32 action) override
+        {
+            if (!go || go->GetEntry() != BOARD_ENTRY) return false;
+            uint32 guid = player->GetGUID().GetCounter();
+            float x = player->GetPositionX(), y = player->GetPositionY();
+            if (action >= ACT_TAKE)
+                Say(player, sSoloSim->PlayerTake(player->GetMapId(), x, y, guid, player->GetName(), action - ACT_TAKE));
+            else if (action == ACT_TURNIN)
+            {
+                uint32 reward = 0;
+                Say(player, sSoloSim->PlayerTurnIn(player->GetMapId(), x, y, guid, player->GetName(), reward));
+                if (reward) player->ModifyMoney(int32(reward));
+            }
+            else if (action == ACT_SHOPS)
+            {
+                std::string board = sSoloSim->PlayerBoard(player->GetMapId(), x, y, guid);
+                size_t p = board.find("In the shops:");
+                Say(player, p == std::string::npos ? "The shops have nothing the gatherers brought in right now." : board.substr(p, board.find('\n', p) - p));
+            }
+            else if (action == ACT_DROP)
+                Say(player, sSoloSim->PlayerDrop(guid, player->GetName()));
+            else if (action == ACT_NOTICES)
+                Say(player, sSoloSim->Notices(player->GetMapId(), x, y));
+            ShowMenu(player, go);
+            return true;
+        }
+
+        bool CanGameObjectGossipSelectCode(Player* player, GameObject* go, uint32 /*sender*/, uint32 action, char const* code) override
+        {
+            if (!go || go->GetEntry() != BOARD_ENTRY) return false;
+            if (action == ACT_ASK && code)
+                Say(player, sSoloSim->AskAfter(code));
+            ShowMenu(player, go);
+            return true;
+        }
+    };
+}
+
+namespace SoloBoards
+{
+    GameObjectTemplate const* Template(uint32 entry)
+    {
+        if (entry != BOARD_ENTRY) return nullptr;
+        std::shared_lock lock(tplLock);
+        return tplBuilt ? &boardTemplate : nullptr;
+    }
+
+    // World thread, from the bot bubble: put up a board in inn towns near the player (once each).
+    void Update(Player* player)
+    {
+        if (!tplBuilt) BuildTemplate();
+        if (!tplBuilt) return;
+        Map* map = player->GetMap();
+        for (SoloSim::SimSite const& town : sSoloSim->InnTowns(map->GetId()))
+        {
+            if (player->GetExactDist2d(town.x, town.y) > 250.0f) continue;
+            if (auto it = boards.find(town.id); it != boards.end())
+            {
+                if (map->GetGameObject(it->second)) continue;
+                boards.erase(it);
+            }
+            Position spot;
+            if (!BoardSpot(map, town, spot)) continue;
+            if (GameObject* go = map->SummonGameObject(BOARD_ENTRY, spot.GetPositionX(), spot.GetPositionY(), spot.GetPositionZ(), spot.GetOrientation(), 0, 0, 0, 0, 0))
+            {
+                boards[town.id] = go->GetGUID();
+                LOG_INFO("server.loading", "SoloWoW: bounty board put up in {}", town.name);
+            }
+        }
+    }
+}
+
+void AddSC_solosim_boards()
+{
+    new solosim_board();
+}
