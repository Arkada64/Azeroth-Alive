+    // SoloWoW bubble: queue one wanderer at one of the given nodes. Picks a spare bot whose team
+    // has spawn nodes here and a level bracket those nodes support (so the level_nodes ASSERT in
+    // GenerateWanderingBotToSpawn can't fire), weighted toward the player's own bracket.
+    bool GenerateBubbleWanderer(std::vector<WanderNode const*> const& nodes, uint8 preferBracket)
+    {
+        using NodeVec = std::vector<WanderNode const*>;
+
+        if (_spareBotIdsPerClassMap.empty() || nodes.empty())
+            return false;
+
+        NodeVec spawns_a, spawns_h, spawns_n;
+        for (WanderNode const* wp : nodes)
+        {
+            if (!wp->HasFlag(BotWPFlags::BOTWP_FLAG_SPAWN))
+                continue;
+            if (bot_ai::IsWanderNodeAvailableForBotFaction(wp, FACTION_TEMPLATE_ALLIANCE_DEFAULT, false, true))
+                spawns_a.push_back(wp);
+            if (bot_ai::IsWanderNodeAvailableForBotFaction(wp, FACTION_TEMPLATE_HORDE_DEFAULT, false, true))
+                spawns_h.push_back(wp);
+            if (bot_ai::IsWanderNodeAvailableForBotFaction(wp, FACTION_TEMPLATE_NEUTRAL_HOSTILE, false, true))
+                spawns_n.push_back(wp);
+        }
+
+        std::vector<std::pair<uint8, uint32>> candidates;
+        for (auto const& [bot_class, spare_bots] : _spareBotIdsPerClassMap)
+            for (uint32 spareBotId : spare_bots)
+                candidates.emplace_back(bot_class, spareBotId);
+        Bcore::Containers::RandomShuffle(candidates);
+
+        for (std::pair<uint8, uint32> const& candidate : candidates)
+        {
+            const auto [bot_class, orig_entry] = candidate;
+            NpcBotExtras const* orig_extras = BotDataMgr::SelectNpcBotExtras(orig_entry);
+            if (!orig_extras)
+                continue;
+            uint32 bot_faction = BotDataMgr::GetDefaultFactionForBotRaceClass(bot_class, orig_extras->race);
+            NodeVec const* team_nodes;
+            switch (BotDataMgr::GetTeamIdForFaction(bot_faction))
+            {
+                case TEAM_ALLIANCE: team_nodes = &spawns_a; break;
+                case TEAM_HORDE:    team_nodes = &spawns_h; break;
+                default:            team_nodes = &spawns_n; break;
+            }
+            if (team_nodes->empty())
+                continue;
+
+            const uint8 min_bracket = BotDataMgr::GetMinLevelForBotClass(bot_class) / 10;
+            std::array<uint32, BRACKETS_COUNT> weights{};
+            uint32 total_weight = 0;
+            for (uint8 b = min_bracket; b < BRACKETS_COUNT; ++b)
+            {
+                bool fits = std::ranges::any_of(*team_nodes, [b](WanderNode const* wp) {
+                    return b * 10 + 9 >= wp->GetLevels().first && wp->GetLevels().second >= b * 10;
+                });
+                if (!fits)
+                    continue;
+                uint32 dist = uint32(std::abs(int32(b) - int32(preferBracket)));
+                weights[b] = dist == 0 ? 6 : dist == 1 ? 3 : 1;
+                total_weight += weights[b];
+            }
+            if (!total_weight)
+                continue;
+
+            uint32 roll = urand(1, total_weight);
+            uint8 bracket = 0;
+            for (uint8 b = 0; b < BRACKETS_COUNT; ++b)
+            {
+                if (roll <= weights[b]) { bracket = b; break; }
+                roll -= weights[b];
+            }
+
+            return GenerateWanderingBotToSpawn(candidate, bracket, spawns_a, spawns_h, spawns_n, false, nullptr, nullptr);
+        }
+        return false;
+    }
+
+    // SoloWoW sim embodiment: a wanderer that IS a simulated person - their name, level, race and class
+    // (looks from the source template). Queued like other wanderers. Returns the new entry, 0 on failure.
+    uint32 GenerateSimBot(uint32 orig_entry, std::string const& name, uint8 level, WanderNode const* spawnLoc)
+    {
+        CreatureTemplate const* orig_template = sObjectMgr->GetCreatureTemplate(orig_entry);
+        NpcBotExtras const* orig_extras = BotDataMgr::SelectNpcBotExtras(orig_entry);
+        if (!orig_template || !orig_extras || !spawnLoc || orig_extras->bclass == BOT_CLASS_NONE)
+            return 0;
+        Map* map = sMapMgr->CreateBaseMap(spawnLoc->GetMapId());
+        if (!map || !map->GetEntry() || !map->GetEntry()->IsContinent())
+            return 0;
+
+        CreatureTemplateContainer const* all_templates = sObjectMgr->GetCreatureTemplates();
+        while (all_templates->contains(++next_bot_id) || _botsExtraCreatureTemplates.contains(next_bot_id));
+
+        const uint8 bot_class = orig_extras->bclass;
+        uint32 bot_faction = BotDataMgr::GetDefaultFactionForBotRaceClass(bot_class, orig_extras->race);
+
+        CreatureTemplate& bot_template = _botsExtraCreatureTemplates[next_bot_id];
+        bot_template = *orig_template;
+        bot_template.Entry = next_bot_id;
+        bot_template.Name = name;
+        bot_template.SubName = "";
+        bot_template.speed_run = BotCfg::GetBotWandererSpeedMod();
+        bot_template.KillCredit[0] = orig_entry;
+        bot_template.minlevel = std::max<uint32>(1, level);
+        bot_template.maxlevel = std::max<uint32>(1, level);
+        bot_template.flags_extra &= ~(CREATURE_FLAG_EXTRA_NO_XP);
+        bot_template.InitializeQueryData();
+
+        uint8 bot_spec = BotDataMgr::SelectSpecForClass(bot_class);
+        _botsData.emplace(std::piecewise_construct, std::forward_as_tuple(next_bot_id), std::forward_as_tuple(BotDataMgr::DefaultRolesForClass(bot_class, bot_spec), bot_faction, bot_spec));
+        _botsExtras.emplace(next_bot_id, NpcBotExtras{.race = orig_extras->race, .bclass = bot_class});
+        if (NpcBotAppearanceData const* orig_apdata = BotDataMgr::SelectNpcBotAppearance(orig_entry))
+            _botsAppearanceData.emplace(std::piecewise_construct, std::forward_as_tuple(next_bot_id), std::forward_as_tuple(orig_apdata->gender, orig_apdata->skin, orig_apdata->face, orig_apdata->hair, orig_apdata->haircolor, orig_apdata->features));
+
+        int8 beqId = 1;
+        _botsExtraCreatureEquipmentTemplates[next_bot_id] = sObjectMgr->GetEquipmentInfo(orig_entry, beqId);
+
+        _botsWanderCreaturesToSpawn.emplace_back(next_bot_id, spawnLoc);
+        return next_bot_id;
+    }
