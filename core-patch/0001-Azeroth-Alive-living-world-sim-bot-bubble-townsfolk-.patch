+static std::string EncodePlan(std::vector<PlanStep> const& plan)
+{
+    std::string s;
+    for (PlanStep const& p : plan) s += Acore::StringFormat("{}:{}:{}:{};", uint32(p.verb), p.site, p.minutes, p.announce ? 1 : 0);
+    return s;
+}
+
+static std::vector<PlanStep> DecodePlan(std::string const& s)
+{
+    std::vector<PlanStep> out;
+    size_t pos = 0;
+    while (pos < s.size())
+    {
+        size_t end = s.find(';', pos); if (end == std::string::npos) break;
+        std::string part = s.substr(pos, end - pos);
+        uint32 v = 0, site = 0, mins = 0, ann = 0;
+        if (std::sscanf(part.c_str(), "%u:%u:%u:%u", &v, &site, &mins, &ann) >= 3) out.push_back({ Verb(v), site, mins, ann != 0 });
+        pos = end + 1;
+    }
+    return out;
+}
+
+static void Chunked(std::string const& head, std::vector<std::string> const& rows)
+{
+    for (size_t i = 0; i < rows.size(); i += 200)
+    {
+        std::string sql = head;
+        for (size_t j = i; j < std::min(rows.size(), i + 200); ++j) { if (j > i) sql += ","; sql += rows[j]; }
+        CharacterDatabase.DirectExecute(sql);
+    }
+}
