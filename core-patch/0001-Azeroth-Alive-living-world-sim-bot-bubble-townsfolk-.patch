+// SoloWoW: .sim commands (GM chat, server console and SOAP).
+//   .sim run [days]   step the living world forward headless (default 1 day), write logs\chronicle.txt
+//   .sim status       population summary
+//   .sim reset        wipe sim data in this save; the next run builds a new world
+#include "solosim.h"
+#include "solosim_boards.h"
+#include "solosim_civilians.h"
+#include "solosim_camps.h"
+#include "botbubble.h"
+#include "Chat.h"
+#include "Creature.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "WorldSession.h"
+#include "CommandScript.h"
+#include "RBAC.h"
+#include "ScriptMgr.h"
+#include "WorldScript.h"
+
+using namespace Acore::ChatCommands;
+
+class solosim_commands : public CommandScript
+{
+public:
+    solosim_commands() : CommandScript("solosim_commands") { }
+
+    ChatCommandTable GetCommands() const override
+    {
+        static ChatCommandTable simTable =
+        {
+            { "run",    HandleRun,    rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "status", HandleStatus, rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "reset",  HandleReset,  rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "people", HandlePeople, rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "hours",  HandleHours,  rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "bounties", HandleBounties, rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "who",    HandleWho,    rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "advice", HandleAdvice, rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "threat", HandleThreat, rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+            { "camp",   HandleCamp,   rbac::RBAC_PERM_COMMAND_NPCBOT_DUMP_WRITE, Console::Yes },
+        };
+        static ChatCommandTable root =
+        {
+            { "sim", simTable },
+        };
+        return root;
+    }
+
+    static bool HandleRun(ChatHandler* handler, Optional<uint32> days)
+    {
+        uint32 d = days.value_or(1);
+        if (d == 0 || d > 3650) { handler->SendSysMessage("Usage: .sim run [days 1-3650]"); return true; }
+        handler->SendSysMessage(sSoloSim->Run(d));
+        return true;
+    }
+
+    // skip ahead a few hours (testing; the live world re-syncs to the wall clock on the next server start)
+    static bool HandleHours(ChatHandler* handler, uint32 hours)
+    {
+        if (hours == 0 || hours > 240) { handler->SendSysMessage("Usage: .sim hours <1-240>"); return true; }
+        handler->SendSysMessage(sSoloSim->RunHours(hours));
+        return true;
+    }
+
+    static bool HandleStatus(ChatHandler* handler)
+    {
+        handler->SendSysMessage(sSoloSim->Status());
+        return true;
+    }
+
+    // in game: the sim people nearest you and what they're doing; console: how many are out per zone (Eastern Kingdoms)
+    static bool HandlePeople(ChatHandler* handler)
+    {
+        Player* p = handler->GetSession() ? handler->GetSession()->GetPlayer() : nullptr;
+        std::string text = p ? sSoloSim->People(p->GetMapId(), p->GetPositionX(), p->GetPositionY(), true, p->GetGUID().GetCounter())
+                             : sSoloSim->People(0, 0.0f, 0.0f, false);
+        size_t start = 0;
+        while (start <= text.size())
+        {
+            size_t end = text.find('\n', start);
+            handler->SendSysMessage(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+            if (end == std::string::npos) break;
+            start = end + 1;
+        }
+        return true;
+    }
+
+    static bool HandleBounties(ChatHandler* handler)
+    {
+        std::string text = sSoloSim->Board();
+        size_t start = 0;
+        while (start <= text.size())
+        {
+            size_t end = text.find('\n', start);
+            handler->SendSysMessage(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+            if (end == std::string::npos) break;
+            start = end + 1;
+        }
+        return true;
+    }
+
+    static bool HandleWho(ChatHandler* handler, Tail name)
+    {
+        handler->SendSysMessage(sSoloSim->AskAfter(std::string(name)));
+        return true;
+    }
+
+    static bool HandleAdvice(ChatHandler* handler, uint32 agent)
+    {
+        handler->SendSysMessage(sSoloSim->Advice(agent));
+        return true;
+    }
+
+    // .sim camp [town]: a roadside camp now, for the town nearest you (in game) or the named town (console)
+    static bool HandleCamp(ChatHandler* handler, Tail town)
+    {
+        Player* p = handler->GetSession() ? handler->GetSession()->GetPlayer() : nullptr;
+        std::string want(town);
+        if (!want.empty())
+            for (uint32 m : { 0u, 1u })
+                for (SoloSim::SimSite const& s : sSoloSim->InnTowns(m))
+                    if (s.name == want)
+                    {
+                        handler->SendSysMessage(sSoloSim->SummonCamp(true, s.map, s.x, s.y));
+                        return true;
+                    }
+        if (!want.empty()) { handler->SendSysMessage("No inn town by that name."); return true; }
+        handler->SendSysMessage(sSoloSim->SummonCamp(p != nullptr, p ? p->GetMapId() : 0, p ? p->GetPositionX() : 0.0f, p ? p->GetPositionY() : 0.0f));
+        return true;
+    }
+
+    static bool HandleThreat(ChatHandler* handler)
+    {
+        handler->SendSysMessage(sSoloSim->SummonThreats());
+        return true;
+    }
+
+    static bool HandleReset(ChatHandler* handler)
+    {
+        handler->SendSysMessage(sSoloSim->Reset());
+        return true;
+    }
+};
+
+// .bounty               the nearest town's board (and your bounties elsewhere)
+// .bounty take <n>      put your name down for bounty n on this board
+// .bounty turnin        collect for finished bounties (in the town that posted them)
+// .bounty drop          take your name off all your bounties
+class solosim_bounty_commands : public CommandScript
+{
+public:
+    solosim_bounty_commands() : CommandScript("solosim_bounty_commands") { }
+
+    ChatCommandTable GetCommands() const override
+    {
+        static ChatCommandTable bountyTable =
+        {
+            { "take",   HandleTake,   SEC_PLAYER, Console::No },
+            { "turnin", HandleTurnIn, SEC_PLAYER, Console::No },
+            { "drop",   HandleDrop,   SEC_PLAYER, Console::No },
+            { "",       HandleBoard,  SEC_PLAYER, Console::No },
+        };
+        static ChatCommandTable root =
+        {
+            { "bounty", bountyTable },
+        };
+        return root;
+    }
+
+    static void Say(ChatHandler* handler, std::string const& text)
+    {
+        size_t start = 0;
+        while (start <= text.size())
+        {
+            size_t end = text.find('\n', start);
+            handler->SendSysMessage(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+            if (end == std::string::npos) break;
+            start = end + 1;
+        }
+    }
+
+    static bool HandleBoard(ChatHandler* handler)
+    {
+        Player* p = handler->GetPlayer();
+        Say(handler, sSoloSim->PlayerBoard(p->GetMapId(), p->GetPositionX(), p->GetPositionY(), p->GetGUID().GetCounter()));
+        return true;
+    }
+
+    static bool HandleTake(ChatHandler* handler, uint32 index)
+    {
+        Player* p = handler->GetPlayer();
+        Say(handler, sSoloSim->PlayerTake(p->GetMapId(), p->GetPositionX(), p->GetPositionY(), p->GetGUID().GetCounter(), p->GetName(), index));
+        return true;
+    }
+
+    static bool HandleTurnIn(ChatHandler* handler)
+    {
+        Player* p = handler->GetPlayer();
+        uint32 reward = 0;
+        Say(handler, sSoloSim->PlayerTurnIn(p->GetMapId(), p->GetPositionX(), p->GetPositionY(), p->GetGUID().GetCounter(), p->GetName(), reward));
+        if (reward)
+            p->ModifyMoney(int32(reward));
+        return true;
+    }
+
+    static bool HandleDrop(ChatHandler* handler)
+    {
+        Player* p = handler->GetPlayer();
+        Say(handler, sSoloSim->PlayerDrop(p->GetGUID().GetCounter(), p->GetName()));
+        return true;
+    }
+};
+
+// Kills count toward the player's bounties; killing what a sim person was fighting is remembered.
+class solosim_player : public PlayerScript
+{
+public:
+    solosim_player() : PlayerScript("solosim_player", { PLAYERHOOK_ON_CREATURE_KILL, PLAYERHOOK_ON_CREATURE_KILLED_BY_PET, PLAYERHOOK_ON_BEFORE_BUY_ITEM_FROM_VENDOR }) { }
+
+    // town shops only have what the gatherers brought in
+    void OnPlayerBeforeBuyItemFromVendor(Player* player, ObjectGuid vendorguid, uint32 /*vendorslot*/, uint32& item, uint8 count, uint8 /*bag*/, uint8 /*slot*/) override
+    {
+        if (!item || !vendorguid.IsCreature()) return;
+        if (sSoloSim->MarketSoldOut(vendorguid.GetEntry(), item, std::max<uint32>(1, count)))
+        {
+            ChatHandler(player->GetSession()).SendSysMessage("Sold out - nobody has brought any in lately.");
+            item = 0;
+        }
+    }
+
+    void OnPlayerCreatureKill(Player* killer, Creature* killed) override { Credit(killer, killed); }
+    void OnPlayerCreatureKilledByPet(Player* owner, Creature* killed) override { Credit(owner, killed); }
+
+    static void Credit(Player* player, Creature* killed)
+    {
+        if (!player || !killed)
+            return;
+        uint32 entry = killed->GetEntry();
+        if (uint32 camp = SoloCamps::CampOf(killed->GetGUID()))
+            entry = camp | SoloSim::CAMP_MARK;                      // one of a roadside camp
+        else if (killed->IsNPCBotOrPet())
+        {
+            // a roaming threat (a hostile hero) counts, by its sim id; any other bot does not
+            uint32 agent = killed->IsNPCBot() ? BotBubble::SimAgentOf(entry) : 0;
+            if (!agent || !sSoloSim->IsThreat(agent))
+                return;
+            entry = agent | SoloSim::THREAT_MARK;
+        }
+        std::string found = sSoloSim->PlayerKill(player->GetGUID().GetCounter(), player->GetName(), entry, killed->GetName(), killed->GetMapId(), killed->GetPositionX(), killed->GetPositionY());
+        if (!found.empty())
+            ChatHandler(player->GetSession()).SendSysMessage(found);
+        // was it fighting one of the sim's people? then you stepped in for them
+        for (Unit* u : killed->getAttackers())
+            if (u && u->IsNPCBot())
+                if (uint32 agent = BotBubble::SimAgentOf(u->GetEntry()))
+                    if (u->ToCreature()->IsFreeBot())
+                        sSoloSim->HelpedBy(agent, player->GetGUID().GetCounter(), player->GetName());
+    }
+};
+
+// the living world saves when the server shuts down (it otherwise saves every 10 minutes)
+class solosim_world : public WorldScript
+{
+public:
+    solosim_world() : WorldScript("solosim_world", { WORLDHOOK_ON_SHUTDOWN }) { }
+    void OnShutdown() override { sSoloSim->SaveOnShutdown(); }
+};
