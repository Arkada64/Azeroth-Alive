+// is destroyed, so a long session that travels only ever grows. A grid is let go once, for 5 minutes, no player has been
+// within 2 grids of it and it holds nothing that must outlive it: players, corpses, spell objects, transports, NPCBots
+// (adventurer bodies, threats, hirelings), pets/summons (townsfolk) or anything owned or charmed, anything in combat or
+// set active, or anything that isn't a plain saved spawn (except our bounty boards, which are put back up on demand).
+// The grid comes back from the database the next time something needs it - pools, respawn timers and corpses included.
+namespace
+{
+    struct SoloGridKeepCheck
+    {
+        bool keep = false;
+        void Visit(PlayerMapType& m) { if (!m.IsEmpty()) keep = true; }
+        void Visit(CorpseMapType& m) { if (!m.IsEmpty()) keep = true; }
+        void Visit(DynamicObjectMapType& m) { if (!m.IsEmpty()) keep = true; }
+        void Visit(GameObjectMapType& m)
+        {
+            for (auto it = m.begin(); it != m.end() && !keep; ++it)
+            {
+                GameObject* go = it->GetSource();
+                if (go->IsTransport() || go->isActiveObject() || go->GetOwnerGUID() || (!go->GetSpawnId() && go->GetEntry() != 9100000))
+                    keep = true;
+            }
+        }
+        void Visit(CreatureMapType& m)
+        {
+            for (auto it = m.begin(); it != m.end() && !keep; ++it)
+            {
+                Creature* c = it->GetSource();
+                if (c->IsNPCBotOrPet() || c->IsSummon() || c->IsPet() || c->IsInCombat() || c->isActiveObject() || c->GetCharmerOrOwnerGUID()
+                    || !c->GetSpawnId() || c->GetTransport() || c->IsVehicle())
+                    keep = true;
+            }
+        }
+        template<class T> void Visit(GridRefMgr<T>&) { }
+    };
+}
+
+void Map::SoloUnloadIdleGrids(uint32 diff)
+{
+    if (!GetEntry() || !GetEntry()->IsContinent())
+        return;
+    _soloUnloadTimer += diff;
+    if (_soloUnloadTimer < 30000)
+        return;
+    _soloUnloadTimer = 0;
+    static bool const enabled = sConfigMgr->GetOption<bool>("SoloWoW.UnloadIdleGrids", true);
+    static uint32 const idleMs = sConfigMgr->GetOption<uint32>("SoloWoW.UnloadIdleGrids.Minutes", 5) * 60000;
+    if (!enabled || !_creaturesToMove.empty() || !_gameObjectsToMove.empty() || !_dynamicObjectsToMove.empty())
+        return;
+
+    uint32 now = getMSTime();
+    std::unordered_set<uint32> nearPlayers;
+    for (MapRefMgr::iterator it = m_mapRefMgr.begin(); it != m_mapRefMgr.end(); ++it)
+        if (Player* player = it->GetSource())
+        {
+            GridCoord g = Acore::ComputeGridCoord(player->GetPositionX(), player->GetPositionY());
+            for (int32 dx = -2; dx <= 2; ++dx)
+                for (int32 dy = -2; dy <= 2; ++dy)
+                {
+                    int32 x = int32(g.x_coord) + dx, y = int32(g.y_coord) + dy;
+                    if (x >= 0 && y >= 0 && x < MAX_NUMBER_OF_GRIDS && y < MAX_NUMBER_OF_GRIDS)
+                        nearPlayers.insert(uint32(y) * MAX_NUMBER_OF_GRIDS + uint32(x));
+                }
+        }
+
+    std::vector<MapGridType*> idle;
+    uint32 loaded = 0;
+    for (GridRefMgr<MapGridType>::iterator i = GridRefMgr<MapGridType>::begin(); i != GridRefMgr<MapGridType>::end(); ++i)
+    {
+        MapGridType* grid = i->GetSource();
+        if (!grid)
+            continue;
+        ++loaded;
+        uint32 id = grid->GetId();
+        bool needed = nearPlayers.contains(id);
+        if (!needed)
+        {
+            SoloGridKeepCheck check;
+            TypeContainerVisitor<SoloGridKeepCheck, GridTypeMapContainer> visitor(check);
+            grid->VisitAllCells(visitor);
+            needed = check.keep;
+        }
+        auto seen = _soloGridNeeded.try_emplace(id, now).first;
+        if (needed)
+            seen->second = now;
+        else if (getMSTimeDiff(seen->second, now) >= idleMs)
+            idle.push_back(grid);
+    }
+    for (MapGridType* grid : idle)
+    {
+        _soloGridNeeded.erase(grid->GetId());
+        UnloadGrid(*grid);
+    }
+    if (!idle.empty())
+        LOG_INFO("maps", "SoloWoW: let go of {} idle grid(s) on map {} ({} still loaded)", uint32(idle.size()), GetId(), loaded - uint32(idle.size()));
+}
