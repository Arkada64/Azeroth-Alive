+// the player brought a townsperson safely to the town they were walking to
+bool World::EscortArrived(uint32 agentId, uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand& e : _errands)
+        if (e.agent == agentId && !e.done && e.kind == ERRAND_ESCORT && e.player == guid && e.progress < e.count)
+        {
+            e.progress = e.count;
+            if (SimAgent* a = AgentById(agentId)) CivilianGrow(*a, "came back from the road a little harder");
+            return true;
+        }
+    return false;
+}
