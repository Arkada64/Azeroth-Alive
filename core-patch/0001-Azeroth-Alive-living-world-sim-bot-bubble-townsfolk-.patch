+void World::HelpedBy(uint32 agentId, uint32 guid, std::string const& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a || a->status != AgentStatus::Active) return;
+    // once an hour is plenty
+    for (auto it = _memories.rbegin(); it != _memories.rend() && it->at + 60 > _clock; ++it)
+        if (it->agent == a->id && it->subjectType == 4 && it->subject == guid && it->eventType == uint8(EventType::PlayerHelped)) return;
+    bool first = Regard(a->id, guid).empty();
+    RememberPlayer(*a, guid, 40, 70, EventType::PlayerHelped);
+    SimSite const* s = SiteById(a->site);
+    Log(EventType::PlayerHelped, *a, a->site, Acore::StringFormat("{} was in a tight spot{} until {} stepped in.", Who(*a),
+        s ? " near " + AreaOf(SiteName(s->id)) : std::string(), first ? "a stranger called " + name : name), true);
+}
