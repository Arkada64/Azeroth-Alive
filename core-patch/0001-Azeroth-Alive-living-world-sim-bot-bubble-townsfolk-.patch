+uint32 World::InnkeeperOf(uint32 hub) const
+{
+    if (auto it = hubInnkeeper.find(hub); it != hubInnkeeper.end()) return it->second;
+    SimSite const* h = SiteById(hub);
+    uint32 best = 0; float bestD = 1e9f;
+    for (auto const& [hid, e] : hubInnkeeper)
+        if (SimSite const* o = SiteById(hid); o && h) { float d = Dist2d(o->x, o->y, h->x, h->y); if (d < bestD) { bestD = d; best = e; } }
+    return best;
+}
