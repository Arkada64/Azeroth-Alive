+}
+
+void World::Log(EventType t, SimAgent const& a, uint32 site, std::string text, bool notable, uint32 target, int32 n1, int32 n2)
+{
+    SimEvent e; e.id = _nextEvent++; e.at = _clock; e.type = t; e.actor = a.id; e.target = target; e.site = site;
+    e.n1 = n1; e.n2 = n2; e.notable = notable; e.text = std::move(text);
+    if (notable && site)                                 // what people in the nearest town will be talking about
+        if (uint32 town = TownOf(site))
+        {
+            auto& r = _rumors[town];
+            r.push_back(e.text);
+            if (r.size() > 8) r.erase(r.begin());
+            auto& n = _notices[town];
+            n.emplace_back(e.at, e.text);
+            if (n.size() > 15) n.pop_front();
+        }
+    _pending.push_back(std::move(e));
+}
+
+uint32 World::TravelMinutes(uint32 fromSite, uint32 toSite, SimAgent const& a) const
+{
+    SimSite const* f = SiteById(fromSite); SimSite const* t = SiteById(toSite);
+    if (!f || !t || f == t) return 0;
+    if (f->map != t->map)
+    {
+        // another continent: walk to a port, take the boat (about 25 minutes at sea), walk on from the far port
+        uint32 best = UINT32_MAX;
+        for (SimSite const& p : _sites)
+        {
+            if (p.type != SiteType::Hub || !(p.services & SVC_INN) || p.map != f->map || !PORT_ZONES.contains(p.zone)) continue;
+            for (SimSite const& q : _sites)
+            {
+                if (q.type != SiteType::Hub || !(q.services & SVC_INN) || q.map != t->map || !PORT_ZONES.contains(q.zone)) continue;
+                uint32 m = TravelMinutes(fromSite, p.id, a) + 25 + TravelMinutes(q.id, toSite, a);
+                best = std::min(best, m);
+            }
+        }
+        return best == UINT32_MAX ? 24 * 60 : best;
+    }
+    // along the roads (wander-node graph): site -> its node -> ... -> node -> site. Straight line x 1.3 if no road connects them.
+    float yards = Dist2d(f->x, f->y, t->x, t->y) * 1.3f;
+    uint32 fi = SiteRoad(fromSite), ti = SiteRoad(toSite);
+    if (fi != UINT32_MAX && ti != UINT32_MAX)
+    {
+        float road = DistTo(ti)[fi];
+        if (road < 1e8f)
+            yards = Dist2d(f->x, f->y, _roads[fi].x, _roads[fi].y) + road + Dist2d(_roads[ti].x, _roads[ti].y, t->x, t->y);
+    }
+    // travelling pace: a run (7 yd/s) with stops, about 5.5 yd/s; mounted from level 40 (+60%)
+    float pace = 5.5f * (a.level >= 40 ? 1.6f : 1.0f);
+    return std::max<uint32>(1, uint32(yards / pace / 60.0f + 0.5f));
+}
+
+uint32 World::NearestHub(SimAgent const& a, uint32 need) const
+{
+    uint32 best = 0, bestMin = UINT32_MAX;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & need) == need)
+        {
+            uint32 m = TravelMinutes(a.site, s.id, a);
+            if (m < bestMin) { bestMin = m; best = s.id; }
+        }
+    return best ? best : a.home;
+}
+
+static bool HuntFits(SimSite const& s, uint8 level, uint8 bravery)
+{
+    uint8 gray = Acore::XP::GetGrayLevel(level);
+    uint8 reach = uint8(level + (bravery > 70 ? 3 : 2));
+    return s.type == SiteType::Hunt && s.maxLevel > gray && s.minLevel <= reach && s.maxLevel <= level + 5;
+}
+
+bool World::HasFittingHunt(SimAgent const& a, uint32 nearHub, float radius) const
+{
+    SimSite const* h = SiteById(nearHub);
+    if (!h) return false;
+    for (SimSite const& s : _sites)
+        if (HuntFits(s, a.level, a.bravery) && s.map == h->map && Dist2d(h->x, h->y, s.x, s.y) <= radius)
+            return true;
+    return false;
+}
+
+uint32 World::PickHuntSite(SimAgent& a)
+{
+    float ideal = float(a.level) + (float(a.bravery) - 50.0f) / 50.0f;     // brave ones push a little higher
+    std::vector<std::pair<float, uint32>> scored;
+    for (SimSite const& s : _sites)
+    {
+        if (!HuntFits(s, a.level, a.bravery)) continue;
+        if (SimSite const* here = SiteById(a.site); here && here->map != s.map) continue;   // no sea voyages for a day's hunting
+        float avg = (s.minLevel + s.maxLevel) / 2.0f;
+        float score = 100.0f - std::abs(avg - ideal) * 12.0f - float(TravelMinutes(a.site, s.id, a)) * 0.6f - (s.elite ? 25.0f : 0.0f);
+        scored.emplace_back(score, s.id);
+    }
+    if (scored.empty()) return 0;
+    std::stable_sort(scored.begin(), scored.end(), [](auto const& x, auto const& y) { return x.first > y.first; });
+    Rng r = R(a, P_HUNT);
+    return scored[r.Range(0, std::min<uint32>(4, uint32(scored.size()) - 1))].second;
+}
+
+uint32 World::PickNewHome(SimAgent const& a) const
+{
+    uint32 best = 0, bestMin = UINT32_MAX;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.id != a.home && HasFittingHunt(a, s.id, 2500.0f))
+        {
+            uint32 m = TravelMinutes(a.site, s.id, a);
+            if (m < bestMin) { bestMin = m; best = s.id; }
+        }
+    return best;
+}
