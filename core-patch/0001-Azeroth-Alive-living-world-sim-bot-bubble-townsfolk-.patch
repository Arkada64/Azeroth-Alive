+// SoloWoW: "bubble" wandering bots.
+// Keeps NpcBot.Bubble.Count free wandering bots in the player's zone (plus the zones linked to it
+// by wander nodes) and recycles wanderers that are left behind, out of the player's sight.
+// Replaces NpcBot.WanderingBots.Continents.Count (set that to 0 when the bubble is on).
+//
+// NpcBot.Bubble.Source = "sim" (default when the SoloSim live world runs): the bubble embodies the
+// simulation's people - the ones whose sim position is in the bubble's zones, nearest first - with
+// their names, levels, races and classes, and steers them toward where the sim says they are going.
+// "random": the older behavior, anonymous random wanderers.
+#ifndef SOLOWOW_BOT_BUBBLE_H
+#define SOLOWOW_BOT_BUBBLE_H
+
+#include "Define.h"
+#include <string>
+
+class Creature;
+class Unit;
+class WanderNode;
+struct Position;
+
+namespace BotBubble
+{
+    void Update(uint32 diff);
+
+    // Pinned bots are never recycled (quest givers, quest targets, escorts - later milestones).
+    void Pin(uint32 botEntry);
+    void Unpin(uint32 botEntry);
+    bool IsPinned(uint32 botEntry);
+
+    // Sim embodiment: the next wander node for an embodied sim person (nullptr = not ours, wander normally).
+    WanderNode const* NextSimNode(Creature const* bot, WanderNode const* cur);
+    // Sim agent id embodied by this bot entry, 0 if none.
+    uint32 SimAgentOf(uint32 botEntry);
+    // a sim person asked to travel with the player: "" = yes, otherwise their answer
+    std::string HireRefusal(Creature const* bot, Player const* player);
+    // Sim embodiment: called when an embodied body reached its last target. Fills where to go next (target,
+    // and nextNode when the step is along the roads), how long to wait first and how close counts as arrived.
+    // Returns false if this bot is not a sim body (wander normally).
+    bool SimLife(Creature* bot, WanderNode const* cur, Position& target, WanderNode const*& nextNode, uint32& waitMs, float& arrive);
+    void ForgetLife(uint32 botEntry);
+    // A sim body died in the game world: the sim hears of it (a defeat, or worse) on the next bubble check.
+    void OnBodyDied(Creature const* bot, Unit const* killer);
+    // Townsfolk: a seat at the inn near (cx, cy) - chair, bench or floor; released when they move on.
+    bool ClaimInnSeat(Creature* me, uint32 agent, float cx, float cy, Position& out, uint8& stand);
+    void ReleaseInnSeat(uint32 entry);
+    // A sim person's body (any kind) died in the game world.
+    void ReportFallen(uint32 agent, std::string const& killer);
+}
+
+#endif
