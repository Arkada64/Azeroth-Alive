+std::string World::EnsureReady()
+{
+    if (_ready) return "ready";
+    CreateTables();
+    if (Load())
+    {
+        _ready = true;
+        ExpandRegion();
+        FindRares();
+        EnsureCivilians();
+        CharacterDatabase.DirectExecute("DELETE FROM sim_event WHERE notable = 0");   // older saves kept every routine step
+        RebuildTownTalk();
+        return Acore::StringFormat("loaded {} sites and {} people at {}", uint32(_sites.size()), uint32(_agents.size()), Clock(_clock));
+    }
+    _sites.clear(); _agents.clear(); _relations.clear(); _memories.clear(); _bounties.clear(); _news.clear(); _hubNews.clear(); _market.clear();
+    _clock = 6 * 60; _nextAgent = 1; _nextSite = 1; _nextEvent = 1; _nextBounty = 1; _nextNews = 1; _lastDailyTick = 0;
+    // the first region (Elwynn and its neighbours) the way it was first built, then every other zone the way the wider
+    // world was added to it - 10 adventurers per town, 14 in the cities - so a new world matches a grown one
+    BootstrapSites({ 12, 40, 44, 10, 1519 });
+    if (_sites.empty()) return "no sites found - are wander nodes loaded (NpcBot.Enable = 1)?";
+    GeneratePopulation(100);
+    Save();
+    _ready = true;
+    ExpandRegion();
+    FindRares();
+    EnsureCivilians();
+    // a fortnight of history before anyone arrives: people have levels, friends, grudges and a few graves
+    SimTime start = _clock;
+    uint32 wakes = 0;
+    Advance(_clock + 14 * MIN_PER_DAY, wakes);
+    Flush(Acore::StringFormat("######## Before you arrived: {} -> {} ########", Clock(start), Clock(_clock)));
+    Persist();
+    uint32 hubs = 0, hunts = 0;
+    for (SimSite const& s : _sites) (s.type == SiteType::Hub ? hubs : hunts)++;
+    return Acore::StringFormat("new world: {} hubs, {} hunting grounds, {} people, after a fortnight of history", hubs, hunts, uint32(_agents.size()));
+}
+
+std::string World::Reset()
+{
+    // in a running world the bodies out there still belong to the old people: start fresh from the launcher instead
+    if (_live && _liveStarted)
+        return "The live world can't be reset while it runs - use 'Start fresh' in the launcher (or scripts\\reset-sim.ps1) with the world stopped.";
+    for (char const* t : SIM_TABLES) CharacterDatabase.DirectExecute(Acore::StringFormat("DROP TABLE IF EXISTS {}", t));
+    _sites.clear(); _agents.clear(); _relations.clear(); _memories.clear(); _pending.clear();
+    _bounties.clear(); _news.clear(); _hubNews.clear(); _market.clear(); _socialChronicled.clear(); _rain.clear();
+    _errands.clear(); _mail.clear(); _rumors.clear(); _notices.clear(); _camps.clear(); _nextCamp = 1; _townOf.clear(); _rares.clear(); _rareDownUntil.clear(); _requeue.clear();
+    _nextErrand = 1; _lastBountyTick = 0;
+    _ready = false;
+    _siteRoad.clear(); _flushed = 0; _liveStarted = false; _liveMs = 0; _realTime = 0;
+    return _live ? "sim data cleared - the live world rebuilds on the next server tick" : "sim data cleared - next .sim run builds a new world";
+}
