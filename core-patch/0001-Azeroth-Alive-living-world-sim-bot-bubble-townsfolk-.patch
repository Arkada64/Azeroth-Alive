+std::string World::Regard(uint32 agentId, uint32 guid) const
+{
+    int32 sum = 0; bool met = false;
+    for (SimMemory const& m : _memories)
+        if (m.agent == agentId && m.subjectType == 4 && m.subject == guid) { met = true; sum += int32(m.valence) * m.intensity / 100; }
+    if (!met) return "";
+    if (sum >= 60) return "trusts you";
+    if (sum > 0) return "remembers you kindly";
+    if (sum < -30) return "hates you";
+    if (sum < 0) return "holds a grudge";
+    return "knows your face";
+}
