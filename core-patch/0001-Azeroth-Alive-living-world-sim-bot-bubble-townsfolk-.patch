+// called from map update threads (bot AI); maps may update in parallel, the sim itself does not run meanwhile
+static std::mutex sBodyLock;
+
+uint32 World::GoalNode(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a || a->status != AgentStatus::Active) return 0;
+    uint32 site = (a->doing == Verb::Goto && !a->plan.empty() && a->plan.front().verb == Verb::Goto) ? a->plan.front().site : a->site;
+    uint32 idx = SiteRoad(site);
+    return idx == UINT32_MAX ? 0 : _roads[idx].id;
+}
+
+bool World::Intent(uint32 agentId, SimIntent& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a || a->status != AgentStatus::Active) return false;
+    out.agent = a->id; out.cls = a->cls; out.role = a->role; out.job = a->job;
+    out.travelling = a->doing == Verb::Goto && !a->plan.empty() && a->plan.front().verb == Verb::Goto;
+    out.siteId = out.travelling ? a->plan.front().site : a->site;
+    SimSite const* s = SiteById(out.siteId);
+    if (!s) return false;
+    out.siteType = s->type; out.x = s->x; out.y = s->y; out.z = s->z; out.services = s->services;
+    out.verb = out.travelling ? Verb::Idle : a->doing;
+    if (SimSite const* hs = SiteById(a->home)) { out.homeX = hs->x; out.homeY = hs->y; out.homeZ = hs->z; }
+    if (a->role == ROLE_CIVILIAN)
+        for (SimErrand const& e : _errands)
+            if (e.agent == a->id && !e.done && e.kind == ERRAND_ESCORT && e.player)
+                if (SimSite const* d = SiteById(e.site))
+                {
+                    out.escort = e.player; out.escortState = e.progress >= e.count ? 2 : 1;
+                    out.destX = d->x; out.destY = d->y; out.destZ = d->z;
+                }
+    uint32 idx = SiteRoad(out.siteId);
+    out.goalNode = idx == UINT32_MAX ? 0 : _roads[idx].id;
+    return true;
+}
+
+// The next node for an embodied person standing at cur: one step along the road toward the goal,
+// or, once there, a short stroll around it (they stay at the hunt, the camp, the town).
+WanderNode const* World::StepToward(WanderNode const* cur, uint32 goalNodeId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!cur) return nullptr;
+    uint32 gi = RoadIdx(goalNodeId);
+    WanderNode const* goal = WanderNode::FindInAllWPs(goalNodeId);
+    if (gi == UINT32_MAX || !goal || goal->GetMapId() != cur->GetMapId()) return nullptr;
+
+    if (cur->GetWPId() == goalNodeId || cur->GetExactDist2d(goal) < 60.0f)
+    {
+        std::vector<WanderNode const*> stroll;
+        WanderNode const* closest = nullptr; float closestD = 1e9f;
+        for (WanderNode::WanderNodeLink const& l : cur->GetLinks())
+        {
+            if (!l.wp || l.wp == cur) continue;
+            float d = l.wp->GetExactDist2d(goal);
+            if (d < 150.0f) stroll.push_back(l.wp);
+            if (d < closestD) { closestD = d; closest = l.wp; }
+        }
+        if (cur->GetWPId() != goalNodeId && goal != cur) stroll.push_back(goal);
+        if (!stroll.empty()) return stroll[urand(0, uint32(stroll.size()) - 1)];
+        return closest;
+    }
+
+    std::vector<float> const& d = DistTo(gi);
+    WanderNode const* best = nullptr; float bestD = 1e9f;
+    for (WanderNode::WanderNodeLink const& l : cur->GetLinks())
+    {
+        if (!l.wp || l.wp == cur) continue;
+        uint32 vi = RoadIdx(l.wp->GetWPId());
+        if (vi == UINT32_MAX) continue;
+        float total = cur->GetExactDist(l.wp) + d[vi];
+        if (total < bestD) { bestD = total; best = l.wp; }
+    }
+    return bestD < 1e8f ? best : nullptr;
+}
+
+std::string World::Doing(SimAgent const& a) const
+{
+    switch (a.status)
+    {
+        case AgentStatus::Recovering: return Acore::StringFormat("recovering in {}", SiteName(a.home));
+        case AgentStatus::Dead: return a.deathCause.empty() ? std::string("dead") : "dead, " + a.deathCause;
+        case AgentStatus::Gone: return "gone from the region";
+        case AgentStatus::Hired: return "hired";
+        default: break;
+    }
+    switch (a.doing)
+    {
+        case Verb::Goto:
+            if (!a.plan.empty())
+                return Acore::StringFormat("on the road from {} to {} ({} min to go)", SiteName(a.site), SiteName(a.plan.front().site), a.wakeAt > _clock ? a.wakeAt - _clock : 0);
+            break;
+        case Verb::Fight:     return Acore::StringFormat("hunting {}", SiteName(a.site));
+        case Verb::Gather:    return Acore::StringFormat("gathering {}", PlaceOnly(SiteName(a.site)));
+        case Verb::Sleep:     return std::string(a.role == ROLE_CIVILIAN ? "asleep at home in " : "asleep in ") + SiteName(a.site);
+        case Verb::Work:      return std::string(a.job == JOB_FARMHAND ? "working the fields by " : a.job == JOB_LABORER ? "hauling timber in " : "helping at the market in ") + SiteName(a.site);
+        case Verb::Trade:     return Acore::StringFormat("trading in {}", SiteName(a.site));
+        case Verb::Socialize: return Acore::StringFormat("at the inn in {}", SiteName(a.site));
+        case Verb::Train:     return Acore::StringFormat("with the trainers in {}", SiteName(a.site));
+        case Verb::Recover:   return Acore::StringFormat("resting up in {}", SiteName(a.site));
+        default: break;
+    }
+    return Acore::StringFormat("in {}", SiteName(a.site));
+}
