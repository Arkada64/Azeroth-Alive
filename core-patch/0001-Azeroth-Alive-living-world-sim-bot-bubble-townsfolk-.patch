+}
+
+void World::FormParty(SimAgent& leader, uint32 site, uint32 minutes, uint32 want, bool open)
+{
+    want = std::clamp<uint32>(want, 1, 2);
+    auto free = [&](SimAgent const* o) {
+        if (!o || o->id == leader.id || o->status != AgentStatus::Active || o->site != leader.site || o->party || o->role != ROLE_ADVENTURER) return false;
+        if (o->doing != Verb::Socialize && o->doing != Verb::Trade && o->doing != Verb::Idle) return false;
+        return o->wounds <= 40 && o->fatigue <= 60 && std::abs(int32(o->level) - int32(leader.level)) <= 4;
+    };
+    auto rivals = [&](uint32 x) {
+        return std::ranges::any_of(_relations, [&](SimRelation const& rel) {
+            return rel.kind == 2 && ((rel.a == leader.id && rel.b == x) || (rel.b == leader.id && rel.a == x)); });
+    };
+    // friends at the same place who are awake and free, of similar level, come along
+    std::vector<SimAgent*> mates;
+    for (SimRelation const& rel : _relations)
+    {
+        if (mates.size() >= want) break;
+        if (rel.kind == 2 || rel.strength < 40 || (rel.a != leader.id && rel.b != leader.id)) continue;
+        SimAgent* o = AgentById(rel.a == leader.id ? rel.b : rel.a);
+        if (free(o)) mates.push_back(o);
+    }
+    // a dangerous job: the leader asks around town, and the brave answer (strangers become acquaintances)
+    std::vector<SimAgent*> strangers;
+    if (open)
+        for (auto& [id, o] : _agents)
+        {
+            if (mates.size() >= want) break;
+            if (!free(&o) || o.bravery < 35 || rivals(o.id) || std::ranges::find(mates, &o) != mates.end()) continue;
+            mates.push_back(&o);
+            strangers.push_back(&o);
+        }
+    for (SimAgent* s : strangers)
+    {
+        auto it = std::ranges::find_if(_relations, [&](SimRelation const& rel) {
+            return (rel.a == leader.id && rel.b == s->id) || (rel.b == leader.id && rel.a == s->id); });
+        if (it == _relations.end()) _relations.push_back({ std::min(leader.id, s->id), std::max(leader.id, s->id), 1, 25 });
+        else it->strength = int8(std::min(100, it->strength + 10));
+    }
+    if (mates.empty()) return;
+    uint32 pid = _nextParty++;
+    leader.party = pid;
+    leader.partySize = uint8(1 + mates.size());
+    std::string names = leader.FullName();
+    for (SimAgent* m : mates)
+    {
+        m->party = pid;
+        m->partySize = uint8(1 + mates.size());
+        m->plan.clear();
+        if (site != m->site) m->plan.push_back({ Verb::Goto, site, 0, false });
+        m->plan.push_back({ Verb::Fight, site, minutes, false });
+        StartStep(*m);
+        _requeue.push_back(m->id);
+        names += (m == mates.back()) ? " and " + m->FullName() : ", " + m->FullName();
+    }
+    // a pair or trio makes the chronicle at most every 5 days
+    auto key = std::make_pair(std::min(leader.id, mates[0]->id), std::max(leader.id, mates[0]->id) + 1000000);
+    auto seen = _socialChronicled.find(key);
+    bool chronicle = seen == _socialChronicled.end() || _clock - seen->second >= 7 * MIN_PER_DAY;
+    if (chronicle) _socialChronicled[key] = _clock;
+    Log(EventType::PartyFormed, leader, leader.site, Acore::StringFormat("{} set out together to hunt {}.", names, SiteName(site)), chronicle, mates[0]->id);
+}
