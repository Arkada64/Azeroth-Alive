+// =====================================================================================================
+// roads: the wander-node graph
+// =====================================================================================================
+void World::BuildRoads() const
+{
+    _roadsBuilt = true;
+    _roads.clear(); _roadIdx.clear(); _distTo.clear();
+    if (WanderNode::GetAllWPsCount() == 0) { _roadsBuilt = false; return; }
+    WanderNode::DoForAllWPs([this](WanderNode const* wp) {
+        RoadNode n; n.id = wp->GetWPId(); n.map = wp->GetMapId(); n.zone = wp->GetZoneId();
+        n.x = wp->GetPositionX(); n.y = wp->GetPositionY(); n.z = wp->GetPositionZ();
+        _roadIdx[n.id] = uint32(_roads.size());
+        _roads.push_back(std::move(n));
+    });
+    WanderNode::DoForAllWPs([this](WanderNode const* wp) {
+        uint32 from = _roadIdx.at(wp->GetWPId());
+        for (WanderNode::WanderNodeLink const& l : wp->GetLinks())
+        {
+            if (!l.wp) continue;
+            auto it = _roadIdx.find(l.wp->GetWPId());
+            if (it == _roadIdx.end() || _roads[it->second].map != _roads[from].map) continue;
+            float len = wp->GetExactDist(l.wp);
+            _roads[from].out.emplace_back(it->second, len);
+            _roads[it->second].in.emplace_back(from, len);
+        }
+    });
+    LOG_INFO("server.loading", "SoloWoW sim: road graph has {} nodes", uint32(_roads.size()));
+}
+
+uint32 World::RoadIdx(uint32 wpId) const
+{
+    if (!_roadsBuilt) BuildRoads();
+    auto it = _roadIdx.find(wpId);
+    return it == _roadIdx.end() ? UINT32_MAX : it->second;
+}
+
+uint32 World::NearestRoad(uint32 map, float x, float y) const
+{
+    if (!_roadsBuilt) BuildRoads();
+    uint32 best = UINT32_MAX; float bestD = 1e9f;
+    for (uint32 i = 0; i < _roads.size(); ++i)
+    {
+        RoadNode const& n = _roads[i];
+        if (n.map != map || (n.out.empty() && n.in.empty())) continue;
+        float d = Dist2d(n.x, n.y, x, y);
+        if (d < bestD) { bestD = d; best = i; }
+    }
+    return best;
+}
+
+// Dijkstra over reversed links from idx: result[i] = yards to walk from node i to node idx.
+std::vector<float> const& World::DistTo(uint32 idx) const
+{
+    if (!_roadsBuilt) BuildRoads();
+    auto it = _distTo.find(idx);
+    if (it != _distTo.end()) return it->second;
+    std::vector<float>& d = _distTo[idx];
+    d.assign(_roads.size(), 1e9f);
+    if (idx >= _roads.size()) return d;
+    using QI = std::pair<float, uint32>;
+    std::priority_queue<QI, std::vector<QI>, std::greater<QI>> q;
+    d[idx] = 0; q.push({ 0.0f, idx });
+    while (!q.empty())
+    {
+        auto [dist, u] = q.top(); q.pop();
+        if (dist > d[u]) continue;
+        for (auto const& [v, len] : _roads[u].in)
+            if (dist + len < d[v]) { d[v] = dist + len; q.push({ d[v], v }); }
+    }
+    return d;
+}
+
+uint32 World::SiteRoad(uint32 siteId) const
+{
+    auto it = _siteRoad.find(siteId);
+    if (it != _siteRoad.end()) return it->second;
+    SimSite const* s = SiteById(siteId);
+    uint32 idx = s ? NearestRoad(s->map, s->x, s->y) : UINT32_MAX;
+    _siteRoad[siteId] = idx;
+    return idx;
+}
+
+std::vector<uint32> World::Route(uint32 fromIdx, uint32 toIdx) const
+{
+    std::vector<uint32> path;
+    if (fromIdx >= _roads.size() || toIdx >= _roads.size()) return path;
+    std::vector<float> const& d = DistTo(toIdx);
+    if (d[fromIdx] >= 1e8f) return path;
+    uint32 cur = fromIdx;
+    path.push_back(cur);
+    while (cur != toIdx && path.size() < 4000)
+    {
+        uint32 next = UINT32_MAX; float best = 1e9f;
+        for (auto const& [v, len] : _roads[cur].out)
+            if (len + d[v] < best) { best = len + d[v]; next = v; }
+        if (next == UINT32_MAX) break;
+        cur = next;
+        path.push_back(cur);
+    }
+    return path;
+}
+
+// =====================================================================================================
+// embodiment: where is everyone, and where are they going
+// =====================================================================================================
+bool World::BodyOf(SimAgent const& a, SimBody& b) const
+{
+    if (a.status != AgentStatus::Active || !a.sourceEntry) return false;
+    SimSite const* here = SiteById(a.site);
+    if (!here) return false;
+    b.agent = a.id; b.name = a.FullName(); b.race = a.race; b.cls = a.cls; b.gender = a.gender; b.level = a.level;
+    b.sourceEntry = a.sourceEntry; b.map = here->map; b.doing = a.doing;
+    b.role = a.role; b.job = a.job; b.home = a.home; b.veteran = a.role == ROLE_CIVILIAN && a.kills > 0;
+
+    uint32 hereIdx = SiteRoad(a.site);
+    if (a.role == ROLE_CIVILIAN)
+    {
+        // townsfolk are out unless they're home asleep; they appear at their own door (the body finds it)
+        if (a.doing == Verb::Sleep || hereIdx == UINT32_MAX) return false;
+        b.x = here->x; b.y = here->y; b.z = here->z;
+        b.spawnNode = b.goalNode = _roads[hereIdx].id;
+        b.zone = _roads[hereIdx].zone;
+        return true;
+    }
+    if (a.doing == Verb::Goto && !a.plan.empty() && a.plan.front().verb == Verb::Goto)
+    {
+        SimSite const* there = SiteById(a.plan.front().site);
+        if (there && there->map != here->map) return false;  // at sea: no body until they land
+        uint32 thereIdx = SiteRoad(a.plan.front().site);
+        uint32 total = std::max<uint32>(1, a.plan.front().minutes);
+        float now = float(_clock) + float(_liveMs % 60000) / 60000.0f;
+        float frac = std::clamp((now - float(a.wakeAt - std::min(a.wakeAt, total))) / float(total), 0.0f, 1.0f);
+        std::vector<uint32> path = Route(hereIdx, thereIdx);
+        if (there && !path.empty())
+        {
+            // polyline: site -> nodes -> site; find the point at frac of its length
+            std::vector<std::array<float, 3>> pts;
+            pts.push_back({ here->x, here->y, here->z });
+            for (uint32 i : path) pts.push_back({ _roads[i].x, _roads[i].y, _roads[i].z });
+            pts.push_back({ there->x, there->y, there->z });
+            float length = 0;
+            for (size_t i = 1; i < pts.size(); ++i) length += Dist2d(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1]);
+            float want = length * frac, walked = 0;
+            size_t seg = 1;
+            for (; seg < pts.size(); ++seg)
+            {
+                float l = Dist2d(pts[seg - 1][0], pts[seg - 1][1], pts[seg][0], pts[seg][1]);
+                if (walked + l >= want || seg + 1 == pts.size())
+                {
+                    float t = l > 0 ? std::clamp((want - walked) / l, 0.0f, 1.0f) : 1.0f;
+                    b.x = pts[seg - 1][0] + (pts[seg][0] - pts[seg - 1][0]) * t;
+                    b.y = pts[seg - 1][1] + (pts[seg][1] - pts[seg - 1][1]) * t;
+                    b.z = pts[seg - 1][2] + (pts[seg][2] - pts[seg - 1][2]) * t;
+                    break;
+                }
+                walked += l;
+            }
+            // appear at the next node ahead on the road (pts[k] is path[k-1])
+            size_t ahead = std::clamp<size_t>(seg, 1, path.size());
+            b.spawnNode = _roads[path[ahead - 1]].id;
+            b.goalNode = _roads[thereIdx].id;
+            b.zone = _roads[path[ahead - 1]].zone;
+            return true;
+        }
+    }
+    if (hereIdx == UINT32_MAX) return false;
+    b.x = here->x; b.y = here->y; b.z = here->z;
+    b.spawnNode = b.goalNode = _roads[hereIdx].id;
+    b.zone = _roads[hereIdx].zone;
+    return true;
+}
+
+void World::Bodies(uint32 mapId, std::vector<SimBody>& out)
+{
+    out.clear();
+    if (!_ready) return;
+    for (auto const& [id, a] : _agents)
+    {
+        SimBody b;
+        if (BodyOf(a, b) && b.map == mapId) out.push_back(std::move(b));
+    }
+}
