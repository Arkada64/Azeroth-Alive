+std::string World::PlayerDrop(uint32 guid, std::string const& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    uint32 n = 0;
+    for (SimBounty& b : _bounties)
+        if (!b.done && b.player == guid) { b.player = 0; b.playerProgress = 0; ++n; }
+    (void)name;
+    return n ? Acore::StringFormat("You took your name off {} {}.", n, n == 1 ? "bounty" : "bounties") : "You have no bounties.";
+}
