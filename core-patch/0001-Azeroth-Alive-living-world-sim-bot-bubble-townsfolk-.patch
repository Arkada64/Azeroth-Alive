+bool World::ErrandFor(uint32 agentId, SimErrand& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand const& e : _errands)
+        if (e.agent == agentId && !e.done) { out = e; return true; }
