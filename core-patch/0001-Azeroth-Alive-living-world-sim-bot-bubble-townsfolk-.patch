+// after a restart: what each town has been talking about comes back from the saved chronicle events
+void World::RebuildTownTalk()
+{
+    _rumors.clear(); _notices.clear();
+    SimTime since = _clock > 14 * MIN_PER_DAY ? _clock - 14 * MIN_PER_DAY : 0;
+    std::vector<std::tuple<SimTime, uint32, std::string>> rows;
+    if (QueryResult r = CharacterDatabase.Query("SELECT at, site, text FROM sim_event WHERE notable = 1 AND site <> 0 AND at >= {} ORDER BY id DESC LIMIT 6000", since))
+        do { Field* f = r->Fetch(); rows.emplace_back(f[0].Get<uint32>(), f[1].Get<uint32>(), f[2].Get<std::string>()); } while (r->NextRow());
+    for (auto it = rows.rbegin(); it != rows.rend(); ++it)
+        if (uint32 town = TownOf(std::get<1>(*it)))
+        {
+            auto& r = _rumors[town];
+            r.push_back(std::get<2>(*it));
+            if (r.size() > 8) r.erase(r.begin());
+            auto& n = _notices[town];
+            n.emplace_back(std::get<0>(*it), std::get<2>(*it));
+            if (n.size() > 15) n.pop_front();
+        }
+}
+
+// the board's notices: the latest happenings in and around this town, oldest first
+std::string World::Notices(uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    uint32 hub = _ready ? HubNear(map, x, y, 120.0f) : 0;
+    if (!hub) return "There's no board here.";
+    auto it = _notices.find(hub);
+    if (it == _notices.end() || it->second.empty()) return Acore::StringFormat("Notices, {}: nothing pinned up lately.", SiteName(hub));
+    std::string out = Acore::StringFormat("Notices, {}:", SiteName(hub));
+    for (auto const& [at, text] : it->second)
+        out += Acore::StringFormat("\n{} - {}", Clock(at), text);
+    return out;
+}
+
+// "Have you seen ...?": anyone in the world by name (given name, or full name). Where they are, or what became of them.
+std::string World::AskAfter(std::string const& asked)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    auto lower = [](std::string s) { for (char& ch : s) ch = char(std::tolower(uint8(ch))); return s; };
+    std::string q = lower(asked);
+    while (!q.empty() && std::isspace(uint8(q.back()))) q.pop_back();
+    while (!q.empty() && std::isspace(uint8(q.front()))) q.erase(q.begin());
+    if (q.size() < 2) return "Who? You'll have to give me a name.";
+    std::vector<SimAgent const*> found;
+    for (auto const& [id, a] : _agents)
+        if (lower(a.FullName()) == q || lower(a.given) == q || lower(a.family) == q) found.push_back(&a);
+    if (found.empty()) return Acore::StringFormat("{}? Never heard of anyone by that name.", asked);
+    // the living first, then the most recently dead
+    std::ranges::stable_sort(found, [](SimAgent const* x, SimAgent const* y) {
+        bool xa = x->status != AgentStatus::Dead, ya = y->status != AgentStatus::Dead;
+        return xa != ya ? xa : x->diedAt > y->diedAt; });
+    auto about = [this](SimAgent const& a) -> std::string {
+        SimSite const* s = SiteById(a.site);
+        std::string where = s ? AreaOf(SiteName(s->id)) : std::string("somewhere");
+        switch (a.status)
+        {
+            case AgentStatus::Dead:
+                return Acore::StringFormat("{} died on {} near {}{}.", a.FullName(), Clock(a.diedAt), where, a.deathCause.empty() ? "" : " - " + a.deathCause);
+            case AgentStatus::Gone:       return Acore::StringFormat("{} left these parts a while back.", a.FullName());
+            case AgentStatus::Recovering: return Acore::StringFormat("{} is laid up, getting over a bad beating, near {}.", a.FullName(), where);
+            case AgentStatus::Hired:      return Acore::StringFormat("{} went off travelling with someone.", a.FullName());
+            default:
+                if (a.role == ROLE_CIVILIAN) return Acore::StringFormat("{} lives in {} - you'll find {} about town.", a.FullName(), SiteName(a.home), a.gender ? "her" : "him");
+                if (a.role == ROLE_THREAT) return Acore::StringFormat("{}? Last anyone saw, it was prowling near {}. Don't go alone.", a.FullName(), where);
+                return Acore::StringFormat("{} was last seen {}.", a.FullName(), Doing(a));
+        }
+    };
+    std::string out = about(*found[0]);
+    if (found.size() > 1)
+    {
+        out = Acore::StringFormat("There's more than one by that name. {}", out);
+        for (size_t i = 1; i < std::min<size_t>(found.size(), 3); ++i) out += " " + about(*found[i]);
+    }
+    return out;
+}
+
+// Where people have been dying lately near this town (the last 30 days), and from an old hand, a rare they know of.
+std::string World::Advice(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    SimSite const* home = a ? SiteById(a->home) : nullptr;
+    if (!home) return "";
+    std::map<uint32, uint32> deaths;                       // site -> deaths
+    std::map<uint32, std::string> killer;
+    for (auto const& [id, o] : _agents)
+        if (o.status == AgentStatus::Dead && _clock - o.diedAt < 30 * MIN_PER_DAY)
+            if (SimSite const* s = SiteById(o.site); s && s->map == home->map && Dist2d(s->x, s->y, home->x, home->y) < 2000.0f)
+            {
+                ++deaths[s->id];
+                if (s->type == SiteType::Hunt) killer[s->id] = s->creatureName;
+            }
+    std::string out;
+    if (deaths.empty())
+        out = "Nobody from round here has died on the road this month. Doesn't mean they won't.";
+    else
+    {
+        auto worst = std::ranges::max_element(deaths, [](auto const& x, auto const& y) { return x.second < y.second; });
+        std::string what = killer.contains(worst->first) ? " - " + killer[worst->first] + "s, they say" : "";
+        static char const* const n[] = { "", "one", "two", "three", "four", "five" };
+        out = worst->second == 1
+            ? Acore::StringFormat("Mind yourself near {}{}. Someone died out there this month.", AreaOf(SiteName(worst->first)), what)
+            : Acore::StringFormat("Stay clear of {}{}. It's taken {} people this month.", AreaOf(SiteName(worst->first)), what,
+                worst->second <= 5 ? std::string(n[worst->second]) : std::to_string(worst->second));
+    }
+    if (a->kills > 0)                                      // an old hand knows the named ones
+        for (SimRare const& x : _rares)
+            if (SimSite const* s = SiteById(x.site); s && s->map == home->map && Dist2d(s->x, s->y, home->x, home->y) < 1800.0f
+                && !(_rareDownUntil.contains(x.entry) && _rareDownUntil.at(x.entry) > _clock))
+            {
+                out += Acore::StringFormat(" And there's {} out by {}. I've seen it - level {} or so{}. Don't go alone.", x.name, AreaOf(SiteName(s->id)),
+                    x.level, x.elite ? ", and tougher than it looks" : "");
+                break;
+            }
+    return out;
+}
+
+std::string World::Rumor(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a) return "";
+    auto it = _rumors.find(a->home);
+    if (it == _rumors.end() || it->second.empty())
+    {
+        static char const* const quiet[] = { "Quiet week. Can't complain.", "Nothing worth telling, I'm afraid.", "Same as ever - work, sleep, work." };
+        return quiet[(a->id + _clock / 60) % 3];
+    }
+    std::string const& news = it->second[(a->id + _clock / 30) % it->second.size()];
+    static char const* const lead[] = { "Did you hear? ", "They were saying at the inn: ", "Word is: " };
+    return lead[a->id % 3] + news;
+}
+
+std::vector<SimSite> World::InnTowns(uint32 map) const
+{
+    std::vector<SimSite> out;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.map == map) out.push_back(s);
+    return out;
+}
+
+std::string World::Board() const
+{
+    if (!_ready) return "sim not started";
+    static char const* const kinds[] = { "thinning", "a pack", "elites", "a named rare", "a threat" };
+    std::string out = Acore::StringFormat("{}. Bounty boards:", Clock(_clock));
+    uint32 shown = 0;
+    for (SimBounty const& b : _bounties)
+    {
+        if (b.done) continue;
+        ++shown;
+        std::string what = b.kind == BOUNTY_RARE ? ((b.target & (THREAT_MARK | CAMP_MARK)) ? Acore::StringFormat("{} near {}", RareName(b.target), AreaOf(SiteName(b.site)))
+        : Acore::StringFormat("one rare near {}", AreaOf(SiteName(b.site)))) : Acore::StringFormat("{} of the {}", b.count, SiteName(b.site));
+        std::string who = "nobody has taken it";
+        if (b.taker)
+            for (auto const& [id, a] : _agents)
+                if (a.id == b.taker) who = Acore::StringFormat("taken by {} ({}/{})", a.FullName(), a.bountyProgress, b.count);
+        out += Acore::StringFormat("\n  {} - {}: {} for {}{}; {}; {} h left", SiteName(b.hub), kinds[(b.target & THREAT_MARK) ? 4 : (b.target & CAMP_MARK) ? 1 : std::min<uint8>(b.kind, 3)], what, Money(b.reward),
+            b.party > 1 ? Acore::StringFormat(", bring {}", b.party) : std::string(), who, b.expires > _clock ? (b.expires - _clock) / 60 : 0);
+    }
+    if (!shown) out += "\n  (nothing posted right now)";
+    return out;
+}
+
+std::string World::People(uint32 mapId, float x, float y, bool nearest, uint32 guid)
+{
+    if (!_ready) return "sim not started";
+    std::vector<SimBody> bodies;
+    Bodies(mapId, bodies);
+    std::string out;
+    if (nearest)
+    {
+        std::ranges::sort(bodies, [x, y](SimBody const& p, SimBody const& q) { return Dist2d(p.x, p.y, x, y) < Dist2d(q.x, q.y, x, y); });
+        out = Acore::StringFormat("{}. Nearest of {} people out and about:", Clock(_clock), uint32(bodies.size()));
+        for (size_t i = 0; i < bodies.size() && i < 12; ++i)
+            if (SimAgent const* a = const_cast<World*>(this)->AgentById(bodies[i].agent))
+                { std::string regard = guid ? Regard(a->id, guid) : std::string(); out += Acore::StringFormat("\n{} yd - {}: {}{}", uint32(Dist2d(bodies[i].x, bodies[i].y, x, y)), Who(*a), Doing(*a), regard.empty() ? std::string() : " (" + regard + ")"); }
+        return out;
+    }
+    std::map<uint32, uint32> perZone, travelling;
+    for (SimBody const& b : bodies) { ++perZone[b.zone]; if (b.doing == Verb::Goto) ++travelling[b.zone]; }
+    out = Acore::StringFormat("{}. {} people out and about on map {}:", Clock(_clock), uint32(bodies.size()), mapId);
+    for (auto const& [zone, n] : perZone)
+    {
+        AreaTableEntry const* area = sAreaTableStore.LookupEntry(zone);
+        out += Acore::StringFormat("\n  {}: {} ({} on the road)", area ? area->area_name[0] : "zone " + std::to_string(zone), n, travelling[zone]);
+    }
+    uint32 shown = 0;
+    for (SimBody const& b : bodies)
+        if (b.doing == Verb::Goto && shown++ < 8)
+            if (SimAgent const* a = const_cast<World*>(this)->AgentById(b.agent))
+                out += Acore::StringFormat("\n  {}: {} - now at ({:.0f}, {:.0f}), next road node {}", Who(*a), Doing(*a), b.x, b.y, b.spawnNode);
+    return out;
+}
+
+// =====================================================================================================
+// live mode
+// =====================================================================================================
+void World::Update(uint32 diff)
+{
+    if (!_liveChecked)
+    {
+        _liveChecked = true;
+        _live = sConfigMgr->GetOption<bool>("SoloSim.Live.Enable", true);
+        _liveScale = std::max(0.0f, sConfigMgr->GetOption<float>("SoloSim.Live.TimeScale", 1.0f));
+        _catchUpHours = sConfigMgr->GetOption<uint32>("SoloSim.Live.CatchUpHours", 168);
+    }
+    if (!_live) return;
+    if (!_liveStarted || !_ready) { StartLive(); return; }
+
+    _liveMs += uint64(float(diff) * _liveScale);
+    if (_liveMs >= 60000)
+    {
+        SimTime minutes = SimTime(_liveMs / 60000);
+        _liveMs %= 60000;
+        uint32 wakes = 0;
+        Advance(_clock + minutes, wakes);
+        Flush("");
+    }
+    _saveTimer += diff;
+    if (_saveTimer >= 10 * 60 * 1000) { _saveTimer = 0; Persist(); }
+    DeliverMail();
+    _marketTimer += diff;
+    if (_marketTimer >= 2 * 60 * 1000) { _marketTimer = 0; SyncMarkets(); }
+}
+
+void World::StartLive()
+{
+    _liveStarted = true;
+    uint32 ms = getMSTime();
+    std::string ready = EnsureReady();
+    if (!_ready)
+    {
+        LOG_ERROR("server.loading", "SoloWoW sim: cannot go live: {}", ready);
+        _live = false;
+        return;
+    }
+    // hired bodies don't outlive a server restart (NPCBots keeps no generated bots): they went home
+    for (auto& [id, ag] : _agents)
+        if (ag.status == AgentStatus::Hired) { ag.status = AgentStatus::Active; ag.site = ag.home; ag.plan.clear(); ag.doing = Verb::Idle; ag.wakeAt = _clock; }
+    SimTime from = _clock, target = _clock;
+    // the world went on while the server was off (capped)
+    uint64 now = uint64(std::time(nullptr));
+    if (_realTime && now > _realTime)
+        target += SimTime(float(std::min<uint64>(now - _realTime, uint64(_catchUpHours) * 3600)) * _liveScale / 60.0f);
+    // at real speed, sim days follow the clock on the wall: move forward to the same time of day
+    if (_liveScale == 1.0f)
+    {
+        std::time_t t = std::time(nullptr);
+        std::tm local{};
+#ifdef _WIN32
+        localtime_s(&local, &t);
+#else
+        localtime_r(&t, &local);
+#endif
+        SimTime tod = SimTime(local.tm_hour * 60 + local.tm_min);
+        target += (tod + MIN_PER_DAY - target % MIN_PER_DAY) % MIN_PER_DAY;
+    }
+    uint32 wakes = 0;
+    _away = target - from > 60; _awayMajor = 0;            // more than an hour gone: the quieter rules apply
+    Advance(target, wakes);
+    _away = false;
+    Flush(Acore::StringFormat("######## Live: {} -> {} ({} while the world was quiet) ########", Clock(from), Clock(target),
+        target - from >= 60 ? Acore::StringFormat("{} hours", (target - from) / 60) : std::string("caught up")));
+    Persist();
+    SyncMarkets();
+    _liveMs = 0; _saveTimer = 0;
+    LOG_INFO("server.loading", "SoloWoW sim: live at {} ({}; caught up {} sim-minutes in {} ms). {}", Clock(_clock), ready, target - from, GetMSTimeDiffToNow(ms), Status());
+}
+
