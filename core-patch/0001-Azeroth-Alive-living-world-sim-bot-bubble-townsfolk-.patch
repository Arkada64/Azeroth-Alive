+                                                 : Acore::StringFormat("{} of the {}", b.count, SiteName(b.site));
+        std::string text = Acore::StringFormat("{}{} - {}{}", kinds[(b.target & THREAT_MARK) ? 4 : (b.target & CAMP_MARK) ? 1 : std::min<uint8>(b.kind, 3)], what, Money(b.reward), b.party > 1 ? Acore::StringFormat(", bring {}", b.party) : std::string());
