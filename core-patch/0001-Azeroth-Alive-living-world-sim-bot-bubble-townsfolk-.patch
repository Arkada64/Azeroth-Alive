+// =====================================================================================================
+// v2: news travels town to town with people
+// =====================================================================================================
+void World::MakeNews(SimAgent const& dead, SimSite const& site)
+{
+    SimNews n; n.id = _nextNews++; n.subject = dead.id; n.site = site.id; n.at = _clock;
+    _news.push_back(n);
+    // the nearest town hears first (someone found the body, or the survivors brought word)
+    uint32 hub = 0; float best = 1e9f;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub) { float d = Dist2d(s.x, s.y, site.x, site.y); if (d < best) { best = d; hub = s.id; } }
+    if (hub) _hubNews[hub].push_back(n.id);
+    std::erase_if(_news, [this](SimNews const& x) { return _clock - x.at > 30 * MIN_PER_DAY; });
+}
+
+void World::LearnNews(SimAgent& a, SimNews const& n, char const* how)
+{
+    if (std::find(a.knownNews.begin(), a.knownNews.end(), n.id) != a.knownNews.end()) return;
+    a.knownNews.push_back(n.id);
+    if (a.knownNews.size() > 40) a.knownNews.erase(a.knownNews.begin());
+    SimAgent* dead = AgentById(n.subject);
+    if (!dead || dead->id == a.id) return;
+    for (SimRelation const& rel : _relations)
+    {
+        if (!((rel.a == a.id && rel.b == dead->id) || (rel.b == a.id && rel.a == dead->id))) continue;
+        uint32 days = (_clock - n.at) / MIN_PER_DAY;
+        std::string when = days == 0 ? "" : days == 1 ? ", a day after it happened" : Acore::StringFormat(", {} days after it happened", days);
+        _memories.push_back({ a.id, 1, dead->id, uint8(EventType::Died), int8(rel.kind == 2 ? 10 : -80), 90, _clock });
+        if (rel.kind == 2)
+        {
+            Log(EventType::HeardDeath, a, a.site, Acore::StringFormat("{} {} that their rival {} was dead{}, and did not mourn.", a.FullName(), how, dead->FullName(), when), true, dead->id);
+            return;
+        }
+        Log(EventType::HeardDeath, a, a.site, Acore::StringFormat("{} {} that {} was killed by {}{}.", a.FullName(), how, dead->FullName(), SiteName(n.site), when), true, dead->id);
+        SimSite const* site = SiteById(n.site);
+        if (site && a.bravery > 50 && a.ambition != AmbitionType::Avenge && a.level + 3 >= site->minLevel)
+        {
+            a.ambition = AmbitionType::Avenge; a.ambitionTarget = site->id; a.ambitionProgress = 0; a.avengeFor = dead->id;
+            Log(EventType::AmbitionSet, a, a.site, Acore::StringFormat("{} swore to avenge {} against the {}.", a.FullName(), dead->FullName(), SiteName(site->id)), true, dead->id);
+        }
+        return;
+    }
+}
+
+void World::ExchangeNews(SimAgent& a)
+{
+    SimSite const* s = SiteById(a.site);
+    if (!s || s->type != SiteType::Hub) return;
+    std::vector<uint32>& here = _hubNews[s->id];
+    // the traveller hears what the town knows...
+    for (uint32 nid : std::vector<uint32>(here))
+        for (SimNews const& n : _news)
+            if (n.id == nid) { LearnNews(a, n, Acore::StringFormat("heard in {}", SiteName(s->id)).c_str()); break; }
+    // ...and the town hears what the traveller knows
+    for (uint32 nid : a.knownNews)
+        if (std::find(here.begin(), here.end(), nid) == here.end()) here.push_back(nid);
+}
+
+// =====================================================================================================
+// combat, defeat and death
+// =====================================================================================================
+void World::ResolveFight(SimAgent& a, SimSite const& site, uint32 minutes)
+{
+    Rng r = R(a, P_FIGHT);
+    uint32 n = PartySize(a);
+    // kills per hour: a cautious, living adventurer - not a grinding player. Class, gear, training and party shift it.
+    float classMul = (a.cls == 3 || a.cls == 9) ? 1.1f : (a.cls == 5 ? 0.85f : 1.0f);
+    float trainMul = (a.level > a.trainedLevel + 2) ? 0.85f : 1.0f;                          // overdue at the trainer
+    float partyMul = n == 1 ? 1.0f : (n == 2 ? 1.6f : 2.1f);
+    float perHour = 10.0f * classMul * trainMul * partyMul * (0.8f + a.gearTier / 250.0f) * (1.1f - a.caution / 500.0f);
+    uint32 killsPlanned = std::max<uint32>(1, uint32(perHour * minutes / 60.0f));
+    float xpRate = sWorld->getRate(RATE_XP_KILL);
+    float groupRate = n > 1 ? Acore::XP::xp_in_group_rate(n, false) / float(n) : 1.0f;     // WoW's group split
+    float partySafety = std::pow(0.55f, float(n - 1));
+    uint8 gray = Acore::XP::GetGrayLevel(a.level);
+    uint8 retreatAt = uint8(35 + a.bravery * 0.45f);
+    int8 skinSlot = a.prof[0] == PROF_SKINNING ? 0 : (a.prof[1] == PROF_SKINNING ? 1 : -1);
+    uint32 kills = 0, xpGained = 0, copper = 0, skins = 0;
+    bool retreated = false;
+
+    // bounty work: a named rare to track down; or a pack, where every pull brings friends
+    float packDanger = 1.0f;
+    if (SimBounty* bb = BountyOf(a); bb && !bb->done && bb->site == site.id)
+    {
+        if (bb->kind == BOUNTY_RARE && a.bountyProgress < 1 && RareFight(a, *bb, site) && a.wounds >= 100)
+        {
+            Defeat(a, site);
+            return;
+        }
+        if (bb->kind == BOUNTY_PACK) { packDanger = 1.6f; killsPlanned = killsPlanned * 13 / 10; }
+    }
+
+    for (uint32 k = 0; k < killsPlanned; ++k)
+    {
+        uint8 mob = uint8(r.Range(site.minLevel, site.maxLevel));
+        int32 d = std::clamp<int32>(int32(mob) - int32(a.level), -4, 5);
+        float danger = std::pow(1.5f, float(d)) * (site.elite ? 3.0f : 1.0f) * (1.15f - a.gearTier / 200.0f) * (1.2f - a.caution / 250.0f) * partySafety * packDanger;
+        if (r.Chance(0.05f * danger)) a.wounds = uint8(std::min<uint32>(100, a.wounds + r.Range(5, 15)));
+        if (r.Chance(0.006f * danger)) a.wounds = uint8(std::min<uint32>(100, a.wounds + r.Range(30, 60))); // a bad pull
+        if (a.wounds >= 100) { a.kills += kills; Defeat(a, site); return; }
+
+        ++kills;
+        if (mob > gray)
+        {
+            uint32 xp = uint32(Acore::XP::BaseGain(a.level, mob, CONTENT_1_60) * xpRate * groupRate * (site.elite ? 2.0f : 1.0f));
+            a.xp += xp; xpGained += xp;
+            while (a.level < 80 && a.xp >= sObjectMgr->GetXPForLevel(a.level))
+            {
+                a.xp -= sObjectMgr->GetXPForLevel(a.level);
+                ++a.level;
+                Log(EventType::LevelUp, a, site.id, Acore::StringFormat("{} grew stronger hunting {}: now level {}.", a.FullName(), site.creatureName, a.level), a.level % 10 == 0, 0, a.level);
+            }
+        }
+        // humanoids carry coin; beasts and others leave hides, fangs and junk worth a little
+        copper += site.creatureType == 7 ? site.copperPerKill : uint32(mob * mob / 2 + 5);
+        if (skinSlot >= 0 && site.creatureType == 1 && r.Chance(0.8f)) { ++skins; copper += 10 + mob * 3; }
+        if (k % 4 == 3 && a.supplies) --a.supplies;
+        if (k % 6 == 5 && a.durability) --a.durability;
+        if (a.wounds >= retreatAt) { retreated = true; break; }
+    }
+
+    a.kills += kills;
+    a.lootValue += copper;
+    if (skins) { a.goodsUnits[PROF_SKINNING] += skins; SkillUp(a, uint8(skinSlot), skins); }
+    a.fatigue = uint8(std::min<uint32>(100, a.fatigue + minutes * 7 / 60));
+    if (a.ambition == AmbitionType::Avenge && a.ambitionTarget == site.id) a.ambitionProgress += kills;
+    if (a.bounty)
+        for (SimBounty const& b : _bounties)
+            if (b.id == a.bounty && b.site == site.id && b.kind != BOUNTY_RARE) a.bountyProgress += kills;
+    Log(EventType::Hunted, a, site.id, Acore::StringFormat("{} hunted {} x {}{} (+{} xp{}).", a.FullName(), kills, SiteName(site.id), n > 1 ? " in a party" : "",
+        xpGained, retreated ? ", pulled back wounded" : ""), false, 0, int32(kills), int32(xpGained));
+}
+
+bool World::InParty(SimAgent const& o, uint32 party) const
+{
+    return party && (o.party == party || (o.lastParty == party && _clock - o.lastPartyAt <= 60));
+}
