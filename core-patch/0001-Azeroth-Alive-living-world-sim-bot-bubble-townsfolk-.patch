+// the player stands where a missing adventurer fell: they find what's left
+std::string World::ReachedPlace(uint32 guid, uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand& e : _errands)
+    {
+        if (e.done || e.kind != ERRAND_MISSING || e.player != guid || e.progress >= e.count) continue;
+        SimAgent const* t = AgentById(e.target);
+        SimSite const* s = t ? SiteById(t->site) : nullptr;
+        if (!s || s->map != map || Dist2d(s->x, s->y, x, y) > 70.0f) continue;
+        e.progress = e.count;
+        static char const* const finds[] = { "a torn pack and a pair of boots", "a broken weapon in the grass", "a cloak caught on the brush, and blood on the stones" };
+        return Acore::StringFormat("Near {} you find {}. This is where {}{} fell. Someone in {} is waiting to hear.", AreaOf(SiteName(s->id)),
+            finds[(e.id + guid) % 3], t->FullName(), "", SiteName(t->home));
+    }
+    return "";
+}
