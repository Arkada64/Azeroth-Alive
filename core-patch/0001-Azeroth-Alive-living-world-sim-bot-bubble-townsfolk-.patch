+std::string World::PlayerKill(uint32 guid, std::string const& playerName, uint32 entry, std::string const& creatureName, uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "";
+    std::string note;
+    for (SimErrand& e : _errands)                        // a townsperson's pests, or the thieves who robbed them
+    {
+        if (e.done || e.player != guid || (e.kind != ERRAND_CULL && e.kind != ERRAND_STOLEN) || e.progress >= e.count) continue;
+        SimSite const* s = SiteById(e.site);
+        if (!s || s->map != map || Dist2d(s->x, s->y, x, y) >= 350.0f || creatureName != s->creatureName) continue;
+        ++e.progress;
+        if (e.kind == ERRAND_STOLEN && e.progress >= e.count)
+            if (SimAgent const* a = AgentById(e.agent))
+            {
+                std::string thing = StolenThing(e.id);
+                if (thing.starts_with("my ")) thing = thing.substr(3);
+                else if (thing.starts_with("the ")) thing = thing.substr(4);
+                else if (thing.starts_with("a ")) thing = thing.substr(2);
+                note = Acore::StringFormat("Among the {}'s things you find {}'s {}. Time to take it back to {}.", creatureName, a->given, thing, SiteName(a->home));
+            }
+    }
+    for (SimErrand& e : _errands)                        // an old hand's old foe, wherever it's met
+        if (!e.done && e.player == guid && e.kind == ERRAND_OLDFOE && e.progress < e.count && entry == e.target)
+        {
+            e.progress = e.count;
+            _rareDownUntil[e.target] = _clock + 7 * MIN_PER_DAY;
+            if (SimAgent const* a = AgentById(e.agent))
+                note = Acore::StringFormat("That's the {} {} told you about. {} will want to hear.", creatureName, a->given, SiteName(a->home));
+        }
+    for (SimBounty& b : _bounties)
+    {
+        if (b.done || b.player != guid || b.playerProgress >= b.count) continue;
+        SimSite const* s = SiteById(b.site);
+        if (!s || s->map != map || (Dist2d(s->x, s->y, x, y) > 350.0f && !(b.target & (THREAT_MARK | CAMP_MARK)))) continue;
+        bool counts = b.kind == BOUNTY_RARE ? entry == b.target : creatureName == s->creatureName;
+        if (!counts) continue;
+        ++b.playerProgress;
+        if (b.kind == BOUNTY_RARE) _rareDownUntil[b.target] = _clock + 7 * MIN_PER_DAY;
+        if (b.playerProgress < b.count) continue;
+        // done: the board pays out by mail, so there's no walk back for the money
+        b.done = true;
+        std::string what = b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site);
+        Log(EventType::PlayerBounty, Nobody(), b.hub, Acore::StringFormat("{} filled the {} bounty on the {} ({}).", playerName, SiteName(b.hub), what, Money(b.reward)), true);
+        _mail.push_back({ guid, b.hub, Acore::StringFormat("Bounty paid: {}", what),
+            Acore::StringFormat("Word came back that the job is done. The {} board pays what it promised - it's enclosed.\n\nWell done.", SiteName(b.hub)), b.reward });
+        if (SimAgent* t = AgentById(b.taker))
+        {
+            Log(EventType::BountyExpired, *t, b.hub, Acore::StringFormat("{} got to the {} bounty first; {} was paid nothing for the work.", playerName, SiteName(b.hub), t->FullName()), true);
+            RememberPlayer(*t, guid, -20, 60, EventType::PlayerBounty);
+            t->bounty = 0; t->bountyProgress = 0;
+        }
+    }
+    if (entry & THREAT_MARK)
+        if (SimAgent* t = AgentById(entry & ~THREAT_MARK); t && t->role == ROLE_THREAT && t->status == AgentStatus::Active)
+            ThreatDown(*t, playerName);
+    return note;
+}
