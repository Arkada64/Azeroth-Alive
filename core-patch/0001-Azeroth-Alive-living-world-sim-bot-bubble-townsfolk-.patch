+// Would they travel with this player? "" = yes; otherwise what they say instead. People who trust you always come;
+// a grudge, a big gap in experience, a cautious stranger or a hunting party of friends can each be a no.
+// The answer holds for the day (asking again won't re-roll it).
+std::string World::HireRefusal(uint32 agentId, uint32 guid, uint8 playerLevel)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    if (!a || a->role != ROLE_ADVENTURER) return "";
+    int32 sum = 0; bool met = false;
+    for (SimMemory const& m : _memories)
+        if (m.agent == agentId && m.subjectType == 4 && m.subject == guid) { met = true; sum += int32(m.valence) * m.intensity / 100; }
+    if (sum >= 60) return "";                                              // trusts you
+    Rng r(_seed, agentId, (uint64(guid) << 20) ^ (_clock / MIN_PER_DAY), P_SOCIAL + 900);
+    uint32 pick = r.Range(0, 2);
+    if (sum < -30)
+    {
+        static char const* const l[] = { "I'd sooner walk with a ghoul. Find someone else.", "You? No. Not after what you did.", "Keep walking." };
+        return l[pick];
+    }
+    if (sum < 0)
+    {
+        static char const* const l[] = { "Not after last time. Ask me again when I've forgotten it.", "I don't think so. I remember you.",
+            "Maybe some other day. Not today." };
+        return l[pick];
+    }
+    if (a->party && !r.Chance(float(100 - a->sociability) / 200.0f))
+    {
+        static char const* const l[] = { "I'm with my friends for now - maybe another time.", "We're a party already, thanks. Ask me when we're done.",
+            "Can't leave this lot to fend for themselves. Another time." };
+        return l[pick];
+    }
+    if (a->level > uint32(playerLevel) + 5 && sum < 30)
+    {
+        static char const* const l[] = { "No offence, but you'd slow me down. Come back when you've a few more scars.",
+            "I've got further to go than you can follow yet. Come find me in a while.", "You're brave, I'll give you that. Brave isn't enough out where I'm headed." };
+        return l[pick];
+    }
+    if (!met && a->caution > 70 && r.Chance(float(a->caution - 50) / 60.0f))
+    {
+        static char const* const l[] = { "I don't know you. Help me out on the road sometime and we'll talk.", "I don't travel with strangers. No offence.",
+            "Ask around about me first - and let me hear something about you." };
+        return l[pick];
+    }
+    return "";
+}
+
+void World::SetHired(uint32 agentId, uint32 guid, std::string const& name, bool hired)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent* a = AgentById(agentId);
+    if (!a) return;
+    if (hired && a->status == AgentStatus::Active)
+    {
+        a->status = AgentStatus::Hired;
+        a->plan.clear(); a->doing = Verb::Idle; a->party = 0;
+        RememberPlayer(*a, guid, 30, 60, EventType::Hired);
+        Log(EventType::Hired, *a, a->site, Acore::StringFormat("{} agreed to travel with {}.", Who(*a), name), true);
+    }
+    else if (!hired && a->status == AgentStatus::Hired)
+    {
+        a->status = AgentStatus::Active;
+        a->site = a->home; a->plan.clear(); a->doing = Verb::Idle; a->wakeAt = _clock + 1;
+        _requeue.push_back(a->id);
+        Log(EventType::Dismissed, *a, a->home, Acore::StringFormat("{} parted ways with {} and went home to {}.", Who(*a), name, SiteName(a->home)), true);
+    }
+}
