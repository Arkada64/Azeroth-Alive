+// =====================================================================================================
+// townsfolk: they live in their town, work there, drink at its inn and go home to sleep
+// =====================================================================================================
+// per job: townsfolk templates to borrow a look from (each has several faces; the model decides man or woman)
+static std::vector<uint32> const CIVILIAN_BODIES[] = {
+    { 20426, 20429, 39686, 40125 },                              // (none)
+    { 20433, 20426, 20429, 20430, 39686 },                       // farmhand: Hillsbrad Farmer and Citizens
+    { 29152, 6670, 20428, 20426 },                               // laborer: Stormwind Dock Worker, Westfall Woodworker, Citizen
+    { 40125, 39686, 20429, 20430, 20426, 20428 },                // market hand: Stormwind and Hillsbrad Citizens
+    { 20428, 20430, 40110, 39686 },                              // loafer
+};
+static std::vector<uint32> const DWARF_BODIES = { 12998, 19148 };   // Dwarven Farmer, Dwarf Commoner (men and women)
+static std::vector<uint32> const ELF_BODIES = { 19173, 15905 };     // Night Elf Commoner, Darnassus Reveler (men and women)
+
+static uint32 CivilianDisplay(uint64 seed, SimAgent const& a)
+{
+    CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(a.sourceEntry);
+    if (!t || t->Models.empty()) return 0;
+    return t->Models[uint32(Mix(seed ^ (uint64(a.id) * 0x27D4EB2Full)) % t->Models.size())].CreatureDisplayID;
+}
+
+// How tough a townsperson is: people live about as hard as the land around them. Labourers are the sturdiest,
+// market folk and idlers the least; the cities' folk have seen more; now and then an old adventurer has settled down.
+static uint8 CivilianLevel(uint64 seed, SimAgent const& a, SimSite const& home)
+{
+    Rng r(seed, a.id, home.id, P_GEN + 520);
+    bool city = home.zone == 1519 || home.zone == 1537 || home.zone == 1657;
+    float base = std::max(float(home.regionLevel), 3.0f);
+    if (city) base = std::max(base, 20.0f);
+    float lo = 0.35f, hi = 0.85f;                                    // loafers
+    if (a.job == JOB_FARMHAND) { lo = 0.6f; hi = 0.95f; }
+    else if (a.job == JOB_LABORER) { lo = 0.75f; hi = 1.1f; }
+    else if (a.job == JOB_MARKET) { lo = 0.5f; hi = 0.9f; }
+    float f = lo + (hi - lo) * float(r.Range(0, 1000)) / 1000.0f;
+    int32 lvl = int32(base * f + 0.5f);
+    if (r.Chance(0.06f)) lvl = int32(base) + int32(r.Range(8, 20));    // a retired adventurer
+    return uint8(std::clamp(lvl, 1, 60));
+}
+
+// one townsperson of h (their look, name, job and nature); age is set by the caller when it matters
+SimAgent World::MakeCivilian(SimSite const& h, uint32 id)
+{
+    bool dwarven = DWARF_ZONES.contains(h.zone), elven = ELF_ZONES.contains(h.zone);
+    Rng r(_seed, id, h.id, P_GEN + 500);
+    SimAgent a;
+    a.id = id; a.role = ROLE_CIVILIAN; a.race = dwarven ? 3 : elven ? 4 : 1; a.cls = 1; a.level = uint8(r.Range(1, 6));
+    uint32 roll = r.Range(1, 100);
+    a.job = h.zone == 1519 ? (roll <= 45 ? JOB_MARKET : roll <= 75 ? JOB_LABORER : JOB_LOAFER)
+                           : (roll <= 45 ? JOB_FARMHAND : roll <= 70 ? JOB_LABORER : roll <= 90 ? JOB_MARKET : JOB_LOAFER);
+    std::vector<uint32> const& looks = dwarven ? DWARF_BODIES : elven ? ELF_BODIES : CIVILIAN_BODIES[a.job];
+    a.sourceEntry = looks[r.Range(0, uint32(looks.size()) - 1)];
+    uint32 display = CivilianDisplay(_seed, a);
+    CreatureModelInfo const* mi = display ? sObjectMgr->GetCreatureModelInfo(display) : nullptr;
+    a.gender = mi ? uint8(mi->gender == 1 ? 1 : 0) : uint8(r.Range(0, 1));
+    NameKit const& k = Kit(a.race);
+    Rng rn(_seed, id, h.id, P_NAME);
+    auto pick = [&rn](std::vector<char const*> const& v) -> std::string { return v.empty() ? "" : v[rn.Range(0, uint32(v.size()) - 1)]; };
+    a.given = a.gender ? pick(k.fStart) + pick(k.fEnd) : pick(k.mStart) + pick(k.mEnd);
+    a.family = pick(k.famRoot) + pick(k.famEnd);
+    a.bravery = uint8(r.Range(5, 60)); a.greed = uint8(r.Range(5, 95)); a.sociability = uint8(r.Range(5, 95));
+    a.caution = uint8(r.Range(30, 95)); a.wanderlust = uint8(r.Range(5, 40));
+    a.home = h.id; a.site = h.id; a.born = _clock; a.money = r.Range(50, 2000);
+    a.status = AgentStatus::Active; a.wakeAt = _clock + r.Range(0, 30);
+    return a;
+}
+
+void World::EnsureCivilians()
+{
+    // the first townsfolk wore the hunched Warcraft III peasant look: move them out, and move proper townsfolk in
+    static std::set<uint32> const oldLooks = { 11260, 11328, 842, 1975 };
+    if (std::erase_if(_agents, [](auto const& kv) { return kv.second.role == ROLE_CIVILIAN && oldLooks.contains(kv.second.sourceEntry); }))
+        LOG_INFO("server.loading", "SoloWoW sim: rebuilding the townsfolk with their new looks");
+    // every inn town gets its townsfolk once (towns added with the wider world get theirs on the next load)
+    std::set<uint32> settled;
+    for (auto const& [id, ag] : _agents) if (ag.role == ROLE_CIVILIAN) settled.insert(ag.home);
+    uint32 made = 0;
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN) || settled.contains(h.id)) continue;
+        bool dwarven = DWARF_ZONES.contains(h.zone), elven = ELF_ZONES.contains(h.zone);
+        uint32 count = (h.zone == 1519 || h.zone == 1537 || h.zone == 1657) ? 10 : 6;   // the cities have more people
+        for (uint32 i = 0; i < count; ++i)
+        {
+            uint32 id = _nextAgent++;
+            _agents[id] = MakeCivilian(h, id);
+            ++made;
+        }
+    }
+    LOG_INFO("server.loading", "SoloWoW sim: {} townsfolk moved into the region's towns", made);
+    // levels start from town and work (a floor: what they've grown into since is kept)
+    uint32 lo = 255, hi = 0;
+    for (auto& [id, ag] : _agents)
+        if (ag.role == ROLE_CIVILIAN)
+            if (SimSite const* h = SiteById(ag.home))
+            {
+                ag.level = std::max(ag.level, CivilianLevel(_seed, ag, *h));
+                lo = std::min<uint32>(lo, ag.level); hi = std::max<uint32>(hi, ag.level);
+            }
+    if (hi) LOG_INFO("server.loading", "SoloWoW sim: townsfolk are levels {} to {}", lo, hi);
+    AssignAges();
+}
+
+// =====================================================================================================
+// ageing: a year passes every game week (real time runs 1:1, so a real year would never be seen)
+// =====================================================================================================
+constexpr SimTime SIM_YEAR = 7 * MIN_PER_DAY;
+
+uint32 World::Age(SimAgent const& a) const
+{
+    return uint32(a.age0) + (_clock - std::min(_clock, a.born)) / SIM_YEAR;
+}
+
+// everyone without an age gets one: townsfolk of every age (more young than old), adventurers mostly young
+void World::AssignAges()
+{
+    for (auto& [id, a] : _agents)
+    {
+        if (a.age0) continue;
+        Rng r(_seed, id, 0, P_GEN + 540);
+        uint32 want = a.role == ROLE_CIVILIAN ? 16 + std::min(r.Range(0, 58), r.Range(0, 58)) : 17 + std::min(r.Range(0, 30), r.Range(0, 30));
+        uint32 passed = (_clock - std::min(_clock, a.born)) / SIM_YEAR;
+        a.age0 = uint8(std::max<uint32>(1, want > passed ? want - passed : 1));
+    }
+}
+
+// Elders put down their work, the very old die in their sleep, and the town's young come of age to take their place.
+void World::TownsfolkGenerations()
+{
+    std::map<uint32, uint32> living;
+    for (auto& [id, a] : _agents)
+    {
+        if (a.role != ROLE_CIVILIAN || a.status != AgentStatus::Active) continue;
+        uint32 age = Age(a);
+        Rng g(_seed, id, _clock, P_GEN + 550);
+        if (age >= 60 && a.job != JOB_LOAFER && g.Chance(0.03f))
+        {
+            static char const* const tool[] = { "", "plough", "axe", "stall", "" };
+            Log(EventType::Socialized, a, a.home, Acore::StringFormat("{} of {} has given up the {} for good, at {}.", a.FullName(), SiteName(a.home), tool[std::min<uint8>(a.job, 4)], age), true);
+            a.job = JOB_LOAFER;
+        }
+        if (age >= 66 && g.Chance(float(age - 65) * 0.004f))
+        {
+            a.status = AgentStatus::Dead; a.diedAt = _clock; a.deathCause = "old age"; a.plan.clear();
+            for (SimErrand& e : _errands) if (e.agent == id) e.done = true;
+            Log(EventType::Died, a, a.home, Acore::StringFormat("{} of {} died peacefully in {} sleep, aged {}.", a.FullName(), SiteName(a.home), a.gender ? "her" : "his", age), true);
+            continue;
+        }
+        ++living[a.home];
+    }
+    // a town that has lost people: one of its young is old enough to work now
+    std::vector<SimSite const*> towns;
+    for (SimSite const& h : _sites)
+        if (h.type == SiteType::Hub && (h.services & SVC_INN) && h.regionLevel) towns.push_back(&h);
+    for (SimSite const* h : towns)
+    {
+        uint32 target = (h->zone == 1519 || h->zone == 1537 || h->zone == 1657) ? 10 : 6;
+        Rng rr(_seed, h->id, _clock, P_GEN + 560);
+        if (living[h->id] >= target || !living[h->id] || !rr.Chance(0.25f)) continue;
+        uint32 id = _nextAgent++;
+        SimAgent n = MakeCivilian(*h, id);
+        // a child of one of the town's families
+        std::vector<SimAgent const*> kin;
+        for (auto const& [oid, o] : _agents)
+            if (o.role == ROLE_CIVILIAN && o.home == h->id && o.race == n.race && Age(o) >= 36) kin.push_back(&o);
+        std::string parent;
+        if (!kin.empty())
+        {
+            SimAgent const* p = kin[rr.Range(0, uint32(kin.size()) - 1)];
+            n.family = p->family; parent = p->given;
+        }
+        n.age0 = uint8(16 + rr.Range(0, 2)); n.born = _clock;
+        n.level = CivilianLevel(_seed, n, *h);
+        _agents[id] = n;
+        static char const* const work[] = { "", "work in the fields", "work hauling timber", "a place at the market", "nothing much yet" };
+        Log(EventType::Newcomer, n, h->id, parent.empty()
+            ? Acore::StringFormat("{} of {} is old enough to work now and has taken up {}.", n.FullName(), SiteName(h->id), work[std::min<uint8>(n.job, 4)])
+            : Acore::StringFormat("{}, {}'s {}, is old enough to work now and has taken up {} in {}.", n.FullName(), parent, n.gender ? "daughter" : "son",
+                work[std::min<uint8>(n.job, 4)], SiteName(h->id)), true);
+    }
+}
+
+// =====================================================================================================
+// catch-up while nobody was here (StartLive): routine life goes on; big events are rarer and capped; your people are safe
+// =====================================================================================================
+bool World::CloseToAPlayer(uint32 agentId) const
+{
+    std::map<uint32, int32> regard;
+    for (SimMemory const& m : _memories)
+        if (m.agent == agentId && m.subjectType == 4) regard[m.subject] += int32(m.valence) * m.intensity / 100;
+    return std::ranges::any_of(regard, [](auto const& kv) { return kv.second >= 40; });
+}
+
+// a major event (a threat, a camp) during catch-up: a third as often, and at most two per absence
+bool World::AwayAllows(uint32 salt)
+{
+    if (!_away) return true;
+    if (_awayMajor >= 2) return false;
+    Rng r(_seed, salt, _clock, P_GEN + 650);
+    if (!r.Chance(0.33f)) return false;
+    ++_awayMajor;
+    return true;
+}
+
+// =====================================================================================================
+// roadside camps: a band of the region's bandits or beasts sets up by a road, away from where their kind is usually
+// found, near a town. They waylay passing adventurers, have their own bounty, and break camp after a few days.
+// =====================================================================================================
+namespace
+{
+    // a creature template for a hunting ground's creature (by name, near the level)
+    uint32 CampEntry(std::string const& name, uint32 level)
+    {
+        static std::map<std::string, uint32> cache;
+        if (auto it = cache.find(name); it != cache.end()) return it->second;
+        uint32 best = 0;
+        for (auto const& [entry, t] : *sObjectMgr->GetCreatureTemplates())
+            if (t.Name == name && !t.npcflag && !t.IsNPCBotOrPet() && t.minlevel <= level + 3 && t.maxlevel + 3 >= level && (!best || entry < best))
+                best = entry;
+        cache[name] = best;
+        return best;
+    }
+
+    // "Gray Forest Wolf" -> "Gray Forest Wolves", "Kobold Vermin" stays, "Harpy" -> "Harpies"
+    std::string Plural(std::string const& n)
+    {
+        auto ends = [&](char const* s) { size_t l = std::strlen(s); return n.size() >= l && n.compare(n.size() - l, l, s) == 0; };
+        if (n.empty() || ends("Vermin") || ends("Folk") || ends("Sheep") || ends("Deer") || ends("Murloc Spawn")) return n;
+        if (ends("man")) return n.substr(0, n.size() - 3) + "men";
+        if (ends("Wolf") || ends("Elf") || ends("Dwarf")) return n.substr(0, n.size() - 1) + "ves";
+        if (ends("fe")) return n.substr(0, n.size() - 2) + "ves";
+        if (n.size() > 1 && n.back() == 'y' && !std::strchr("aeiou", n[n.size() - 2])) return n.substr(0, n.size() - 1) + "ies";
+        if (ends("s") || ends("x") || ends("ch") || ends("sh")) return n + "es";
+        return n + "s";
+    }
+
+    float SegDist(float px, float py, float ax, float ay, float bx, float by)
+    {
+        float dx = bx - ax, dy = by - ay, len = dx * dx + dy * dy;
+        float t = len > 0.0f ? std::clamp(((px - ax) * dx + (py - ay) * dy) / len, 0.0f, 1.0f) : 0.0f;
+        float cx = ax + t * dx - px, cy = ay + t * dy - py;
+        return std::sqrt(cx * cx + cy * cy);
+    }
+}
+
+void World::PostCamps(bool force, uint32 nearTown)
+{
+    for (SimCamp& k : _camps)                                         // camps whose time is up move on
+        if (!k.done && _clock >= k.until)
+        {
+            k.done = true;
+            Log(EventType::LeftRegion, Nobody(), k.site, Acore::StringFormat("The {} by the road near {} have broken camp and moved on.", Plural(k.name), AreaOf(SiteName(k.site))), true);
+            for (SimBounty& b : _bounties) if (!b.done && b.target == (k.id | CAMP_MARK)) { b.done = true; b.expires = _clock; }
+        }
+    std::erase_if(_camps, [this](SimCamp const& k) { return k.done && _clock > k.until + 2 * MIN_PER_DAY; });
+    if (!_roadsBuilt) BuildRoads();
+
+    for (SimSite const& h : _sites)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN) || !h.regionLevel || !SIM_MAPS.contains(h.map)) continue;
+        if (nearTown && h.id != nearTown) continue;
+        Rng r(_seed, h.id, _clock, P_GEN + 600);
+        if (!force && !r.Chance(0.06f)) continue;
+        if (!force && !AwayAllows(h.id + 1000)) continue;
+        if (std::ranges::any_of(_camps, [&](SimCamp const& k) { return !k.done && k.town == h.id; })) continue;
+        // who: the region's bandits or beasts, about the town's level
+        std::vector<SimSite const*> kinds;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && !s.elite && s.map == h.map && (s.creatureType == 7 || s.creatureType == 1) && Dist2d(s.x, s.y, h.x, h.y) < 2500.0f
+                && std::abs(int32((s.minLevel + s.maxLevel) / 2) - int32(h.regionLevel)) <= 3)
+                kinds.push_back(&s);
+        if (kinds.empty()) continue;
+        SimSite const& src = *kinds[r.Range(0, uint32(kinds.size()) - 1)];
+        uint32 lvl = (src.minLevel + src.maxLevel) / 2;
+        uint32 entry = CampEntry(src.creatureName, lvl);
+        if (!entry) continue;
+        // where: on a road, a fair walk from town, away from any hunting ground or town
+        std::vector<RoadNode const*> spots;
+        for (RoadNode const& n : _roads)
+        {
+            if (n.map != h.map) continue;
+            float d = Dist2d(n.x, n.y, h.x, h.y);
+            if (d < 250.0f || d > 1100.0f) continue;
+            bool clear = true;
+            for (SimSite const& s : _sites)
+                if (s.map == h.map && Dist2d(n.x, n.y, s.x, s.y) < (s.type == SiteType::Hub ? 300.0f : 250.0f)) { clear = false; break; }
+            if (clear) spots.push_back(&n);
+        }
+        if (spots.empty()) continue;
+        RoadNode const& at = *spots[r.Range(0, uint32(spots.size()) - 1)];
+        SimCamp k;
+        k.id = _nextCamp++; k.map = h.map; k.entry = entry; k.town = h.id; k.name = src.creatureName; k.level = uint8(lvl);
+        k.x = at.x + 12.0f; k.y = at.y + 12.0f; k.z = at.z;                     // just off the road
+        k.size = k.alive = uint8(r.Range(4, 7)); k.made = _clock; k.until = _clock + r.Range(3, 5) * MIN_PER_DAY;
+        uint32 closest = h.id; float nd = 1e9f;                                 // for "near ..." on the board
+        for (SimSite const& s : _sites)
+            if (s.map == h.map) { float d = Dist2d(s.x, s.y, k.x, k.y); if (d < nd) { nd = d; closest = s.id; } }
+        k.site = closest;
+        _camps.push_back(k);
+        Log(EventType::RareFind, Nobody(), h.id, Acore::StringFormat("{} have made camp by the road near {}. Travellers are going the long way round.", Plural(k.name), AreaOf(SiteName(k.site))), true);
+        SimBounty b;
+        b.id = _nextBounty++; b.hub = h.id; b.site = k.site; b.kind = BOUNTY_RARE; b.count = k.size; b.party = 3;
+        b.target = k.id | CAMP_MARK; b.targetLevel = k.level;
+        b.reward = (lvl * lvl * 30 + 500) * 3 / 2;
+        b.posted = _clock; b.expires = k.until;
+        _bounties.push_back(b);
+    }
+}
+
+// an adventurer's road went past a camp: strong ones cut their way through, the rest take a beating (or worse)
+void World::RoadDanger(SimAgent& a, uint32 from, uint32 to)
+{
+    SimSite const* f = SiteById(from); SimSite const* t = SiteById(to);
+    if (!f || !t || f->map != t->map) return;
+    for (SimCamp& k : _camps)
+    {
+        if (k.done || k.map != f->map || SegDist(k.x, k.y, f->x, f->y, t->x, t->y) > 400.0f) continue;
+        Rng r(_seed, a.id, _clock, P_FIGHT + 900);
+        if (!r.Chance(0.25f)) return;
+        if (a.level >= k.level + 3)
+        {
+            uint32 n = std::min<uint32>(k.alive, r.Range(1, 2));
+            for (uint32 i = 0; i < n; ++i) CampLossLocked(k, a.FullName());
+            return;
+        }
+        a.wounds = uint8(std::min<uint32>(100, a.wounds + r.Range(30, 60)));
+        if (a.wounds >= 100)
+        {
+            _culprit = Acore::StringFormat("{} on the road near {}", Plural(k.name), AreaOf(SiteName(k.site)));
+            Defeat(a, *t);
+            _culprit.clear();
+        }
+        else
+            Log(EventType::Defeated, a, to, Acore::StringFormat("{} was set upon by {} on the road near {} and limped on.", a.FullName(), Plural(k.name), AreaOf(SiteName(k.site))), false);
+        return;
+    }
+}
+
+void World::CampLossLocked(SimCamp& k, std::string const& by)
+{
+    if (k.done || !k.alive) return;
+    if (--k.alive) return;
+    k.done = true; k.until = _clock;
+    Log(EventType::BountyDone, Nobody(), k.site, Acore::StringFormat("The {} camp by the road near {} was cleared{}.", k.name, AreaOf(SiteName(k.site)),
+        by.empty() ? std::string() : " by " + by), true);
+    for (SimBounty& b : _bounties)
+        if (!b.done && b.target == (k.id | CAMP_MARK) && b.playerProgress < b.count)
+        {
+            if (b.player)
+                _mail.push_back({ b.player, b.hub, "Too late: " + k.name + " camp",
+                    Acore::StringFormat("The camp by the road is cleared - {} saw to it. The {} board has taken the notice down.", by.empty() ? "someone" : by, SiteName(b.hub)), 0 });
+            b.done = true;
+        }
+}
+
+// =====================================================================================================
+// threats: the Warcraft III hero classes as roaming named elites, hostile to everyone. One at a time per continent;
+// it moves between hunting grounds, falls on adventurers it finds there, and has a price on its head.
+// =====================================================================================================
+namespace
+{
+    struct HeroSource { uint32 entry; uint8 cls, race; std::string name; };
+    std::vector<HeroSource> const& HeroSources()
+    {
+        static std::vector<HeroSource> list;
+        static bool loaded = false;
+        if (!loaded)
+        {
+            loaded = true;
+            if (QueryResult r = WorldDatabase.Query("SELECT e.entry, e.class, e.race, t.name FROM creature_template_npcbot_extras e JOIN creature_template t ON t.entry = e.entry "
+                "WHERE e.class >= 12 AND e.class <= 20 AND e.class <> 13 AND t.name NOT LIKE 'Mirror Image%' ORDER BY e.entry"))
+                do { Field* f = r->Fetch(); list.push_back({ f[0].Get<uint32>(), f[1].Get<uint8>(), f[2].Get<uint8>(), f[3].Get<std::string>() }); } while (r->NextRow());
+        }
+        return list;
+    }
+    char const* HeroTitle(uint8 cls)
+    {
+        static char const* const t[] = { "Blademaster", "Sphynx", "Archmage", "Dreadlord", "Spellbreaker", "Dark Ranger", "Necromancer", "Sea Witch", "Crypt Lord" };
+        return cls >= 12 && cls <= 20 ? t[cls - 12] : "Terror";
+    }
+}
+
+
+void World::SpawnThreats(bool force)
+{
+    std::vector<HeroSource> const& heroes = HeroSources();
+    if (heroes.empty()) return;
+    std::set<uint32> busy;                                // maps with a threat already
+    std::set<std::string> names;
+    for (auto const& [id, a] : _agents)
+        if (a.role == ROLE_THREAT && a.status == AgentStatus::Active)
+            if (SimSite const* s = SiteById(a.site)) { busy.insert(s->map); names.insert(a.given); }
+    for (uint32 map : SIM_MAPS)
+    {
+        if (busy.contains(map)) continue;
+        Rng r(_seed, map, _clock, P_GEN + 580);
+        if (!force && !r.Chance(0.15f)) continue;         // about one a week, after the last is gone
+        if (!force && !AwayAllows(map + 1)) continue;
+        std::vector<SimSite const*> lairs;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && s.map == map && !s.elite && (s.minLevel + s.maxLevel) / 2 >= 20 && (s.minLevel + s.maxLevel) / 2 <= 55 && TownOf(s.id))
+                lairs.push_back(&s);
+        if (lairs.empty()) continue;
+        SimSite const& lair = *lairs[r.Range(0, uint32(lairs.size()) - 1)];
+        std::vector<HeroSource const*> pick;
+        for (HeroSource const& h : heroes) if (!names.contains(h.name)) pick.push_back(&h);
+        if (pick.empty()) continue;
+        HeroSource const& h = *pick[r.Range(0, uint32(pick.size()) - 1)];
+        SimAgent t;
+        t.id = _nextAgent++; t.role = ROLE_THREAT; t.cls = h.cls; t.race = h.race; t.sourceEntry = h.entry;
+        t.given = h.name; t.family = std::string("the ") + HeroTitle(h.cls);
+        t.level = uint8(std::clamp<int32>((lair.minLevel + lair.maxLevel) / 2 + 3, 20, 60));
+        t.home = lair.id; t.site = lair.id; t.born = _clock; t.status = AgentStatus::Active; t.wakeAt = _clock + 1;
+        t.bravery = 100; t.caution = 0;
+        _agents[t.id] = t;
+        _requeue.push_back(t.id);
+        names.insert(h.name);
+        uint32 town = TownOf(lair.id);
+        Log(EventType::RareFind, t, lair.id, Acore::StringFormat("Travellers speak of {}, prowling near {}. Few who've met it have much to say.", t.FullName(), AreaOf(SiteName(lair.id))), true);
+        SimBounty b;
+        b.id = _nextBounty++; b.hub = town; b.site = lair.id; b.count = 1; b.kind = BOUNTY_RARE; b.party = 5;
+        b.target = t.id | THREAT_MARK; b.targetLevel = t.level;
+        b.reward = uint32(t.level) * t.level * 60 + 2000;
+        b.posted = _clock; b.expires = _clock + 30 * MIN_PER_DAY;
+        _bounties.push_back(b);
+        Log(EventType::BountyPosted, Nobody(), town, Acore::StringFormat("{} posted a price on {}: {}. Bring friends.", SiteName(town), t.FullName(), Money(b.reward)), true);
+    }
+}
+
+// A threat's day: prowl a hunting ground for a while, fall on whoever is hunting there, then move to another nearby.
+// After a month unkilled it moves on for good.
+void World::ThreatWake(SimAgent& t)
+{
+    if (!t.plan.empty())
+    {
+        PlanStep s = t.plan.front();
+        t.plan.erase(t.plan.begin());
+        if (s.verb == Verb::Goto)
+        {
+            t.site = s.site;
+            for (SimBounty& b : _bounties)                // the board keeps up with where it was last seen
+                if (!b.done && b.target == (t.id | THREAT_MARK)) b.site = t.site;
+        }
+        else if (s.verb == Verb::Fight)
+            ThreatStrike(t);
+        if (t.status != AgentStatus::Active) return;
+    }
+    if (_clock - t.born > 30 * MIN_PER_DAY)
+    {
+        t.status = AgentStatus::Gone; t.plan.clear();
+        Log(EventType::LeftRegion, t, t.site, Acore::StringFormat("Nobody has seen {} for a while now. Folk say it's moved on.", t.FullName()), true);
+        for (SimBounty& b : _bounties) if (!b.done && b.target == (t.id | THREAT_MARK)) { b.done = true; b.expires = _clock; }
+        return;
+    }
+    if (t.plan.empty())
+    {
+        Rng r = R(t, P_PLAN);
+        SimSite const* here = SiteById(t.site);
+        uint32 prowl = t.site;                            // where the next stretch of prowling happens
+        if (here && r.Chance(0.35f))
+        {
+            std::vector<uint32> next;
+            for (SimSite const& s : _sites)
+                if (s.type == SiteType::Hunt && s.id != here->id && s.map == here->map && !s.elite && Dist2d(s.x, s.y, here->x, here->y) < 1500.0f
+                    && std::abs(int32((s.minLevel + s.maxLevel) / 2) - int32(t.level)) <= 8)
+                    next.push_back(s.id);
+            if (!next.empty())
+            {
+                prowl = next[r.Range(0, uint32(next.size()) - 1)];
+                t.plan.push_back({ Verb::Goto, prowl, 0, false });
+            }
+        }
+        t.plan.push_back({ Verb::Fight, prowl, r.Range(3, 8) * MIN_PER_HOUR, false });
+    }
+    StartStep(t);
+}
+
+// whoever is hunting where it prowls: a strong enough band may bring it down; otherwise it takes one or two of them
+void World::ThreatStrike(SimAgent& t)
+{
+    SimSite const* site = SiteById(t.site);
+    if (!site) return;
+    std::vector<SimAgent*> there;
+    for (auto& [id, o] : _agents)
+        if (o.role == ROLE_ADVENTURER && o.status == AgentStatus::Active && o.site == t.site && o.doing == Verb::Fight) there.push_back(&o);
+    if (there.empty()) return;
+    Rng r(_seed, t.id, _clock, P_FIGHT + 800);
+    uint32 power = 0;
+    for (SimAgent const* o : there) power += o->level;
+    float slay = there.size() >= 3 ? std::clamp(float(power) / (float(t.level) * 4.0f) - 0.2f, 0.05f, 0.6f) : 0.02f;
+    if (r.Chance(slay))
+    {
+        std::string by = there[0]->FullName();
+        if (there.size() == 2) by += " and " + there[1]->FullName();
+        else if (there.size() > 2) by += ", " + there[1]->FullName() + " and " + (there.size() == 3 ? there[2]->FullName() : std::string("their friends"));
+        for (SimAgent* o : there) { o->kills += 1; _memories.push_back({ o->id, 3, t.id, uint8(EventType::RareSlain), 80, 90, _clock }); }
+        ThreatDown(t, by);
+        return;
+    }
+    uint32 victims = std::min<uint32>(uint32(there.size()), r.Range(1, 2));
+    for (uint32 i = 0; i < victims; ++i)
+    {
+        SimAgent& v = *there[i];
+        _culprit = Acore::StringFormat("{} near {}", t.FullName(), AreaOf(SiteName(site->id)));
+        v.wounds = 100;
+        Defeat(v, *site);
+        _culprit.clear();
+        _requeue.push_back(v.id);
+    }
+}
+
+void World::ThreatDown(SimAgent& t, std::string const& by)
+{
+    if (t.status != AgentStatus::Active) return;
+    t.status = AgentStatus::Dead; t.diedAt = _clock; t.deathCause = "slain by " + by; t.plan.clear();
+    Log(EventType::RareSlain, t, t.site, Acore::StringFormat("{} was slain near {} by {}.", t.FullName(), AreaOf(SiteName(t.site)), by), true);
+    for (SimBounty& b : _bounties)
+        if (!b.done && b.target == (t.id | THREAT_MARK))
+        {
+            if (b.player && b.playerProgress < b.count)   // a player had it, and someone else got there first
+                _mail.push_back({ b.player, b.hub, "Too late: " + t.FullName(),
+                    Acore::StringFormat("{} is dead - {} got there first. The {} board has taken the notice down.", t.FullName(), by, SiteName(b.hub)), 0 });
+            if (b.playerProgress < b.count) b.done = true;
+        }
+}
+
+// Adventurers getting on in years (or who've been beaten once too often) hang up their gear and settle in their home
+// town as townsfolk: same name, same friends and grudges, the level they reached. A few a day at most.
+void World::RetireAdventurers()
+{
+    uint32 retired = 0;
+    for (auto& [id, a] : _agents)
+    {
+        if (retired >= 3) break;
+        if (a.role != ROLE_ADVENTURER || a.status != AgentStatus::Active || a.party || a.doing == Verb::Fight) continue;
+        if (a.race != 1 && a.race != 3 && a.race != 4) continue;        // townsfolk looks exist for humans, dwarves, night elves
+        SimSite const* h = SiteById(a.home);
+        if (!h || h->type != SiteType::Hub || !(h->services & SVC_INN)) continue;
+        uint32 age = Age(a);
+        Rng r(_seed, id, _clock, P_GEN + 570);
+        float chance = age >= 45 ? float(age - 44) * 0.008f : 0.0f;
+        if (a.defeats >= 5 && age >= 30) chance += 0.03f;
+        if (chance <= 0.0f || !r.Chance(chance)) continue;
+        uint8 job = a.greed > 65 ? JOB_MARKET : a.bravery > 60 ? JOB_LABORER : r.Chance(0.6f) ? JOB_FARMHAND : JOB_LOAFER;
+        std::vector<uint32> const& looks = a.race == 3 ? DWARF_BODIES : a.race == 4 ? ELF_BODIES : CIVILIAN_BODIES[job];
+        uint32 src = 0;                                                  // a look with a body of their own sex
+        for (uint32 k = 0; k < looks.size() && !src; ++k)
+            if (CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(looks[(k + id) % looks.size()]))
+                for (CreatureModel const& m : t->Models)
+                    if (CreatureModelInfo const* mi = sObjectMgr->GetCreatureModelInfo(m.CreatureDisplayID); mi && uint8(mi->gender == 1 ? 1 : 0) == a.gender)
+                    { src = t->Entry; break; }
+        if (!src) continue;
+        if (SimBounty* b = BountyOf(a); b && !b->done) b->taker = 0;
+        for (SimErrand& e : _errands)                                    // word from home can't reach them on the road any more
+            if (!e.done && e.kind == ERRAND_MESSAGE && e.target == id) e.done = true;
+        a.bounty = 0; a.bountyProgress = 0; a.plan.clear(); a.doing = Verb::Idle; a.ambition = AmbitionType::None; a.avengeFor = 0;
+        a.role = ROLE_CIVILIAN; a.job = job; a.sourceEntry = src; a.site = a.home; a.wakeAt = _clock + 1;
+        a.level = std::min<uint8>(a.level, 60);
+        _requeue.push_back(id);
+        static char const* const gear[] = { "gear", "sword", "hammer", "bow", "daggers", "staff", "blade", "totems", "staff", "staff", "gear", "staff" };
+        static char const* const work[] = { "", " to work the fields", " to haul timber", " to keep a market stall", " to take it easy" };
+        Log(EventType::MovedHome, a, a.home, Acore::StringFormat("{} has hung up {} {} at {} and settled in {}{}.", a.FullName(), a.gender ? "her" : "his",
+            gear[std::min<uint8>(a.cls, 11)], age, SiteName(a.home), work[std::min<uint8>(job, 4)]), true);
+        ++retired;
+    }
+}
+
+// A townsperson grows a little tougher: hard work over the days, a fight they came through, a road they walked.
+// Each stays within ten levels of where they started (a few become something like adventurers themselves).
+void World::CivilianGrow(SimAgent& a, char const* how)
+{
+    SimSite const* h = SiteById(a.home);
+    if (!h || a.role != ROLE_CIVILIAN) return;
+    uint8 cap = uint8(std::min<uint32>(60, CivilianLevel(_seed, a, *h) + 10));
+    if (a.level >= cap) return;
+    ++a.level;
+    if (how && a.level % 5 == 0)
+        Log(EventType::SkillUp, a, a.home, Acore::StringFormat("{} of {} {}.", a.FullName(), SiteName(a.home), how), false);
+}
+
+
+void World::CivilianDecide(SimAgent& a)
+{
+    Rng r = R(a, P_PLAN);
+    a.site = a.home;
+    uint32 tod = _clock % MIN_PER_DAY, wake = WakeMinute(a), len = SleepMinutes(a);
+    if (Asleep(a, _clock))
+    {
+        a.plan.push_back({ Verb::Sleep, a.home, std::max<uint32>(30, (wake + MIN_PER_DAY - tod) % MIN_PER_DAY) });
+        return;
+    }
+    uint32 awake = (tod + MIN_PER_DAY - wake) % MIN_PER_DAY;    // minutes since they got up
+    uint32 dayLen = MIN_PER_DAY - len;
+    uint32 toBed = dayLen > awake ? dayLen - awake : 0;
+    bool rain = Rainy(a.home);
+    Verb v;
+    if (awake < 60) v = Verb::Idle;                                                     // up and about
+    else if (a.job != JOB_LOAFER && awake < 9 * 60)                                     // the working day
+        v = (rain && a.job == JOB_FARMHAND && r.Chance(0.5f)) ? Verb::Socialize : Verb::Work;
+    else if (toBed <= 180 && (a.sociability > 35 || rain)) v = Verb::Socialize;         // evenings at the inn
+    else v = r.Chance(0.3f) ? Verb::Trade : Verb::Idle;                                 // errands, the market, idling
+    uint32 minutes = std::max<uint32>(15, std::min<uint32>(toBed ? toBed : 15, r.Range(45, 120)));
+    a.plan.push_back({ v, a.home, minutes });
+}
+
+// =====================================================================================================
+// personal rhythm: when someone sleeps (no saved field: it follows from who they are)
+// =====================================================================================================
+uint32 World::WakeMinute(SimAgent const& a) const
+{
+    uint32 h = uint32(Mix(_seed ^ (uint64(a.id) * 0x9E3779B1ull) ^ 0xC10C) % 100);
+    uint32 m = uint32(Mix(_seed ^ (uint64(a.id) * 0x85EBCA6Bull) ^ 0xC10D) % 120);
+    if (h < 25) return 4 * 60 + m;                      // early riser: up between 4 and 6
+    if (h < 75) return 6 * 60 + m;                      // ordinary: 6 to 8
+    return 10 * 60 + m * 3 / 2;                         // night owl: 10 to 13
+}
+
+uint32 World::SleepMinutes(SimAgent const& a) const
+{
+    return 6 * 60 + uint32(Mix(_seed ^ (uint64(a.id) * 0xC2B2AE35ull) ^ 0xC10E) % 181);   // 6 to 9 hours
+}
+
+bool World::Asleep(SimAgent const& a, SimTime t) const
+{
+    uint32 tod = t % MIN_PER_DAY, wake = WakeMinute(a), len = SleepMinutes(a);
+    uint32 bed = (wake + MIN_PER_DAY - len) % MIN_PER_DAY;
+    return bed < wake ? (tod >= bed && tod < wake) : (tod >= bed || tod < wake);
+}
+
+uint32 World::MinutesToBed(SimAgent const& a) const
+{
+    uint32 bed = (WakeMinute(a) + MIN_PER_DAY - SleepMinutes(a)) % MIN_PER_DAY;
+    return (bed + MIN_PER_DAY - _clock % MIN_PER_DAY) % MIN_PER_DAY;
+}
+
+// =====================================================================================================
+// the brain: wake -> finish step -> decide -> start next step
+// =====================================================================================================
+void World::Wake(SimAgent& a)
+{
+    if (a.status == AgentStatus::Dead || a.status == AgentStatus::Gone || a.status == AgentStatus::Hired)
+        return;
+    if (a.role == ROLE_THREAT) { ThreatWake(a); return; }
+    if (a.status == AgentStatus::Recovering)
+    {
+        if (_clock < a.statusUntil) { a.wakeAt = a.statusUntil; return; }
+        a.status = AgentStatus::Active;
+        a.wounds = 20; a.fatigue = 0;
+        Log(EventType::Recovered, a, a.site, Acore::StringFormat("{} was back on their feet in {}.", a.FullName(), SiteName(a.site)), true);
+        ExchangeNews(a);
+    }
+
+    if (!a.plan.empty())
+    {
+        PlanStep s = a.plan.front();
+        a.plan.erase(a.plan.begin());
+        FinishStep(a, s);
+        if (a.status != AgentStatus::Active) return;      // defeated / died / left during the step
+        CheckAmbition(a);
+    }
+    if (a.plan.empty())
+        Decide(a);
+    if (a.status != AgentStatus::Active) return;
+    StartStep(a);
+}
+
+void World::Decide(SimAgent& a)
+{
+    if (a.role == ROLE_CIVILIAN) { CivilianDecide(a); return; }
+    Rng r = R(a, P_PLAN);
+    if (a.party) { a.lastParty = a.party; a.lastPartyAt = _clock; }   // mates still finishing the same outing can find us
+    a.party = 0; a.partySize = 1;                       // hunting parties last one outing
+    auto noise = [&r]() { return float(r.Range(0, 10)); };
+    bool night = Asleep(a, _clock);                     // their own night: larks, owls and everyone between
+    bool rain = Rainy(a.site);
+    uint32 hour = HourOf(_clock);
+    uint32 bagScale = uint32(a.level) * a.level * 30 + 200;
+    float bags = std::min(100.0f, a.lootValue * 100.0f / bagScale);
+    SimBounty const* bounty = nullptr;
+    for (SimBounty const& b : _bounties) if (b.id == a.bounty) bounty = &b;
+    if (a.bounty && (!bounty || bounty->done)) { a.bounty = 0; a.bountyProgress = 0; bounty = nullptr; }
+
+    float rest   = a.fatigue + a.wounds * 0.7f + (night ? 35.0f : 0.0f) + (rain ? 8.0f : 0.0f) + noise();
+    if (a.wounds >= 70) rest = 150.0f;
+    float upkeep = std::max({ 100.0f - a.supplies, 100.0f - a.durability, bags }) * (0.8f + a.greed / 250.0f) + noise();
+    float growth = 45.0f + a.bravery * 0.25f - a.wounds * 0.6f - a.fatigue * 0.3f - (night ? 30.0f : 0.0f) - (rain ? 15.0f : 0.0f) + noise();
+    float hoursAlone = float(_clock - std::min(_clock, a.lastSocial)) / 60.0f;
+    float ties   = a.sociability * 0.35f + std::min(40.0f, hoursAlone / 2.0f) + ((MinutesToBed(a) <= 4 * 60 && !night) ? 20.0f : 0.0f) + (rain ? 20.0f : 0.0f) - 25.0f + noise();
+    float ambition = (a.ambition == AmbitionType::SeePlace || a.ambition == AmbitionType::Avenge) ? 20.0f + a.wanderlust * 0.4f + noise() : 0.0f;
+    float moveOn = HasFittingHunt(a, a.home, 2500.0f) ? 0.0f : 120.0f;
+    bool canGather = std::ranges::any_of(a.prof, [](uint8 p) { return p == PROF_MINING || p == PROF_HERBALISM || p == PROF_FISHING; });
+    float work   = canGather ? 20.0f + a.greed * 0.25f + (a.money < uint32(a.level) * a.level * 100 ? 20.0f : 0.0f) - (night ? 35.0f : 0.0f) - (rain ? 10.0f : 0.0f) - a.fatigue * 0.2f + noise() : -1.0f;
+    float train  = a.level >= a.trainedLevel + 2 ? 30.0f + (a.level - a.trainedLevel) * 12.0f - (night ? 30.0f : 0.0f) + noise() : -1.0f;
+    float claim  = (bounty && a.bountyProgress >= bounty->count) ? 95.0f : -1.0f;
+    uint32 offer = (!a.bounty && !night) ? PickBounty(a) : 0;
+    float takeBounty = offer ? 30.0f + a.greed * 0.35f + noise() : -1.0f;
+
+    enum { REST, UPKEEP, GROWTH, TIES, AMBITION, MOVEON, WORK, TRAIN, CLAIM, TAKE };
+    std::array<float, 10> score = { rest, upkeep, growth, ties, ambition, moveOn, work, train, claim, takeBounty };
+    if (a.supplies < 15 || a.durability < 15) { score[GROWTH] = -1.0f; score[TAKE] = -1.0f; }   // fix gear first
+    int choice = int(std::max_element(score.begin(), score.end()) - score.begin());
+
+    auto goTo = [&a](uint32 site, bool announce = false) { if (site && site != a.site) a.plan.push_back({ Verb::Goto, site, 0, announce }); };
+    switch (choice)
+    {
+        case REST:
+        {
+            uint32 inn = (SiteById(a.site) && SiteById(a.site)->type == SiteType::Hub && (SiteById(a.site)->services & SVC_INN)) ? a.site : NearestHub(a, SVC_INN);
+            uint32 untilMorning = night ? ((WakeMinute(a) + MIN_PER_DAY - (_clock % MIN_PER_DAY)) % MIN_PER_DAY) : 0; // until their own morning
+            uint32 sleep = night ? untilMorning + r.Range(0, 90) : r.Range(240, 420);
+            if (TravelMinutes(a.site, inn, a) > 90 && night) inn = a.site;                         // too far: camp where you are
+            goTo(inn);
+            a.plan.push_back({ Verb::Sleep, inn, std::max<uint32>(60, sleep) });
+            break;
+        }
+        case UPKEEP:
+        {
+            uint32 need = SVC_VENDOR | (a.durability < 60 ? SVC_REPAIR : 0);
+            uint32 hub = NearestHub(a, need);
+            goTo(hub);
+            a.plan.push_back({ Verb::Trade, hub, 30 });
+            break;
+        }
+        case TAKE:
+        {
+            for (SimBounty& b : _bounties)
+                if (b.id == offer)
+                {
+                    b.taker = a.id; a.bounty = b.id; a.bountyProgress = 0;
+                    Log(EventType::BountyTaken, a, a.site, Acore::StringFormat("{} took the {} bounty on the {}.", Who(a), SiteName(b.hub), SiteName(b.site)), true);
+                    bounty = &b;
+                }
+            [[fallthrough]];
+        }
+        case GROWTH:
+        {
+            uint32 site = (bounty && a.bountyProgress < bounty->count) ? bounty->site : PickHuntSite(a);
+            if (!site) { score[GROWTH] = -1; goto move_on; }
+            uint32 minutes = r.Range(60, 180);
+            bool dangerous = bounty && bounty->party > 1 && site == bounty->site;
+            if (dangerous)
+            {
+                // a dangerous job: round up a party first; nobody willing and not brave enough -> hand it back
+                FormParty(a, site, minutes, bounty->party - 1, true);
+                if (PartySize(a) == 1 && a.bravery < 65)
+                {
+                    for (SimBounty& b : _bounties)
+                        if (b.id == a.bounty) b.taker = 0;
+                    Log(EventType::BountyAbandoned, a, a.site, Acore::StringFormat("{} couldn't find anyone to go after the {} with, and gave the bounty back.",
+                        a.FullName(), bounty->kind == BOUNTY_RARE ? RareName(bounty->target) : SiteName(bounty->site)), true);
+                    a.bounty = 0; a.bountyProgress = 0; bounty = nullptr;
+                    site = PickHuntSite(a);
+                    if (!site) { score[GROWTH] = -1; goto move_on; }
+                }
+                else if (PartySize(a) == 1)
+                    Log(EventType::BountyTaken, a, a.site, Acore::StringFormat("Nobody would come along, so {} went after it alone.", a.FullName()), a.bountyProgress == 0);
+            }
+            goTo(site);
+            a.plan.push_back({ Verb::Fight, site, minutes });
+            if (!dangerous) FormParty(a, site, minutes);
+            break;
+        }
+        case TIES:
+            goTo(a.home);
+            a.plan.push_back({ Verb::Socialize, a.home, r.Range(90, 150) });
+            break;
+        case AMBITION:
+            goTo(a.ambitionTarget, a.ambition == AmbitionType::SeePlace);
+            if (a.ambition == AmbitionType::Avenge) a.plan.push_back({ Verb::Fight, a.ambitionTarget, r.Range(90, 180) });
+            else a.plan.push_back({ Verb::Socialize, a.ambitionTarget, 60 });
+            break;
+        case WORK:
+            if (!PlanGather(a)) { goTo(a.home); a.plan.push_back({ Verb::Socialize, a.home, 60 }); }
+            break;
+        case TRAIN:
+        {
+            uint32 hub = NearestHub(a, SVC_TRAINER);
+            goTo(hub);
+            a.plan.push_back({ Verb::Train, hub, 30 });
+            break;
+        }
+        case CLAIM:
+            goTo(bounty->hub);
+            a.plan.push_back({ Verb::Trade, bounty->hub, 30 });
+            break;
+        case MOVEON:
+        move_on:
+        {
+            uint32 newHome = PickNewHome(a);
+            if (!newHome)
+            {
+                a.status = AgentStatus::Gone;
+                a.plan.clear();
+                Log(EventType::LeftRegion, a, a.site, Acore::StringFormat("{} outgrew these lands and set out for distant roads.", Who(a)), true);
+                SpawnNewcomer();
+                return;
+            }
+            std::string from = SiteName(a.home);
+            a.home = newHome;
+            Log(EventType::MovedHome, a, a.site, Acore::StringFormat("{} left {} for good and headed to {}, where the hunting suits them better.", Who(a), from, SiteName(newHome)), true);
+            goTo(newHome);
+            a.plan.push_back({ Verb::Trade, newHome, 30 });
+            break;
+        }
+    }
+    if (a.plan.empty()) a.plan.push_back({ Verb::Socialize, a.site, 60 });
+}
+
+void World::StartStep(SimAgent& a)
+{
+    PlanStep& s = a.plan.front();
+    a.doing = s.verb;
+    if (s.verb == Verb::Goto)
+    {
+        s.minutes = TravelMinutes(a.site, s.site, a);
+        // only purposeful journeys (an ambition to see a place) make the chronicle; errands and hunts are routine
+        Log(EventType::Departed, a, a.site, Acore::StringFormat("{} left {} for {}.", a.FullName(), SiteName(a.site), SiteName(s.site)), s.announce, 0, int32(s.minutes));
+    }
+    a.wakeAt = _clock + std::max<uint32>(1, s.minutes);
+}
+
+void World::FinishStep(SimAgent& a, PlanStep const& s)
+{
+    switch (s.verb)
+    {
+        case Verb::Goto:
+        {
+            uint32 from = a.site;
+            a.site = s.site;
+            if (a.role == ROLE_ADVENTURER)
+            {
+                RoadDanger(a, from, s.site);
+                if (a.status != AgentStatus::Active) break;
+            }
+            uint32 hours = s.minutes / 60;
+            a.fatigue = uint8(std::min<uint32>(100, a.fatigue + hours * 5));
+            a.wounds = uint8(a.wounds > hours * 3 ? a.wounds - hours * 3 : 0);
+            if (a.supplies > hours) a.supplies -= uint8(hours); else a.supplies = 0;
+            Log(EventType::Arrived, a, s.site, Acore::StringFormat("{} arrived at {}.", a.FullName(), SiteName(s.site)), false);
+            ExchangeNews(a);
+            break;
+        }
+        case Verb::Fight:
+            if (SimSite const* site = SiteById(s.site))
+                ResolveFight(a, *site, s.minutes);
+            break;
+        case Verb::Gather:
+            ResolveGather(a, s.site, s.minutes);
+            break;
+        case Verb::Sleep:
+            a.fatigue = 0;
+            a.wounds = uint8(a.wounds > 50 ? a.wounds - 50 : 0);
+            Log(EventType::Slept, a, a.site, Acore::StringFormat("{} slept at {}.", a.FullName(), SiteName(a.site)), false);
+            ExchangeNews(a);
+            break;
+        case Verb::Train:
+        {
+            uint32 cost = uint32(a.level) * a.level * 12;
+            if (a.money >= cost)
+            {
+                a.money -= cost;
+                a.trainedLevel = a.level;
+                Log(EventType::Trained, a, a.site, Acore::StringFormat("{} learned new skills from the trainers in {} ({}).", a.FullName(), SiteName(a.site), Money(cost)), a.level % 10 == 0);
+            }
+            else
+                Log(EventType::Broke, a, a.site, Acore::StringFormat("{} couldn't afford training in {} and went back out to earn it.", a.FullName(), SiteName(a.site)), false);
+            break;
+        }
+        case Verb::Trade:
+        {
+            ClaimBounty(a);
+            uint32 sold = a.lootValue;
+            a.money += sold; a.lootValue = 0;
+            // goods go into this town's market (the hook for shops with real stock)
+            auto& market = _market[a.site];
+            for (uint8 p = 1; p < PROF_COUNT; ++p) { market[p] += a.goodsUnits[p]; a.goodsUnits[p] = 0; }
+            uint32 repair = uint32(a.level) * a.level * 4 * (100 - a.durability) / 100;
+            uint32 restock = uint32(a.level) * 15 * (100 - a.supplies) / 100;
+            uint32 paid = 0;
+            if (a.money >= repair) { a.money -= repair; paid += repair; a.durability = 100; }
+            if (a.money >= restock) { a.money -= restock; paid += restock; a.supplies = 100; }
+            if (a.durability < 100 || a.supplies < 100)
+                Log(EventType::Broke, a, a.site, Acore::StringFormat("{} couldn't afford repairs and supplies at {} and had to make do.", a.FullName(), SiteName(a.site)), true);
+            else
+                Log(EventType::Traded, a, a.site, Acore::StringFormat("{} sold goods for {} and spent {} at {}.", a.FullName(), Money(sold), Money(paid), SiteName(a.site)), false, 0, int32(sold), int32(paid));
+            ExchangeNews(a);
+            break;
+        }
+        case Verb::Socialize:
+            Socialize(a);
+            ExchangeNews(a);
+            break;
+        default:
+            break;
+    }
+}
