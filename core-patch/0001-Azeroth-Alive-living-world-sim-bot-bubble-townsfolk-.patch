+// =====================================================================================================
+// the player in the world: bounty boards, hiring, being remembered
+// =====================================================================================================
+uint32 World::HubNear(uint32 map, float x, float y, float range) const
+{
+    uint32 best = 0; float bestD = range;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && s.map == map)
+        {
+            float d = Dist2d(s.x, s.y, x, y);
+            if (d < bestD) { bestD = d; best = s.id; }
+        }
+    return best;
+}
