+std::string World::ErrandText(SimErrand const& e)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(e.agent);
+    if (!a) return "";
+    if (e.kind == ERRAND_FETCH)
+    {
+        MarketGood const* g = nullptr;
+        for (MarketGood const& x : GOODS) if (x.item == e.item) g = &x;
+        if (!g) return "";
+        static char const* const why[PROF_COUNT] = { "", "My plough-blade's cracked and the smith wants ore for the mend.",
+            "My mother's cough is back, and the herbalist says this will settle it.", "The harness on the cart is falling apart.",
+            "We've had nothing but bread all week." };
+        static char const* const whyLabor[PROF_COUNT] = { "", "The axe-head's gone and the smith won't work without ore.",
+            "The foreman's hand got cut on a saw and it's gone bad.", "My boots have split right through.", "A man can't haul timber on bread alone." };
+        char const* reason = (a->job == JOB_LABORER ? whyLabor : why)[g->prof];
+        return Acore::StringFormat("{} Could you bring me {} {}? I'll pay {}.", reason, e.count, g->name, Money(e.reward));
+    }
+    if (e.kind == ERRAND_MESSAGE || e.kind == ERRAND_MISSING)
+    {
+        SimAgent const* t = AgentById(e.target);
+        if (!t) return "";
+        static char const* const kin[2][3] = { { "My brother", "My cousin", "A lad who lodges with us," }, { "My sister", "My cousin", "A girl who lodges with us," } };
+        std::string who = Acore::StringFormat("{} {}", kin[t->gender ? 1 : 0][(e.agent + e.target) % 3], t->given);
+        if (e.kind == ERRAND_MISSING)
+        {
+            uint32 days = std::max<uint32>(1, (_clock - t->diedAt) / MIN_PER_DAY);
+            return Acore::StringFormat("{} went out toward {} {} {} ago and never came back. Would you go and look? I can't pay much - {}.",
+                who, AreaOf(SiteName(t->site)), days, days == 1 ? "day" : "days", Money(e.reward));
+        }
+        std::string where = t->status != AgentStatus::Active ? "off somewhere" : Doing(*t);
+        return Acore::StringFormat("{} is {}. If you see {}, tell {} our mother's poorly and to come home for a bit. I'll pay {}.",
+            who, where, t->gender ? "her" : "him", t->gender ? "her" : "him", Money(e.reward));
+    }
+    SimSite const* s = SiteById(e.site);
+    if (!s) return "";
+    char const* what = a->job == JOB_FARMHAND ? "the fields" : a->job == JOB_LABORER ? "the woodpile" : a->job == JOB_MARKET ? "the stalls" : "the stores";
+    if (e.kind == ERRAND_OLDFOE)
+    {
+        static char const* const gear[] = { "my gear", "a sword", "a hammer", "a bow", "my daggers", "a staff", "a blade", "my totems", "a staff", "a staff", "my gear", "a staff" };
+        return Acore::StringFormat("Back when I still carried {}, {} near {} nearly finished me. It's still out there - I hear the talk. "
+            "Put it down for me, and bring friends. I'll pay {}.", gear[std::min<uint8>(a->cls, 11)], RareName(e.target), AreaOf(SiteName(s->id)), Money(e.reward));
+    }
+    if (e.kind == ERRAND_STOLEN)
+    {
+        char const* when = a->job == JOB_FARMHAND ? "out in the fields" : a->job == JOB_LABORER ? "at the woodpile" : a->job == JOB_MARKET ? "minding the stall" : "asleep";
+        return Acore::StringFormat("Someone went through the house while I was {} and took {}. The tracks went off toward {} - {}, I'd wager. "
+            "One of them has it. Get it back for me? I'll pay {}.", when, StolenThing(e.id), AreaOf(SiteName(s->id)), s->creatureName, Money(e.reward));
+    }
+    if (e.kind == ERRAND_ESCORT)
+    {
+        static char const* const why[] = { "My sister's near her time and I promised I'd be there.", "There's a buyer waiting on our wool, and he won't wait long.",
+            "I've been offered work there, if I turn up.", "My father's taken ill and there's nobody else to see to him." };
+        return Acore::StringFormat("I need to get to {}. {} But the road's not safe on my own. Would you walk with me? I'll pay {}.",
+            SiteName(s->id), why[(e.id + e.agent) % 4], Money(e.reward));
+    }
+    return Acore::StringFormat("The {} from {} have been at {} again. Thin them out - {} should do it. I'll pay {}.",
+        s->creatureName, AreaOf(SiteName(s->id)), what, e.count, Money(e.reward));
+}
+
+std::string World::TakeErrand(uint32 agentId, uint32 guid, std::string const& name)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand& e : _errands)
+    {
+        if (e.agent != agentId || e.done) continue;
+        if (e.player && e.player != guid) return "Someone's already said they'd do it, thanks.";
+        e.player = guid; e.progress = 0;
+        if (SimAgent* a = AgentById(agentId)) RememberPlayer(*a, guid, 10, 30, EventType::PlayerHelped);
+        (void)name;
+        if (e.kind == ERRAND_ESCORT) return "Thank you. Lead on - I'll keep close.";
+        return "Thank you. You'll find me about town.";
+    }
+    return "";
+}
+
+bool World::FinishErrand(uint32 agentId, uint32 guid, std::string const& name, uint32& reward, std::string& thanks)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    reward = 0;
+    for (SimErrand& e : _errands)
+    {
+        if (e.agent != agentId || e.done || e.player != guid) continue;
+        if (e.kind != ERRAND_FETCH && e.progress < e.count) return false;
+        e.done = true;
+        reward = e.reward;
+        SimAgent* a = AgentById(agentId);
+        if (a)
+        {
+            RememberPlayer(*a, guid, 50, 70, EventType::PlayerHelped);
+            std::string what = e.kind == ERRAND_FETCH ? "a delivery" : e.kind == ERRAND_CULL ? "the pests at their work"
+                : e.kind == ERRAND_STOLEN ? "getting back what thieves took" : e.kind == ERRAND_OLDFOE ? "an old score with " + RareName(e.target) : e.kind == ERRAND_ESCORT ? "the road to " + SiteName(e.site)
+                : e.kind == ERRAND_MESSAGE ? "word for family" : "news of the missing";
+            Log(EventType::PlayerHelped, *a, a->home, Acore::StringFormat("{} helped {} of {} with {}.", name, a->FullName(), SiteName(a->home), what), true);
+        }
+        static char const* const lines[] = { "That's a weight off. Thank you - truly.", "You're a good sort. Here, as promised.",
+            "I won't forget this.", "Bless you. I didn't think anyone would bother." };
+        thanks = lines[(e.id + guid) % 4];
+        if (e.kind == ERRAND_STOLEN)
+            thanks = Acore::StringFormat("That's it - that's {}! I never thought I'd see it again. Here, you've earned this.", StolenThing(e.id));
+        if (e.kind == ERRAND_OLDFOE)
+            thanks = Acore::StringFormat("{} is dead? ...Good. I've been saving this for whoever did it.", RareName(e.target));
+        if (e.kind == ERRAND_ESCORT)
+            thanks = Acore::StringFormat("{} at last. I'd not have made it alone. Here - as promised.", SiteName(e.site));
+        if (e.kind == ERRAND_MISSING)
+        {
+            static char const* const grief[] = { "So that's that, then. Thank you for going out there.", "I knew. I think I knew. Thank you for telling me.",
+                "...Thank you. I'd rather know than wonder." };
+            thanks = grief[(e.id + guid) % 3];
+        }
+        return true;
+    }
+    return false;
+}
+
+// the player is next to an adventurer: if they carry word from home for them, it's delivered - and they head home
+std::string World::ReachedPerson(uint32 guid, uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand& e : _errands)
+    {
+        if (e.done || e.kind != ERRAND_MESSAGE || e.player != guid || e.target != agentId || e.progress >= e.count) continue;
+        e.progress = e.count;
+        SimAgent* t = AgentById(agentId);
+        SimAgent* from = AgentById(e.agent);
+        if (!t || !from) return "";
+        if (t->status == AgentStatus::Active)
+        {
+            t->plan.clear();
+            t->plan.push_back({ Verb::Goto, t->home, 0, false });
+            t->plan.push_back({ Verb::Socialize, t->home, 180, false });
+            t->wakeAt = _clock + 1;
+            _requeue.push_back(t->id);
+        }
+        RememberPlayer(*t, guid, 20, 40, EventType::PlayerHelped);
+        Log(EventType::Departed, *t, t->site, Acore::StringFormat("{} got word from home and set off for {}.", t->FullName(), SiteName(t->home)), true);
+        static char const* const lines[] = { "Mother? I'll go at once. Thank you for coming all this way.", "Poorly? I'll head home tonight. Tell them I'm coming.",
+            "Thanks for finding me. I'll go back straight away." };
+        return lines[(e.id + guid) % 3];
+    }
+    return "";
+}
