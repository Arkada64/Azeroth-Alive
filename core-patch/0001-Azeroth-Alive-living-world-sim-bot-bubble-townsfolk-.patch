+namespace SoloSim
+{
+    // ---------------------------------------------------------------- time
+    // Sim time is in sim-minutes since the start of Day 1, 00:00. The world starts at Day 1, 06:00.
+    using SimTime = uint32;
+    constexpr SimTime MIN_PER_HOUR = 60;
+    constexpr SimTime MIN_PER_DAY  = 24 * 60;
+    inline uint32 DayOf(SimTime t)  { return t / MIN_PER_DAY + 1; }
+    inline uint32 HourOf(SimTime t) { return (t % MIN_PER_DAY) / 60; }
+    inline bool   IsNight(SimTime t) { uint32 h = HourOf(t); return h >= 22 || h < 6; }
+
+    // ---------------------------------------------------------------- deterministic RNG
+    // Every roll is hash(seed, agent, time, purpose, n): reproducible, and one agent never reshuffles another.
+    uint64 Mix(uint64 x);
+    struct Rng
+    {
+        uint64 state;
+        Rng(uint64 seed, uint64 a, uint64 b, uint64 c) : state(Mix(seed ^ Mix(a ^ Mix(b ^ Mix(c))))) {}
+        uint64 Next() { state += 0x9E3779B97F4A7C15ull; return Mix(state); }
+        float  Float() { return float(Next() >> 40) / float(1u << 24); }            // [0,1)
+        uint32 Range(uint32 lo, uint32 hi) { return hi <= lo ? lo : lo + uint32(Next() % (hi - lo + 1)); }
+        bool   Chance(float p) { return Float() < p; }
+    };
+
+    // ---------------------------------------------------------------- sites
+    enum class SiteType : uint8 { Hub = 1, Hunt = 2 };
+    enum HubService : uint32 { SVC_INN = 1, SVC_VENDOR = 2, SVC_REPAIR = 4, SVC_FLIGHT = 8, SVC_TRAINER = 16 };
+
+    struct SimSite
+    {
+        uint32 id = 0;
+        SiteType type = SiteType::Hub;
+        std::string name;                 // "Goldshire", "Kobold Vermin near Jasperlode Mine"
+        std::string creatureName;         // hunt sites: the dominant creature ("Kobold Vermin")
+        uint32 map = 0, zone = 0, area = 0;
+        float x = 0, y = 0, z = 0;
+        uint32 services = 0;              // hubs: HubService mask
+        uint8 minLevel = 0, maxLevel = 0; // hunt sites: creature levels
+        uint32 creatureType = 0;          // hunt: CreatureType of the dominant creature (beast 1, humanoid 7...)
+        uint32 copperPerKill = 0;         // hunt: average money drop (mingold/maxgold) of its creatures
+        bool elite = false;
+        uint32 spawns = 0;                // how many creature spawns formed it
+        uint8 regionLevel = 0;            // hubs: typical level of hunting nearby
+    };
+
+    // ---------------------------------------------------------------- agents
+    enum class AgentStatus : uint8 { Active = 1, Recovering = 2, Dead = 3, Gone = 4, Hired = 5 };
+    enum class Verb : uint8 { Idle = 0, Goto = 1, Fight = 2, Sleep = 3, Trade = 4, Socialize = 5, Recover = 6, Gather = 7, Train = 8, Work = 9 };
+    enum class AmbitionType : uint8 { None = 0, ReachLevel = 1, SaveGold = 2, SeePlace = 3, Avenge = 4 };
+    enum Role : uint8 { ROLE_ADVENTURER = 0, ROLE_CIVILIAN = 1, ROLE_THREAT = 2 };   // threat: a roaming hero-class elite (hostile to all)
+    constexpr uint32 THREAT_MARK = 0x80000000;
+    constexpr uint32 CAMP_MARK = 0x40000000;     // ... with this bit, a roadside camp's id
+    // A band that has made camp by a road where its kind isn't normally found; spawned for real when a player comes near.
+    struct SimCamp { uint32 id = 0, map = 0, entry = 0, town = 0, site = 0; float x = 0, y = 0, z = 0; std::string name; uint8 level = 1, size = 0, alive = 0; SimTime made = 0, until = 0; bool done = false; };   // a bounty target with this bit is a threat's agent id, not a creature entry
+    enum Job : uint8 { JOB_NONE = 0, JOB_FARMHAND = 1, JOB_LABORER = 2, JOB_MARKET = 3, JOB_LOAFER = 4 };
+    enum Profession : uint8 { PROF_NONE = 0, PROF_MINING = 1, PROF_HERBALISM = 2, PROF_SKINNING = 3, PROF_FISHING = 4, PROF_COUNT = 5 };
+
+    struct PlanStep { Verb verb = Verb::Idle; uint32 site = 0; uint32 minutes = 0; bool announce = false; }; // announce: a journey with a purpose (chronicle)
+
+    struct SimAgent
+    {
+        // identity
+        uint32 id = 0;
+        std::string given, family;
+        uint8 gender = 0, race = 0, cls = 0;
+        uint32 sourceEntry = 0;           // NPCBots template used for looks/class when embodied
+        // progress
+        uint8 level = 1;
+        uint32 xp = 0;
+        uint8 gearTier = 30;              // 0-100, relative to level
+        uint32 money = 0;                 // copper
+        uint32 lootValue = 0;             // copper worth of unsold loot in bags
+        // body state, 0-100
+        uint8 wounds = 0, fatigue = 0, supplies = 100, durability = 100;
+        // personality, 0-100, fixed
+        uint8 bravery = 50, greed = 50, sociability = 50, caution = 50, wanderlust = 50;
+        // life
+        uint32 home = 0;                  // hub site id
+        uint32 site = 0;                  // where they are now (site id)
+        SimTime born = 0;
+        uint8 age0 = 0;                   // age (years) when born was set; a year passes every game week (see Age())
+        AgentStatus status = AgentStatus::Active;
+        SimTime statusUntil = 0;          // recovering until
+        uint8 defeats = 0;
+        SimTime diedAt = 0;
+        std::string deathCause;
+        uint32 kills = 0;
+        // ambition
+        AmbitionType ambition = AmbitionType::None;
+        uint32 ambitionTarget = 0;        // level / gold / site id / site id
+        uint32 ambitionProgress = 0;
+        uint32 avengeFor = 0;             // agent id being avenged
+        // plan
+        std::vector<PlanStep> plan;       // remaining steps, front = current
+        Verb doing = Verb::Idle;
+        SimTime wakeAt = 0;
+        SimTime lastSocial = 0;
+        // v2: life beyond hunting
+        uint32 party = 0;                 // runtime only: ad-hoc hunting party id
+        uint8 partySize = 1;              // runtime only: size when the party formed
+        uint32 lastParty = 0; SimTime lastPartyAt = 0; // runtime only: the outing just finished (mates may still be resolving it)
+        std::array<uint32, PROF_COUNT> goodsUnits{}; // runtime only: gathered goods carried to market
+        uint32 bounty = 0, bountyProgress = 0;
+        uint8 trainedLevel = 1;           // last level they visited a trainer for
+        std::array<uint8, 2> prof{};      // Profession
+        std::array<uint16, 2> profSkill{};
+        std::vector<uint32> knownNews;
+        uint8 role = ROLE_ADVENTURER, job = JOB_NONE;   // townsfolk live at home and work in town; they don't hunt
+
+        std::string FullName() const { return family.empty() ? given : given + " " + family; }
+    };
+
+    struct SimRelation { uint32 a = 0, b = 0; uint8 kind = 1; int8 strength = 50; }; // kind: 1 friend, 2 rival, 3 partner
+
+    struct SimMemory { uint32 agent = 0; uint8 subjectType = 0; uint32 subject = 0; uint8 eventType = 0; int8 valence = 0; uint8 intensity = 0; SimTime at = 0; };
+
+    enum class EventType : uint8
+    {
+        Arrived = 1, Departed = 2, Hunted = 3, LevelUp = 4, Traded = 5, Slept = 6, Defeated = 7, Died = 8,
+        Recovered = 9, MovedHome = 10, Socialized = 11, AmbitionSet = 12, AmbitionDone = 13, HeardDeath = 14,
+        Newcomer = 15, LeftRegion = 16, Broke = 17, PartyFormed = 18, Gathered = 19, SkillUp = 20, RareFind = 21,
+        BountyPosted = 22, BountyTaken = 23, BountyDone = 24, BountyExpired = 25, Trained = 26, Weather = 27, FellBeside = 28,
+        RareSlain = 29, BountyAbandoned = 30, RareRepelled = 31, PlayerHelped = 32, Hired = 33, Dismissed = 34, PlayerBounty = 35
+    };
+
+    struct SimEvent
+    {
+        uint64 id = 0;
+        SimTime at = 0;
+        EventType type = EventType::Arrived;
+        uint32 actor = 0, target = 0, site = 0;
+        int32 n1 = 0, n2 = 0;
+        bool notable = false;             // goes to the chronicle (everything goes to the full log)
+        std::string text;
+    };
+
+    // Bounties: thinning a camp; breaking up a big pack; elites; a named rare. The last three are meant for parties.
+    enum BountyKind : uint8 { BOUNTY_THIN = 0, BOUNTY_PACK = 1, BOUNTY_ELITE = 2, BOUNTY_RARE = 3 };
+    struct SimBounty
+    {
+        uint32 id = 0, hub = 0, site = 0, count = 0, reward = 0, taker = 0; SimTime posted = 0, expires = 0; bool done = false;
+        uint8 kind = BOUNTY_THIN, party = 1;      // party: how many the board says to bring
+        uint32 target = 0; uint8 targetLevel = 0; // rare: creature entry and level
+        uint32 player = 0, playerProgress = 0;    // a player who took it (character guid low) and their kills
+    };
+    // A named rare in the region (from the world's spawns, not saved): hunted down by bounty, gone for a while once slain.
+    struct SimRare { uint32 entry = 0, site = 0; std::string name; uint8 level = 1; bool elite = false; };
+    struct SimNews { uint32 id = 0, subject = 0, site = 0; SimTime at = 0; };   // a death, spreading town to town
+    // A townsperson's request: bring goods, or thin out the creatures pestering their work. Shown with a blue '!'.
+    enum ErrandKind : uint8 { ERRAND_FETCH = 1, ERRAND_CULL = 2, ERRAND_MESSAGE = 3, ERRAND_MISSING = 4, ERRAND_STOLEN = 5, ERRAND_ESCORT = 6, ERRAND_OLDFOE = 7 };
+    char const* StolenThing(uint32 errandId);   // what the thieves took (stolen errands)
+    struct SimErrand { uint32 id = 0, agent = 0; uint8 kind = 0; uint32 item = 0, site = 0, count = 0, reward = 0, player = 0, progress = 0; SimTime expires = 0; bool done = false; uint32 target = 0; };
+    struct SimMail { uint32 guid = 0, hub = 0; std::string subject, body; uint32 money = 0; };  // a letter to a player from a town
+
+    // Where a person is right now, for embodiment by the bot bubble.
+    struct SimBody
+    {
+        uint32 agent = 0;
+        std::string name;
+        uint8 race = 0, cls = 0, gender = 0, level = 1;
+        uint32 sourceEntry = 0;
+        uint32 map = 0, zone = 0;
+        float x = 0, y = 0, z = 0;
+        uint32 spawnNode = 0;             // wander node to appear at (on their road, or at their site)
+        uint32 goalNode = 0;              // wander node they are heading for / staying around
+        Verb doing = Verb::Idle;
+        uint8 role = 0, job = 0;
+        uint32 home = 0;
