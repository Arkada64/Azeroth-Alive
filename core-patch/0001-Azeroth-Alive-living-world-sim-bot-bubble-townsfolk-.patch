+std::string World::Run(uint32 days) { return RunSpan(days * MIN_PER_DAY, Acore::StringFormat("{} days", days)); }
+std::string World::RunHours(uint32 hours) { return RunSpan(hours * MIN_PER_HOUR, Acore::StringFormat("{} hours", hours)); }
+
+std::string World::RunSpan(SimTime span, std::string const& label)
+{
+    std::string ready = EnsureReady();
+    if (!_ready) return ready;
+    SimTime start = _clock, end = _clock + span;
+    uint32 msStart = getMSTime();
+    uint32 wakes = 0;
+    Flush("");                                          // anything the live world has not written yet
+    size_t before = _pending.size();
+    Advance(end, wakes);
+    uint32 events = uint32(_pending.size() - before);
+    uint32 notable = Flush(Acore::StringFormat("######## Sim run: {} -> {} (seed {}) ########", Clock(start), Clock(end), _seed));
+    std::string summary = Status();
+    Persist();
+    std::string dir = sConfigMgr->GetOption<std::string>("LogsDir", "");
+    if (!dir.empty() && dir.back() != '/' && dir.back() != '\\') dir += "/";
+    return Acore::StringFormat("ran {} in {} ms: {} wakes, {} events ({} in the chronicle). {} Chronicle: {}chronicle.txt",
+        label, GetMSTimeDiffToNow(msStart), wakes, events, notable, summary, dir);
+}
+
+void World::Persist()
+{
+    Save();
+    _pending.clear();
+    _flushed = 0;
+}
+
+// Writes events not yet written: notable ones to chronicle.txt, everything to sim-full.log. Returns notable count.
+uint32 World::Flush(std::string const& header)
+{
+    if (_flushed >= _pending.size()) return 0;
+    std::stable_sort(_pending.begin() + _flushed, _pending.end(), [](SimEvent const& x, SimEvent const& y) { return x.at != y.at ? x.at < y.at : x.id < y.id; });
+    std::string dir = sConfigMgr->GetOption<std::string>("LogsDir", "");
+    if (!dir.empty() && dir.back() != '/' && dir.back() != '\\') dir += "/";
+    // the chronicle keeps one older volume: past 2 MB it becomes chronicle-older.txt and a new one starts
+    {
+        std::error_code ec;
+        std::filesystem::path p(dir + "chronicle.txt");
+        if (std::filesystem::exists(p, ec) && std::filesystem::file_size(p, ec) > 2u * 1024 * 1024)
+        {
+            std::filesystem::path older(dir + "chronicle-older.txt");
+            std::filesystem::remove(older, ec);
+            std::filesystem::rename(p, older, ec);
+        }
+    }
+    static bool const fullLog = sConfigMgr->GetOption<bool>("SoloSim.FullLog", false);   // every little thing: debugging only
+    std::ofstream chron(dir + "chronicle.txt", std::ios::app), full;
+    if (fullLog) full.open(dir + "sim-full.log", std::ios::app);
+    static uint32 lastDay = 0;
+    uint32 notable = 0;
+    if (!header.empty()) { chron << "\n" << header << "\n"; lastDay = 0; }
+    for (size_t i = _flushed; i < _pending.size(); ++i)
+    {
+        SimEvent const& e = _pending[i];
+        if (fullLog) full << Clock(e.at) << " - " << e.text << "\n";
+        if (!e.notable) continue;
+        if (DayOf(e.at) != lastDay) { lastDay = DayOf(e.at); chron << "\n=== Day " << lastDay << " ===\n"; }
+        chron << Acore::StringFormat("{:02}:{:02}  ", HourOf(e.at), e.at % 60) << e.text << "\n";
+        ++notable;
+    }
+    _flushed = _pending.size();
+    return notable;
+}
+
+void World::Advance(SimTime end, uint32& wakes)
+{
+    if (end <= _clock) return;
+    using QItem = std::pair<SimTime, uint32>;
+    std::priority_queue<QItem, std::vector<QItem>, std::greater<QItem>> q;
+    for (auto& [id, a] : _agents)
+        if (a.status == AgentStatus::Active || a.status == AgentStatus::Recovering)
+        {
+            a.wakeAt = std::max(a.wakeAt, _clock);
+            q.push({ a.wakeAt, id });
+        }
+
+    uint32 known = _nextAgent;
+    while (!q.empty())
+    {
+        auto [t, id] = q.top();
+        if (t > end) break;
+        q.pop();
+        SimAgent* a = AgentById(id);
+        if (!a || a->wakeAt != t) continue;             // stale queue entry
+        _clock = t;
+        if (DayOf(t) > _lastDailyTick) { _lastDailyTick = DayOf(t); DailyTick(); }
+        if (t / (12 * MIN_PER_HOUR) > _lastBountyTick) { _lastBountyTick = t / (12 * MIN_PER_HOUR); PostBounties(); PostErrands(); }
+        Wake(*a);
+        ++wakes;
+        if (a->status == AgentStatus::Active || a->status == AgentStatus::Recovering) q.push({ a->wakeAt, id });
+        for (uint32 rid : _requeue)                     // party members whose plans changed
+            if (SimAgent* m = AgentById(rid)) q.push({ m->wakeAt, rid });
+        _requeue.clear();
+        for (; known < _nextAgent; ++known)             // newcomers
+            if (SimAgent* n = AgentById(known)) q.push({ n->wakeAt, known });
+    }
+    _clock = end;
+}
+
+std::string World::Status() const
+{
+    if (!_ready) return "sim not started (.sim run <days>)";
+    uint32 active = 0, recovering = 0, dead = 0, gone = 0, levelSum = 0, alive = 0, townsfolk = 0, threats = 0;
+    uint8 top = 0;
+    for (auto const& [id, a] : _agents)
+    {
+        if (a.role == ROLE_CIVILIAN) { if (a.status == AgentStatus::Active) ++townsfolk; continue; }
+        if (a.role == ROLE_THREAT) { if (a.status == AgentStatus::Active) ++threats; continue; }
+        switch (a.status)
+        {
+            case AgentStatus::Active: ++active; break;
+            case AgentStatus::Recovering: ++recovering; break;
+            case AgentStatus::Dead: ++dead; break;
+            case AgentStatus::Gone: ++gone; break;
+            default: break;
+        }
+        if (a.status == AgentStatus::Active || a.status == AgentStatus::Recovering) { levelSum += a.level; ++alive; top = std::max(top, a.level); }
+    }
+    uint32 openBounties = uint32(std::ranges::count_if(_bounties, [](SimBounty const& b) { return !b.done; }));
+    uint64 goods = 0;
+    for (auto const& [hub, g] : _market) for (uint32 v : g) goods += v;
+    return Acore::StringFormat("{}: {} adventurers active, {} recovering, {} dead, {} left the region; average level {:.1f}, highest {}; {} townsfolk; {} {} abroad; {} open bounties, {} lots of goods in town markets.",
+        Clock(_clock), active, recovering, dead, gone, alive ? float(levelSum) / alive : 0.0f, top, townsfolk, threats, threats == 1 ? "threat" : "threats", openBounties, goods);
+}
