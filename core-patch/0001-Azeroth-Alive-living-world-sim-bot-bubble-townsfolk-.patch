+    uint32 before = _nextAgent;
+    SpawnThreats(true);
+    std::string out;
+    for (uint32 id = before; id < _nextAgent; ++id)
+        if (SimAgent const* t = AgentById(id))
+            out += Acore::StringFormat("{}{} (level {}) is prowling near {}.", out.empty() ? "" : " ", t->FullName(), t->level, AreaOf(SiteName(t->site)));
+    return out.empty() ? "Each continent already has a threat." : out;
+}
