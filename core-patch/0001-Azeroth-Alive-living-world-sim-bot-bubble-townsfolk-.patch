+// =====================================================================================================
+// v2: gathering professions
+// =====================================================================================================
+bool World::PlanGather(SimAgent& a)
+{
+    // pick a gathering profession (skinning happens during hunts) and a fitting spot
+    std::vector<uint8> slots;
+    for (uint8 i = 0; i < 2; ++i)
+        if (a.prof[i] == PROF_MINING || a.prof[i] == PROF_HERBALISM || a.prof[i] == PROF_FISHING) slots.push_back(i);
+    if (slots.empty()) return false;
+    Rng r = R(a, P_GATHER);
+    uint8 slot = slots[r.Range(0, uint32(slots.size()) - 1)];
+    uint8 prof = a.prof[slot];
+    uint32 best = 0; float bestScore = -1e9f;
+    for (SimSite const& s : _sites)
+    {
+        bool ok = false;
+        switch (prof)
+        {
+            case PROF_MINING:    ok = s.type == SiteType::Hunt && NameHas(s.name, { "Mine", "Quarry", "Cave", "Hills", "Ridge", "Tunnel", "Pit" }); break;
+            case PROF_HERBALISM: ok = s.type == SiteType::Hunt && !NameHas(s.name, { "Mine", "Quarry", "Tunnel", "Crypt", "Catacomb" }); break;
+            case PROF_FISHING:   ok = NameHas(s.name, { "Lake", "Coast", "River", "Pond", "Shore", "Bay", "Falls", "Water", "Pool", "Bank" }); break;
+            default: break;
+        }
+        if (!ok) continue;
+        if (s.type == SiteType::Hunt && s.minLevel > a.level + 2) continue;            // too dangerous to work there
+        float score = -float(TravelMinutes(a.site, s.id, a)) - (s.type == SiteType::Hunt ? std::abs(float(s.minLevel) - a.level) * 3.0f : 0.0f) + r.Float() * 20.0f;
+        if (score > bestScore) { bestScore = score; best = s.id; }
+    }
+    if (!best) return false;
+    if (best != a.site) a.plan.push_back({ Verb::Goto, best, 0, false });
+    a.plan.push_back({ Verb::Gather, best, r.Range(60, 150), false });
+    // the skill this outing trains goes to slot 0 (ResolveGather reads slot 0)
+    if (slot == 1) std::swap(a.prof[0], a.prof[1]), std::swap(a.profSkill[0], a.profSkill[1]);
+    return true;
+}
+
+void World::SkillUp(SimAgent& a, uint8 slot, uint32 tries)
+{
+    // WoW-like: skill rises easily early, slower near the cap; cap follows level (trainers) up to 450.
+    uint16 cap = uint16(std::min<uint32>(450, 75 + uint32(a.level) * 5));
+    Rng r = R(a, P_GATHER + 7);
+    uint16 before = a.profSkill[slot];
+    for (uint32 i = 0; i < tries && a.profSkill[slot] < cap; ++i)
+    {
+        float chance = 0.35f * std::max(0.1f, 1.0f - float(a.profSkill[slot]) / float(cap + 25));   // slower than retail (Era)
+        if (r.Chance(chance)) ++a.profSkill[slot];
+    }
+    for (uint16 milestone : { 75, 150, 225, 300, 375 })
+        if (before < milestone && a.profSkill[slot] >= milestone)
+            Log(EventType::SkillUp, a, a.site, Acore::StringFormat("{} became a {} hand at {} (skill {}).", a.FullName(),
+                milestone >= 300 ? "master" : milestone >= 225 ? "seasoned" : milestone >= 150 ? "capable" : "decent", ProfName(a.prof[slot]), milestone), true);
+}
+
+void World::ResolveGather(SimAgent& a, uint32 siteId, uint32 minutes)
+{
+    SimSite const* site = SiteById(siteId);
+    if (!site) return;
+    uint8 prof = a.prof[0];                                  // PlanGather put the trained skill in slot 0
+    Rng r = R(a, P_GATHER + 3);
+    uint32 tries = std::max<uint32>(1, minutes / 6), units = 0;
+    uint32 tier = std::min<uint32>(a.profSkill[0] / 75, 5);
+    for (uint32 i = 0; i < tries; ++i)
+    {
+        if (r.Chance(prof == PROF_FISHING ? 0.7f : 0.55f)) ++units;
+        // hostile ground: something may notice you
+        if (site->type == SiteType::Hunt)
+        {
+            int32 d = std::clamp<int32>(int32(site->maxLevel) - int32(a.level), -4, 5);
+            if (r.Chance(0.02f * std::pow(1.5f, float(d)))) a.wounds = uint8(std::min<uint32>(95, a.wounds + r.Range(5, 15)));
+        }
+        if (r.Chance(0.0015f))
+        {
+            static const std::array<char const*, 4> rare = { "a flawless gem in the rock", "a rare bloom", "a pearl in a mussel", "a forgotten coin purse" };
+            char const* what = rare[prof == PROF_MINING ? 0 : prof == PROF_HERBALISM ? 1 : prof == PROF_FISHING ? 2 : 3];
+            uint32 value = 2000 + tier * 3000;
+            a.lootValue += value;
+            Log(EventType::RareFind, a, siteId, Acore::StringFormat("{} found {} while {} {} (worth {}).", a.FullName(), what,
+                prof == PROF_MINING ? "mining" : prof == PROF_HERBALISM ? "gathering herbs" : "fishing", PlaceOnly(SiteName(siteId)), Money(value)), true);
+        }
+    }
+    uint32 perUnit = 20 * (tier + 1) * (tier + 1);
+    a.lootValue += units * perUnit;
+    a.goodsUnits[prof] += units;
+    a.fatigue = uint8(std::min<uint32>(100, a.fatigue + minutes * 4 / 60));
+    SkillUp(a, 0, units);
+    Log(EventType::Gathered, a, siteId, Acore::StringFormat("{} spent {} hours {} {} ({} lots).", a.FullName(), minutes / 60,
+        prof == PROF_MINING ? "mining" : prof == PROF_HERBALISM ? "gathering herbs" : "fishing", PlaceOnly(SiteName(siteId)), units), false, 0, int32(units));
+}
+
+// =====================================================================================================
+// v2: bounties posted by towns
+// =====================================================================================================
+void World::PostBounties()
+{
+    // expire old ones
+    for (SimBounty& b : _bounties)
+    {
+        if (_away && b.player && !b.done) { b.expires = std::max(b.expires, _clock + MIN_PER_DAY); continue; }   // yours waits for you
+        if (b.done || _clock < b.expires) continue;
+        b.done = true;
+        if (SimAgent* t = AgentById(b.taker)) { t->bounty = 0; t->bountyProgress = 0; }
+        if (SimSite const* s = SiteById(b.site))
+            Log(EventType::BountyExpired, Nobody(), b.hub, Acore::StringFormat("The bounty {} posted on {} went unclaimed.", SiteName(b.hub), SiteName(s->id)), b.taker == 0);
+    }
+    std::erase_if(_bounties, [this](SimBounty const& b) { return b.done && _clock - b.expires > 2 * MIN_PER_DAY; });
+
+    // every 12 hours, towns with an inn and trouble nearby fill their board: up to 3 open bounties, no two on the same camp
+    for (SimSite const& h : _sites)
+    for (uint32 k = uint32(std::ranges::count_if(_bounties, [&h](SimBounty const& b) { return b.hub == h.id && !b.done; })); k < 3; ++k)
+    {
+        if (h.type != SiteType::Hub || !(h.services & SVC_INN) || !h.regionLevel) break;
+        Rng r(_seed, h.id * 8 + k, _clock, P_BOUNTY);
+        auto posted = [&](uint32 site) { return std::ranges::any_of(_bounties, [&](SimBounty const& b) { return b.hub == h.id && !b.done && b.site == site; }); };
+        auto inRange = [&](SimSite const& s, int32 below, int32 above) {
+            int32 mid = (s.minLevel + s.maxLevel) / 2, rl = h.regionLevel;
+            return s.type == SiteType::Hunt && s.map == h.map && Dist2d(h.x, h.y, s.x, s.y) < 1500.0f && mid >= rl - below && mid <= rl + above;
+        };
+        std::vector<uint32> thin, packs, elites;
+        for (SimSite const& s : _sites)
+        {
+            if ((!inRange(s, 4, 4) && !inRange(s, 2, 7)) || posted(s.id)) continue;
+            if (s.elite) { if (inRange(s, 2, 7)) elites.push_back(s.id); }
+            else if (inRange(s, 4, 4)) { thin.push_back(s.id); if (s.spawns >= 15) packs.push_back(s.id); }
+        }
+        std::vector<SimRare const*> rares;
+        for (SimRare const& rare : _rares)
+        {
+            SimSite const* s = SiteById(rare.site);
+            auto down = _rareDownUntil.find(rare.entry);
+            if (s && s->map == h.map && Dist2d(h.x, h.y, s->x, s->y) < 1800.0f && int32(rare.level) >= int32(h.regionLevel) - 2 && int32(rare.level) <= int32(h.regionLevel) + 8
+                && (down == _rareDownUntil.end() || _clock >= down->second)
+                && !std::ranges::any_of(_bounties, [&](SimBounty const& o) { return !o.done && o.kind == BOUNTY_RARE && o.target == rare.entry; }))
+                rares.push_back(&rare);
+        }
+
+        // what the board asks for: mostly thinning; sometimes a pack, elites or a named rare - work for a party
+        uint32 roll = r.Range(1, 100);
+        SimBounty b; b.id = _nextBounty++; b.hub = h.id;
+        b.posted = _clock; b.expires = _clock + r.Range(3, 5) * MIN_PER_DAY;
+        std::string text;
+        if (roll > 85 && !rares.empty())
+        {
+            SimRare const* rare = rares[r.Range(0, uint32(rares.size()) - 1)];
+            b.kind = BOUNTY_RARE; b.site = rare->site; b.count = 1; b.target = rare->entry; b.targetLevel = rare->level;
+            b.party = rare->elite ? 3 : 2;
+            b.reward = uint32(rare->level) * rare->level * 30 + 500;   // pay goes by level only; the loot is the rest of the pay
+            b.expires = _clock + r.Range(4, 7) * MIN_PER_DAY;
+            text = Acore::StringFormat("{} put a price on {} (level {}{}), seen near {}: {}. Hunters are told to go in numbers.",
+                SiteName(h.id), rare->name, rare->level, rare->elite ? ", elite" : "", AreaOf(SiteName(rare->site)), Money(b.reward));
+        }
+        else if (roll > 72 && !elites.empty())
+        {
+            SimSite const* s = SiteById(elites[r.Range(0, uint32(elites.size()) - 1)]);
+            uint32 lvl = (s->minLevel + s->maxLevel) / 2;
+            b.kind = BOUNTY_ELITE; b.site = s->id; b.count = r.Range(5, 8); b.party = 3;
+            b.reward = lvl * lvl * 30 + 500;
+            text = Acore::StringFormat("{} wants the {} dealt with: {} of them ({}). They are dangerous - bring friends.",
+                SiteName(h.id), SiteName(s->id), b.count, Money(b.reward));
+        }
+        else if (roll > 55 && !packs.empty())
+        {
+            SimSite const* s = SiteById(packs[r.Range(0, uint32(packs.size()) - 1)]);
+            uint32 lvl = (s->minLevel + s->maxLevel) / 2;
+            b.kind = BOUNTY_PACK; b.site = s->id; b.count = r.Range(25, 40); b.party = 2;
+            b.reward = lvl * lvl * 30 + 500;
+            text = Acore::StringFormat("{} is paying to break up the {}: {} of them ({}). Not a job for one.",
+                SiteName(h.id), SiteName(s->id), b.count, Money(b.reward));
+        }
+        else
+        {
+            if (thin.empty()) { --_nextBounty; continue; }
+            SimSite const* s = SiteById(thin[r.Range(0, uint32(thin.size()) - 1)]);
+            uint32 lvl = (s->minLevel + s->maxLevel) / 2;
+            b.kind = BOUNTY_THIN; b.site = s->id; b.count = r.Range(10, 20); b.party = 1;
+            b.reward = lvl * lvl * 30 + 500;
+            text = Acore::StringFormat("{} posted a bounty: {} of the {} ({}).", SiteName(h.id), b.count, SiteName(s->id), Money(b.reward));
+        }
+        _bounties.push_back(b);
+        Log(EventType::BountyPosted, Nobody(), h.id, text, true);
+        if (b.kind == BOUNTY_RARE)                           // people the town knows hear of a price on a rare
+        {
+            std::set<uint32> known;
+            for (SimMemory const& m : _memories) if (m.subjectType == 4) known.insert(m.subject);
+            for (SimBounty const& o : _bounties) if (o.player) known.insert(o.player);
+            for (uint32 g : known)
+                _mail.push_back({ g, h.id, "A price on " + RareName(b.target), text + "\n\nThe board is outside the inn, if you're interested.", 0 });
+        }
+    }
+}
+
+std::string World::RareName(uint32 entry) const
+{
+    if (entry & CAMP_MARK)
+    {
+        for (SimCamp const& k : _camps) if (k.id == (entry & ~CAMP_MARK)) return "the " + k.name + " camp by the road";
+        return "a roadside camp";
+    }
+    if (entry & THREAT_MARK)
+    {
+        auto it = _agents.find(entry & ~THREAT_MARK);
+        return it == _agents.end() ? "the beast" : it->second.FullName();
+    }
+    for (SimRare const& x : _rares) if (x.entry == entry) return x.name;
+    return "the beast";
+}
+
+SimBounty* World::BountyOf(SimAgent const& a)
+{
+    if (!a.bounty) return nullptr;
+    for (SimBounty& b : _bounties)
+        if (b.id == a.bounty) return &b;
+    return nullptr;
+}
+
+void World::FindRares()
+{
+    // named rares and rare elites of the region, each tied to the nearest hunting ground (ordered by spawn id)
+    _rares.clear();
+    FactionTemplateEntry const* alliance = sFactionTemplateStore.LookupEntry(1);
+    std::map<ObjectGuid::LowType, CreatureData const*> spawns;
+    for (auto const& [guid, data] : sObjectMgr->GetAllCreatureData())
+        if (SIM_MAPS.contains(data.mapid))
+            spawns[guid] = &data;
+    std::set<uint32> seen;
+    for (auto const& [guid, data] : spawns)
+    {
+        CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(data->id);
+        if (!t || (t->rank != 2 && t->rank != 4) || seen.contains(t->Entry) || t->IsNPCBotOrPet()) continue;
+        FactionTemplateEntry const* ft = sFactionTemplateStore.LookupEntry(t->faction);
+        if (!ft || !alliance || ft->IsFriendlyTo(*alliance)) continue;
+        uint32 best = 0; float bestD = 400.0f;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && s.map == data->mapid && REGION_ZONES.contains(s.zone))
+            {
+                float d = Dist2d(s.x, s.y, data->posX, data->posY);
+                if (d < bestD) { bestD = d; best = s.id; }
+            }
+        if (!best) continue;
+        seen.insert(t->Entry);
+        SimRare rare; rare.entry = t->Entry; rare.site = best; rare.name = t->Name;
+        rare.level = uint8((t->minlevel + t->maxlevel) / 2); rare.elite = t->rank == 2;
+        _rares.push_back(rare);
+    }
+    LOG_INFO("server.loading", "SoloWoW sim: {} named rares in the region", uint32(_rares.size()));
+}
+
+// A party (or a fool alone) tracks down the bounty's rare. True if it was found and fought this outing.
+bool World::RareFight(SimAgent& a, SimBounty& b, SimSite const& site)
+{
+    Rng r = R(a, P_BOUNTY + 100);
+    if (!r.Chance(0.45f)) return false;                       // no sign of it today
+    SimRare const* rare = nullptr;
+    for (SimRare const& x : _rares) if (x.entry == b.target) rare = &x;
+    if (!rare) return false;
+    uint32 n = PartySize(a);
+    float us = float(n) * float(a.level) * (0.8f + a.gearTier / 250.0f) * (1.0f + a.bravery / 400.0f);
+    float them = float(rare->level) * (rare->elite ? 2.6f : 1.5f);
+    float win = std::clamp(us / (us + them) * 1.2f, 0.05f, 0.95f);
+    std::vector<std::string> names{ a.FullName() };
+    if (a.party)
+        for (auto const& [id, o] : _agents)
+            if (o.id != a.id && InParty(o, a.party)) names.push_back(o.FullName());
+    std::string party = names.size() == 1 ? names[0] : names.size() == 2 ? names[0] + " and " + names[1] : names[0] + ", " + names[1] + " and " + names[2];
+    if (r.Chance(win))
+    {
+        uint32 xp = uint32(Acore::XP::BaseGain(a.level, rare->level, CONTENT_1_60) * sWorld->getRate(RATE_XP_KILL) * (rare->elite ? 4.0f : 2.0f));
+        a.xp += xp;
+        while (a.level < 80 && a.xp >= sObjectMgr->GetXPForLevel(a.level)) { a.xp -= sObjectMgr->GetXPForLevel(a.level); ++a.level; }
+        a.lootValue += uint32(rare->level) * rare->level * 20;
+        a.gearTier = uint8(std::min(100, a.gearTier + 8));                 // rares drop good things
+        b.count = 1; a.bountyProgress = 1;
+        _rareDownUntil[rare->entry] = _clock + r.Range(5, 10) * MIN_PER_DAY;
+        _memories.push_back({ a.id, 3, site.id, uint8(EventType::RareSlain), 90, 95, _clock });
+        Log(EventType::RareSlain, a, site.id, Acore::StringFormat("{} brought down {} near {}.", party, rare->name, AreaOf(SiteName(site.id))), true, 0, rare->level);
+        return true;
+    }
+    Log(EventType::RareRepelled, a, site.id, Acore::StringFormat("{} found {} near {} - and it was too much for them.", party, rare->name, AreaOf(SiteName(site.id))), true);
+    a.wounds = 100;                                           // the defeat roll decides the rest
+    return true;
+}
+
+uint32 World::PickBounty(SimAgent const& a) const
+{
+    for (SimBounty const& b : _bounties)
+    {
+        if (b.done || b.taker || (b.hub != a.site && b.hub != a.home)) continue;
+        SimSite const* s = SiteById(b.site);
+        if (!s) continue;
+        switch (b.kind)
+        {
+            case BOUNTY_RARE:  if (b.target & (THREAT_MARK | CAMP_MARK)) break;                      // threats: their strikes decide it (ThreatStrike)
+                               if (a.level + 2 >= b.targetLevel && a.bravery >= 40) return b.id; break;  // with friends, they can punch up a little
+            case BOUNTY_ELITE: if (a.level + 1 >= s->minLevel && a.bravery >= 45) return b.id; break;
+            case BOUNTY_PACK:  if (a.bravery >= 30 && HuntFits(*s, a.level, a.bravery)) return b.id; break;
+            default:           if (HuntFits(*s, a.level, a.bravery)) return b.id; break;
+        }
+    }
+    return 0;
+}
+
+void World::ClaimBounty(SimAgent& a)
+{
+    for (SimBounty& b : _bounties)
+    {
+        if (b.id != a.bounty) continue;
+        if (b.done) { a.bounty = 0; a.bountyProgress = 0; return; }                    // expired on the way back
+        if (a.bountyProgress < b.count || a.site != b.hub) return;
+        a.money += b.reward;
+        b.done = true;
+        if (b.player)                                        // a player was after it too: they hear it's gone
+            _mail.push_back({ b.player, b.hub, "Too late: " + (b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site)),
+                Acore::StringFormat("Sorry - {} came back with the job done before you did, and the board paid them.\n\nThere will be other work.", a.FullName()), 0 });
+        Log(EventType::BountyDone, a, b.hub, Acore::StringFormat("{} collected the {} bounty for the {} ({}).", Who(a), SiteName(b.hub), SiteName(b.site), Money(b.reward)), true);
+        a.bounty = 0; a.bountyProgress = 0;
+        return;
+    }
+    a.bounty = 0; a.bountyProgress = 0;
+}
