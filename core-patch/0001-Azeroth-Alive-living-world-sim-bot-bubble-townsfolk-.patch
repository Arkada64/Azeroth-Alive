+// =====================================================================================================
+// ambitions, social life, newcomers, the daily tick
+// =====================================================================================================
+void World::SetAmbition(SimAgent& a)
+{
+    Rng r = R(a, P_AMBITION);
+    a.ambitionProgress = 0; a.avengeFor = 0;
+    if (a.greed > 65 && r.Chance(0.6f))
+    {
+        a.ambition = AmbitionType::SaveGold;
+        a.ambitionTarget = a.money + uint32(a.level) * a.level * 400 * r.Range(2, 4) + 5000;   // several days of loot
+    }
+    else if (a.wanderlust > 60 && r.Chance(0.6f))
+    {
+        SimSite const* here = SiteById(a.site);
+        std::vector<uint32> farHubs;                    // somewhere they are not, and not just around the corner
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.id != a.home && s.id != a.site && s.regionLevel && s.regionLevel <= a.level + 6
+                && (!here || Dist2d(here->x, here->y, s.x, s.y) > 1200.0f))
+                farHubs.push_back(s.id);
+        if (!farHubs.empty()) { a.ambition = AmbitionType::SeePlace; a.ambitionTarget = farHubs[r.Range(0, uint32(farHubs.size()) - 1)]; return; }
+        a.ambition = AmbitionType::ReachLevel; a.ambitionTarget = std::min<uint32>(80, a.level + r.Range(3, 6));
+    }
+    else
+    {
+        a.ambition = AmbitionType::ReachLevel;
+        a.ambitionTarget = std::min<uint32>(80, a.level + r.Range(3, 6));
+    }
+}
+
+static std::string AmbitionText(AmbitionType t, uint32 target, std::string const& place)
+{
+    switch (t)
+    {
+        case AmbitionType::ReachLevel: return Acore::StringFormat("to grow strong enough for the next road (level {})", target);
+        case AmbitionType::SaveGold:   return Acore::StringFormat("to save {}", Money(target));
+        case AmbitionType::SeePlace:   return Acore::StringFormat("to see {}", place);
+        default: return "";
+    }
+}
+
+void World::CheckAmbition(SimAgent& a)
+{
+    bool done = false; std::string what;
+    switch (a.ambition)
+    {
+        case AmbitionType::ReachLevel: done = a.level >= a.ambitionTarget; what = Acore::StringFormat("reached level {}, as promised", a.level); break;
+        case AmbitionType::SaveGold:
+            done = a.money >= a.ambitionTarget;
+            if (done)
+            {
+                uint32 spend = a.money / 2; a.money -= spend; a.gearTier = uint8(std::min<uint32>(100, a.gearTier + 15));
+                what = Acore::StringFormat("finally had the coin saved and spent {} on better gear", Money(spend));
+            }
+            break;
+        case AmbitionType::SeePlace: done = a.site == a.ambitionTarget; what = Acore::StringFormat("finally saw {}", SiteName(a.ambitionTarget)); break;
+        case AmbitionType::Avenge:
+            done = a.ambitionProgress >= 20;
+            if (done)
+            {
+                SimAgent* f = AgentById(a.avengeFor);
+                what = Acore::StringFormat("avenged {} at {}", f ? f->FullName() : std::string("a friend"), SiteName(a.ambitionTarget));
+            }
+            break;
+        default: break;
+    }
+    if (!done) return;
+    // "reach the next level" goals are routine: full log only. Gold, places and revenge make the chronicle.
+    Log(EventType::AmbitionDone, a, a.site, Acore::StringFormat("{} {}.", Who(a), what), a.ambition != AmbitionType::ReachLevel);
+    SetAmbition(a);
+    std::string next = AmbitionText(a.ambition, a.ambitionTarget, SiteName(a.ambitionTarget));
+    if (!next.empty())
+        Log(EventType::AmbitionSet, a, a.site, Acore::StringFormat("{} now wants {}.", a.FullName(), next), a.ambition != AmbitionType::ReachLevel);
+}
+
+void World::Socialize(SimAgent& a)
+{
+    a.lastSocial = _clock;
+    bool rain = Rainy(a.site);
+    for (SimRelation& rel : _relations)
+    {
+        if (rel.a != a.id && rel.b != a.id) continue;
+        SimAgent* o = AgentById(rel.a == a.id ? rel.b : rel.a);
+        if (!o || o->status != AgentStatus::Active || o->site != a.site) continue;
+        if (o->doing == Verb::Fight || o->doing == Verb::Goto || o->doing == Verb::Gather) continue;
+        Rng r = R(a, P_SOCIAL);
+        auto pairKey = std::make_pair(std::min(a.id, o->id), std::max(a.id, o->id));
+        auto seen = _socialChronicled.find(pairKey);
+        bool chronicle = seen == _socialChronicled.end() || _clock - seen->second >= 7 * MIN_PER_DAY;
+        if (chronicle) _socialChronicled[pairKey] = _clock;
+        if (rel.kind == 2)
+        {
+            Log(EventType::Socialized, a, a.site, Acore::StringFormat("{} and {} traded insults at {}.", a.FullName(), o->FullName(), SiteName(a.site)), chronicle, o->id);
+            rel.strength = int8(std::max<int32>(-100, rel.strength - 5));
+        }
+        else
+        {
+            static const std::array<char const*, 5> acts = { "shared a drink", "swapped stories of the road", "split a hot meal", "played cards late into the night", "waited out the rain by the fire" };
+            uint32 act = rain ? 4 : r.Range(0, 3);
+            Log(EventType::Socialized, a, a.site, Acore::StringFormat("{} and {} {} at {}.", a.FullName(), o->FullName(), acts[act], SiteName(a.site)), chronicle, o->id);
+            rel.strength = int8(std::min<int32>(100, rel.strength + 3));
+            o->lastSocial = _clock;
+        }
+        _memories.push_back({ a.id, 1, o->id, uint8(EventType::Socialized), int8(rel.kind == 2 ? -20 : 20), 30, _clock });
+        return;
+    }
+    Log(EventType::Socialized, a, a.site, Acore::StringFormat("{} spent a quiet evening at {}.", a.FullName(), SiteName(a.site)), false);
+}
+
+void World::SpawnNewcomer(uint32 minDelay, uint32 maxDelay)
+{
+    uint32 id = _nextAgent++;
+    Rng r(_seed, id, _clock, P_NEWCOMER);
+    std::vector<uint32> starts;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.regionLevel && s.regionLevel <= 12) starts.push_back(s.id);
+    if (starts.empty()) return;
+    uint8 level = uint8(r.Range(1, 6));
+    SimTime arrive = _clock + r.Range(minDelay, maxDelay);
+    SimAgent a = MakeAgent(id, level, starts[r.Range(0, uint32(starts.size()) - 1)], arrive, _clock);
+    SetAmbition(a);
+    _agents[id] = a;
+    SimEvent e; e.id = _nextEvent++; e.at = arrive; e.type = EventType::Newcomer; e.actor = id; e.site = a.home; e.notable = true;
+    e.text = Acore::StringFormat("A newcomer, {}, arrived in {}.", Who(a), SiteName(a.home));
+    _pending.push_back(e);
+}
+
+// once per sim day: weather, bounties, expiring bounties, and young people setting out from the starting towns
+void World::DailyTick()
+{
+    RollWeather();
+    for (auto& [hub, g] : _market)                     // the town uses up its goods: crafters, cooks, tanners
+        for (uint32& v : g) v = v * 7 / 10;
+    uint32 alive = 0;
+    for (auto const& [id, a] : _agents)
+        if ((a.status == AgentStatus::Active || a.status == AgentStatus::Recovering) && a.role == ROLE_ADVENTURER) ++alive;
+    AssignAges();
+    TownsfolkGenerations();
+    RetireAdventurers();
+    SpawnThreats();
+    PostCamps();
+    // the townsfolk's days harden them a little: labourers most, idlers least
+    for (auto& [id, a] : _agents)
+    {
+        if (a.role != ROLE_CIVILIAN || a.status != AgentStatus::Active) continue;
+        Rng g(_seed, id, _clock, P_GEN + 530);
+        float chance = a.job == JOB_LABORER ? 0.10f : a.job == JOB_FARMHAND ? 0.07f : a.job == JOB_MARKET ? 0.04f : 0.02f;
+        static char const* const how[] = { "", "has grown strong from the fields", "has grown strong from the hauling", "has a shrewd eye for trade now", "has somehow got tougher" };
+        if (g.Chance(chance)) CivilianGrow(a, how[std::min<uint8>(a.job, 4)]);
+    }
+    Rng r(_seed, 0, _clock, P_NEWCOMER + 1000);
+    uint32 towns = uint32(std::ranges::count_if(_sites, [](SimSite const& s) { return s.type == SiteType::Hub && (s.services & SVC_INN) && s.regionLevel; }));
+    if (alive < std::max<uint32>(130, towns * 18) && r.Chance(0.6f))
+        SpawnNewcomer(0, 24 * 60);
+}
