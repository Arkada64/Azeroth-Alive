+
+void World::BootstrapSites(std::set<uint32> const& zones)
+{
+    // Wander nodes carry zone/area ids; creature spawns mostly don't (zoneId is 0 for almost all rows).
+    struct Node { float x, y; uint32 zone, area; };
+    std::map<uint32, std::vector<Node>> nodes;            // per map
+    for (uint32 m : SIM_MAPS)
+        WanderNode::DoForAllMapWPs(m, [&nodes, m](WanderNode const* wp) {
+            nodes[m].push_back({ wp->GetPositionX(), wp->GetPositionY(), wp->GetZoneId(), wp->GetAreaId() });
+        });
+    auto nearest = [&nodes](uint32 map, float x, float y, float& dist) -> Node const* {
+        Node const* best = nullptr; dist = 1e9f;
+        for (Node const& n : nodes[map]) { float d = Dist2d(x, y, n.x, n.y); if (d < dist) { dist = d; best = &n; } }
+        return best;
+    };
+
+    FactionTemplateEntry const* alliance = sFactionTemplateStore.LookupEntry(1); // human player faction template
+    FactionTemplateEntry const* horde = sFactionTemplateStore.LookupEntry(2);    // orc player faction template: Horde towns aren't hunting grounds
+    struct Point { float x, y, z; uint32 entry; uint32 zone, area, map; };
+    std::vector<Point> services, hostiles;
+
+    // holiday / world-event spawns (Pilgrim's Bounty turkeys etc.) aren't part of the everyday world
+    std::set<ObjectGuid::LowType> eventSpawns;
+    if (QueryResult r = WorldDatabase.Query("SELECT guid FROM game_event_creature"))
+        do { eventSpawns.insert(r->Fetch()[0].Get<uint32>()); } while (r->NextRow());
+
+    // ordered by spawn id for determinism
+    std::map<ObjectGuid::LowType, CreatureData const*> spawns;
+    for (auto const& [guid, data] : sObjectMgr->GetAllCreatureData())
+        if (SIM_MAPS.contains(data.mapid) && !eventSpawns.contains(guid))
+            spawns[guid] = &data;
+
+    for (auto const& [guid, data] : spawns)
+    {
+        CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(data->id);
+        if (!t || t->IsNPCBotOrPet())
+            continue;
+        float d; Node const* n = nearest(data->mapid, data->posX, data->posY, d);
+        if (!n || d > 900.0f || !zones.contains(n->zone))
+            continue;
+        FactionTemplateEntry const* ft = sFactionTemplateStore.LookupEntry(t->faction);
+        if (!ft || !alliance)
+            continue;
+        Point p{ data->posX, data->posY, data->posZ, data->id, n->zone, n->area, data->mapid };
+        constexpr uint32 SERVICE_FLAGS = 65536 | 128 | 4096 | 8192 | 16; // innkeeper, vendor, repair, flight master, trainer
+        bool hostile = ft->IsHostileTo(*alliance) || ft->IsHostileToPlayers();
+        if ((t->npcflag & SERVICE_FLAGS) && !hostile)
+            services.push_back(p);
+        else if (!t->npcflag && !ft->IsFriendlyTo(*alliance) && t->minlevel >= 1
+            && t->type != 8 && t->type != 11 && t->type != 12 && t->type != 13      // critter, totem, non-combat pet, gas cloud
+            && !(t->unit_flags & (0x2 | 0x02000000))                                 // NON_ATTACKABLE, NOT_SELECTABLE
+            && !(t->flags_extra & 0x80)                                              // TRIGGER
+            && t->rank != 3                                                          // bosses
+            && !(horde && ft->IsFriendlyTo(*horde)))                                // Horde guards and townsfolk
+            hostiles.push_back(p);
+    }
+
+    auto areaName = [](uint32 area, uint32 zone) -> std::string {
+        AreaTableEntry const* e = sAreaTableStore.LookupEntry(area);
+        if (!e || !e->area_name[0] || !*e->area_name[0]) e = sAreaTableStore.LookupEntry(zone);
+        return e && e->area_name[0] ? std::string(e->area_name[0]) : std::string("the wilds");
+    };
+    std::map<std::string, uint32> usedNames;
+    for (SimSite const& s : _sites)                     // names already in the world (a region added to an older save)
+    {
+        std::string base = s.name;
+        if (size_t p = base.rfind(" ("); p != std::string::npos && base.back() == ')') base = base.substr(0, p);
+        ++usedNames[base];
+    }
+    auto uniqueName = [&usedNames](std::string n) { uint32 c = ++usedNames[n]; return c == 1 ? n : Acore::StringFormat("{} ({})", n, c); };
+
+    // hubs: single-link clusters of friendly service NPCs within 45 yd (service NPCs are sparse, so this stays local)
+    std::vector<bool> used(services.size(), false);
+    for (uint32 i = 0; i < services.size(); ++i)
+    {
+        if (used[i]) continue;
+        std::vector<uint32> c{ i }; used[i] = true;
+        for (uint32 k = 0; k < c.size(); ++k)
+            for (uint32 j = 0; j < services.size(); ++j)
+                if (!used[j] && services[j].map == services[c[k]].map && Dist2d(services[c[k]].x, services[c[k]].y, services[j].x, services[j].y) <= 45.0f)
+                { used[j] = true; c.push_back(j); }
+        SimSite s; s.type = SiteType::Hub;
+        uint32 inn = 0;
+        float sx = 0, sy = 0, sz = 0;
+        for (uint32 idx : c)
+        {
+            Point const& p = services[idx];
+            CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(p.entry);
+            if (t->npcflag & 65536) { s.services |= SVC_INN; ++inn; }
+            if (t->npcflag & 128)   s.services |= SVC_VENDOR;
+            if (t->npcflag & 4096)  s.services |= SVC_REPAIR;
+            if (t->npcflag & 8192)  s.services |= SVC_FLIGHT;
+            if (t->npcflag & 16)    s.services |= SVC_TRAINER;
+            sx += p.x; sy += p.y; sz += p.z;
+        }
+        if (c.size() < 2 && !inn && !(s.services & SVC_FLIGHT))
+            continue;
+        s.x = sx / c.size(); s.y = sy / c.size(); s.z = sz / c.size();
+        s.map = services[c[0]].map; s.zone = services[c[0]].zone; s.area = services[c[0]].area;
+        s.spawns = uint32(c.size());
+        s.name = uniqueName(areaName(s.area, s.zone));
+        s.id = _nextSite++;
+        _sites.push_back(s);
+    }
+
+    // hunting grounds: hostile spawns bucketed into 200-yard grid cells (single-link clustering chains dense
+    // spawns across whole zones). Level range = 10th-90th percentile, so a stray high-level mob doesn't stretch it.
+    constexpr float CELL = 200.0f;
+    std::map<std::tuple<uint32, int32, int32>, std::vector<uint32>> cells;  // (map, x, y) - ordered: deterministic
+    for (uint32 i = 0; i < hostiles.size(); ++i)
+        cells[{ hostiles[i].map, int32(std::floor(hostiles[i].x / CELL)), int32(std::floor(hostiles[i].y / CELL)) }].push_back(i);
+    for (auto const& [key, c] : cells)
+    {
+        if (c.size() < 6) continue;
+        std::map<uint32, uint32> byEntry;
+        std::vector<uint8> lv;
+        float sx = 0, sy = 0, sz = 0;
+        uint64 copper = 0;
+        for (uint32 i : c)
+        {
+            Point const& p = hostiles[i];
+            CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(p.entry);
+            ++byEntry[p.entry];
+            lv.push_back(uint8((t->minlevel + t->maxlevel) / 2));
+            copper += (t->mingold + t->maxgold) / 2;
+            sx += p.x; sy += p.y; sz += p.z;
+        }
+        std::sort(lv.begin(), lv.end());
+        uint32 dom = std::max_element(byEntry.begin(), byEntry.end(), [](auto const& a, auto const& b) { return a.second < b.second; })->first;
+        CreatureTemplate const* dt = sObjectMgr->GetCreatureTemplate(dom);
+        Point const* domPt = nullptr;
+        for (uint32 i : c) if (hostiles[i].entry == dom) { domPt = &hostiles[i]; break; }
+        SimSite s; s.type = SiteType::Hunt;
+        s.x = sx / c.size(); s.y = sy / c.size(); s.z = sz / c.size();
+        s.map = domPt->map; s.zone = domPt->zone; s.area = domPt->area;
+        s.minLevel = lv[lv.size() / 10]; s.maxLevel = std::max<uint8>(lv[(lv.size() * 9) / 10], s.minLevel);
+        s.creatureName = dt->Name; s.creatureType = dt->type;
+        s.copperPerKill = uint32(copper / c.size()); s.elite = (dt->rank == 1 || dt->rank == 2); s.spawns = uint32(c.size());
+        s.name = uniqueName(Acore::StringFormat("{} near {}", dt->Name, areaName(s.area, s.zone)));
+        s.id = _nextSite++;
+        _sites.push_back(s);
+    }
+
+    // hub region level = median level of hunting within 1500 yd
+    for (SimSite& h : _sites)
+    {
+        if (h.type != SiteType::Hub) continue;
+        std::vector<uint8> lv;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && s.map == h.map && Dist2d(h.x, h.y, s.x, s.y) < 1500.0f)
+                lv.push_back(uint8((s.minLevel + s.maxLevel) / 2));
+        if (lv.empty()) { h.regionLevel = 0; continue; }
+        std::sort(lv.begin(), lv.end());
+        h.regionLevel = lv[lv.size() / 2];
+    }
+
+    uint32 hubs = 0, hunts = 0;
+    for (SimSite const& s : _sites) (s.type == SiteType::Hub ? hubs : hunts)++;
+    LOG_INFO("server.loading", "SoloSim: bootstrapped {} hubs and {} hunting grounds from {} service and {} hostile spawns",
+        hubs, hunts, uint32(services.size()), uint32(hostiles.size()));
+}
+
+SimAgent World::MakeAgent(uint32 id, uint8 level, uint32 home, SimTime born, uint32 salt, uint8 forceRace)
+{
+    SimAgent a; a.id = id;
+    Rng r(_seed, id, salt, P_GEN);
+
+    // Alliance races weighted to the region; normal WoW classes only (no WC3 heroes, no death knights)
+    static const std::array<std::pair<uint8, uint32>, 5> races = { { {1, 45}, {3, 20}, {4, 15}, {7, 12}, {11, 8} } };
+    uint32 roll = r.Range(1, 100), acc = 0;
+    for (auto const& [race, w] : races) { acc += w; if (roll <= acc) { a.race = race; break; } }
+    if (!a.race) a.race = 1;
+    if (forceRace) a.race = forceRace;
+    static const std::array<uint8, 9> classes = { 1, 2, 3, 4, 5, 7, 8, 9, 11 };
+    std::vector<uint8> valid;
+    for (uint8 c : classes) if (sObjectMgr->GetPlayerInfo(a.race, c)) valid.push_back(c);
+    a.cls = valid.empty() ? 1 : valid[r.Range(0, uint32(valid.size()) - 1)];
+    a.gender = uint8(r.Range(0, 1));
+
+    NameKit const& k = Kit(a.race);
+    Rng rn(_seed, id, salt, P_NAME);
+    auto pick = [&rn](std::vector<char const*> const& v) -> std::string { return v.empty() ? "" : v[rn.Range(0, uint32(v.size()) - 1)]; };
+    a.given = a.gender ? pick(k.fStart) + pick(k.fEnd) : pick(k.mStart) + pick(k.mEnd);
+    a.family = k.famRoot.empty() ? "" : pick(k.famRoot) + pick(k.famEnd);
+
+    // looks/class source: an NPCBots template of the same race and class (ordered scan = deterministic)
+    std::vector<uint32> src;
+    std::map<uint32, CreatureTemplate const*> ordered;
+    for (auto const& [entry, t] : *sObjectMgr->GetCreatureTemplates()) ordered[entry] = &t;
+    for (auto const& [entry, t] : ordered)
+        if (t->IsNPCBot())
+            if (NpcBotExtras const* ex = BotDataMgr::SelectNpcBotExtras(entry))
+                if (ex->race == a.race && ex->bclass == a.cls) src.push_back(entry);
+    a.sourceEntry = src.empty() ? 0 : src[r.Range(0, uint32(src.size()) - 1)];
+    // the body decides the gender (its model, face and hair); re-roll the given name to match
+    if (a.sourceEntry)
+        if (NpcBotAppearanceData const* ap = BotDataMgr::SelectNpcBotAppearance(a.sourceEntry))
+            if (ap->gender != a.gender)
+            {
+                a.gender = ap->gender;
+                a.given = a.gender ? pick(k.fStart) + pick(k.fEnd) : pick(k.mStart) + pick(k.mEnd);
+            }
+
+    a.level = level;
+    a.trainedLevel = level;
+    a.xp = r.Range(0, sObjectMgr->GetXPForLevel(level) / 2);
+    a.gearTier = uint8(r.Range(20, 60));
+    a.money = uint32(level) * level * 40 + r.Range(0, 400);
+    a.bravery = uint8(r.Range(5, 95)); a.greed = uint8(r.Range(5, 95)); a.sociability = uint8(r.Range(5, 95));
+    a.caution = uint8(r.Range(5, 95)); a.wanderlust = uint8(r.Range(5, 95));
+    a.home = home; a.site = home; a.born = born;
+    a.fatigue = uint8(r.Range(0, 30));
+    a.wakeAt = born + r.Range(0, 120);
+    a.lastSocial = born;
+    AssignProfessions(a);
+    return a;
+}
+
+void World::AssignProfessions(SimAgent& a)
+{
+    // one or two gathering skills; skill roughly where a player of that level would be (5 per level, some spread)
+    Rng r(_seed, a.id, 0, P_PROF);
+    std::vector<uint8> pool = { PROF_MINING, PROF_HERBALISM, PROF_SKINNING, PROF_FISHING };
+    uint32 count = r.Chance(0.55f) ? 2 : 1;
+    for (uint32 i = 0; i < count; ++i)
+    {
+        uint32 idx = r.Range(0, uint32(pool.size()) - 1);
+        a.prof[i] = pool[idx];
+        pool.erase(pool.begin() + idx);
+        a.profSkill[i] = uint16(std::min<uint32>(450, uint32(a.level) * 5 + r.Range(0, 25)));
+    }
+}
+
+void World::GeneratePopulation(uint32 count)
+{
+    std::vector<SimSite const*> inns;
+    for (SimSite const& s : _sites)
+        if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.regionLevel)
+            inns.push_back(&s);
+    if (inns.empty())
+        for (SimSite const& s : _sites) if (s.type == SiteType::Hub) inns.push_back(&s);
+
+    for (uint32 i = 0; i < count; ++i)
+    {
+        uint32 id = _nextAgent++;
+        Rng r(_seed, id, 0, P_GEN + 100);
+        uint8 level = uint8(std::clamp<int32>(1 + int32(24.0f * std::pow(r.Float(), 1.8f)), 1, 25));   // mixed 1-25, skewed low
+        std::vector<std::pair<int32, SimSite const*>> scored;
+        for (SimSite const* h : inns) scored.emplace_back(std::abs(int32(h->regionLevel) - int32(level)), h);
+        std::stable_sort(scored.begin(), scored.end(), [](auto const& x, auto const& y) { return x.first < y.first; });
+        uint32 home = scored.empty() ? 0 : scored[r.Range(0, std::min<uint32>(2, uint32(scored.size()) - 1))].second->id;
+        SimAgent a = MakeAgent(id, level, home, _clock, 0);
+        SetAmbition(a);
+        _agents[id] = a;
+    }
+    MakeRelations();
+}
+
+// A save made before zones were added to the region: map the new zones (hubs, hunting grounds) and move people into
+// their towns - adventurers at the level of the land around each town, dwarves and gnomes in the dwarven lands.
+void World::ExpandRegion()
+{
+    std::set<uint32> have, missing;
+    for (SimSite const& s : _sites) have.insert(s.zone);
+    for (uint32 z : REGION_ZONES) if (!have.contains(z)) missing.insert(z);
+    if (missing.empty()) return;
+    uint32 firstNew = _nextSite;
+    BootstrapSites(missing);
+    // the hubs of the new zones only (BootstrapSites may also touch older hubs' region level - that's fine)
+    uint32 added = 0;
+    for (SimSite const& h : _sites)
+    {
+        if (h.id < firstNew || h.type != SiteType::Hub || !(h.services & SVC_INN) || !h.regionLevel) continue;
+        uint32 count = (h.zone == 1537 || h.zone == 1519 || h.zone == 1657) ? 14 : 10;
+        for (uint32 i = 0; i < count; ++i)
+        {
+            uint32 id = _nextAgent++;
+            Rng r(_seed, id, h.id, P_GEN + 200);
+            int32 lvl = int32(h.regionLevel) + int32(r.Range(0, 8)) - 4;
+            uint8 level = uint8(std::clamp<int32>(lvl, 1, 50));
+            uint8 race = 0;
+            if (DWARF_ZONES.contains(h.zone)) race = r.Chance(0.7f) ? 3 : (r.Chance(0.7f) ? 7 : 0);
+            if (ELF_ZONES.contains(h.zone)) race = r.Chance(0.75f) ? 4 : 0;
+            SimAgent a = MakeAgent(id, level, h.id, _clock, 0, race);
+            SetAmbition(a);
+            _agents[id] = a;
+            ++added;
+        }
+    }
+    uint32 hubs = 0, hunts = 0;
+    for (SimSite const& s : _sites) if (s.id >= firstNew) (s.type == SiteType::Hub ? hubs : hunts)++;
+    LOG_INFO("server.loading", "SoloWoW sim: the world grew by {} zones: {} towns and outposts, {} hunting grounds, {} new adventurers",
+        uint32(missing.size()), hubs, hunts, added);
+    MakeRelations();                                    // the newcomers know a few people (idempotent for everyone else)
+}
+
+void World::MakeRelations()
+{
+    std::set<std::pair<uint32, uint32>> have;
+    for (auto& [id, a] : _agents)
+    {
+        if (a.status == AgentStatus::Dead) continue;
+        Rng r(_seed, id, 0, P_REL);
+        uint32 want = r.Range(2, 4), count = 0;
+        for (auto const& rel : _relations) if (rel.a == id || rel.b == id) ++count;
+        for (uint32 tries = 0; count < want && tries < 40; ++tries)
+        {
+            std::vector<uint32> pool;
+            bool local = r.Chance(0.7f);          // prefer people from the same home
+            for (auto const& [oid, o] : _agents)
+                if (oid != id && o.status != AgentStatus::Dead && o.role != ROLE_THREAT && (!local || o.home == a.home)) pool.push_back(oid);
+            if (pool.empty()) continue;
+            uint32 other = pool[r.Range(0, uint32(pool.size()) - 1)];
+            auto key = std::make_pair(std::min(id, other), std::max(id, other));
+            if (have.contains(key)) continue;
+            have.insert(key);
+            SimRelation rel; rel.a = key.first; rel.b = key.second;
+            uint32 k = r.Range(1, 100);
+            rel.kind = k <= 80 ? 1 : (k <= 95 ? 2 : 3);
+            rel.strength = int8(rel.kind == 2 ? -int32(r.Range(30, 80)) : int32(r.Range(30, 90)));
+            _relations.push_back(rel);
+            ++count;
+        }
+    }
+}
