@@ -0,0 +1,894 @@
+// SoloWoW: "bubble" wandering bots. See botbubble.h.
+#include "botbubble.h"
+#include <tuple>
+#include "bot_ai.h"
+#include "botdatamgr.h"
+#include "botlog.h"
+#include "botwanderful.h"
+#include "Chat.h"
+#include "Config.h"
+#include "Creature.h"
+#include "DBCStores.h"
+#include "Map.h"
+#include "Player.h"
+#include "CellImpl.h"
+#include "GridNotifiers.h"
+#include "GridNotifiersImpl.h"
+#include "GameObject.h"
+#include "ObjectAccessor.h"
+#include "PathGenerator.h"
+#include "Random.h"
+#include "SharedDefines.h"
+#include "solosim.h"
+#include "solosim_civilians.h"
+#include "solosim_boards.h"
+#include "solosim_camps.h"
+#include "Timer.h"
+#include "WorldSession.h"
+#include "WorldSessionMgr.h"
+
+#include <cmath>
+#include <list>
+#include <mutex>
+#include <shared_mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace
+{
+    struct BubbleConfig
+    {
+        bool   enable       = false;
+        uint32 count        = 0;      // free wanderers wanted inside the bubble
+        bool   neighbors    = true;   // include zones linked to the player's zone
+        uint32 interval     = 2000;   // ms between bubble checks
+        uint32 maxDespawn   = 5;      // recycled per check
+        uint32 maxSpawn     = 4;      // queued per check (the core spawns one every 500 ms)
+        float  safeDistance = 150.0f; // never recycle a bot this close to the player
+        float  spawnAway    = 120.0f; // prefer spawn points at least this far from the player
+        uint32 homeShare    = 75;     // % of new bots spawned in the player's own zone
+        bool   simSource    = true;   // embody the SoloSim people instead of random wanderers
+        uint32 townsfolk    = 30;     // townsfolk bodies around the player (sim source only)
+    };
+
+    BubbleConfig cfg;
+    bool cfgLoaded = false;
+    uint32 checkTimer = 0;
+    uint32 lastZone = 0;
+    uint32 lastMap = 0xFFFFFFFF;
+    uint32 statusTimer = 0;
+    uint32 statusZone = 0;
+
+    std::unordered_map<uint32, std::unordered_set<uint32>> zoneLinks;
+    bool zoneLinksBuilt = false;
+
+    std::unordered_set<uint32> pinned;
+
+    void LoadConfig()
+    {
+        cfg.enable       = sConfigMgr->GetOption<bool>("NpcBot.Bubble.Enable", false);
+        cfg.count        = sConfigMgr->GetOption<uint32>("NpcBot.Bubble.Count", 40);
+        cfg.neighbors    = sConfigMgr->GetOption<bool>("NpcBot.Bubble.Neighbors", true);
+        cfg.interval     = std::max<uint32>(500, sConfigMgr->GetOption<uint32>("NpcBot.Bubble.Interval", 2000));
+        cfg.maxDespawn   = std::max<uint32>(1, sConfigMgr->GetOption<uint32>("NpcBot.Bubble.MaxRecyclePerCheck", 5));
+        cfg.maxSpawn     = std::max<uint32>(1, sConfigMgr->GetOption<uint32>("NpcBot.Bubble.MaxSpawnPerCheck", 4));
+        cfg.safeDistance = sConfigMgr->GetOption<float>("NpcBot.Bubble.SafeDistance", 150.0f);
+        cfg.spawnAway    = sConfigMgr->GetOption<float>("NpcBot.Bubble.SpawnAwayDistance", 120.0f);
+        cfg.homeShare    = std::min<uint32>(100, sConfigMgr->GetOption<uint32>("NpcBot.Bubble.HomeZoneShare", 75));
+        cfg.simSource    = sConfigMgr->GetOption<std::string>("NpcBot.Bubble.Source", "sim") != "random";
+        cfg.townsfolk    = sConfigMgr->GetOption<uint32>("NpcBot.Bubble.Townsfolk", 30);
+        cfgLoaded = true;
+        BOT_LOG_INFO("server.loading", "SoloWoW bubble: {} (count {}, neighbors {}, source {})",
+            cfg.enable ? "enabled" : "disabled", cfg.count, cfg.neighbors ? "on" : "off", cfg.simSource ? "sim" : "random");
+    }
+
+    // ---- sim embodiment
+    std::unordered_map<uint32, uint32> simEntryToAgent;   // bot entry -> sim agent
+    std::unordered_map<uint32, uint32> simAgentToEntry;   // sim agent -> bot entry
+    std::unordered_map<uint32, uint32> simSpawnedAt;      // bot entry -> getMSTime() when queued
+
+    void ForgetSimBot(uint32 entry)
+    {
+        if (auto it = simEntryToAgent.find(entry); it != simEntryToAgent.end())
+        {
+            simAgentToEntry.erase(it->second);
+            simEntryToAgent.erase(it);
+        }
+        simSpawnedAt.erase(entry);
+        BotBubble::ForgetLife(entry);
+    }
+
+    // deaths of bodies in the game world, reported from map threads, handed to the sim on the world thread
+    std::mutex fallenLock;
+    std::vector<std::tuple<uint32, std::string, bool>> fallen;     // agent, killer, died in a dungeon
+    std::unordered_map<uint32, std::pair<uint32, std::string>> hiredBy;   // sim agent -> (player guid low, name)
+
+    void UpdateSimBodies(Player* player, uint32 mapId, uint32 zoneId, std::unordered_set<uint32> const& bubble)
+    {
+        {
+            std::vector<std::tuple<uint32, std::string, bool>> deaths;
+            {
+                std::lock_guard<std::mutex> guard(fallenLock);
+                deaths.swap(fallen);
+            }
+            for (auto const& [agent, killer, dungeon] : deaths)
+                sSoloSim->BodyFell(agent, killer, dungeon);
+        }
+
+        // 0. hiring: a body that got an owner is hired in the sim; free again (dismissed) -> back to their own life
+        for (auto const& [entry, agent] : simEntryToAgent)
+        {
+            Creature const* bot = BotDataMgr::FindBot(entry);
+            if (!bot)
+                continue;
+            auto h = hiredBy.find(agent);
+            if (!bot->IsFreeBot())
+            {
+                if (h == hiredBy.end())
+                    if (Player const* owner = bot->GetBotOwner())
+                    {
+                        hiredBy[agent] = { owner->GetGUID().GetCounter(), owner->GetName() };
+                        sSoloSim->SetHired(agent, owner->GetGUID().GetCounter(), owner->GetName(), true);
+                    }
+            }
+            else if (h != hiredBy.end())
+            {
+                sSoloSim->SetHired(agent, h->second.first, h->second.second, false);
+                hiredBy.erase(h);
+            }
+        }
+
+        // 1. forget bodies that are gone (despawned elsewhere, or a queued spawn that never happened)
+        std::vector<uint32> stale;
+        for (auto const& [entry, agent] : simEntryToAgent)
+        {
+            if (BotDataMgr::FindBot(entry))
+                continue;
+            if (auto h = hiredBy.find(agent); h != hiredBy.end())
+            {
+                sSoloSim->SetHired(agent, h->second.first, h->second.second, false);   // the hireling's body is gone: home they go
+                hiredBy.erase(h);
+            }
+            if (BotDataMgr::IsWanderSpawnPending(entry) && GetMSTimeDiffToNow(simSpawnedAt[entry]) < 60000)
+                continue;
+            stale.push_back(entry);
+        }
+        for (uint32 e : stale)
+            ForgetSimBot(e);
+
+        // 2. who should have a body: sim people whose position is in the bubble, nearest first
+        std::vector<SoloSim::SimBody> bodies;
+        sSoloSim->Bodies(mapId, bodies);
+        // townsfolk are plain creatures with their own cap; adventurers are NPCBots
+        SoloCivilians::Update(player, mapId, bubble, bodies, cfg.townsfolk, cfg.safeDistance);
+        std::erase_if(bodies, [&](SoloSim::SimBody const& b) { return b.role == SoloSim::ROLE_CIVILIAN || !bubble.contains(b.zone); });
+        std::ranges::sort(bodies, [&](SoloSim::SimBody const& x, SoloSim::SimBody const& y) {
+            bool hx = x.zone == zoneId, hy = y.zone == zoneId;
+            if (hx != hy) return hx;                                        // own zone first
+            return player->GetExactDist2d(x.x, x.y) < player->GetExactDist2d(y.x, y.y);
+        });
+        if (bodies.size() > cfg.count)
+            bodies.resize(cfg.count);
+        std::unordered_set<uint32> wanted;
+        for (SoloSim::SimBody const& b : bodies)
+            wanted.insert(b.agent);
+
+        // 3. recycle: random wanderers, and bodies whose person is no longer wanted here
+        std::vector<uint32> recycle;
+        {
+            std::shared_lock lock(*BotDataMgr::GetLock());
+            for (Creature const* bot : BotDataMgr::GetExistingNPCBots())
+            {
+                if (!bot || !bot->IsInWorld() || !bot->IsWandererBot() || !bot->IsFreeBot())
+                    continue;
+                Map const* bmap = bot->FindMap();
+                if (!bmap || !bmap->GetEntry() || !bmap->GetEntry()->IsContinent())
+                    continue;
+                if (pinned.contains(bot->GetEntry()))
+                    continue;
+                auto it = simEntryToAgent.find(bot->GetEntry());
+                if (it != simEntryToAgent.end() && wanted.contains(it->second))
+                    continue;
+                // never pop someone out of existence in front of the player
+                if (bmap->GetId() == mapId && bot->GetExactDist2d(player) < cfg.safeDistance)
+                    continue;
+                recycle.push_back(bot->GetEntry());
+            }
+        }
+        for (uint32 i = 0; i < recycle.size() && i < cfg.maxDespawn; ++i)
+        {
+            BotDataMgr::DespawnWandererBot(recycle[i]);
+            ForgetSimBot(recycle[i]);
+        }
+
+        // 4. embody the wanted who have no body yet
+        uint32 spawned = 0;
+        for (SoloSim::SimBody const& b : bodies)
+        {
+            if (spawned >= cfg.maxSpawn)
+                break;
+            if (simAgentToEntry.contains(b.agent))
+                continue;
+            WanderNode const* node = WanderNode::FindInAllWPs(b.spawnNode);
+            if (!node || node->GetMapId() != mapId)
+                continue;
+            uint32 entry = BotDataMgr::GenerateSimBot(b.sourceEntry, b.name, b.level, node);
+            if (!entry)
+                continue;
+            simEntryToAgent[entry] = b.agent;
+            simAgentToEntry[b.agent] = entry;
+            simSpawnedAt[entry] = getMSTime();
+            ++spawned;
+        }
+
+        // townsfolk requests: word carried to someone out here, or the place where a missing person fell
+        uint32 guid = player->GetGUID().GetCounter();
+        for (auto const& [entry, agent] : simEntryToAgent)
+            if (Creature* bot = const_cast<Creature*>(BotDataMgr::FindBot(entry)); bot && bot->IsInWorld() && bot->IsAlive()
+                && bot->GetMapId() == mapId && bot->GetExactDist(player) < 8.0f)
+                if (std::string say = sSoloSim->ReachedPerson(guid, agent); !say.empty())
+                {
+                    bot->SetFacingToObject(player);
+                    bot->Say(say, LANG_UNIVERSAL, player);
+                }
+        if (std::string found = sSoloSim->ReachedPlace(guid, mapId, player->GetPositionX(), player->GetPositionY()); !found.empty())
+            ChatHandler(player->GetSession()).SendSysMessage(found);
+
+        statusTimer += cfg.interval;
+        if (statusTimer >= 30000 || zoneId != statusZone)
+        {
+            statusTimer = 0;
+            statusZone = zoneId;
+            BOT_LOG_INFO("server.loading", "SoloWoW bubble (sim): zone {} ({} zones), {} sim people here, {} embodied, recycled {}",
+                zoneId, uint32(bubble.size()), uint32(wanted.size()), uint32(simEntryToAgent.size()), uint32(std::min<size_t>(recycle.size(), cfg.maxDespawn)));
+        }
+    }
+
+    // Zone graph: two zones are neighbors if any wander node in one links to a node in the other.
+    void BuildZoneLinks()
+    {
+        WanderNode::DoForAllWPs([](WanderNode const* wp) {
+            for (WanderNode::WanderNodeLink const& link : wp->GetLinks())
+            {
+                WanderNode const* other = link.wp;
+                if (!other || other->GetMapId() != wp->GetMapId())
+                    continue;
+                uint32 a = wp->GetZoneId(), b = other->GetZoneId();
+                if (!a || !b || a == b)
+                    continue;
+                zoneLinks[a].insert(b);
+                zoneLinks[b].insert(a);
+            }
+        });
+        zoneLinksBuilt = true;
+        BOT_LOG_INFO("server.loading", "SoloWoW bubble: zone graph built ({} zones with neighbors)", uint32(zoneLinks.size()));
+    }
+
+    Player* FindLocalPlayer()
+    {
+        for (auto const& [id, session] : sWorldSessionMgr->GetAllSessions())
+            if (Player* player = session ? session->GetPlayer() : nullptr)
+                if (player->IsInWorld())
+                    return player;
+        return nullptr;
+    }
+}
+
+void BotBubble::Pin(uint32 botEntry) { pinned.insert(botEntry); }
+void BotBubble::Unpin(uint32 botEntry) { pinned.erase(botEntry); }
+bool BotBubble::IsPinned(uint32 botEntry) { return pinned.contains(botEntry); }
+
+// =====================================================================================================
+// Sim bodies: acting out the sim's intent on screen. Modeled on mod-playerbots' NewRpg states
+// (wander random / wander npc / go far): on the road they keep their own lane; at a place they leave the
+// node graph and use real spots - the innkeeper, the vendor, their class trainer, the hunting camp.
+// =====================================================================================================
+namespace
+{
+    struct Life
+    {
+        bool pending = false;                     // walking somewhere; on arrival: settle, then stay
+        uint32 stay = 0;                          // ms to stay after arriving
+        ObjectGuid npc;                           // walking up to this NPC: face and greet them on arrival
+        uint8 stand = UNIT_STAND_STATE_STAND;     // stand state to take on arrival (sit, sleep)
+        float faceAngle = -1.0f;                  // orientation to take on arrival (<0: none)
+        uint64 spot = 0;                          // inn seat/bed claimed (key), 0 = none
+        bool snap = false;                        // on arrival, settle exactly onto the spot (chairs)
+        float sx = 0, sy = 0, sz = 0, so = 0;
+    };
+    std::unordered_map<uint32, Life> lives;       // bot entry -> life
+    std::mutex lifeLock;                          // bodies update on map threads
+
+    uint32 Hash(uint32 agent, uint32 salt) { return uint32(SoloSim::Mix((uint64(agent) << 20) ^ salt)); }
+    float Unit01(uint32 agent, uint32 salt) { return float(Hash(agent, salt) % 10000) / 10000.0f; }
+
+    class ServiceNpcCheck
+    {
+    public:
+        ServiceNpcCheck(Unit const* me, float x, float y, float range, uint32 flags, char const* subname)
+            : _me(me), _x(x), _y(y), _range(range), _flags(flags), _subname(subname) { }
+        bool operator()(Creature* c) const
+        {
+            if (!c || !c->IsInWorld() || !c->IsAlive() || c->IsNPCBotOrPet() || c->IsInCombat())
+                return false;
+            CreatureTemplate const* t = c->GetCreatureTemplate();
+            if (!t || !t->npcflag || (_flags && !(t->npcflag & _flags)))
+                return false;
+            if (_subname && t->SubName.find(_subname) == std::string::npos)
+                return false;
+            if (c->IsHostileTo(_me) || c->isMoving())
+                return false;
+            return c->GetExactDist2d(_x, _y) <= _range;
+        }
+    private:
+        Unit const* _me; float _x, _y, _range; uint32 _flags; char const* _subname;
+    };
+
+    std::vector<Creature*> FindServiceNpcs(Creature* me, float x, float y, float range, uint32 flags, char const* subname = nullptr)
+    {
+        std::list<Creature*> found;
+        ServiceNpcCheck check(me, x, y, range, flags, subname);
+        Acore::CreatureListSearcher<ServiceNpcCheck> searcher(me, found, check);
+        Cell::VisitObjects(me, searcher, std::max(range + me->GetExactDist2d(x, y), 40.0f));
+        return { found.begin(), found.end() };
+    }
+
+    char const* TrainerTitle(uint8 cls)
+    {
+        switch (cls)
+        {
+            case CLASS_WARRIOR: return "Warrior Trainer"; case CLASS_PALADIN: return "Paladin Trainer"; case CLASS_HUNTER: return "Hunter Trainer";
+            case CLASS_ROGUE: return "Rogue Trainer"; case CLASS_PRIEST: return "Priest Trainer"; case CLASS_SHAMAN: return "Shaman Trainer";
+            case CLASS_MAGE: return "Mage Trainer"; case CLASS_WARLOCK: return "Warlock Trainer"; case CLASS_DRUID: return "Druid Trainer";
+            default: return nullptr;
+        }
+    }
+
+    // A standing spot in front of an NPC (the customer side), spread per person so they don't stack.
+    Position SpotBy(Creature* me, Creature* npc, uint32 agent, float minDist, float maxDist, bool personal)
+    {
+        float facing = npc->GetOrientation();
+        float angle = personal ? facing + (Unit01(agent, 11) - 0.5f) * float(M_PI) * 0.6f      // their own place in the room
+                               : npc->GetAngle(me) + frand(-0.25f, 0.25f) * float(M_PI);       // walking up from where they are
+        float dist = minDist + (personal ? Unit01(agent, 12) : frand(0.0f, 1.0f)) * (maxDist - minDist);
+        float x = npc->GetPositionX() + std::cos(angle) * dist, y = npc->GetPositionY() + std::sin(angle) * dist, z = npc->GetPositionZ();
+        if (!npc->GetMap()->CheckCollisionAndGetValidCoords(npc, npc->GetPositionX(), npc->GetPositionY(), npc->GetPositionZ(), x, y, z))
+        {
+            x = npc->GetPositionX() + std::cos(facing) * 2.5f; y = npc->GetPositionY() + std::sin(facing) * 2.5f; z = npc->GetPositionZ();
+        }
+        return Position(x, y, z, Position::NormalizeOrientation(std::atan2(npc->GetPositionY() - y, npc->GetPositionX() - x)));
+    }
+
+    // ---- inns: real places to sit and sleep, found once per innkeeper
+    struct InnSpot { float x = 0, y = 0, z = 0, o = 0; uint8 stand = UNIT_STAND_STATE_SIT; };
+    struct Inn { std::vector<InnSpot> seats, beds; };
+    std::unordered_map<uint32, Inn> inns;                  // innkeeper spawn id -> spots
+    std::unordered_map<uint64, uint32> spotTaken;           // spot key -> bot entry
+
+    uint64 SpotKey(uint32 innId, bool bed, uint32 idx) { return (uint64(innId) << 20) | (uint64(bed) << 16) | idx; }
+
+    class ChairCheck
+    {
+    public:
+        ChairCheck(WorldObject const* keeper, float range) : _keeper(keeper), _range(range) { }
+        bool operator()(GameObject* go) const
+        {
+            return go && go->GetGoType() == GAMEOBJECT_TYPE_CHAIR && go->isSpawned() && go->GetExactDist(_keeper) <= _range;
+        }
+    private:
+        WorldObject const* _keeper; float _range;
+    };
+
+    Inn const& InnOf(Creature* keeper)
+    {
+        uint32 id = keeper->GetSpawnId();
+        if (auto it = inns.find(id); it != inns.end())
+            return it->second;
+        Inn& inn = inns[id];
+        Map* map = keeper->GetMap();
+        auto farFromAll = [&](float x, float y, float z) {
+            for (auto const* v : { &inn.seats, &inn.beds })
+                for (InnSpot const& s : *v)
+                    if (std::fabs(s.z - z) < 2.5f && std::hypot(s.x - x, s.y - y) < 2.2f)
+                        return false;
+            return true;
+        };
+
+        // seats: chairs and benches (each bench slot is a seat), as the core seats players on them
+        std::list<GameObject*> chairs;
+        ChairCheck check(keeper, 30.0f);
+        Acore::GameObjectListSearcher<ChairCheck> searcher(keeper, chairs, check);
+        Cell::VisitObjects(keeper, searcher, 30.0f);
+        for (GameObject* go : chairs)
+        {
+            GameObjectTemplate const* info = go->GetGOInfo();
+            uint32 slots = std::clamp<uint32>(info->chair.slots, 1, 4);
+            float ortho = go->GetOrientation() + float(M_PI) / 2.0f;
+            for (uint32 i = 0; i < slots; ++i)
+            {
+                float rel = info->size * float(i) - info->size * float(slots - 1) / 2.0f;
+                InnSpot s;
+                s.x = go->GetPositionX() + rel * std::cos(ortho);
+                s.y = go->GetPositionY() + rel * std::sin(ortho);
+                s.z = go->GetPositionZ();
+                s.o = go->GetOrientation();
+                s.stand = uint8(UNIT_STAND_STATE_SIT_LOW_CHAIR + std::min<uint32>(info->chair.height, 2));
+                inn.seats.push_back(s);
+            }
+        }
+
+        // beds: indoor floor the innkeeper could walk to, on every storey (upstairs rooms included)
+        for (float zOff : { 0.0f, 3.0f, 6.0f, 9.0f, 12.0f })
+        {
+            size_t storeyStart = inn.beds.size();       // at most 14 per storey, so upstairs gets its share
+            for (float r = 2.5f; r <= 22.0f && inn.beds.size() < storeyStart + 14; r += 2.5f)
+                for (int a = 0; a < 16 && inn.beds.size() < storeyStart + 14; ++a)
+                {
+                    float ang = float(a) * float(M_PI) / 8.0f + r * 0.37f;
+                    float x = keeper->GetPositionX() + r * std::cos(ang), y = keeper->GetPositionY() + r * std::sin(ang);
+                    float want = keeper->GetPositionZ() + zOff;
+                    float z = map->GetHeight(keeper->GetPhaseMask(), x, y, want + 1.5f, true, 4.0f);
+                    if (z <= INVALID_HEIGHT || std::fabs(z - want) > 2.0f || !farFromAll(x, y, z))
+                        continue;
+                    PositionFullTerrainStatus terrain;
+                    map->GetFullTerrainStatusForPosition(keeper->GetPhaseMask(), x, y, z, keeper->GetCollisionHeight(), terrain);
+                    if (terrain.outdoors || terrain.liquidInfo.Status != LIQUID_MAP_NO_WATER)
+                        continue;
+                    PathGenerator path(keeper);
+                    path.CalculatePath(x, y, z);
+                    if (path.GetPathType() != PATHFIND_NORMAL || path.getPathLength() > 60.0f)
+                        continue;
+                    inn.beds.push_back({ x, y, z, ang + float(M_PI), UNIT_STAND_STATE_SLEEP });
+                }
+        }
+        BOT_LOG_INFO("server.loading", "SoloWoW bubble: inn of {} has {} seats and {} places to sleep", keeper->GetName(), uint32(inn.seats.size()), uint32(inn.beds.size()));
+        return inn;
+    }
+
+    // Each person has their own preferred seat/bed (the same one every night), taking the next free one if it's taken.
+    bool ClaimSpot(uint32 entry, uint32 agent, uint32 innId, bool bed, std::vector<InnSpot> const& list, InnSpot& out, uint64& key)
+    {
+        if (list.empty())
+            return false;
+        uint32 n = uint32(list.size());
+        uint32 start = Hash(agent, bed ? 31 : 32) % n;
+        for (uint32 k = 0; k < n; ++k)
+        {
+            uint32 i = (start + k) % n;
+            uint64 sk = SpotKey(innId, bed, i);
+            auto it = spotTaken.find(sk);
+            if (it == spotTaken.end() || it->second == entry)
+            {
+                spotTaken[sk] = entry;
+                out = list[i];
+                key = sk;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void ReleaseSpot(Life& life, uint32 entry)
+    {
+        if (!life.spot)
+            return;
+        if (auto it = spotTaken.find(life.spot); it != spotTaken.end() && it->second == entry)
+            spotTaken.erase(it);
+        life.spot = 0;
+        life.snap = false;
+    }
+
+    // A reachable, dry point within `radius` of (cx, cy) - playerbots' MoveRandomNear, bounded to the site.
+    bool RandomNear(Creature* me, float cx, float cy, float cz, float radius, Position& out)
+    {
+        Map* map = me->GetMap();
+        for (int attempt = 0; attempt < 8; ++attempt)
+        {
+            float dist = (0.25f + rand_norm() * 0.75f) * radius;
+            float angle = float(rand_norm()) * 2.0f * float(M_PI);
+            float x = cx + dist * std::cos(angle), y = cy + dist * std::sin(angle), z = cz;
+            float ground = map->GetHeight(me->GetPhaseMask(), x, y, z + 5.0f);
+            if (ground <= INVALID_HEIGHT)
+                continue;
+            z = ground;
+            if (!map->CanReachPositionAndGetValidCoords(me, x, y, z))
+                continue;
+            if (map->IsInWater(me->GetPhaseMask(), x, y, z, me->GetCollisionHeight()))
+                continue;
+            out.Relocate(x, y, z, frand(0.0f, 2.0f * float(M_PI)));
+            return true;
+        }
+        return false;
+    }
+}
+
+bool BotBubble::SimLife(Creature* me, WanderNode const* cur, Position& target, WanderNode const*& nextNode, uint32& waitMs, float& arrive)
+{
+    if (!me || !cur || !sSoloSim->IsLive())
+        return false;
+    uint32 agent = SimAgentOf(me->GetEntry());
+    if (!agent)
+        return false;
+    SoloSim::SimIntent in;
+    if (!sSoloSim->Intent(agent, in))
+        return false;
+
+    std::lock_guard<std::mutex> guard(lifeLock);
+    Life& life = lives[me->GetEntry()];
+    nextNode = nullptr;
+
+    // This is called when the body has reached its last target. The engine's wait comes BEFORE the next
+    // move, so a stay is done here, on arrival: settle (sit, lie down, face and greet the NPC), then wait.
+    if (life.pending)
+    {
+        life.pending = false;
+        if (life.npc)
+        {
+            if (Creature* npc = ObjectAccessor::GetCreature(*me, life.npc); npc && me->GetExactDist2d(npc) < 8.0f)
+            {
+                me->SetFacingToObject(npc);
+                me->HandleEmoteCommand(urand(0, 2) ? EMOTE_ONESHOT_TALK : EMOTE_ONESHOT_POINT);
+            }
+            life.npc.Clear();
+        }
+        if (life.snap && me->GetExactDist(life.sx, life.sy, life.sz) < 4.0f)
+            me->NearTeleportTo(life.sx, life.sy, life.sz, life.so);     // onto the chair / into the bed
+        life.snap = false;
+        if (life.faceAngle >= 0.0f)
+            me->SetFacingTo(life.faceAngle);
+        if (life.stand != UNIT_STAND_STATE_STAND)
+        {
+            me->SetStandState(life.stand);
+            // the hunter's cat and the warlock's imp don't sleep in the common room (back once they're up)
+            if (life.spot)
+                if (bot_ai* ai = me->GetBotAI(); ai && ai->GetBotsPet())
+                    ai->UnsummonAll(true);
+        }
+        life.faceAngle = -1.0f;
+        target.Relocate(me);
+        arrive = 3.0f;
+        waitMs = std::max<uint32>(1, life.stay);
+        return true;
+    }
+
+    // go somewhere, then (on arrival) settle and stay
+    auto go = [&](Position const& p, float arriveWithin, uint32 stay, uint8 stand = UNIT_STAND_STATE_STAND, float face = -1.0f) {
+        ReleaseSpot(life, me->GetEntry());
+        if (me->GetStandState() != UNIT_STAND_STATE_STAND)
+            me->SetStandState(UNIT_STAND_STATE_STAND);
+        target.Relocate(p);
+        arrive = arriveWithin;
+        waitMs = 1;
+        life.pending = true; life.stay = stay; life.stand = stand; life.faceAngle = face;
+        return true;
+    };
+
+    // 1. far from the place they mean to be: take the roads there, in their own lane
+    float siteDist = me->GetExactDist2d(in.x, in.y);
+    float siteRadius = in.siteType == SoloSim::SiteType::Hub ? 60.0f : 70.0f;
+    if (siteDist > siteRadius && in.goalNode && cur->GetWPId() != in.goalNode)
+    {
+        WanderNode const* next = sSoloSim->StepToward(cur, in.goalNode);
+        if (next && next != cur)
+        {
+            float dx = next->GetPositionX() - cur->GetPositionX(), dy = next->GetPositionY() - cur->GetPositionY();
+            float len = std::max(1.0f, std::sqrt(dx * dx + dy * dy));
+            float lane = (Unit01(agent, 21) - 0.5f) * 10.0f + frand(-1.0f, 1.0f);   // -5..+5 yd off the centre line
+            float x = next->GetPositionX() - dy / len * lane, y = next->GetPositionY() + dx / len * lane, z = next->GetPositionZ();
+            float ground = me->GetMap()->GetHeight(me->GetPhaseMask(), x, y, z + 5.0f);
+            if (ground > INVALID_HEIGHT && std::fabs(ground - z) < 8.0f)
+                z = ground;
+            else
+            {
+                x = next->GetPositionX(); y = next->GetPositionY();
+            }
+            nextNode = next;
+            go(Position(x, y, z, next->GetOrientation()), 8.0f, 1);   // round the corner early, don't touch the node
+            life.pending = false;                                    // no stay on the road
+            return true;
+        }
+    }
+
+    // 2. at the place: act out what they're doing there
+    using SoloSim::Verb;
+    Verb v = in.verb;
+    if (in.siteType == SoloSim::SiteType::Hub)
+    {
+        // the inn: asleep in front of the innkeeper's counter, or sitting about in the common room
+        if (v == Verb::Sleep || ((v == Verb::Socialize || v == Verb::Recover) && urand(0, 99) < 70))
+        {
+            std::vector<Creature*> inn = FindServiceNpcs(me, in.x, in.y, 70.0f, UNIT_NPC_FLAG_INNKEEPER);
+            if (!inn.empty())
+            {
+                Creature* keeper = inn.front();
+                bool sleep = v == Verb::Sleep;
+                Inn const& spots = InnOf(keeper);
+                // already settled in their place: stay rather than get up and settle again
+                if (life.spot && ((life.spot >> 16) & 1) == uint64(sleep) && !me->IsStandState() && me->GetExactDist(life.sx, life.sy, life.sz) < 2.5f)
+                {
+                    target.Relocate(me);
+                    arrive = 4.0f;
+                    waitMs = sleep ? 60000 : urand(40000, 120000);
+                    return true;
+                }
+                // their own bed (any storey) to sleep; a chair or bench to sit about, else a free bit of floor
+                InnSpot s; uint64 key = 0;
+                ReleaseSpot(life, me->GetEntry());
+                if (ClaimSpot(me->GetEntry(), agent, keeper->GetSpawnId(), sleep, sleep ? spots.beds : spots.seats, s, key) ||
+                    (!sleep && ClaimSpot(me->GetEntry(), agent, keeper->GetSpawnId(), true, spots.beds, s, key)))
+                {
+                    uint8 settle = sleep ? UNIT_STAND_STATE_SLEEP : (s.stand == UNIT_STAND_STATE_SLEEP ? UNIT_STAND_STATE_SIT : s.stand);
+                    go(Position(s.x, s.y, s.z, s.o), 1.5f, sleep ? 60000 : urand(60000, 180000), settle, s.o);
+                    spotTaken[key] = me->GetEntry();           // go() released the old spot; this one is ours
+                    life.spot = key; life.snap = true;
+                    life.sx = s.x; life.sy = s.y; life.sz = s.z; life.so = s.o;
+                    return true;
+                }
+                uint8 stand = v == Verb::Sleep ? UNIT_STAND_STATE_SLEEP : UNIT_STAND_STATE_SIT;
+                Position spot = SpotBy(me, keeper, agent, v == Verb::Sleep ? 4.0f : 3.0f, v == Verb::Sleep ? 9.0f : 7.0f, true);
+                // already settled there: stay put rather than get up and lie down again
+                if (me->GetStandState() == stand && me->GetExactDist2d(spot) < 4.0f)
+                {
+                    target.Relocate(me);
+                    arrive = 4.0f;
+                    waitMs = v == Verb::Sleep ? 60000 : urand(30000, 90000);
+                    return true;
+                }
+                if (v != Verb::Sleep && urand(0, 1))
+                    RandomNear(me, spot.GetPositionX(), spot.GetPositionY(), spot.GetPositionZ(), 4.0f, spot); // a different seat now and then
+                return go(spot, 1.5f, v == Verb::Sleep ? 60000 : urand(40000, 120000), stand, frand(0.0f, 2.0f * float(M_PI)));
+            }
+        }
+        // errands and idling: walk up to someone useful (playerbots' wander-npc), or mill about the square
+        uint32 flags = 0; char const* title = nullptr;
+        if (v == Verb::Trade)      flags = UNIT_NPC_FLAG_VENDOR | UNIT_NPC_FLAG_REPAIR;
+        else if (v == Verb::Train) { flags = UNIT_NPC_FLAG_TRAINER; title = TrainerTitle(in.cls); }
+        if (flags || urand(0, 99) < 55)
+        {
+            std::vector<Creature*> npcs = FindServiceNpcs(me, in.x, in.y, 70.0f, flags, title);
+            if (npcs.empty() && title)
+                npcs = FindServiceNpcs(me, in.x, in.y, 70.0f, flags);
+            if (!npcs.empty())
+            {
+                Creature* npc = npcs[urand(0, uint32(npcs.size()) - 1)];
+                go(SpotBy(me, npc, agent, 2.0f, 3.5f, false), 1.5f, urand(12000, 30000));   // playerbots' npcStayTime
+                life.npc = npc->GetGUID();
+                return true;
+            }
+        }
+        Position p;
+        if (RandomNear(me, in.x, in.y, in.z, 25.0f, p))
+            return go(p, 2.0f, urand(5000, 20000));
+    }
+    else
+    {
+        // a hunting camp or a gathering spot: work the area (the bot fights whatever it meets there)
+        Position p;
+        if (RandomNear(me, in.x, in.y, in.z, 35.0f, p))
+            return go(p, 2.0f, urand(2000, 9000));
+    }
+    // nothing fit: stand here a moment and think again
+    target.Relocate(me);
+    arrive = 3.0f;
+    waitMs = 5000;
+    return true;
+}
+
+void BotBubble::ForgetLife(uint32 botEntry)
+{
+    std::lock_guard<std::mutex> guard(lifeLock);
+    if (auto it = lives.find(botEntry); it != lives.end())
+    {
+        ReleaseSpot(it->second, botEntry);
+        lives.erase(it);
+    }
+}
+
+// townsfolk use the same inn seats as everyone (keyed by their own creature entry)
+bool BotBubble::ClaimInnSeat(Creature* me, uint32 agent, float cx, float cy, Position& out, uint8& stand)
+{
+    std::vector<Creature*> inn = FindServiceNpcs(me, cx, cy, 70.0f, UNIT_NPC_FLAG_INNKEEPER);
+    if (inn.empty())
+        return false;
+    std::lock_guard<std::mutex> guard(lifeLock);
+    Life& life = lives[me->GetEntry()];
+    ReleaseSpot(life, me->GetEntry());
+    Inn const& spots = InnOf(inn.front());
+    InnSpot s; uint64 key = 0;
+    if (!ClaimSpot(me->GetEntry(), agent, inn.front()->GetSpawnId(), false, spots.seats, s, key) &&
+        !ClaimSpot(me->GetEntry(), agent, inn.front()->GetSpawnId(), true, spots.beds, s, key))
+        return false;
+    life.spot = key;
+    out.Relocate(s.x, s.y, s.z, s.o);
+    stand = s.stand == UNIT_STAND_STATE_SLEEP ? uint8(UNIT_STAND_STATE_SIT) : s.stand;
+    return true;
+}
+
+void BotBubble::ReleaseInnSeat(uint32 entry)
+{
+    std::lock_guard<std::mutex> guard(lifeLock);
+    if (auto it = lives.find(entry); it != lives.end())
+        ReleaseSpot(it->second, entry);
+}
+
+void BotBubble::ReportFallen(uint32 agent, std::string const& killer)
+{
+    std::lock_guard<std::mutex> guard(fallenLock);
+    fallen.emplace_back(agent, killer, false);
+}
+
+void BotBubble::OnBodyDied(Creature const* bot, Unit const* killer)
+{
+    if (!bot)
+        return;
+    uint32 agent = SimAgentOf(bot->GetEntry());
+    if (!agent)
+        return;
+    // raids: wipes are part of raiding - a death there never touches the sim. dungeons: rarely final (World::BodyFell)
+    Map const* map = bot->FindMap();
+    if (map && map->IsRaid())
+        return;
+    bool dungeon = map && map->IsDungeon();
+    std::string who = killer ? (killer->IsPlayer() ? killer->GetName() : std::string(killer->GetName())) : std::string("something in the wilds");
+    if (killer && killer->IsCreature() && !killer->IsNPCBotOrPet())
+        who = (killer->ToCreature()->GetCreatureTemplate()->rank >= 1 ? "the " : "a ") + who;
+    std::lock_guard<std::mutex> guard(fallenLock);
+    fallen.emplace_back(agent, who, dungeon);
+}
+
+uint32 BotBubble::SimAgentOf(uint32 botEntry)
+{
+    auto it = simEntryToAgent.find(botEntry);
+    return it == simEntryToAgent.end() ? 0 : it->second;
+}
+
+std::string BotBubble::HireRefusal(Creature const* bot, Player const* player)
+{
+    if (!bot || !player || !sSoloSim->IsLive()) return "";
+    uint32 agent = SimAgentOf(bot->GetEntry());
+    return agent ? sSoloSim->HireRefusal(agent, player->GetGUID().GetCounter(), player->GetLevel()) : std::string();
+}
+
+WanderNode const* BotBubble::NextSimNode(Creature const* bot, WanderNode const* cur)
+{
+    if (!bot || !cur || !sSoloSim->IsLive())
+        return nullptr;
+    uint32 agent = SimAgentOf(bot->GetEntry());
+    if (!agent)
+        return nullptr;
+    uint32 goal = sSoloSim->GoalNode(agent);
+    return goal ? sSoloSim->StepToward(cur, goal) : nullptr;
+}
+
+void BotBubble::Update(uint32 diff)
+{
+    if (!cfgLoaded)
+        LoadConfig();
+    if (!cfg.enable || !cfg.count)
+        return;
+
+    checkTimer += diff;
+    if (checkTimer < cfg.interval)
+        return;
+    checkTimer = 0;
+
+    if (!BotDataMgr::AllBotsLoaded() || WanderNode::GetAllWPsCount() == 0)
+        return;
+    if (!zoneLinksBuilt)
+        BuildZoneLinks();
+
+    Player* player = FindLocalPlayer();
+    if (!player)
+        return;
+    Map* pmap = player->GetMap();
+    // In a dungeon, raid or battleground the outside world just waits.
+    if (!pmap || !pmap->GetEntry() || !pmap->GetEntry()->IsContinent())
+        return;
+    // Don't churn bots while flying over zones on a taxi; the bubble catches up on landing.
+    if (player->IsInFlight())
+        return;
+
+    const uint32 mapId = pmap->GetId();
+    const uint32 zoneId = player->GetZoneId();
+
+    std::unordered_set<uint32> bubble{ zoneId };
+    if (cfg.neighbors)
+        if (auto it = zoneLinks.find(zoneId); it != zoneLinks.end())
+            bubble.insert(it->second.begin(), it->second.end());
+
+    if (zoneId != lastZone || mapId != lastMap)
+    {
+        BOT_LOG_INFO("npcbots", "SoloWoW bubble: player {} entered zone {} map {}, bubble has {} zones",
+            player->GetName(), zoneId, mapId, uint32(bubble.size()));
+        lastZone = zoneId;
+        lastMap = mapId;
+    }
+
+    if (cfg.simSource && sSoloSim->IsLive())
+    {
+        UpdateSimBodies(player, mapId, zoneId, bubble);
+        SoloBoards::Update(player);
+        SoloCamps::Update(player);
+        return;
+    }
+
+    // Sort free wanderers into "inside the bubble" and "left behind".
+    uint32 inside = 0;
+    std::vector<uint32> leftBehind;
+    {
+        std::shared_lock lock(*BotDataMgr::GetLock());
+        for (Creature const* bot : BotDataMgr::GetExistingNPCBots())
+        {
+            if (!bot || !bot->IsInWorld() || !bot->IsWandererBot() || !bot->IsFreeBot())
+                continue;
+            Map const* bmap = bot->FindMap();
+            if (!bmap || !bmap->GetEntry() || !bmap->GetEntry()->IsContinent())
+                continue; // battleground bots etc. are not ours
+            if (bmap->GetId() == mapId && bubble.contains(bot->GetZoneId()))
+            {
+                ++inside;
+                continue;
+            }
+            if (pinned.contains(bot->GetEntry()))
+                continue;
+            if (bmap->GetId() == mapId && bot->GetExactDist2d(player) < cfg.safeDistance)
+                continue; // still near the player (e.g. just across a zone border) - keep for now
+            leftBehind.push_back(bot->GetEntry());
+        }
+    }
+
+    for (uint32 i = 0; i < leftBehind.size() && i < cfg.maxDespawn; ++i)
+        BotDataMgr::DespawnWandererBot(leftBehind[i]);
+
+    const uint32 pending = BotDataMgr::GetPendingWanderSpawnsCount();
+    statusTimer += cfg.interval;
+    if (statusTimer >= 30000 || zoneId != statusZone)
+    {
+        statusTimer = 0;
+        statusZone = zoneId;
+        BOT_LOG_INFO("server.loading", "SoloWoW bubble: zone {} ({} zones), inside {}/{}, pending {}, left behind {}",
+            zoneId, uint32(bubble.size()), inside, cfg.count, pending, uint32(leftBehind.size()));
+    }
+    if (inside + pending >= cfg.count)
+        return;
+    uint32 need = std::min<uint32>(cfg.count - inside - pending, cfg.maxSpawn);
+
+    // Spawn points: most bots go into the player's own zone; neighbor zones get a share
+    // (they are mainly a buffer so bots that wander off aren't recycled at once).
+    // Within each, prefer points out of the player's sight.
+    auto collect = [&](bool homeZone) {
+        std::vector<WanderNode const*> nearNodes, farNodes;
+        for (uint32 z : bubble)
+        {
+            if ((z == zoneId) != homeZone)
+                continue;
+            WanderNode::DoForAllZoneWPs(z, [&](WanderNode const* wp) {
+                if (wp->GetMapId() != mapId || !wp->HasFlag(BotWPFlags::BOTWP_FLAG_SPAWN))
+                    return;
+                (player->GetExactDist2d(wp) >= cfg.spawnAway ? farNodes : nearNodes).push_back(wp);
+            });
+        }
+        return farNodes.empty() ? nearNodes : farNodes;
+    };
+    std::vector<WanderNode const*> homeNodes = collect(true);
+    std::vector<WanderNode const*> neighborNodes = collect(false);
+    if (homeNodes.empty() && neighborNodes.empty())
+        return;
+
+    const uint8 preferBracket = uint8(std::min<uint32>(player->GetLevel() / 10, 8));
+    uint32 spawned = 0;
+    for (uint32 i = 0; i < need; ++i)
+    {
+        bool useHome = !homeNodes.empty() && (neighborNodes.empty() || urand(1, 100) <= cfg.homeShare);
+        std::vector<WanderNode const*> const& nodes = useHome ? homeNodes : neighborNodes;
+        if (!BotDataMgr::GenerateBubbleWanderer(nodes, preferBracket))
+        {
+            // the chosen set may not fit any spare bot (faction/level) - try the other one once
+            std::vector<WanderNode const*> const& other = useHome ? neighborNodes : homeNodes;
+            if (other.empty() || !BotDataMgr::GenerateBubbleWanderer(other, preferBracket))
+                break;
+        }
+        ++spawned;
+    }
+}
