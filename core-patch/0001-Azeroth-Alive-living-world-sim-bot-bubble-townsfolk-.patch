+// =====================================================================================================
+// v2: weather
+// =====================================================================================================
+void World::RollWeather()
+{
+    std::set<uint32> zones;
+    for (SimSite const& s : _sites) zones.insert(s.zone);
+    for (uint32 z : zones)
+    {
+        Rng r(_seed, z, _clock, P_WEATHER);
+        float chance = z == 40 ? 0.10f : (z == 10 ? 0.30f : 0.20f);     // Westfall dry, Duskwood gloomy
+        bool rain = r.Chance(chance);
+        bool was = _rain[z];
+        _rain[z] = rain;
+        if (rain && !was)
+        {
+            AreaTableEntry const* e = sAreaTableStore.LookupEntry(z);
+            std::string name = e && e->area_name[0] ? e->area_name[0] : "the region";
+            Log(EventType::Weather, Nobody(), 0, Acore::StringFormat("Rain set in over {}; the inns filled up.", name), true);
+        }
+    }
+}
