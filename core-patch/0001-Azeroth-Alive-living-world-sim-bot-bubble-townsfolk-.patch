+std::string World::SummonCamp(bool havePos, uint32 map, float x, float y)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "The world isn't running yet.";
+    if (!havePos) return "Use .sim camp in game: the camp goes up near the town nearest you.";
+    uint32 town = 0; float best = 1e9f;
+    if (havePos)
+        for (SimSite const& h : _sites)
+            if (h.type == SiteType::Hub && (h.services & SVC_INN) && h.regionLevel && h.map == map)
+                if (float d = Dist2d(h.x, h.y, x, y); d < best) { best = d; town = h.id; }
+    uint32 before = _nextCamp;
+    PostCamps(true, town);
+    for (SimCamp const& k : _camps)
+        if (k.id >= before)
+            return Acore::StringFormat("{} (level {}, {} of them) have made camp by the road near {}, for {}.", Plural(k.name), k.level, k.size, AreaOf(SiteName(k.site)), SiteName(k.town));
+    return havePos ? "No camp could be placed near here (the nearest town may already have one)." : "No camp could be placed.";
+}
