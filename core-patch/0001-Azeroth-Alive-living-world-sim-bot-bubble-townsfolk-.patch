+// every 12 hours: old requests lapse, and about one townsperson in five has something to ask
+void World::PostErrands()
+{
+    for (SimErrand& e : _errands)
+        if (_away && e.player && !e.done) e.expires = std::max(e.expires, _clock + MIN_PER_DAY);                  // yours waits for you
+        else if (!e.done && _clock >= e.expires) e.done = true;
+    std::erase_if(_errands, [this](SimErrand const& e) { return e.done && _clock > e.expires + MIN_PER_DAY; });
+    for (auto& [id, a] : _agents)
+    {
+        if (a.role != ROLE_CIVILIAN || a.status != AgentStatus::Active) continue;
+        if (std::ranges::any_of(_errands, [&](SimErrand const& e) { return e.agent == id && !e.done; })) continue;
+        Rng r(_seed, id, _clock, P_BOUNTY + 300);
+        if (!r.Chance(0.2f)) continue;
+        SimSite const* home = SiteById(a.home);
+        if (!home || !home->regionLevel) continue;
+        uint32 lvl = home->regionLevel;
+        SimErrand e; e.id = _nextErrand++; e.agent = id; e.expires = _clock + r.Range(48, 72) * MIN_PER_HOUR;
+        e.reward = lvl * lvl * 12 + 150;
+        std::vector<MarketGood const*> goods;
+        for (MarketGood const& g : GOODS) if (lvl >= g.minLvl && lvl <= g.maxLvl) goods.push_back(&g);
+        std::vector<uint32> pests;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && !s.elite && s.map == home->map && Dist2d(s.x, s.y, home->x, home->y) < 900.0f
+                && std::abs(int32((s.minLevel + s.maxLevel) / 2) - int32(lvl)) <= 4)
+                pests.push_back(s.id);
+        // someone from this town who went out and never came back (died in the last 10 days, nobody's asking yet)
+        uint32 lost = 0;
+        for (auto const& [oid, o] : _agents)
+            if (o.role == ROLE_ADVENTURER && o.status == AgentStatus::Dead && o.home == a.home && _clock - o.diedAt < 10 * MIN_PER_DAY
+                && !std::ranges::any_of(_errands, [&](SimErrand const& x) { return x.kind == ERRAND_MISSING && x.target == oid; }))
+            { lost = oid; break; }
+        // someone from this town out hunting, who could do with hearing from home
+        std::vector<uint32> away;
+        for (auto const& [oid, o] : _agents)
+            if (o.role == ROLE_ADVENTURER && o.status == AgentStatus::Active && o.home == a.home && o.site != a.home) away.push_back(oid);
+        // a camp of humanoids close enough that one of them came into town and went through someone's things
+        std::vector<uint32> thieves;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hunt && !s.elite && s.creatureType == 7 && s.map == home->map && Dist2d(s.x, s.y, home->x, home->y) < 1200.0f
+                && std::abs(int32((s.minLevel + s.maxLevel) / 2) - int32(lvl)) <= 5)
+                thieves.push_back(s.id);
+        // the next town along the road, for someone who needs to get there and daren't go alone
+        uint32 escortTo = 0; float escortD = 2200.0f;
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hub && (s.services & SVC_INN) && s.id != home->id && s.map == home->map)
+            {
+                float d = Dist2d(s.x, s.y, home->x, home->y);
+                if (d > 300.0f && d < escortD) { escortD = d; escortTo = s.id; }
+            }
+        // an old hand remembers something out there that nearly killed them, and it's still about
+        uint32 foe = 0, foeSite = 0;
+        if (a.kills > 0)
+            for (SimRare const& x : _rares)
+            {
+                SimSite const* s = SiteById(x.site);
+                if (!s || s->map != home->map || Dist2d(s->x, s->y, home->x, home->y) > 2500.0f) continue;
+                if (_rareDownUntil.contains(x.entry) && _rareDownUntil[x.entry] > _clock) continue;
+                if (std::abs(int32(x.level) - int32(a.level)) > 6) continue;
+                if (std::ranges::any_of(_errands, [&](SimErrand const& o) { return !o.done && o.kind == ERRAND_OLDFOE && o.target == x.entry; })) continue;
+                foe = x.entry; foeSite = x.site;
+                if (r.Chance(0.5f)) break;
+            }
+        uint32 roll = r.Range(1, 100);
+        if (foe && r.Chance(0.6f))
+        {
+            SimRare const* x = nullptr;
+            for (SimRare const& y : _rares) if (y.entry == foe) x = &y;
+            e.kind = ERRAND_OLDFOE; e.target = foe; e.site = foeSite; e.count = 1;
+            e.reward = uint32(x ? x->level : lvl) * (x ? x->level : lvl) * 20 + 300;
+        }
+        else if (lost && roll <= 40)
+        {
+            e.kind = ERRAND_MISSING; e.target = lost; e.count = 1; e.reward = e.reward / 2 + 100;
+        }
+        else if (!away.empty() && roll <= 25)
+        {
+            e.kind = ERRAND_MESSAGE; e.target = away[r.Range(0, uint32(away.size()) - 1)]; e.count = 1;
+        }
+        else if (!thieves.empty() && roll > 25 && roll <= 42)
+        {
+            // one of the camp has it: which one, nobody knows - a few of them will have to be put down
+            e.kind = ERRAND_STOLEN; e.site = thieves[r.Range(0, uint32(thieves.size()) - 1)]; e.count = r.Range(2, 6);
+            e.reward = e.reward * 6 / 5;
+        }
+        else if (escortTo && roll > 42 && roll <= 56)
+        {
+            e.kind = ERRAND_ESCORT; e.site = escortTo; e.count = 1;
+            e.reward = e.reward * 3 / 2;
+        }
+        else if ((r.Chance(0.5f) || pests.empty()) && !goods.empty())
+        {
+            e.kind = ERRAND_FETCH; e.item = goods[r.Range(0, uint32(goods.size()) - 1)]->item; e.count = r.Range(3, 10);
+        }
+        else if (!pests.empty())
+        {
+            e.kind = ERRAND_CULL; e.site = pests[r.Range(0, uint32(pests.size()) - 1)]; e.count = r.Range(6, 12);
+        }
+        else { --_nextErrand; continue; }
+        _errands.push_back(e);
+    }
+}
