+std::string World::PlayerBoard(uint32 map, float x, float y, uint32 guid)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "The world isn't running yet.";
+    static char const* const kinds[] = { "", " [pack]", " [elites]", " [rare]", " [threat]" };
+    std::string out;
+    uint32 hub = HubNear(map, x, y, 120.0f);
+    if (!hub) out = "There's no bounty board here - they're posted in towns with an inn.";
+    else
+    {
+        out = Acore::StringFormat("Bounty board, {}:", SiteName(hub));
+        uint32 i = 0;
+        for (SimBounty const& b : _bounties)
+        {
+            if (b.done || b.hub != hub) continue;
+            ++i;
+            std::string what = b.kind == BOUNTY_RARE ? Acore::StringFormat("{} (level {}), seen near {}", RareName(b.target), b.targetLevel, AreaOf(SiteName(b.site)))
+                                                     : Acore::StringFormat("{} of the {}", b.count, SiteName(b.site));
+            std::string others;
+            if (b.taker)
+                if (SimAgent const* t = const_cast<World*>(this)->AgentById(b.taker))
+                    others = Acore::StringFormat(" - {} is after it too", t->FullName());
+            out += Acore::StringFormat("\n  {}.{} {} - {}{}{}{}", i, kinds[(b.target & THREAT_MARK) ? 4 : (b.target & CAMP_MARK) ? 1 : std::min<uint8>(b.kind, 3)], what, Money(b.reward),
+                b.party > 1 ? Acore::StringFormat(", bring {}", b.party) : std::string(), others,
+                b.player == guid ? Acore::StringFormat(" - yours ({}/{})", b.playerProgress, b.count) : std::string());
+        }
+        if (!i) out += "\n  (nothing posted right now - check back tomorrow)";
+        out += "\n  .bounty take <number> to put your name down, .bounty turnin when it's done.";
+        for (SimSite const& s : _sites)
+            if (s.type == SiteType::Hub && s.map == map && Dist2d(s.x, s.y, x, y) < 120.0f)
+                if (std::string shops = ShopsOf(s.id); !shops.empty() && shops[0] == 'I')
+                    out += "\n  " + shops;
+    }
+    for (SimBounty const& b : _bounties)
+        if (!b.done && b.player == guid && b.hub != hub)
+            out += Acore::StringFormat("\n  Yours elsewhere: {} - {} ({}/{})", SiteName(b.hub),
+                b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site), b.playerProgress, b.count);
+    return out;
+}
+
+std::string World::PlayerTake(uint32 map, float x, float y, uint32 guid, std::string const& name, uint32 index)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!_ready) return "The world isn't running yet.";
+    uint32 hub = HubNear(map, x, y, 120.0f);
+    if (!hub) return "There's no bounty board here.";
+    uint32 i = 0;
+    for (SimBounty& b : _bounties)
+    {
+        if (b.done || b.hub != hub || ++i != index) continue;
+        if (b.player == guid) return "Your name is already on that one.";
+        b.player = guid; b.playerProgress = 0;
+        Log(EventType::PlayerBounty, Nobody(), hub, Acore::StringFormat("{} put their name down for the {} bounty on {}.", name, SiteName(hub),
+            b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site)), true);
+        std::string out = Acore::StringFormat("You took the bounty: {}. {} days to do it. Come back here to collect.",
+            b.kind == BOUNTY_RARE ? Acore::StringFormat("{} near {}", RareName(b.target), AreaOf(SiteName(b.site))) : Acore::StringFormat("{} of the {}", b.count, SiteName(b.site)),
+            b.expires > _clock ? (b.expires - _clock + MIN_PER_DAY - 1) / MIN_PER_DAY : 0);
+        if (b.party > 1) out += Acore::StringFormat(" The board says to bring {} - people in town can be hired.", b.party);
+        if (b.taker)
+            if (SimAgent const* t = AgentById(b.taker))
+                out += Acore::StringFormat(" {} is already after it - whoever comes back first gets paid.", t->FullName());
+        return out;
+    }
+    return "There's no bounty with that number here (.bounty to see the board).";
+}
+
+std::string World::PlayerTurnIn(uint32 map, float x, float y, uint32 guid, std::string const& name, uint32& reward)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    reward = 0;
+    if (!_ready) return "The world isn't running yet.";
+    uint32 hub = HubNear(map, x, y, 120.0f);
+    std::string out;
+    for (SimBounty& b : _bounties)
+    {
+        if (b.done || b.player != guid) continue;
+        if (b.playerProgress < b.count) { out += Acore::StringFormat("\n  Not done yet: {} ({}/{}).", b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site), b.playerProgress, b.count); continue; }
+        if (b.hub != hub) { out += Acore::StringFormat("\n  Done - collect it in {}.", SiteName(b.hub)); continue; }
+        b.done = true;
+        reward += b.reward;
+        Log(EventType::PlayerBounty, Nobody(), hub, Acore::StringFormat("{} collected the {} bounty for the {} ({}).", name, SiteName(hub),
+            b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site), Money(b.reward)), true);
+        if (SimAgent* t = AgentById(b.taker))
+        {
+            Log(EventType::BountyExpired, *t, hub, Acore::StringFormat("{} got to the {} bounty first; {} was paid nothing for the work.", name, SiteName(hub), t->FullName()), true);
+            RememberPlayer(*t, guid, -20, 60, EventType::PlayerBounty);
+            t->bounty = 0; t->bountyProgress = 0;
+        }
+        out += Acore::StringFormat("\n  Paid {} for the {}.", Money(b.reward), b.kind == BOUNTY_RARE ? RareName(b.target) : SiteName(b.site));
+    }
+    if (out.empty()) return "You have no bounties to turn in.";
+    return "Bounties:" + out;
+}
