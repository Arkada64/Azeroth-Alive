+std::string World::Culprit(SimSite const& site) const
+{
+    return _culprit.empty() ? SiteName(site.id) : _culprit;
+}
+
+// A body was killed in the game world, in front of the player: in the sim that is a defeat like any other.
+void World::BodyFell(uint32 agentId, std::string const& killer, bool dungeon)
+{
+    struct Scale { float& s; float old; ~Scale() { s = old; } } scale{ _deathScale, _deathScale };
+    if (dungeon) _deathScale = 0.15f;
+    SimAgent* a = AgentById(agentId);
+    if (!a || (a->status != AgentStatus::Active && a->status != AgentStatus::Hired)) return;
+    if (a->role == ROLE_THREAT) { ThreatDown(*a, killer); return; }
+    a->status = AgentStatus::Active;                   // a hireling falls like anyone else
+    for (SimErrand& e : _errands)                      // whatever they'd asked for dies with the asking
+        if (e.agent == agentId && !e.done)
+        {
+            e.done = true;
+            if (e.kind == ERRAND_ESCORT && e.player)
+                _mail.push_back({ e.player, a->home, Acore::StringFormat("{}", a->FullName()),
+                    Acore::StringFormat("Word reached {} that {} never made it to {}. You were with them on the road.\n\nThere's nothing owed.",
+                        SiteName(a->home), a->FullName(), SiteName(e.site)), 0 });
+        }
+    SimSite const* site = SiteById(a->site);
+    if (!site) return;
+    SimSite here = *site;
+    _culprit = Acore::StringFormat("{} near {}", killer, AreaOf(SiteName(site->id)));
+    a->wounds = 100;
+    Defeat(*a, here);
+    _culprit.clear();
+    _requeue.push_back(a->id);
+}
+
+void World::Defeat(SimAgent& a, SimSite const& site)
+{
+    ++a.defeats;
+    // whatever bounty they carried goes back on the board for someone else
+    if (SimBounty* b = BountyOf(a); b && !b->done)
+        b->taker = 0;
+    a.bounty = 0; a.bountyProgress = 0;
+    Rng r = R(a, P_DEFEAT);
+    float finalChance = std::min(0.85f, 0.10f + 0.15f * float(a.defeats - 1));
+    static bool const permadeath = sConfigMgr->GetOption<bool>("SoloSim.Permadeath", true);   // off: nobody dies for good (testing)
+    finalChance *= _deathScale;                                    // a dungeon is far kinder than the open world
+    if (_away)                                                     // while nobody was here: fewer deaths, and never your people
+        finalChance = CloseToAPlayer(a.id) ? 0.0f : finalChance * 0.3f;
+    if (!permadeath) finalChance = 0.0f;
+    a.plan.clear();
+    a.lootValue = 0;
+    a.goodsUnits = {};
+    a.durability = uint8(a.durability > 10 ? a.durability - 10 : 0);
+    _memories.push_back({ a.id, 3, site.id, uint8(EventType::Defeated), -60, 80, _clock });
+    if (r.Chance(finalChance)) { Die(a, site); return; }
+
+    uint32 party = a.party;
+    a.party = 0;
+    a.status = AgentStatus::Recovering;
+    a.statusUntil = _clock + r.Range(24 * 60, 72 * 60);
+    a.wakeAt = a.statusUntil;
+    a.site = a.home;
+    a.wounds = 90;
+    a.doing = Verb::Recover;
+    // in a party, the others carry you home; alone, you drag yourself back
+    SimAgent* carrier = nullptr;
+    if (party)
+        for (auto& [id, o] : _agents)
+            if (InParty(o, party) && o.id != a.id && o.status == AgentStatus::Active) { carrier = &o; break; }
+    std::string how = carrier ? Acore::StringFormat("was carried back to {} by {}", SiteName(a.home), carrier->FullName())
+                              : Acore::StringFormat("{} {}", r.Chance(0.5f) ? "was dragged back to" : "barely made it back to", SiteName(a.home));
+    if (carrier) _memories.push_back({ a.id, 1, carrier->id, uint8(EventType::Defeated), 70, 80, _clock });
+    Log(EventType::Defeated, a, site.id, Acore::StringFormat("{} was beaten by {} and {} ({}).", Who(a), Culprit(site), how,
+        a.defeats == 1 ? std::string("first defeat") : Acore::StringFormat("defeat number {}", a.defeats)), true, carrier ? carrier->id : 0, a.defeats);
+}
+
+void World::Die(SimAgent& a, SimSite const& site)
+{
+    uint32 party = a.party;
+    a.status = AgentStatus::Dead;
+    a.diedAt = _clock;
+    a.deathCause = Acore::StringFormat("killed by {}", Culprit(site));
+    a.plan.clear();
+    a.doing = Verb::Idle;
+    a.party = 0;
+    Log(EventType::Died, a, site.id, Acore::StringFormat("{} was killed by {}. (defeat number {})", Who(a), Culprit(site), a.defeats), true, 0, a.defeats);
+    MakeNews(a, site);
+    // party members saw it happen: they know at once
+    if (party)
+        for (auto& [id, o] : _agents)
+            if (InParty(o, party) && o.id != a.id && o.status == AgentStatus::Active)
+            {
+                Log(EventType::FellBeside, o, site.id, Acore::StringFormat("{} watched {} fall beside them at {}.", o.FullName(), a.FullName(), SiteName(site.id)), true, a.id);
+                LearnNews(o, _news.back(), "saw with their own eyes");
+            }
+    SpawnNewcomer();
+}
