+// townsfolk requests (errands) and rumors
+// =====================================================================================================
+uint32 World::TownOf(uint32 site) const
+{
+    if (auto it = _townOf.find(site); it != _townOf.end()) return it->second;
+    SimSite const* s = SiteById(site);
+    uint32 best = 0; float bestD = 1500.0f;
+    if (s)
+        for (SimSite const& h : _sites)
+            if (h.type == SiteType::Hub && (h.services & SVC_INN) && h.map == s->map)
+            {
+                float d = Dist2d(h.x, h.y, s->x, s->y);
+                if (d < bestD) { bestD = d; best = h.id; }
+            }
+    _townOf[site] = best;
+    return best;
+}
