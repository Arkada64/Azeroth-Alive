+void World::Save()
+{
+    auto kv = [](char const* k, uint64 v) { CharacterDatabase.DirectExecute(Acore::StringFormat("REPLACE INTO sim_state (k, v) VALUES ('{}', {})", k, v)); };
+    kv("seed", _seed); kv("clock", _clock); kv("next_agent", _nextAgent); kv("next_site", _nextSite); kv("next_event", _nextEvent);
+    kv("next_bounty", _nextBounty); kv("next_news", _nextNews); kv("last_daily", _lastDailyTick); kv("version", SCHEMA_VERSION);
+    _realTime = uint64(std::time(nullptr));
+    kv("real_time", _realTime);
+
+    std::vector<std::string> rows;
+    CharacterDatabase.DirectExecute("DELETE FROM sim_site");
+    for (SimSite const& s : _sites)
+        rows.push_back(Acore::StringFormat("({},{},'{}','{}',{},{},{},{},{},{},{},{},{},{},{},{},{},{})", s.id, uint32(s.type), Esc(s.name), Esc(s.creatureName),
+            s.map, s.zone, s.area, s.x, s.y, s.z, s.services, s.minLevel, s.maxLevel, s.creatureType, s.copperPerKill, s.elite ? 1 : 0, s.spawns, s.regionLevel));
+    Chunked("INSERT INTO sim_site VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_agent");
+    rows.clear();
+    for (auto const& [id, a] : _agents)
+        rows.push_back(Acore::StringFormat("({},'{}','{}',{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},'{}',{},{},{},{},{},{},{},{},'{}',{},{},{},{},{},{},{},'{}',{},{},{})",
+            a.id, Esc(a.given), Esc(a.family), a.gender, a.race, a.cls, a.sourceEntry, a.level, a.xp, a.gearTier, a.money, a.lootValue,
+            a.wounds, a.fatigue, a.supplies, a.durability, a.bravery, a.greed, a.sociability, a.caution, a.wanderlust,
+            a.home, a.site, a.born, uint32(a.status), a.statusUntil, a.defeats, a.diedAt, Esc(a.deathCause), a.kills,
+            uint32(a.ambition), a.ambitionTarget, a.ambitionProgress, a.avengeFor, uint32(a.doing), a.wakeAt, a.lastSocial, EncodePlan(a.plan),
+            a.bounty, a.bountyProgress, a.trainedLevel, a.prof[0], a.profSkill[0], a.prof[1], a.profSkill[1], JoinIds(a.knownNews), a.role, a.job, a.age0));
+    Chunked("INSERT INTO sim_agent VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_relation");
+    rows.clear();
+    for (SimRelation const& r : _relations) rows.push_back(Acore::StringFormat("({},{},{},{})", r.a, r.b, r.kind, r.strength));
+    Chunked("INSERT INTO sim_relation VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_memory");
+    rows.clear();
+    for (SimMemory const& m : _memories)
+        rows.push_back(Acore::StringFormat("({},{},{},{},{},{},{})", m.agent, m.subjectType, m.subject, m.eventType, m.valence, m.intensity, m.at));
+    Chunked("INSERT INTO sim_memory VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_bounty");
+    rows.clear();
+    for (SimBounty const& b : _bounties)
+        rows.push_back(Acore::StringFormat("({},{},{},{},{},{},{},{},{},{},{},{},{},{},{})", b.id, b.hub, b.site, b.count, b.reward, b.taker, b.posted, b.expires, b.done ? 1 : 0,
+            b.kind, b.party, b.target, b.targetLevel, b.player, b.playerProgress));
+    Chunked("INSERT INTO sim_bounty VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_errand");
+    rows.clear();
+    for (SimErrand const& e : _errands)
+        rows.push_back(Acore::StringFormat("({},{},{},{},{},{},{},{},{},{},{},{})", e.id, e.agent, e.kind, e.item, e.site, e.count, e.reward, e.player, e.progress, e.expires, e.done ? 1 : 0, e.target));
+    Chunked("INSERT INTO sim_errand VALUES ", rows);
+    kv("next_errand", _nextErrand);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_camp");
+    rows.clear();
+    for (SimCamp const& k : _camps)
+        rows.push_back(Acore::StringFormat("({},{},{},{},{},{},{},{},'{}',{},{},{},{},{},{})", k.id, k.map, k.entry, k.town, k.site, k.x, k.y, k.z, Esc(k.name),
+            k.level, k.size, k.alive, k.made, k.until, k.done ? 1 : 0));
+    Chunked("INSERT INTO sim_camp VALUES ", rows);
+    kv("next_camp", _nextCamp);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_news");
+    rows.clear();
+    for (SimNews const& n : _news) rows.push_back(Acore::StringFormat("({},{},{},{})", n.id, n.subject, n.site, n.at));
+    Chunked("INSERT INTO sim_news VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_hub_news");
+    rows.clear();
+    for (auto const& [hub, ids] : _hubNews) for (uint32 nid : ids) rows.push_back(Acore::StringFormat("({},{})", hub, nid));
+    Chunked("INSERT INTO sim_hub_news VALUES ", rows);
+
+    CharacterDatabase.DirectExecute("DELETE FROM sim_market");
+    rows.clear();
+    for (auto const& [hub, g] : _market)
+        rows.push_back(Acore::StringFormat("({},{},{},{},{})", hub, g[PROF_MINING], g[PROF_HERBALISM], g[PROF_SKINNING], g[PROF_FISHING]));
+    Chunked("INSERT INTO sim_market VALUES ", rows);
+
+    // only what's worth remembering is kept (the chronicle's events), and only for a season: 90 game days
+    if (_clock > 90 * MIN_PER_DAY)
+        CharacterDatabase.DirectExecute(Acore::StringFormat("DELETE FROM sim_event WHERE at < {}", _clock - 90 * MIN_PER_DAY));
+    rows.clear();
+    for (SimEvent const& e : _pending)
