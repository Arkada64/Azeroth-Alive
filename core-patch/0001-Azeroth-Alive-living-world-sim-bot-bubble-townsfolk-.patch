+SimSite const* World::SiteById(uint32 id) const
+{
+    if (id == 0 || id > _sites.size()) return nullptr;
+    SimSite const& s = _sites[id - 1];                 // ids are assigned 1..n in order
+    return s.id == id ? &s : nullptr;
+}
+
+SimAgent* World::AgentById(uint32 id)
+{
+    auto it = _agents.find(id);
+    return it == _agents.end() ? nullptr : &it->second;
+}
+
+// where a gathering trip happened, without the creature: "near Addle's Stead" / "at Crystal Lake"
+// the place part of a site name: "Kobold Vermin near Jasperlode Mine" -> "Jasperlode Mine"
+static std::string AreaOf(std::string const& name)
+{
+    size_t p = name.find(" near ");
+    return p == std::string::npos ? name : name.substr(p + 6);
+}
+
+static std::string PlaceOnly(std::string const& name)
+{
+    size_t p = name.find(" near ");
+    return p == std::string::npos ? "at " + name : name.substr(p + 1);
+}
+
+std::string World::SiteName(uint32 id) const
+{
+    SimSite const* s = SiteById(id);
+    if (!s) return "the road";
+    std::string n = s->name;                           // display without the " (n)" that keeps stored names unique
+    size_t p = n.rfind(" (");
+    if (p != std::string::npos && n.back() == ')' && n.find_first_not_of("0123456789", p + 2) == n.size() - 1)
+        n.erase(p);
+    return n;
+}
