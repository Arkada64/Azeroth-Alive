+void World::SendBoardMail(uint32 guid, uint32 senderEntry, std::string const& subject, std::string const& body, uint32 money)
+{
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+    MailDraft draft(subject, body);
+    if (money) draft.AddMoney(money);
+    draft.SendMailTo(trans, MailReceiver(guid), senderEntry ? MailSender(MAIL_CREATURE, senderEntry) : MailSender(MAIL_NORMAL, 0), MAIL_CHECK_MASK_COPIED);
+    CharacterDatabase.CommitTransaction(trans);
+}
+
+// how many of this good the town's shops have (shared by every good of the same profession and tier)
+static uint32 ShelfCount(std::array<uint32, PROF_COUNT> const& g, MarketGood const& good, uint8 regionLevel)
+{
+    if (regionLevel < good.minLvl || regionLevel > good.maxLvl) return 0;
+    return std::min<uint32>(SHELF_CAP, g[good.prof] / UNITS_PER_ITEM);
+}
+
+void World::SyncMarkets()
+{
+    if (hubVendors.empty())
+    {
+        // general goods and trade supplies sellers near each town centre
+        for (auto const& [guid, data] : sObjectMgr->GetAllCreatureData())
+        {
+            if (!SIM_MAPS.contains(data.mapid)) continue;
+            CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(data.id);
+            if (!t || !(t->npcflag & UNIT_NPC_FLAG_VENDOR)) continue;
+            bool keeper = t->npcflag & UNIT_NPC_FLAG_INNKEEPER;
+            bool shop = NameHas(t->SubName, { "Supplies", "Goods", "Trade" });
+            if (!keeper && !shop) continue;
+            for (SimSite const& h : _sites)
+                if (h.type == SiteType::Hub && h.map == data.mapid && Dist2d(h.x, h.y, data.posX, data.posY) < 70.0f)
+                {
+                    if (keeper) hubInnkeeper[h.id] = data.id;     // letters from the town come from them
+                    if (!shop) break;
+                    auto& v = hubVendors[h.id];
+                    if (std::ranges::find(v, data.id) == v.end()) v.push_back(data.id);
+                    vendorHub[data.id] = h.id;
+                    break;
+                }
+        }
+        hubVendors[0];                                    // mark as built even if nothing was found
+        LOG_INFO("server.loading", "SoloWoW sim: {} town shops stock what the gatherers bring in", uint32(vendorHub.size()));
+    }
+    for (auto const& [hub, vendors] : hubVendors)
+    {
+        SimSite const* h = SiteById(hub);
+        if (!h) continue;
+        std::array<uint32, PROF_COUNT> g{};
+        if (auto it = _market.find(hub); it != _market.end()) g = it->second;
+        for (MarketGood const& good : GOODS)
+        {
+            bool stocked = ShelfCount(g, good, h->regionLevel) > 0;
+            for (uint32 v : vendors)
+            {
+                auto key = std::make_pair(v, good.item);
+                bool shown = listed.contains(key);
+                if (stocked && !shown)
+                {
+                    VendorItemData const* items = sObjectMgr->GetNpcVendorItemList(v);
+                    if (items && items->FindItemCostPair(good.item, 0)) continue;          // the shop sells it anyway
+                    sObjectMgr->AddVendorItem(v, good.item, 0, 0, 0, false);
+                    listed.insert(key);
+                }
+                else if (!stocked && shown)
+                {
+                    sObjectMgr->RemoveVendorItem(v, good.item, false);
+                    listed.erase(key);
+                }
+            }
+        }
+    }
+}
+
+// a player buying from a town shop: true if it was one of the gatherers' goods and there's none left (sold out)
+bool World::MarketSoldOut(uint32 vendorEntry, uint32 item, uint32 count)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (!listed.contains({ vendorEntry, item })) return false;
+    auto vh = vendorHub.find(vendorEntry);
+    if (vh == vendorHub.end()) return false;
+    for (MarketGood const& good : GOODS)
+    {
+        if (good.item != item) continue;
+        uint32& units = _market[vh->second][good.prof];
+        if (units < count * UNITS_PER_ITEM) return true;
+        units -= count * UNITS_PER_ITEM;
+        return false;
+    }
+    return false;
+}
+
+std::string World::ShopsOf(uint32 hub) const
+{
+    auto vit = hubVendors.find(hub);
+    SimSite const* h = SiteById(hub);
+    if (vit == hubVendors.end() || vit->second.empty() || !h) return "";
+    std::array<uint32, PROF_COUNT> g{};
+    if (auto it = _market.find(hub); it != _market.end()) g = it->second;
+    std::string out;
+    for (MarketGood const& good : GOODS)
+        if (uint32 n = ShelfCount(g, good, h->regionLevel))
+            out += Acore::StringFormat("{}{} {}", out.empty() ? "" : ", ", n >= SHELF_CAP ? std::string("plenty of") : std::to_string(n), good.name);
+    return out.empty() ? "the shops have nothing the gatherers brought in" : "In the shops: " + out + ".";
+}
