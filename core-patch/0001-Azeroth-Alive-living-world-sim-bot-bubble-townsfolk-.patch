diff --git a/src/server/game/SoloSim/solosim_camps.cpp b/src/server/game/SoloSim/solosim_camps.cpp
new file mode 100644
index 0000000..cb78140
--- /dev/null
+++ b/src/server/game/SoloSim/solosim_camps.cpp
@@ -0,0 +1,126 @@
+// SoloWoW roadside camps in the game world - see solosim_camps.h.
+#include "solosim_camps.h"
+#include "solosim.h"
+#include "Creature.h"
+#include "GameObject.h"
+#include "Map.h"
+#include "MapMgr.h"
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "TemporarySummon.h"
+#include "UnitScript.h"
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace
+{
+    constexpr uint32 CAMPFIRE = 1798;
+    constexpr float PUT_UP = 300.0f;          // a camp appears when a player comes this close
+    constexpr float TAKE_DOWN = 450.0f;       // and goes when they're this far away
+
+    struct Placed { uint32 map = 0; float x = 0, y = 0; std::vector<ObjectGuid> members; ObjectGuid fire; };
+
+    std::mutex lock;
+    std::map<uint32, Placed> placed;                       // camp id -> what's in the world
+    std::unordered_map<ObjectGuid, uint32> memberOf;       // creature -> camp id
+    std::unordered_set<ObjectGuid> fallen;                 // members whose death went to the sim already
+
+    void TakeDown(Map* map, Placed const& p)
+    {
+        for (ObjectGuid const& g : p.members)
+        {
+            if (Creature* c = map->GetCreature(g)) c->DespawnOrUnsummon();
+            memberOf.erase(g);
+            fallen.erase(g);
+        }
+        if (GameObject* go = map->GetGameObject(p.fire)) go->DespawnOrUnsummon();
+    }
+
+    class solosim_camp_deaths : public UnitScript
+    {
+    public:
+        solosim_camp_deaths() : UnitScript("solosim_camp_deaths", true, { UNITHOOK_ON_UNIT_DEATH }) { }
+
+        void OnUnitDeath(Unit* unit, Unit* killer) override
+        {
+            if (!unit || !unit->IsCreature()) return;
+            uint32 camp = 0;
+            {
+                std::lock_guard<std::mutex> guard(lock);
+                auto it = memberOf.find(unit->GetGUID());
+                if (it == memberOf.end() || !fallen.insert(unit->GetGUID()).second) return;
+                camp = it->second;
+            }
+            std::string by;
+            if (killer)
+            {
+                Unit* who = killer->GetCharmerOrOwnerOrSelf();
+                if (who->IsPlayer() || who->IsNPCBot()) by = who->GetName();
+            }
+            sSoloSim->CampLoss(camp, by);
+        }
+    };
+}
+
+namespace SoloCamps
+{
+    uint32 CampOf(ObjectGuid const& guid)
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        auto it = memberOf.find(guid);
+        return it == memberOf.end() ? 0 : it->second;
+    }
+
+    void Update(Player* player)
+    {
+        Map* map = player->GetMap();
+        if (!map || !map->GetEntry() || !map->GetEntry()->IsContinent()) return;
+        float px = player->GetPositionX(), py = player->GetPositionY();
+        std::vector<SoloSim::SimCamp> camps = sSoloSim->CampsNear(map->GetId(), px, py, TAKE_DOWN);
+        std::lock_guard<std::mutex> guard(lock);
+        // take down camps the player has left behind, or that are gone in the sim (cleared, moved on)
+        for (auto it = placed.begin(); it != placed.end();)
+        {
+            bool keep = it->second.map == map->GetId() && std::hypot(it->second.x - px, it->second.y - py) <= TAKE_DOWN
+                && std::ranges::any_of(camps, [&](SoloSim::SimCamp const& k) { return k.id == it->first; });
+            if (keep) { ++it; continue; }
+            if (it->second.map == map->GetId()) TakeDown(map, it->second);
+            else if (Map* other = sMapMgr->FindMap(it->second.map, 0)) TakeDown(other, it->second);   // the player crossed the sea
+            it = placed.erase(it);
+        }
+        // put up the ones the player is coming near
+        for (SoloSim::SimCamp const& k : camps)
+        {
+            if (placed.contains(k.id) || std::hypot(k.x - px, k.y - py) > PUT_UP) continue;
+            map->LoadGrid(k.x, k.y);
+            Placed p; p.map = map->GetId(); p.x = k.x; p.y = k.y;
+            float z = map->GetHeight(PHASEMASK_NORMAL, k.x, k.y, k.z + 10.0f, true, 40.0f);
+            if (z <= INVALID_HEIGHT) z = k.z;
+            if (GameObject* fire = map->SummonGameObject(CAMPFIRE, k.x, k.y, z, 0.0f, 0, 0, 0, 0, 0))
+                p.fire = fire->GetGUID();
+            for (uint8 i = 0; i < k.alive; ++i)
+            {
+                float ang = float(i) * 2.0f * float(M_PI) / float(k.alive) + float(k.id % 7) * 0.3f;
+                float r = 4.0f + float((k.id + i) % 3) * 1.5f;
+                float x = k.x + r * std::cos(ang), y = k.y + r * std::sin(ang);
+                float cz = map->GetHeight(PHASEMASK_NORMAL, x, y, z + 10.0f, true, 40.0f);
+                if (cz <= INVALID_HEIGHT) cz = z;
+                Position pos(x, y, cz, std::atan2(k.y - y, k.x - x));   // facing the fire
+                if (TempSummon* c = map->SummonCreature(k.entry, pos))
+                {
+                    c->SetHomePosition(pos);
+                    p.members.push_back(c->GetGUID());
+                    memberOf[c->GetGUID()] = k.id;
+                }
+            }
+            placed[k.id] = std::move(p);
+        }
+    }
+
+    void AddScripts() { new solosim_camp_deaths(); }
+}
