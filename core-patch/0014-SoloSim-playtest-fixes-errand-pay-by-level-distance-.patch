+// what's worth passing on at the inn or pinning to the board: who died, who was beaten and by what, fights between the
+// sides, rares, bounties, people coming and going, dreams come true. Not who had a drink with whom (Nov 17).
+static bool Rumorworthy(EventType t)
+{
+    switch (t)
+    {
+        case EventType::Died: case EventType::Defeated: case EventType::Clash: case EventType::RareSlain: case EventType::RareRepelled:
+        case EventType::RareFind: case EventType::BountyPosted: case EventType::BountyDone: case EventType::AmbitionDone:
+        case EventType::LeftRegion: case EventType::Newcomer: case EventType::MovedHome: case EventType::PlayerBounty:
+        case EventType::PlayerHelped: case EventType::FellBeside:
+            return true;
+        default:
+            return false;
+    }
+}
