+        // the talk animation with words to it: small talk for their work, or the town's news - only when someone is near
+        // enough to hear, at most once a minute each (templated lines; Nov 17)
+        void Chatter(Creature* npc)
+        {
+            if (GetMSTimeDiffToNow(_lastSaid) < 60000 && _lastSaid) return;
+            if (!me->SelectNearestPlayer(25.0f) || urand(1, 100) > 40) return;
+            _lastSaid = getMSTime();
+            uint8 job = 0; uint32 agent = _agent;
+            if (SoloSim::SimIntent in; sSoloSim->Intent(agent, in)) job = in.job;
+            if (urand(1, 100) <= 35)
+            {
+                std::string news = sSoloSim->Rumor(agent);
+                if (!news.empty()) { me->Say(news, LANG_UNIVERSAL); return; }
+            }
+            static char const* const any[] = {
+                "Morning. Or is it afternoon already? Days run together.", "Prices are up again. Don't ask me why.",
