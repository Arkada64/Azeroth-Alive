+// ---- the auction houses (Nov 18) ------------------------------------------------------------------------------
+void World::TakeListings(std::vector<MarketListing>& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    out.swap(_toList);
+    _toList.clear();
+}
+
+uint32 World::MarketBuyer(bool horde, uint32 price, uint8 minLevel, uint64 salt)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (_agents.empty()) return 0;
+    // look over a few hundred people from a random place in the roll: someone of that side, of the level for it, with
+    // the coin to spare
+    Rng r(_seed, uint32(salt), _clock, P_GEN + 960);
+    auto it = _agents.lower_bound(r.Range(1, _nextAgent));
+    for (uint32 n = 0; n < 300; ++n, ++it)
+    {
+        if (it == _agents.end()) it = _agents.begin();
+        SimAgent& a = it->second;
+        if (a.role != ROLE_ADVENTURER || a.status != AgentStatus::Active || IsHordeRace(a.race) != horde) continue;
+        if (a.level < minLevel || a.level > minLevel + 12) continue;          // what they'd use, at about their level
+        if (a.money < price + price / 2) continue;                             // and still eat afterwards
+        a.money -= price;
+        return a.id;
+    }
+    return 0;
+}
+
+void World::MarketSold(uint32 agentId, uint32 money)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (SimAgent* a = AgentById(agentId)) a->money += money;
+}
+
+uint32 World::AdventurersInBand(bool horde, uint8 band)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    if (_bandAt != _clock / MIN_PER_HOUR || !_bandAt)
+    {
+        _bandAt = std::max<SimTime>(1, _clock / MIN_PER_HOUR);
+        for (auto& side : _bandCount) side.fill(0);
+        for (auto const& [id, a] : _agents)
+            if (a.role == ROLE_ADVENTURER && (a.status == AgentStatus::Active || a.status == AgentStatus::Recovering))
+                ++_bandCount[IsHordeRace(a.race) ? 1 : 0][std::min<uint32>(8, a.level / 10)];
+    }
+    return _bandCount[horde ? 1 : 0][std::min<uint32>(8, band)];
+}
