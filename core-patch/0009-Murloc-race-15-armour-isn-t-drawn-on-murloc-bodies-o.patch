Subject: [PATCH 09/14] Murloc race (15): armour isn't drawn on murloc bodies,
 only weapons

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JU37XfnHTvru3VVz2sNN7z
---
 src/server/game/SoloSim/solosim_commands.cpp |  2 ++
 src/server/game/SoloSim/solosim_races.cpp    | 30 ++++++++++++++++++++
 2 files changed, 32 insertions(+)
 create mode 100644 src/server/game/SoloSim/solosim_races.cpp

diff --git a/src/server/game/SoloSim/solosim_commands.cpp b/src/server/game/SoloSim/solosim_commands.cpp
index 3f9b3ab..d3e0086 100644
--- a/src/server/game/SoloSim/solosim_commands.cpp
+++ b/src/server/game/SoloSim/solosim_commands.cpp
@@ -281,10 +281,12 @@ public:
 };
 
 namespace SoloPlainsrunning { void AddScripts(); }
+namespace SoloRaces { void AddScripts(); }
 void AddSC_solosim_xp();
 
 void AddSC_solosim_commands()
 {
