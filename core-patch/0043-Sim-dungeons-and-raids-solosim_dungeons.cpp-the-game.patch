+// ---- a found or won item (Nov 18: dungeon loot) ------------------------------------------------------------------
+namespace
+{
+    std::vector<uint8> SlotsFor(ItemTemplate const* p)
+    {
+        switch (p->InventoryType)
+        {
+            case INVTYPE_HEAD: return { BOT_SLOT_HEAD };
+            case INVTYPE_NECK: return { BOT_SLOT_NECK };
+            case INVTYPE_SHOULDERS: return { BOT_SLOT_SHOULDERS };
+            case INVTYPE_CLOAK: return { BOT_SLOT_BACK };
+            case INVTYPE_CHEST: case INVTYPE_ROBE: return { BOT_SLOT_CHEST };
+            case INVTYPE_WAIST: return { BOT_SLOT_WAIST };
+            case INVTYPE_LEGS: return { BOT_SLOT_LEGS };
+            case INVTYPE_FEET: return { BOT_SLOT_FEET };
+            case INVTYPE_WRISTS: return { BOT_SLOT_WRIST };
+            case INVTYPE_HANDS: return { BOT_SLOT_HANDS };
+            case INVTYPE_FINGER: return { BOT_SLOT_FINGER1, BOT_SLOT_FINGER2 };
+            case INVTYPE_TRINKET: return { BOT_SLOT_TRINKET1, BOT_SLOT_TRINKET2 };
+            case INVTYPE_WEAPON: return { BOT_SLOT_MAINHAND, BOT_SLOT_OFFHAND };
+            case INVTYPE_2HWEAPON: case INVTYPE_WEAPONMAINHAND: return { BOT_SLOT_MAINHAND };
+            case INVTYPE_WEAPONOFFHAND: case INVTYPE_SHIELD: case INVTYPE_HOLDABLE: return { BOT_SLOT_OFFHAND };
+            case INVTYPE_RANGED: case INVTYPE_THROWN: case INVTYPE_RANGEDRIGHT: case INVTYPE_RELIC: return { BOT_SLOT_RANGED };
+            default: return {};
+        }
+    }
+    int32 Worth(ItemTemplate const* p) { static int32 const q[] = { -5, 0, 3, 7, 13, 20, 20, 20 }; return int32(p->ItemLevel) + q[std::min<uint32>(p->Quality, 7)]; }
+}
+
+int32 Gain(uint8 cls, uint8 level, std::string const& kit, uint32 entry, uint8* slotOut)
+{
+    ItemTemplate const* p = sObjectMgr->GetItemTemplate(entry);
+    if (!p || cls < BOT_CLASS_WARRIOR || cls > BOT_CLASS_DRUID || cls == BOT_CLASS_DEATH_KNIGHT) return INT32_MIN;
+    std::map<uint8, uint32> have;
+    for (Piece const& g : Parse(kit)) have[g.slot] = g.entry;
+    ItemTemplate const* mh = have.contains(BOT_SLOT_MAINHAND) ? sObjectMgr->GetItemTemplate(have[BOT_SLOT_MAINHAND]) : nullptr;
+    int32 best = INT32_MIN;
+    for (uint8 s : SlotsFor(p))
+    {
+        if (!SlotOpen(s, cls, level) || !bot_ai::CanEquipFor(cls, level, BOT_SPEC_DEFAULT, CanRanged(cls), p, s)) continue;
+        if (s == BOT_SLOT_OFFHAND && mh && mh->InventoryType == INVTYPE_2HWEAPON) continue;
+        if (have.contains(s) && have[s] == entry) continue;                       // the very same piece already
+        ItemTemplate const* cur = have.contains(s) ? sObjectMgr->GetItemTemplate(have[s]) : nullptr;
+        int32 g = Worth(p) - (cur ? Worth(cur) : 0);
+        if (g > best) { best = g; if (slotOut) *slotOut = s; }
+    }
+    return best;
+}
+
+bool Equip(uint8 cls, uint8 level, std::string& kit, uint32 entry, int32 suffix, std::vector<std::pair<uint32, int32>>* off)
+{
+    uint8 slot = 0;
+    if (Gain(cls, level, kit, entry, &slot) <= 0) return false;
+    std::map<uint8, Piece> bySlot;
+    for (Piece const& g : Parse(kit)) bySlot[g.slot] = g;
+    if (auto it = bySlot.find(slot); it != bySlot.end() && off) off->emplace_back(it->second.entry, it->second.suffix);
+    Piece g; g.slot = slot; g.entry = entry; g.suffix = suffix;
+    bySlot[slot] = g;
+    if (ItemTemplate const* p = sObjectMgr->GetItemTemplate(entry); p && slot == BOT_SLOT_MAINHAND && p->InventoryType == INVTYPE_2HWEAPON)
+        if (auto oh = bySlot.find(BOT_SLOT_OFFHAND); oh != bySlot.end()) { if (off) off->emplace_back(oh->second.entry, oh->second.suffix); bySlot.erase(oh); }
+    kit.clear();
+    for (auto const& [s, x] : bySlot)
+        kit += (kit.empty() ? "" : ",") + std::to_string(uint32(s)) + ":" + std::to_string(x.entry) + ":" + std::to_string(x.suffix) + ":" + std::to_string(x.enchant);
+    return true;
+}
