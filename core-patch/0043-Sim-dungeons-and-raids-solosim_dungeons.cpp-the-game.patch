+// SoloWoW: dungeons and raids in the sim (Nov 18) - the user's design.
+//
+// The dungeons are the game's own: every teleport into a dungeon or raid map from the four continents is an entrance,
+// with its level range (the creatures inside), its bosses (rank boss, or marked a dungeon boss) and their real loot
+// tables. A party of the right level, of one side, gathers at the town nearest the entrance, walks in and is gone from
+// the world while inside. The run is played boss by boss against their levels, kits and numbers: a boss down gives XP,
+// coin and its loot, rolled from its own tables; a wipe ends the run - wounds, and now and then a defeat (the dungeon
+// scale: far kinder than the open world). Raids: companies of the raid's size, of one side, at its level, go once in a
+// while; boss by boss the same way; raid deaths never count.
+//
+// Loot rolls: each member needs (the item fits their class and beats what they wear), greeds (by character, or coin) or
+// passes; the highest need wins, then the highest greed. A winner who needed puts it on (what came off goes to the
+// auction house or a vendor); a greed winner sells it - at the auction house if it's not bound, else to a vendor.
+#include "solosim.h"
+#include "solosim_gear.h"
+#include "DBCStores.h"
+#include "DatabaseEnv.h"
+#include "Field.h"
+#include "Item.h"
+#include "Log.h"
+#include "ObjectMgr.h"
+#include "QueryResult.h"
+#include "Formulas.h"
+#include "MapMgr.h"
+#include <algorithm>
+#include <set>
+
+namespace SoloSim
+{
+namespace
+{
+    struct LootRow { uint32 item = 0, reference = 0; float chance = 0; uint8 group = 0; uint8 minCount = 1, maxCount = 1; };
+    std::unordered_map<uint32, std::vector<LootRow>> creatureLoot, referenceLoot;
+
+    void LoadLoot(std::set<uint32> const& ids)
+    {
+        if (ids.empty()) return;
+        std::string list;
+        for (uint32 id : ids) list += (list.empty() ? "" : ",") + std::to_string(id);
+        auto read = [](QueryResult r, std::unordered_map<uint32, std::vector<LootRow>>& into) {
+            if (!r) return;
+            do
+            {
+                Field* f = r->Fetch();
+                if (f[4].Get<bool>()) continue;                         // quest items: not for the sim
+                LootRow l; l.item = f[1].Get<uint32>(); l.reference = f[2].Get<uint32>(); l.chance = f[3].Get<float>();
+                l.group = f[5].Get<uint8>(); l.minCount = f[6].Get<uint8>(); l.maxCount = f[7].Get<uint8>();
+                into[f[0].Get<uint32>()].push_back(l);
+            } while (r->NextRow());
+        };
+        read(WorldDatabase.Query("SELECT Entry, Item, Reference, Chance, QuestRequired, GroupId, MinCount, MaxCount FROM creature_loot_template WHERE Entry IN ({})", list), creatureLoot);
+        read(WorldDatabase.Query("SELECT Entry, Item, Reference, Chance, QuestRequired, GroupId, MinCount, MaxCount FROM reference_loot_template"), referenceLoot);
+    }
+
+    // the core's way, roughly: ungrouped rows roll each on their own; a group gives one of its rows (the explicit
+    // chances first, then an equal share of the rest); a reference rolls its own table
+    void Roll(std::vector<LootRow> const& rows, Rng& r, std::vector<uint32>& out, uint32 depth)
+    {
+        if (depth > 4) return;
+        std::map<uint8, std::vector<LootRow const*>> groups;
+        for (LootRow const& l : rows)
+        {
+            if (l.group) { groups[l.group].push_back(&l); continue; }
+            if (!r.Chance(std::max(0.0f, l.chance) / 100.0f)) continue;
+            if (l.reference)
+            {
+                if (auto it = referenceLoot.find(l.reference); it != referenceLoot.end())
+                    for (uint32 n = 0; n < std::max<uint32>(1, l.maxCount); ++n) Roll(it->second, r, out, depth + 1);
+            }
+            else out.push_back(l.item);
+        }
+        for (auto const& [g, list] : groups)
+        {
+            LootRow const* pick = nullptr;
+            float roll = r.Float() * 100.0f, explicitSum = 0.0f;
+            std::vector<LootRow const*> equal;
+            for (LootRow const* l : list)
+            {
+                if (l->chance > 0.0f) { explicitSum += l->chance; if (!pick && roll < explicitSum) pick = l; }
+                else equal.push_back(l);
+            }
+            if (!pick && !equal.empty() && explicitSum < 100.0f) pick = equal[r.Range(0, uint32(equal.size()) - 1)];
+            if (!pick) continue;
+            if (pick->reference)
+            {
+                if (auto it = referenceLoot.find(pick->reference); it != referenceLoot.end()) Roll(it->second, r, out, depth + 1);
+            }
+            else out.push_back(pick->item);
+        }
+    }
+}
+
+// ---- the catalogue -------------------------------------------------------------------------------------------------
+void World::BuildDungeons()
+{
+    _dungeonsBuilt = true;
+    _dungeons.clear();
+    std::set<uint32> seen;
+    for (uint32 i = 1; i < 8000; ++i)                                    // 3.3.5's trigger ids stay below this
+    {
+        AreaTrigger const* at = sObjectMgr->GetAreaTrigger(i);
+        AreaTriggerTeleport const* tp = sObjectMgr->GetAreaTriggerTeleport(i);
+        if (!at || !tp || !SimMap(at->map) || seen.contains(tp->target_mapId)) continue;
+        MapEntry const* me = sMapStore.LookupEntry(tp->target_mapId);
+        if (!me || !me->IsDungeon() || me->IsBattlegroundOrArena()) continue;
+        seen.insert(tp->target_mapId);
+        SimDungeon d;
+        d.map = tp->target_mapId; d.name = me->name[0]; d.outMap = at->map; d.x = at->x; d.y = at->y; d.z = at->z;
+        d.raid = me->IsRaid();
+        if (MapDifficulty const* md = GetMapDifficultyData(d.map, REGULAR_DIFFICULTY)) d.size = md->maxPlayers;
+        if (!d.size) d.size = d.raid ? 40 : 5;
+        _dungeons.push_back(std::move(d));
+    }
+    // levels and bosses from the creatures inside
+    std::map<uint32, SimDungeon*> byMap;
+    for (SimDungeon& d : _dungeons) byMap[d.map] = &d;
+    std::map<uint32, std::vector<uint8>> levels;
+    std::map<uint32, std::set<uint32>> bossSeen;
+    std::set<uint32> lootIds;
+    for (auto const& [guid, data] : sObjectMgr->GetAllCreatureData())
+    {
+        auto it = byMap.find(data.mapid);
+        if (it == byMap.end()) continue;
+        CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(data.id);
+        if (!t || t->npcflag || t->type == CREATURE_TYPE_CRITTER) continue;
+        bool boss = t->rank == CREATURE_ELITE_WORLDBOSS || (t->flags_extra & CREATURE_FLAG_EXTRA_DUNGEON_BOSS);
+        if (!boss) { levels[data.mapid].push_back(t->minlevel); continue; }
+        if (!bossSeen[data.mapid].insert(t->Entry).second) continue;
+        SimDungeon& d = *it->second;
+        if (d.bosses.size() >= (d.raid ? 15u : 10u)) continue;
+        d.bosses.push_back({ t->Entry, t->Name, uint8(std::min<uint32>(t->maxlevel, 83)), t->lootid });
+        if (t->lootid) lootIds.insert(t->lootid);
+    }
+    for (SimDungeon& d : _dungeons)
+    {
+        std::vector<uint8>& l = levels[d.map];
+        if (l.empty()) continue;
+        std::ranges::sort(l);
+        d.lo = l[l.size() / 10]; d.hi = l[l.size() * 9 / 10];
+    }
+    std::erase_if(_dungeons, [](SimDungeon const& d) { return d.bosses.empty() || !d.lo; });
+    LoadLoot(lootIds);
+    uint32 raids = uint32(std::ranges::count_if(_dungeons, [](SimDungeon const& d) { return d.raid; }));
+    LOG_INFO("server.loading", "SoloWoW sim: {} dungeons and {} raids the sim's people can go into ({} boss loot tables)",
+        uint32(_dungeons.size()) - raids, raids, uint32(lootIds.size()));
+}
+
+// ---- going in --------------------------------------------------------------------------------------------------------
+// every six sim-hours: a few parties for the dungeons, now and then a raid company
+void World::DelveTick()
+{
+    if (!_dungeonsBuilt) BuildDungeons();
+    Rng r(_seed, uint32(_clock), _clock, 9970);
+    for (uint32 di = 0; di < _dungeons.size(); ++di)
+    {
+        SimDungeon const& d = _dungeons[di];
+        if (!r.Chance(d.raid ? 0.03f : 0.15f)) continue;            // (Nov 18 test: 0.35 sent ~190 parties in 61 hours)
+        bool horde = r.Chance(0.5f);
+        uint8 lo = d.lo > 1 ? d.lo - 1 : 1, hi = uint8(d.hi + (d.raid ? 3 : 1));
+        // who could go: free, fit, of the side and level, not near the player
+        std::vector<std::pair<uint32, uint32>> fit;                  // (travel minutes, agent)
+        for (auto& [id, a] : _agents)
+        {
+            if (a.role != ROLE_ADVENTURER || a.status != AgentStatus::Active || IsHordeRace(a.race) != horde) continue;
+            if (a.level < lo || a.level > hi || a.wounds > 30 || a.fatigue > 60 || a.caravan || a.follow || a.doing == Verb::Delve) continue;
+            if (auto s = _lastSeen.find(id); s != _lastSeen.end() && _clock - s->second < 30) continue;
+            SimSite const* here = SiteById(a.site);
+            if (!here || (!d.raid && here->map != d.outMap)) continue;   // dungeons: someone on the same continent
+            fit.emplace_back(0, id);
+        }
+        if (fit.size() < (d.raid ? d.size * 3 / 4 : 4u)) continue;
+        uint32 town = DockTown(d.outMap, d.x, d.y, _agents.at(fit.front().second), 4000.0f);
+        if (!town) continue;
+        for (auto& [m, id] : fit) m = TravelMinutes(_agents.at(id).site, town, _agents.at(id));
+        std::ranges::sort(fit);
+        uint32 want = std::min<uint32>(d.size, uint32(fit.size()));
+        if (!d.raid && want > 5) want = 5;
+        std::vector<uint32> members;
+        for (auto const& [m, id] : fit) { if (members.size() >= want || m > (d.raid ? 600u : 150u)) break; members.push_back(id); }
+        if (members.size() < (d.raid ? d.size * 3 / 4 : 4u)) continue;
+        // all gather, then go in together: the run ends at the same time for everyone
+        uint32 gather = 0;
+        for (uint32 id : members) gather = std::max(gather, TravelMinutes(_agents.at(id).site, town, _agents.at(id)));
+        uint32 inside = uint32(d.bosses.size()) * (d.raid ? 25 : 15) + 40;
+        SimRun run; run.id = _nextRun++; run.dungeon = di; run.members = members; run.end = _clock + gather + inside;
+        for (uint32 id : members)
+        {
+            SimAgent& a = _agents.at(id);
+            uint32 walk = TravelMinutes(a.site, town, a);
+            a.plan.clear(); a.party = 0; a.bounty = 0;
+            if (a.site != town && walk) a.plan.push_back({ Verb::Goto, town, walk, false });
+            a.plan.push_back({ Verb::Delve, town, std::max<uint32>(1, uint32(run.end - _clock) - (a.site != town ? walk : 0)), false });
+            a.doing = a.plan.front().verb; a.wakeAt = _clock + std::max<uint32>(1, a.plan.front().minutes);
+            _runOf[id] = run.id;
+            _requeue.push_back(id);
+        }
+        Log(EventType::DungeonRun, _agents.at(members.front()), town, Acore::StringFormat("{} gathered at {}{} to go into {}.",
+            d.raid ? Acore::StringFormat("A company of {}", members.size()) : PartyNames(members), SiteName(town),
+            d.raid ? "" : "", d.name), d.raid);
+        _runs[run.id] = std::move(run);
+    }
+}
+
+std::string World::PartyNames(std::vector<uint32> const& ids) const
+{
+    std::vector<std::string> n;
+    for (uint32 id : ids) if (auto it = _agents.find(id); it != _agents.end()) n.push_back(it->second.FullName());
+    if (n.empty()) return "Someone";
+    std::string s = n[0];
+    for (size_t i = 1; i < n.size(); ++i) s += (i + 1 == n.size() ? " and " : ", ") + n[i];
+    return s;
+}
+
+// a member's run is over (their Delve step ended): the first to finish plays it out for all
+void World::FinishDelve(SimAgent& a)
+{
+    auto ro = _runOf.find(a.id);
+    if (ro == _runOf.end()) return;                                   // a run from before a restart: nothing to tell
+    uint32 runId = ro->second;
+    _runOf.erase(ro);
+    auto it = _runs.find(runId);
+    if (it == _runs.end()) return;
+    if (!it->second.resolved) ResolveRun(it->second);
+    if (std::ranges::none_of(it->second.members, [this](uint32 m) { return _runOf.contains(m); })) _runs.erase(it);
+}
+
+void World::ResolveRun(SimRun& run)
+{
+    run.resolved = true;
+    SimDungeon const& d = _dungeons[run.dungeon];
+    std::vector<SimAgent*> party;
+    for (uint32 id : run.members)
+        if (SimAgent* a = AgentById(id); a && a->status == AgentStatus::Active) party.push_back(a);
+    if (party.empty()) return;
+    Rng r(_seed, run.id, _clock, 8970);
+    uint32 down = 0;
+    std::vector<std::string> notes;
+    for (uint32 bi = 0; bi < d.bosses.size(); ++bi)
+    {
+        SimBoss const& b = d.bosses[bi];
+        // the party's strength against what the boss asks of a full group of its level; the last bosses ask more
+        float power = 0;
+        for (SimAgent* m : party) power += float(m->level) * 4.0f + m->gearTier / 10.0f;
+        float need = float(d.size) * (float(b.level) * 4.0f + 5.0f) * (1.0f + 0.04f * float(bi));
+        float chance = std::clamp(0.8f + 2.0f * (power / std::max(1.0f, need) - 1.0f), 0.05f, 0.97f);
+        if (!r.Chance(chance))
+        {
+            // a wipe: everyone hurt, the run over; a defeat for some (never in a raid)
+            for (SimAgent* m : party)
+            {
+                m->wounds = uint8(std::min<uint32>(100, m->wounds + 45));
+                if (!d.raid && r.Chance(0.15f))
+                    if (SimSite const* s = SiteById(m->site)) { float keep = _deathScale; _deathScale = 0.15f; Defeat(*m, *s); _deathScale = keep; }
+            }
+            notes.push_back(Acore::StringFormat("{} beat them back", b.name));
+            break;
+        }
+        ++down;
+        // XP and coin for each, as for an elite and the packs before it
+        for (SimAgent* m : party)
+        {
+            if (m->status != AgentStatus::Active) continue;
+            float band = BandXP(m->level, false);
+            uint32 xp = uint32(Acore::XP::BaseGain(m->level, b.level, CONTENT_1_60) * 6.0f * (band >= 0.0f ? band : 1.0f) / (d.raid ? 4.0f : 1.0f));
+            m->xp += xp;
+            while (m->level < 80 && m->xp >= sObjectMgr->GetXPForLevel(m->level)) { m->xp -= sObjectMgr->GetXPForLevel(m->level); ++m->level; m->gearDue = uint8(std::min<uint32>(6, m->gearDue + 1u)); }
+            m->money += uint32(b.level) * b.level * 3 / uint32(party.size()) + 10;
+        }
+        // the loot, and the rolls
+        std::vector<uint32> drops;
+        if (auto lt = creatureLoot.find(b.lootId); lt != creatureLoot.end()) Roll(lt->second, r, drops, 0);
+        for (uint32 entry : drops)
+        {
+            ItemTemplate const* p = sObjectMgr->GetItemTemplate(entry);
+            if (!p || (p->Class != ITEM_CLASS_WEAPON && p->Class != ITEM_CLASS_ARMOR)) continue;
+            if (p->Quality < ITEM_QUALITY_UNCOMMON) continue;
+            SimAgent* winner = nullptr; int32 best = -1; bool needed = false;
+            for (SimAgent* m : party)
+            {
+                if (m->status != AgentStatus::Active) continue;
+                int32 gain = SoloGear::Gain(m->cls, m->level, m->gear, entry);
+                bool need = gain > 2;
+                bool greed = !need && (m->greed > 45 || p->SellPrice > uint32(m->level) * m->level * 20);
+                if (!need && !greed) continue;                           // pass
+                int32 roll = int32(r.Range(1, 100)) + (need ? 1000 : 0);
+                if (roll > best) { best = roll; winner = m; needed = need; }
+            }
+            if (!winner) continue;
+            int32 suffix = Item::GenerateItemRandomPropertyId(entry);
+            std::vector<std::pair<uint32, int32>> off;
+            bool sell = true;
+            if (needed && SoloGear::Equip(winner->cls, winner->level, winner->gear, entry, suffix, &off)) { TierFromKit(*winner); sell = false; }
+            else off.emplace_back(entry, suffix);
+            SimSite const* at = SiteById(winner->site);
+            for (auto const& [oe, os] : off)
+                if (ItemTemplate const* op = sObjectMgr->GetItemTemplate(oe))
+                {
+                    if (op->Quality >= ITEM_QUALITY_UNCOMMON && op->Bonding != BIND_WHEN_PICKED_UP && _toList.size() < 2000)
+                        _toList.push_back({ winner->id, oe, os, winner->greed, IsHordeRace(winner->race), at && at->side == SIDE_NEUTRAL });
+                    else winner->money += op->SellPrice;
+                }
+            if (p->Quality >= ITEM_QUALITY_RARE && notes.size() < 4)
+                notes.push_back(Acore::StringFormat("{} dropped {}, {} by {}", b.name, p->Name1, sell ? "sold on" : "won", winner->FullName()));
+        }
+    }
+    for (SimAgent* m : party) { m->fatigue = uint8(std::min<uint32>(100, m->fatigue + 30)); m->plan.clear(); }
+    std::string who = d.raid ? Acore::StringFormat("A company of {}", party.size()) : PartyNames(run.members);
+    std::string how = down == d.bosses.size() ? Acore::StringFormat("cleared {}", d.name)
+                    : down ? Acore::StringFormat("fought through {} of {}'s {} bosses", down, d.name, d.bosses.size())
+                           : Acore::StringFormat("went into {} and came straight back out", d.name);
+    std::string text = who + " " + how;
+    for (size_t i = 0; i < notes.size(); ++i) text += (i == 0 ? ": " : "; ") + notes[i];
+    Log(EventType::DungeonRun, *party.front(), party.front()->site, text + ".", true, 0, int32(down), int32(d.bosses.size()));
+}
