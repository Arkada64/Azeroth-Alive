+    switch (a->ambition)
+    {
+        case AmbitionType::SaveGold:
+            if (a->ambitionTarget > a->money)
+                opts.push_back({ a->greed > 60 ? 3.0f : 1.0f, ACT_HOPE, Pick(std::vector<std::string>{ MoneyText(a->ambitionTarget - a->money) + " more and I'm done with all this.",
+                    "Every copper counts. " + MoneyText(a->ambitionTarget - a->money) + " to go.", "One good haul. That's all I need." }, r), 0, 0 });
