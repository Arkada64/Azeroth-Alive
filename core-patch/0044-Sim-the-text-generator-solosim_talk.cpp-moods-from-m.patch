+// ---- what's on their mind --------------------------------------------------------------------------------------------
+uint8 World::MoodOf(SimAgent const& a) const
+{
+    int32 grief = 0, anger = 0, pride = 0;
+    for (SimMemory const& m : _memories)
+    {
+        if (m.agent != a.id || _clock - m.at > 2 * MIN_PER_DAY) continue;
+        switch (EventType(m.eventType))
+        {
+            case EventType::Died: case EventType::HeardDeath: case EventType::FellBeside: grief += m.intensity; break;
+            case EventType::Clash: case EventType::Defeated: anger += m.intensity; break;
+            case EventType::RareSlain: case EventType::BountyDone: case EventType::AmbitionDone: pride += m.intensity; break;
+            default: break;
+        }
+    }
+    if (auto it = _lastRunOf.find(a.id); it != _lastRunOf.end() && _clock - it->second.at < MIN_PER_DAY)
+        (it->second.down == it->second.total ? pride : anger) += 60;
+    if (grief >= 60) return MOOD_GRIEVING;
+    if (a.wounds >= 60) return MOOD_HURT;
+    if (anger >= 60) return MOOD_ANGRY;
+    if (pride >= 60) return a.bravery > 55 ? MOOD_PROUD : MOOD_HAPPY;
+    if (a.fatigue >= 75) return MOOD_TIRED;
+    if (a.caution > 65 && !WorryLine(a).empty()) return MOOD_SCARED;
+    if (a.sociability < 30 && a.wanderlust > 60) return MOOD_BORED;
+    return a.sociability > 60 ? MOOD_HAPPY : MOOD_CONTENT;
+}
