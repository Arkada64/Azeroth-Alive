+        if (pick->act == ACT_WARN && a->bravery > 75) text += Pick(std::vector<std::string>{ " Somebody ought to deal with it. Maybe me.", " I've half a mind to go myself.", "" }, r);
+        if (pick->act == ACT_GRUMBLE && mood == MOOD_ANGRY) text = Pick(v.curse, r) + " " + text;
+        if (pick->act == ACT_WARN && mood == MOOD_SCARED) text += " " + Pick(v.fear, r);
+        if (r.Chance(0.35f)) text = WithTag(text, Pick(v.tag, r));
+    }
+    out.text = text; out.act = pick->act; out.topic = pick->topic; out.emote = pick->emote;
+    out.yell = (pick->act == ACT_BOAST && mood == MOOD_PROUD && a->bravery > 70 && r.Chance(0.2f))
+            || (pick->act == ACT_WARN && a->bravery > 70 && r.Chance(0.12f));
+    return out;
+}
+
+// the listener answers: by what they know, how they feel about the speaker, and how the speaker seems
+World::TalkLine World::TalkReply(uint32 replierId, uint32 speakerId, TalkLine const& said)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    TalkLine out;
+    SimAgent const* b = AgentById(replierId);
+    SimAgent const* a = AgentById(speakerId);
+    if (!b || !a || said.text.empty() || b->status != AgentStatus::Active || b->doing == Verb::Sleep) return out;
+    if (IsHordeRace(a->race) != IsHordeRace(b->race) && (a->role == ROLE_ADVENTURER || b->role == ROLE_ADVENTURER)) return out;
+    Rng r(_seed, replierId, _clock * 17 + speakerId, 9981);
+    Voice const& v = VoiceOf(b->race);
+    int8 kind = 0;
+    for (SimRelation const& rel : _relations)
+        if ((rel.a == a->id && rel.b == b->id) || (rel.b == a->id && rel.a == b->id)) { kind = int8(rel.kind); break; }
+    bool friendly = kind == 1 || kind == 3, rival = kind == 2;
+    out.act = ACT_REPLY;
+    switch (said.act)
+    {
+        case ACT_GOSSIP:
+            if (b->home == a->home) { out.text = Pick(v.agree, r) + Pick(std::vector<std::string>{ " I heard the same.", " Everyone's talking about it.", "" }, r); out.emote = EMOTE_ONESHOT_YES; }
+            else { out.text = Pick(v.surprise, r); out.emote = EMOTE_ONESHOT_EXCLAMATION; }
+            break;
+        case ACT_WARN:
+            out.text = b->bravery > 70 ? Pick(std::vector<std::string>{ "Let them come.", "I'd like to see them try.", "Sounds like work. Paid work, I hope." }, r)
+                     : b->caution > 60 ? Pick(v.fear, r) + Pick(std::vector<std::string>{ " I'll bar the door tonight.", " I'm staying in.", "" }, r)
+                     : Pick(v.agree, r);
+            out.emote = b->bravery > 70 ? EMOTE_ONESHOT_FLEX : 0;
+            break;
+        case ACT_BOAST:
+            if (rival) { out.text = Pick(std::vector<std::string>{ "Lucky.", "I'd have done it faster.", "And I'm the Prince of Stormwind.", "Hah. Sure." }, r); out.emote = EMOTE_ONESHOT_LAUGH; }
+            else { out.text = Pick(v.cheer, r); out.emote = friendly ? EMOTE_ONESHOT_APPLAUD : EMOTE_ONESHOT_CHEER; }
+            break;
+        case ACT_LAMENT:
+        {
+            out.text = Pick(v.sorry, r);
+            if (SimAgent const* d = said.topic ? AgentById(said.topic) : nullptr; d && d->home == b->home)
+                out.text += Pick(std::vector<std::string>{ " " + d->given + " was one of the good ones.", " I'll miss " + d->given + ", too.", "" }, r);
+            break;
+        }
+        case ACT_GRUMBLE:
+            out.text = rival ? Pick(std::vector<std::string>{ "Serves you right.", "Cry me a river.", "Maybe stay home next time." }, r)
+                             : Pick(std::vector<std::string>{ "Rough luck.", "You'll mend.", "Could've been worse. Could always be worse.", "Have a drink. On me." }, r);
+            out.emote = rival ? EMOTE_ONESHOT_LAUGH : 0;
+            break;
+        case ACT_HOPE:
+            out.text = b->caution > 60 ? Pick(std::vector<std::string>{ "Don't get yourself killed doing it.", "Careful what you wish for.", "Hm. If you say so." }, r)
+                                       : Pick(std::vector<std::string>{ "You'll get there.", "I'll drink to that.", "Take me with you." }, r);
+            break;
+        case ACT_GREET:
+            out.text = Fill(Pick(v.hello, r), a->given);
+            out.emote = EMOTE_ONESHOT_WAVE;
+            break;
+        case ACT_JAB:
+            out.text = Fill(Pick(v.scorn, r), a->given);
+            out.emote = r.Chance(0.4f) ? EMOTE_ONESHOT_RUDE : 0;
+            break;
+        default: return out;
+    }
+    if (b->sociability > 70 && r.Chance(0.3f)) out.text = WithTag(out.text, Pick(v.tag, r));
+    return out;
+}
+
+// the danger near their town, in their words (TownWorry without the lock)
+std::string World::WorryLine(SimAgent const& a) const
+{
+    SimSite const* home = SiteById(a.home);
+    if (!home) return "";
+    SimCamp const* closest = nullptr; float best = 1500.0f;
+    for (SimCamp const& k : _camps)
+        if (!k.done && k.kind != CAMP_HERD && k.map == home->map)
+            if (float d = Dist2d(k.x, k.y, home->x, home->y); d < best) { best = d; closest = &k; }
+    Rng r(_seed, a.id, _clock / 60, 9982);
+    for (auto const& [id, o] : _agents)
+        if (o.role == ROLE_THREAT && o.status == AgentStatus::Active)
+            if (SimSite const* s = SiteById(o.site); s && s->map == home->map && Dist2d(s->x, s->y, home->x, home->y) < 2000.0f)
+                return Acore::StringFormat(r.Chance(0.5f) ? "They say {} has been seen closest {}. Nobody's going that way." : "{} - closest {}, they say. Lock your door tonight.",
+                    o.FullName(), AreaText(SiteName(o.site)));
+    if (!closest) return "";
+    std::string where = AreaText(SiteName(closest->site));
+    if (closest->kind == CAMP_PACK)
+        return Acore::StringFormat(closest->alive <= 2 ? "Something's been taking sheep closest {}. A {}, maybe two." : "{} about closest {}. Keep the little ones in after dark.",
+            closest->alive <= 2 ? where : PluralText(closest->name), closest->alive <= 2 ? closest->name : where);
+    static char const* const band[] = { "There's a {} camp off the road closest {}. Nobody goes that way after dark.",
+        "{} - a whole camp of them, closest {}. Someone ought to do something.", "My cousin saw a {} camp by the road closest {}. Bold as anything." };
+    return Acore::StringFormat(band[r.Range(0, 2)], closest->name, where);
+}
+
+std::string World::TalkSample(uint32 n)
+{
+    std::vector<std::pair<uint32, uint32>> pairs;
+    {
+        std::lock_guard<std::mutex> guard(sBodyLock);
+        std::map<uint32, std::vector<uint32>> byTown;
+        for (auto const& [id, a] : _agents)
+            if (a.status == AgentStatus::Active && a.doing != Verb::Sleep && a.role != ROLE_THREAT) byTown[a.site].push_back(id);
+        Rng r(_seed, n, _clock, 9983);
+        std::vector<uint32> towns;
+        for (auto const& [t, v] : byTown) if (v.size() >= 2) towns.push_back(t);
+        for (uint32 i = 0; i < n * 3 && pairs.size() < n && !towns.empty(); ++i)
+        {
+            auto const& v = byTown[towns[r.Range(0, uint32(towns.size()) - 1)]];
+            uint32 a = v[r.Range(0, uint32(v.size()) - 1)], b = v[r.Range(0, uint32(v.size()) - 1)];
+            if (a != b) pairs.emplace_back(a, b);
+        }
+    }
+    static char const* const moods[] = { "content", "happy", "proud", "grieving", "angry", "scared", "hurt", "tired", "bored" };
+    std::string out;
+    for (auto const& [a, b] : pairs)
+    {
+        TalkLine said = Talk(a, b);
+        if (said.text.empty()) continue;
+        TalkLine back = TalkReply(b, a, said);
+        std::string an, bn;
+        {
+            std::lock_guard<std::mutex> guard(sBodyLock);
+            if (SimAgent const* x = AgentById(a)) an = Acore::StringFormat("{} ({} {})", x->FullName(), RaceText(x->race), x->role == ROLE_CIVILIAN ? std::string("townsperson") : ClassText(x->cls));
+            if (SimAgent const* y = AgentById(b)) bn = y->FullName();
+        }
+        out += Acore::StringFormat("\n[{}] {} {}: {}", moods[std::min<uint8>(said.mood, 8)], an, said.yell ? "yells" : "says", said.text);
+        if (!back.text.empty()) out += Acore::StringFormat("\n      {}: {}", bn, back.text);
+    }
+    return out.empty() ? "nobody has anything to say" : out;
+}
