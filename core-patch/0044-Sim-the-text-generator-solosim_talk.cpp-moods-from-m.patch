+World::TalkLine World::Talk(uint32 speakerId, uint32 listenerId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    TalkLine out;
+    SimAgent const* a = AgentById(speakerId);
+    if (!a || a->status != AgentStatus::Active || a->doing == Verb::Sleep) return out;
+    SimAgent const* l = listenerId ? AgentById(listenerId) : nullptr;
+    if (l && IsHordeRace(l->race) != IsHordeRace(a->race) && a->role == ROLE_ADVENTURER) l = nullptr;   // no common tongue
+    Rng r(_seed, speakerId, _clock * 13 + listenerId, 9980);
+    Voice const& v = VoiceOf(a->race);
+    uint8 mood = MoodOf(*a);
+    bool curt = a->sociability < 30;
+    out.mood = mood;
+
+    // ---- candidates: (weight, act, the words) ---------------------------------------------------------------------
+    struct Option { float w; uint8 act; std::string text; uint32 emote; uint32 topic; };
+    std::vector<Option> opts;
+    // grief: a friend lost lately
+    for (SimMemory const& m : _memories)
+        if (m.agent == a->id && m.subjectType == 1 && _clock - m.at < 2 * MIN_PER_DAY
+            && (m.eventType == uint8(EventType::Died) || m.eventType == uint8(EventType::HeardDeath) || m.eventType == uint8(EventType::FellBeside)))
+            if (SimAgent const* d = AgentById(m.subject); d && d->status == AgentStatus::Dead)
+            {
+                std::string place = d->site ? AreaText(SiteName(d->site)) : std::string("out there");
+                std::string t = Pick(std::vector<std::string>{ d->FullName() + " didn't come back. Out near " + place + ".",
+                    "I keep thinking about " + d->FullName() + ".", d->FullName() + " is gone. Just like that.",
+                    "We drank together not a week ago, " + d->given + " and I." }, r);
+                opts.push_back({ mood == MOOD_GRIEVING ? 8.0f : 2.0f, ACT_LAMENT, t, uint32(r.Chance(0.4f) ? EMOTE_ONESHOT_CRY : 0), m.subject });
+                break;
+            }
+    // a beating taken, or the other side met on the road
+    for (SimMemory const& m : _memories)
+        if (m.agent == a->id && _clock - m.at < 2 * MIN_PER_DAY)
+        {
+            if (m.eventType == uint8(EventType::Defeated) && m.subjectType == 3)
+                opts.push_back({ mood == MOOD_ANGRY ? 5.0f : 1.5f, ACT_GRUMBLE, Pick(std::vector<std::string>{ AreaText(SiteName(m.subject)) + " nearly finished me.",
+                    "Got knocked flat out near " + AreaText(SiteName(m.subject)) + ". Never again.", "I'll go back to " + AreaText(SiteName(m.subject)) + ". When I can walk straight." }, r),
+                    uint32(EMOTE_ONESHOT_NO), 0 });
+            else if (m.eventType == uint8(EventType::Clash) && m.subjectType == 1)
+                if (SimAgent const* f = AgentById(m.subject))
+                    opts.push_back({ 2.0f, ACT_GRUMBLE, Pick(std::vector<std::string>{ "Ran into " + f->FullName() + " on the road. " + (IsHordeRace(f->race) ? "Horde" : "Alliance") + " filth.",
+                        "Next time I see " + f->given + ", it ends differently.", "Crossed blades with one of the " + std::string(IsHordeRace(f->race) ? "Horde" : "Alliance") + " lot. " + f->given + ", they called it." }, r),
+                        uint32(EMOTE_ONESHOT_ROAR), 0 });
+            else continue;
+            break;
+        }
+    // a rare brought down
+    for (SimMemory const& m : _memories)
+        if (m.agent == a->id && m.eventType == uint8(EventType::RareSlain) && _clock - m.at < 2 * MIN_PER_DAY)
+        {
+            std::string what = m.subjectType == 3 && SiteById(m.subject) ? "the big one near " + AreaText(SiteName(m.subject)) : std::string("a nasty one");
+            if (SimAgent const* t = AgentById(m.subject); t && t->role == ROLE_THREAT) what = t->FullName();
+            opts.push_back({ mood == MOOD_PROUD ? 6.0f : 3.0f, ACT_BOAST, Pick(std::vector<std::string>{ "We brought down " + what + ". Took all of us.",
+                "You're looking at one of the ones who put down " + what + ".", "Still got the scars from " + what + ". Worth it." }, r),
+                uint32(a->bravery > 60 ? EMOTE_ONESHOT_FLEX : EMOTE_ONESHOT_CHEER), 0 });
+            break;
+        }
+    // a dungeon run
+    if (auto it = _lastRunOf.find(a->id); it != _lastRunOf.end() && _clock - it->second.at < 2 * MIN_PER_DAY)
+    {
+        RunMemory const& rm = it->second;
+        std::string t;
+        if (rm.down == rm.total) t = Pick(std::vector<std::string>{ "We cleared " + rm.dungeon + ". Every last one of them.", "Back from " + rm.dungeon + ". Cleared it top to bottom.",
+            rm.dungeon + "? Done. Next." }, r);
+        else if (rm.down) t = Pick(std::vector<std::string>{ "Got as far as " + rm.stoppedBy + " in " + rm.dungeon + ". Then it all went wrong.",
+            rm.dungeon + " was going well until " + rm.stoppedBy + "." }, r);
+        else t = Pick(std::vector<std::string>{ "Went into " + rm.dungeon + ". Came straight back out. Don't ask.", rm.stoppedBy + " in " + rm.dungeon + " - first room, and we were done." }, r);
+        if (!rm.item.empty() && rm.down) t += Pick(std::vector<std::string>{ " Got " + rm.item + " off " + rm.boss + ", mind.", " " + rm.boss + " dropped " + rm.item + ". Mine now." }, r);
