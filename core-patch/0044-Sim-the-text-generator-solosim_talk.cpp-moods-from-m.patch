index 0000000..0b8f8c9
--- /dev/null
+++ b/src/server/game/SoloSim/solosim_talk.cpp
@@ -0,0 +1,447 @@
+// SoloWoW: the text generator (Nov 18) - the user's design; ours, not an AI model (the templated-text rule stands:
+// every word comes from our phrase banks and the sim's own facts).
+//
+//   what they know   - the town's news, a danger near home, what they did lately (a dungeon run and what dropped, a
+//                      rare they helped bring down), a friend lost, a beating taken, their ambition, who's in front of them
+//   how they feel    - a mood from what happened to them lately and their state, coloured by their nature
+//   what they say    - gossip, a warning, a boast, a lament, a grumble, a hope, a greeting, a jab - and the listener's
+//                      answer, by what they know, how they feel about the speaker and how the speaker seems
+//   how they say it  - each race's voice, true to lore (troll patter, dwarf brogue, orc bluntness, Forsaken grim wit,
+//                      night elf formality, gnome rattle, goblin deal-talk, tauren slowness, draenei devotion, blood elf
+//                      hauteur, Gilnean gruffness, plain human), shaded by personality (the curt say less, the brave
+//                      more, the careful hedge, the greedy count coin)
+//   delivery         - /say, a /yell when it matters, an emote to go with it
+// Facts are never paraphrased - names, places and items are the world's own - so nothing said contradicts the world.
+#include "solosim.h"
+#include "SharedDefines.h"
+#include <algorithm>
+#include <cmath>
+
+namespace SoloSim
+{
+namespace
+{
+    enum Mood : uint8 { MOOD_CONTENT, MOOD_HAPPY, MOOD_PROUD, MOOD_GRIEVING, MOOD_ANGRY, MOOD_SCARED, MOOD_HURT, MOOD_TIRED, MOOD_BORED };
+    enum Act : uint8 { ACT_NONE, ACT_GOSSIP, ACT_WARN, ACT_BOAST, ACT_LAMENT, ACT_GRUMBLE, ACT_HOPE, ACT_GREET, ACT_JAB, ACT_REPLY };
+
+    // ---- the races' voices ----------------------------------------------------------------------------------------
+    struct Voice
+    {
+        std::vector<char const*> lead;      // before news: "Did you hear?"
+        std::vector<char const*> agree;     // "Aye."
+        std::vector<char const*> surprise;  // "Truly?"
+        std::vector<char const*> sorry;     // for grief
+        std::vector<char const*> cheer;     // well done
+        std::vector<char const*> curse;     // anger
+        std::vector<char const*> fear;      // fright
+        std::vector<char const*> tag;       // on the end, sometimes
+        std::vector<char const*> hello;     // a greeting, {} = name
+        std::vector<char const*> scorn;     // for a rival, {} = name
+    };
+
+    Voice const& VoiceOf(uint8 race)
