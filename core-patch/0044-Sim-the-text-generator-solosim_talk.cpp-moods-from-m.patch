+                SoloSim::World::TalkLine said = urand(1, 100) <= 60 ? sSoloSim->Talk(agent, other) : SoloSim::World::TalkLine{};
+                if (!said.text.empty())
+                {
+                    bot->HandleEmoteCommand(Emote(said.emote ? said.emote : EMOTE_ONESHOT_TALK));
+                    if (said.yell) bot->Yell(said.text, tongue); else bot->Say(said.text, tongue);
+                    saidAt[bot->GetEntry()] = getMSTime();
+                    lastChatter = getMSTime();
+                    if (otherBody)
+                    {
+                        SoloSim::World::TalkLine back = sSoloSim->TalkReply(other, agent, said);
+                        if (!back.text.empty())
