+    // the chronicle's words, for saying out loud: without its bookkeeping in brackets ("(troll priest, 72)", "(15 gold)")
+    std::string Speakable(std::string s)
+    {
+        for (size_t open = s.find(" ("); open != std::string::npos; open = s.find(" (", open))
+        {
+            size_t close = s.find(')', open);
+            if (close == std::string::npos) break;
+            s.erase(open, close - open + 1);
+        }
+        for (size_t p = s.find(" ."); p != std::string::npos; p = s.find(" .", p)) s.erase(p, 1);
+        for (size_t p = s.find(" ,"); p != std::string::npos; p = s.find(" ,", p)) s.erase(p, 1);
+        return s;
+    }
+
+    // a tag on the end: ", mon." takes the place of the sentence's own full stop; " Aye." just follows it
+    std::string WithTag(std::string text, std::string const& tag)
+    {
+        if (tag.empty()) return text;
+        if (tag[0] == ',')
+        {
+            if (!text.empty() && (text.back() == '!' || text.back() == '?')) return text;     // "No way, mon!" needs nothing more
+            while (!text.empty() && (text.back() == '.' || text.back() == ' ')) text.pop_back();
+        }
+        return text + tag;
+    }
+
+    template <typename L> std::string Pick(L const& list, Rng& r) { return list.empty() ? std::string() : std::string(list[r.Range(0, uint32(list.size()) - 1)]); }
+    std::string Fill(std::string fmt, std::string const& name)
+    {
+        if (size_t p = fmt.find("{}"); p != std::string::npos) fmt.replace(p, 2, name);
+        return fmt;
+    }
+}
