+                }
+                else if (std::string line = sSoloSim->AdventurerChatter(agent, other); !line.empty())
                 {
                     // in their own side's tongue: the other side hears gibberish, as in the game (Nov 17)
                     bot->Say(line, sSoloSim->AgentIsHorde(agent) ? LANG_ORCISH : LANG_COMMON);
