 // how many adventurers call a town home: by its size, and a capital's shared between its inns (Nov 17)
+// the starting camps (Northshire, Coldridge, Aldrassil, the Valley of Trials, Camp Narache, Deathknell...): trainers
+// and a vendor, no inn, in level 1-10 land. Every new adventurer's life begins in one (Nov 17 - they stood empty).
+bool World::IsStartCamp(SimSite const& h) const
+{
+    if (h.type != SiteType::Hub || (h.services & SVC_INN) || !h.regionLevel) return false;
+    static char const* const camps[] = { "Northshire Valley", "Coldridge Valley", "Aldrassil", "Shadowglen", "Valley of Trials", "Camp Narache", "Deathknell" };
+    std::string base = h.name;
+    if (size_t p = base.rfind(" ("); p != std::string::npos && base.back() == ')') base = base.substr(0, p);
+    return std::ranges::any_of(camps, [&](char const* c) { return base == c; });
+}
