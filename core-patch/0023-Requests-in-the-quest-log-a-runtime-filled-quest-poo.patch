+// SoloWoW: townsfolk requests as real quests in the player's log (Nov 17).
+#ifndef SOLOWOW_SOLOSIM_QUESTS_H
+#define SOLOWOW_SOLOSIM_QUESTS_H
+
+#include "Define.h"
+
+class Player;
+class Creature;
+
+namespace SoloQuests
+{
+    constexpr uint32 QUEST_BASE = 95000, QUEST_POOL = 1000;   // reserved ids 95000-95999 (scripts/sim_quests.sql)
+    inline uint32 QuestId(uint32 errandId) { return QUEST_BASE + errandId % QUEST_POOL; }
+    inline bool IsOurs(uint32 questId) { return questId >= QUEST_BASE && questId < QUEST_BASE + QUEST_POOL; }
+
+    bool Offer(Player* player, Creature* giver, uint32 errandId);    // fill the quest and put it in the log
+    bool TurnIn(Player* player, Creature* giver, uint32 errandId);   // complete + reward if the log says it's done
+    bool InLog(Player* player, uint32 errandId);
+    void Sync(Player* player);                                       // event objectives, expired requests, restore texts
+}
+
+void AddSC_solosim_quests();
+
+#endif
