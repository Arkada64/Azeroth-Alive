diff --git a/src/server/game/SoloSim/solosim_quests.cpp b/src/server/game/SoloSim/solosim_quests.cpp
new file mode 100644
index 0000000..13de5d9
--- /dev/null
+++ b/src/server/game/SoloSim/solosim_quests.cpp
@@ -0,0 +1,195 @@
+// SoloWoW: townsfolk requests as real quests (Nov 17). A pool of reserved quest ids (95000-95999, plain rows added by
+// scripts/sim_quests.sql) is filled at runtime from the sim: title, the townsperson's own words, objectives the game
+// tracks itself (kills of the creature, items to bring, or an "event" the sim marks: an escort arriving, word given,
+// the missing found), the reward (the request's money, a little XP) and a rough area on the map. Taking a request puts
+// it in the log; finishing it with the townsperson completes and rewards the quest. Ids follow the request's own id,
+// so nothing extra is saved: at login the player's open pool quests are filled again from their requests. The client's
+// quest cache is cleared at every launch (launcher, manager), so a slot reused in a later session shows its new text.
+#include "solosim_quests.h"
+#include "solosim.h"
+#include "Chat.h"
+#include "Creature.h"
+#include "DBCStores.h"
+#include "Log.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "QuestDef.h"
+#include "ScriptMgr.h"
+#include <algorithm>
+#include <cmath>
+#include <mutex>
+#include <unordered_map>
+
+// the friend of Quest (QuestDef.h) that rewrites a pool quest
+class SoloQuestWriter
+{
+public:
+    static void Write(Quest* q, SoloSim::World::ErrandQuest const& in, uint32 creatureEntry)
+    {
+        q->Title = in.title; q->Details = in.details; q->Objectives = in.objective;
+        q->RequestItemsText = in.request; q->OfferRewardText = in.offer; q->AreaDescription = ""; q->CompletedText = "";
+        q->Level = int32(in.level); q->MinLevel = 1; q->MaxLevel = 0; q->Type = 0; q->ZoneOrSort = int32(in.giverZone);
+        q->Flags = 0; q->SpecialFlags = 0; q->AllowableRaces = 0; q->SuggestedPlayers = 0; q->TimeAllowed = 0;
+        q->RewardMoney = int32(in.reward); q->RewardXPDifficulty = in.kind == SoloSim::ERRAND_OLDFOE ? 4 : in.kind == SoloSim::ERRAND_FETCH ? 1 : 2;
+        q->RewardNextQuest = 0; q->PrevQuestId = 0; q->NextQuestId = 0; q->ExclusiveGroup = 0; q->BreadcrumbForQuestId = 0;
+        for (uint32 i = 0; i < QUEST_OBJECTIVES_COUNT; ++i) { q->RequiredNpcOrGo[i] = 0; q->RequiredNpcOrGoCount[i] = 0; q->ObjectiveText[i] = ""; }
+        for (uint32 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i) { q->RequiredItemId[i] = 0; q->RequiredItemCount[i] = 0; }
+        q->_reqItemsCount = 0; q->_reqCreatureOrGOcount = 0;
+        switch (in.kind)
+        {
+            case SoloSim::ERRAND_CULL: case SoloSim::ERRAND_STOLEN: case SoloSim::ERRAND_OLDFOE:
+                if (creatureEntry)
+                {
+                    q->RequiredNpcOrGo[0] = int32(creatureEntry);
+                    q->RequiredNpcOrGoCount[0] = in.kind == SoloSim::ERRAND_OLDFOE ? 1 : in.count;
+                    if (in.kind == SoloSim::ERRAND_STOLEN) q->ObjectiveText[0] = in.creatureName + " searched";
+                    q->_reqCreatureOrGOcount = 1;
+                    break;
+                }
+                q->SpecialFlags |= QUEST_SPECIAL_FLAGS_EXPLORATION_OR_EVENT;     // no creature to count: the sim says when
+                break;
+            case SoloSim::ERRAND_FETCH:
+                q->RequiredItemId[0] = in.item; q->RequiredItemCount[0] = in.count; q->_reqItemsCount = 1;
+                break;
+            default:                                                              // escorts, word, the missing
+                q->SpecialFlags |= QUEST_SPECIAL_FLAGS_EXPLORATION_OR_EVENT;
+                break;
+        }
+        q->InitializeQueryData();
+    }
+};
+
+namespace SoloQuests
+{
+namespace
+{
+    // creature entry by name and level (the hunting ground's creature): built once
+    std::mutex nameLock;
+    std::unordered_multimap<std::string, uint32> byName;
+    uint32 CreatureFor(std::string const& name, uint8 lo, uint8 hi)
+    {
+        std::lock_guard<std::mutex> g(nameLock);
+        if (byName.empty())
+            for (auto const& [entry, t] : *sObjectMgr->GetCreatureTemplates())
+                byName.emplace(t.Name, entry);
+        uint32 best = 0; int32 bestD = 1000;
+        auto [b, e] = byName.equal_range(name);
+        for (auto it = b; it != e; ++it)
+            if (CreatureTemplate const* t = sObjectMgr->GetCreatureTemplate(it->second))
+            {
+                int32 mid = int32(t->minlevel + t->maxlevel) / 2, want = int32(lo + hi) / 2;
+                if (int32 d = std::abs(mid - want); d < bestD) { bestD = d; best = it->second; }
+            }
+        return best;
+    }
+
+    // a rough area on the map, the way real quests show where to go (and where to come back to)
+    void SetArea(uint32 questId, SoloSim::World::ErrandQuest const& in)
+    {
+        QuestPOIVector& v = sObjectMgr->SoloQuestPOI(questId);
+        v.clear();
+        auto blob = [&](uint32 id, int32 objective, uint32 map, uint32 zone, float x, float y, float r) {
+            QuestPOI poi(id, objective, map, zone, 0, 0, 1);
+            for (int k = 0; k < 8; ++k)
+            {
+                float a = float(k) * float(M_PI) / 4.0f + 0.3f;
+                QuestPOIPoint p; p.x = int32(x + r * std::cos(a)); p.y = int32(y + r * std::sin(a));
+                poi.points.push_back(p);
+            }
+            v.push_back(poi);
+        };
+        if (in.hasPlace) blob(0, 0, in.map, in.zone, in.x, in.y, 90.0f);
+        blob(1, -1, in.giverMap, in.giverZone, in.giverX, in.giverY, 30.0f);        // turn in: back in town
+    }
+
+    bool Fill(uint32 errandId, uint32 guid)
+    {
+        SoloSim::World::ErrandQuest in;
+        if (!sSoloSim->ErrandQuestInfo(errandId, guid, in)) return false;
+        Quest const* q = sObjectMgr->GetQuestTemplate(QuestId(errandId));
+        if (!q) { LOG_ERROR("server.loading", "SoloWoW: quest pool row {} is missing - apply scripts/sim_quests.sql", QuestId(errandId)); return false; }
+        uint32 entry = in.creatureName.empty() ? 0 : CreatureFor(in.creatureName, in.minLevel, in.maxLevel);
+        SoloQuestWriter::Write(const_cast<Quest*>(q), in, entry);
+        SetArea(q->GetQuestId(), in);
+        return true;
+    }
+}
+
+bool InLog(Player* player, uint32 errandId)
+{
+    QuestStatus st = player->GetQuestStatus(QuestId(errandId));
+    return st == QUEST_STATUS_INCOMPLETE || st == QUEST_STATUS_COMPLETE;
+}
+
+bool Offer(Player* player, Creature* giver, uint32 errandId)
+{
+    if (!player || !Fill(errandId, player->GetGUID().GetCounter())) return false;
+    Quest const* q = sObjectMgr->GetQuestTemplate(QuestId(errandId));
+    if (InLog(player, errandId)) return true;
+    if (player->GetQuestStatus(q->GetQuestId()) == QUEST_STATUS_REWARDED)    // the slot was used before: clear it for the new one
+        player->RemoveRewardedQuest(q->GetQuestId());
+    if (!player->CanAddQuest(q, true)) return false;
+    player->AddQuestAndCheckCompletion(q, giver);
+    ChatHandler(player->GetSession()).PSendSysMessage("Quest accepted: {}", q->GetTitle());
+    return true;
+}
+
+bool TurnIn(Player* player, Creature* giver, uint32 errandId)
+{
+    uint32 id = QuestId(errandId);
+    Quest const* q = sObjectMgr->GetQuestTemplate(id);
+    if (!q || player->GetQuestStatus(id) != QUEST_STATUS_COMPLETE) return false;
+    if (!player->CanRewardQuest(q, true)) return false;
+    sSoloSim->ForceErrandProgress(errandId);
+    player->RewardQuest(q, 0, giver);
+    return true;
+}
+
+void Sync(Player* player)
+{
+    if (!player) return;
+    uint32 guid = player->GetGUID().GetCounter();
+    std::vector<uint32> ours;
+    for (auto const& [qid, st] : player->getQuestStatusMap())
+        if (IsOurs(qid) && (st.Status == QUEST_STATUS_INCOMPLETE || st.Status == QUEST_STATUS_COMPLETE)) ours.push_back(qid);
+    for (uint32 qid : ours)
+    {
+        SoloSim::SimErrand e;
+        if (!sSoloSim->ErrandBySlot(guid, qid - QUEST_BASE, QUEST_POOL, e))
+        {
+            // the request is gone (they gave up waiting, or it was settled another way): off the log
+            player->RemoveActiveQuest(qid);
+            ChatHandler(player->GetSession()).SendSysMessage("A request you took on is no longer needed.");
+            continue;
+        }
+        Quest const* q = sObjectMgr->GetQuestTemplate(qid);
+        if (q && q->GetTitle().empty()) Fill(e.id, guid);                        // after a restart: its words again
+        if (q && q->HasSpecialFlag(QUEST_SPECIAL_FLAGS_EXPLORATION_OR_EVENT) && e.kind != SoloSim::ERRAND_FETCH
+            && e.progress >= e.count && player->GetQuestStatus(qid) == QUEST_STATUS_INCOMPLETE)
+            player->AreaExploredOrEventHappens(qid);                             // the sim saw it done
+    }
+}
+
+namespace
+{
+    class solosim_quest_login : public PlayerScript
+    {
+    public:
+        solosim_quest_login() : PlayerScript("solosim_quest_login", { PLAYERHOOK_ON_LOGIN }) { }
+        void OnPlayerLogin(Player* player) override
+        {
+            // the open requests' quests get their words and objectives again before the client asks for them
+            uint32 guid = player->GetGUID().GetCounter();
+            for (auto const& [qid, st] : player->getQuestStatusMap())
+                if (IsOurs(qid) && (st.Status == QUEST_STATUS_INCOMPLETE || st.Status == QUEST_STATUS_COMPLETE))
+                {
+                    SoloSim::SimErrand e;
+                    if (sSoloSim->ErrandBySlot(guid, qid - QUEST_BASE, QUEST_POOL, e)) Fill(e.id, guid);
+                }
+        }
+    };
+}
+}
+
+void AddSC_solosim_quests() { new SoloQuests::solosim_quest_login(); }
