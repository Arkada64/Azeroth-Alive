+// ---------------------------------------------------------------------------------------------------------------------
+// requests as quests in the player's log (Nov 17): the title, the townsperson's own words, what to do, the reward
+bool World::ErrandQuestInfo(uint32 errandId, uint32 guid, ErrandQuest& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimErrand const* e = nullptr;
+    for (SimErrand const& x : _errands) if (x.id == errandId && !x.done) e = &x;
+    if (!e) return false;
+    SimAgent const* a = AgentById(e->agent);
+    SimSite const* home = a ? SiteById(a->home) : nullptr;
+    if (!a || !home) return false;
+    out = {};
+    out.errand = e->id; out.agent = a->id; out.kind = e->kind; out.reward = e->reward; out.count = e->count; out.item = e->item;
+    out.level = std::max<uint32>(1, home->regionLevel);
+    out.giverMap = home->map; out.giverZone = home->zone; out.giverX = home->x; out.giverY = home->y;
+    out.details = ErrandText(*e);
+    SimSite const* s = SiteById(e->site);
+    std::string who = a->FullName(), town = SiteName(a->home);
+    switch (e->kind)
+    {
+        case ERRAND_CULL:
+            if (!s) return false;
+            out.title = Acore::StringFormat("{} Trouble", s->creatureName); out.creatureName = s->creatureName;
+            out.minLevel = s->minLevel; out.maxLevel = s->maxLevel; out.level = (s->minLevel + s->maxLevel) / 2;
+            out.objective = Acore::StringFormat("Kill {} {} near {}, then return to {} in {}.", e->count, s->creatureName, AreaOf(SiteName(s->id)), who, town);
+            out.request = "Did you thin them out?"; out.offer = "That'll keep them off us for a while. Thank you.";
+            break;
+        case ERRAND_STOLEN:
+            if (!s) return false;
+            out.title = Acore::StringFormat("Stolen: {}", StolenThing(e->id)); out.creatureName = s->creatureName;
+            out.minLevel = s->minLevel; out.maxLevel = s->maxLevel; out.level = (s->minLevel + s->maxLevel) / 2;
+            out.objective = Acore::StringFormat("One of the {} near {} has {}'s {}. Kill them until it turns up ({}), then bring it back to {}.",
+                s->creatureName, AreaOf(SiteName(s->id)), a->given, StolenThing(e->id), e->count, town);
+            out.request = "Any sign of it?"; out.offer = "That's it! I never thought I'd see it again.";
+            break;
+        case ERRAND_OLDFOE:
+            out.title = Acore::StringFormat("An Old Score: {}", RareName(e->target)); out.level = s ? (s->minLevel + s->maxLevel) / 2 + 2 : out.level;
+            out.objective = Acore::StringFormat("Kill {}{}, then tell {} in {}.", RareName(e->target), s ? " near " + AreaOf(SiteName(s->id)) : std::string(), who, town);
+            out.request = "Well? Is it done?"; out.offer = "After all these years. Thank you.";
+            break;
+        case ERRAND_ESCORT:
+            out.title = Acore::StringFormat("The Road to {}", SiteName(e->site));
+            out.objective = Acore::StringFormat("Walk {} safely to {}.", who, SiteName(e->site));
+            out.request = "Are we there yet?"; out.offer = Acore::StringFormat("{} at last. I'd not have made it alone.", SiteName(e->site));
+            break;
+        case ERRAND_MESSAGE:
+            if (SimAgent const* t = AgentById(e->target))
+            {
+                out.title = Acore::StringFormat("Word for {}", t->given);
+                out.objective = Acore::StringFormat("Find {} and give them word from home, then tell {} in {}.", t->FullName(), who, town);
+            }
+            out.request = "Did you find them?"; out.offer = "Thank you. It means more than you know.";
+            break;
+        case ERRAND_MISSING:
+            if (SimAgent const* t = AgentById(e->target))
+            {
+                out.title = Acore::StringFormat("Missing: {}", t->FullName());
+                out.objective = Acore::StringFormat("Find out what became of {}, then tell {} in {}.", t->FullName(), who, town);
+            }
+            out.request = "Any news?"; out.offer = "I'd rather know than wonder.";
+            break;
+        case ERRAND_FETCH:
+        {
+            ItemTemplate const* it = sObjectMgr->GetItemTemplate(e->item);
+            out.title = Acore::StringFormat("{} for {}", it ? it->Name1 : std::string("Supplies"), a->given);
+            out.objective = Acore::StringFormat("Bring {} {} to {} in {}.", e->count, it ? it->Name1 : std::string("of them"), who, town);
+            out.request = "Have you got them?"; out.offer = "Just what I needed.";
+            break;
+        }
+        default: return false;
+    }
+    if (out.title.empty()) return false;
+    // where to go: the same rough place the map flag points at
+    if (s && e->kind != ERRAND_FETCH) { out.hasPlace = true; out.map = s->map; out.zone = s->zone; out.x = s->x; out.y = s->y; }
+    if ((e->kind == ERRAND_MESSAGE || e->kind == ERRAND_MISSING))
+        if (SimAgent const* t = AgentById(e->target))
+            if (SimSite const* ts = SiteById(t->site)) { out.hasPlace = true; out.map = ts->map; out.zone = ts->zone; out.x = ts->x; out.y = ts->y; }
+    return true;
+}
+
+bool World::ErrandBySlot(uint32 guid, uint32 slot, uint32 pool, SimErrand& out)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand const& e : _errands)
+        if (!e.done && e.player == guid && e.id % pool == slot) { out = e; return true; }
+    return false;
+}
+
+void World::ForceErrandProgress(uint32 errandId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    for (SimErrand& e : _errands) if (e.id == errandId && !e.done) e.progress = std::max(e.progress, e.count);
+}
