+// what worries a town right now, said plainly (Nov 17): the nearest bandit camp, pack or roaming threat - or nothing
+std::string World::TownWorry(uint32 agentId)
+{
+    std::lock_guard<std::mutex> guard(sBodyLock);
+    SimAgent const* a = AgentById(agentId);
+    SimSite const* home = a ? SiteById(a->home) : nullptr;
+    if (!home) return "";
+    SimCamp const* closest = nullptr; float best = 1500.0f;
+    for (SimCamp const& k : _camps)
+        if (!k.done && k.kind != CAMP_HERD && k.map == home->map)
+            if (float d = Dist2d(k.x, k.y, home->x, home->y); d < best) { best = d; closest = &k; }
+    Rng r(_seed, agentId, _clock / 60, P_SOCIAL + 960);
+    for (auto const& [id, o] : _agents)
+        if (o.role == ROLE_THREAT && o.status == AgentStatus::Active)
+            if (SimSite const* s = SiteById(o.site); s && s->map == home->map && Dist2d(s->x, s->y, home->x, home->y) < 2000.0f)
+                return Acore::StringFormat(r.Chance(0.5f) ? "They say {} has been seen closest {}. Nobody's going that way." : "{} - closest {}, they say. Lock your door tonight.",
+                    o.FullName(), AreaOf(SiteName(o.site)));
+    if (!closest) return "";
+    std::string where = AreaOf(SiteName(closest->site));
+    if (closest->kind == CAMP_PACK)
+        return Acore::StringFormat(closest->alive <= 2 ? "Something's been taking sheep closest {}. A {}, maybe two." : "{} about closest {}. Keep the little ones in after dark.",
+            closest->alive <= 2 ? where : Plural(closest->name), closest->alive <= 2 ? closest->name : where);
+    static char const* const band[] = { "There's a {} camp off the road closest {}. Nobody goes that way after dark.",
